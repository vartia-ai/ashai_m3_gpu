+static drm_asahi_params_global
+g15_graphics_params()
+{
+   auto p = g15_params();
+   p.vm_start = AGX_G15_CONTEXT_BASE;
+   p.vm_end = UINT64_C(0x6000000000);
+   p.render_context_start = AGX_G15_CONTEXT_USER_MIN;
+   p.render_context_end = AGX_G15_CONTEXT_END;
+   return p;
+}
+
+TEST(G15Graphics, RequiresExplicitModeAndActual624ByteTail)
+{
+   auto p = g15_graphics_params();
+   bool selected = false;
+   ASSERT_TRUE(agx_g15_graphics_select(&p, sizeof(p), true, false, false, &selected));
+   ASSERT_TRUE(selected);
+   EXPECT_FALSE(agx_g15_graphics_select(&p, sizeof(p), true, true, false, &selected));
+   EXPECT_FALSE(selected);
+   EXPECT_FALSE(agx_g15_graphics_select(&p, sizeof(p), true, false, true, &selected));
+   for (size_t size : {size_t(592), size_t(608), size_t(616), size_t(623)})
+      EXPECT_FALSE(agx_g15_graphics_select(&p, size, true, false, false, &selected));
+   drm_asahi_params_global old_reply = {};
+   memcpy(&old_reply, &p, 608);
+   /* GET_PARAMS leaves requested size unchanged: zero tail must fail. */
+   EXPECT_FALSE(agx_g15_graphics_select(&old_reply, 624, true, false, false, &selected));
+   EXPECT_FALSE(selected);
+   EXPECT_TRUE(agx_g15_compute_select(&old_reply, 608, true, false, &selected));
+   EXPECT_TRUE(selected);
+   EXPECT_TRUE(agx_g15_graphics_select(&old_reply, 608, false, true, false, &selected));
+   EXPECT_FALSE(selected);
+   for (unsigned gen : {13, 14, 16, 17}) {
+      p.gpu_generation = gen;
+      EXPECT_TRUE(agx_g15_graphics_select(&p, 592, true, false, false, &selected));
+      EXPECT_FALSE(selected);
+   }
+}
+
+TEST(G15Graphics, RejectsBadContextAndInheritedComputeContracts)
+{
+   auto good = g15_graphics_params();
+   for (unsigned field = 0; field < 11; ++field) {
+      auto p = good;
+      switch (field) {
+      case 0: p.render_context_start = 0; break;
+      case 1: p.render_context_start -= AGX_G15_PAGE_SIZE; break;
+      case 2: p.render_context_end += AGX_G15_PAGE_SIZE; break;
+      case 3: p.render_context_start += 1; break;
+      case 4: p.render_context_end -= 1; break;
+      case 5: p.render_context_end = p.render_context_start; break;
+      case 6: p.render_context_end = p.render_context_start + AGX_G15_PAGE_SIZE; break;
+      case 7: p.vm_start = p.render_context_start + AGX_G15_PAGE_SIZE; break;
+      case 8: p.vm_end = p.render_context_end - AGX_G15_PAGE_SIZE; break;
+      case 9: p.features = UINT64_MAX; break;
+      case 10: p.max_commands_per_submission = 2; break;
+      }
+      bool selected = true;
+      EXPECT_FALSE(agx_g15_graphics_select(&p, 624, true, false, false, &selected));
+      EXPECT_FALSE(selected);
+   }
+}
