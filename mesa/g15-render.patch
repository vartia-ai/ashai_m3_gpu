+TEST(Apple9Launcher, G15AbsoluteTargetsCoverFixedUscWindow)
+{
+   auto p = parameters();
+   p.target_format = AGX_APPLE9_LAUNCH_TARGET_G15_ABSOLUTE;
+   for (auto stage : {AGX_APPLE9_LAUNCH_VERTEX, AGX_APPLE9_LAUNCH_FRAGMENT,
+                     AGX_APPLE9_LAUNCH_COMPUTE}) {
+      for (uint32_t offset : {0u, 0x40u, 0x100u, 0x1c0u, 0x10000200u,
+                              0xfffffe00u, 0xffffffc0u}) {
+         p.entry_offset = offset;
+         std::array<uint8_t, 1024> out;
+         ASSERT_TRUE(agx_apple9_launch_build(out.data(), out.size(), stage, &p));
+         unsigned at = agx_apple9_launch_call_offset(stage, p.resource_count) - 2;
+         EXPECT_EQ(read16(out.data() + at), 0x177u);
+         EXPECT_EQ(out[at + 2] & 0x7f, 0x2a);
+         uint64_t address = 0;
+         for (unsigned byte = 0; byte < 5; ++byte)
+            address |= uint64_t(out[at + 3 + byte]) << (7 + 8 * byte);
+         address |= uint64_t(out[at + 2] >> 7) << 6;
+         EXPECT_EQ(address, p.shader_base + offset);
+         EXPECT_EQ(out[at + 8], stage == AGX_APPLE9_LAUNCH_VERTEX ? 0 : 4);
+         EXPECT_EQ(out[at + 9], 0);
+         EXPECT_EQ(out.back(), 0);
+      }
+   }
+}
+
+TEST(Apple9Launcher, TargetFormatChangesOnlyTheTargetInstruction)
+{
+   auto p = parameters();
+   p.preamble_address = p.shader_base + 0x10000;
+   p.launch_address = p.shader_base + 0x204000;
+   for (auto stage : {AGX_APPLE9_LAUNCH_VERTEX, AGX_APPLE9_LAUNCH_FRAGMENT,
+                     AGX_APPLE9_LAUNCH_COMPUTE}) {
+      std::array<uint8_t, 1024> compact, explicit_compact, absolute;
+      p.target_format = AGX_APPLE9_LAUNCH_TARGET_COMPACT;
+      ASSERT_TRUE(agx_apple9_launch_build(compact.data(), compact.size(), stage, &p));
+      auto default_params = p;
+      default_params.target_format = {};
+      ASSERT_TRUE(agx_apple9_launch_build(explicit_compact.data(),
+                                        explicit_compact.size(), stage, &default_params));
+      EXPECT_EQ(compact, explicit_compact);
+      p.target_format = AGX_APPLE9_LAUNCH_TARGET_G15_ABSOLUTE;
+      ASSERT_TRUE(agx_apple9_launch_build(absolute.data(), absolute.size(), stage, &p));
+      unsigned at = agx_apple9_launch_call_offset(stage, p.resource_count) - 2;
+      memcpy(absolute.data() + at, compact.data() + at, 10);
+      EXPECT_EQ(absolute, compact);
+   }
+}
