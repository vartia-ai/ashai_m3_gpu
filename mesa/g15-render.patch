+
+TEST(G15Compute, LegacyParamsPrefixPreservesOtherDevices)
+{
+   static_assert(offsetof(drm_asahi_params_global, usc_window_start) == 592);
+   static_assert(sizeof(drm_asahi_params_global) == 624);
+   static_assert(offsetof(drm_asahi_params_global, render_context_start) == 608);
+   for (unsigned generation : {13, 14, 16, 17}) {
+      auto p = g15_params();
+      p.gpu_generation = generation;
+      p.features = UINT64_MAX; /* Existing non-G15 feature policy is unchanged. */
+      p.usc_window_start = p.usc_window_end = 0;
+      drm_asahi_params_global reply = {};
+      memcpy(&reply, &p, 592); /* An actual legacy-sized reply, zero-filled tail. */
+      EXPECT_EQ(reply.usc_window_start, 0u);
+      EXPECT_EQ(reply.usc_window_end, 0u);
+      for (bool requested : {false, true}) {
+         bool selected = true;
+         EXPECT_TRUE(agx_g15_compute_select(&reply, 592, requested, false, &selected));
+         EXPECT_FALSE(selected);
+         EXPECT_FALSE(agx_g15_compute_select(&p, 591, requested, false, &selected));
+      }
+   }
+}
