+#ifndef AGX_G15_GRAPHICS_H
+#define AGX_G15_GRAPHICS_H
+
+#include <stdlib.h>
+#include "agx_g15_compute.h"
+
+#define AGX_G15_CONTEXT_BASE UINT64_C(0x1000000000)
+#define AGX_G15_CONTEXT_USER_MIN UINT64_C(0x1004000000)
+#define AGX_G15_CONTEXT_END UINT64_C(0x1100000000)
+
+/* R8b has a separate VDM/PPP aperture. GET_PARAMS does not report the
+ * kernel's output size, so the zero-filled tail must also be validated. */
+static inline bool
+agx_g15_graphics_select(const struct drm_asahi_params_global *p,
+                       size_t returned_size, bool graphics_requested,
+                       bool compute_requested, bool virtio, bool *selected)
+{
+   if (!p || !selected)
+      return false;
+   *selected = false;
+   if (returned_size < offsetof(struct drm_asahi_params_global, usc_window_start))
+      return false;
+   if (p->gpu_generation != 15)
+      return true;
+   if (!graphics_requested)
+      return !compute_requested || returned_size >=
+         offsetof(struct drm_asahi_params_global, render_context_start);
+   bool compute_contract;
+   if (compute_requested || returned_size < sizeof(*p) ||
+       !agx_g15_compute_select(p, returned_size, true, virtio, &compute_contract) ||
+       !compute_contract)
+      return false;
+   uint64_t start = p->render_context_start, end = p->render_context_end;
+   if (start < AGX_G15_CONTEXT_USER_MIN || end > AGX_G15_CONTEXT_END ||
+       start >= end || ((start | end) & (AGX_G15_PAGE_SIZE - 1)) ||
+       end - start < UINT64_C(0x100000) || start < p->vm_start || end > p->vm_end)
+      return false;
+   *selected = true;
+   return true;
+}
+
+/* The bridge renders linear RGBA8 targets up to 256x256 (#10 R4): the kernel
+ * derives the size registers and target descriptors from the command, with
+ * rows at the AGX linear stride (width * 4 rounded up to 128 bytes). */
+#define AGX_G15_GRAPHICS_MAX_DIM 256
+/* The kernel's DRM_ASAHI_G15_RENDER_USER_RT_MAX_SIZE: a target's whole
+ * attachment (for a mip level, the whole tree) must fit. */
+#define AGX_G15_GRAPHICS_MAX_TARGET_BYTES 0x10000000ull
+
+static inline uint64_t
+agx_g15_graphics_target_stride(unsigned width)
+{
+   return ((uint64_t)width * 4 + 127) & ~UINT64_C(127);
+}
+
+static inline bool
+agx_g15_graphics_target_supported(unsigned width, unsigned height,
+                                  unsigned layers, unsigned samples,
+                                  unsigned level, unsigned first_layer,
+                                  unsigned last_layer, uint64_t stride,
+                                  uint64_t size, bool rgba8, bool linear)
+{
+   /* Targets up to 8192 per side, the kernel's default g15_render_max_dim
+    * (5120x3328 and 8192x8192 exact, n6big2); ASAHI_G15_MAX_DIM sets it
+    * (256..16384). The attachment must also fit 256 MiB. */
+   static unsigned max_dim;
+   if (!max_dim) {
+      const char *env = getenv("ASAHI_G15_MAX_DIM");
+      unsigned v = env ? (unsigned)strtoul(env, NULL, 0) : 8192;
+      max_dim = v >= AGX_G15_GRAPHICS_MAX_DIM && v <= 16384 ? v
+                                                          : AGX_G15_GRAPHICS_MAX_DIM;
+   }
+   return width >= 1 && width <= max_dim && height >= 1 &&
+          height <= max_dim && layers == 1 && samples == 1 &&
+          (level == 0 || !linear) && first_layer == 0 && last_layer == 0 &&
+          size <= AGX_G15_GRAPHICS_MAX_TARGET_BYTES &&
+          (!linear || (stride == agx_g15_graphics_target_stride(width) &&
+                       size >= stride * height)) &&
+          rgba8;
+}
+
+#endif
