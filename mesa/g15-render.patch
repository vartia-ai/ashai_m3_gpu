+/* ASAHI_G15_ALLOW: comma-separated G15 draw gates to lift, for hardware
+ * qualification of features the general Apple9 path implements but G15 has
+ * not proven: index, restart, instance, multidraw, prims, scissor, dbias,
+ * fill, blend, colormask, stencil, query, logicop, a2c; or "all". blend
+ * (or all) also admits tile-reading fragment shaders. */
+static bool
+agx_g15_allow(const char *feature)
+{
+   /* Every gated feature passed the desktop-GL qualification with no
+    * baseline loss (G3: 305/617, 78 more than without them), so they are
+    * on by default. ASAHI_G15_ALLOW=none turns them all off; a list enables
+    * only the named ones. */
+   const char *env = getenv("ASAHI_G15_ALLOW");
+   if (!env || !strcmp(env, "all"))
+      return true;
+   if (!strcmp(env, "none"))
+      return false;
+   size_t n = strlen(feature);
+   for (const char *p = env; *p;) {
+      const char *end = strchr(p, ',');
+      size_t len = end ? (size_t)(end - p) : strlen(p);
+      if (len == n && !strncmp(p, feature, n))
+         return true;
+      if (!end)
+         break;
+      p = end + 1;
+   }
+   return false;
