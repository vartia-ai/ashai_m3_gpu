+TEST(G15Compute, FirstProfileRejectsUnqualifiedResourceAndHelperClasses)
+{
+   agx_apple9_compute_profile p = {};
+   p.abi = AGX_APPLE9_COMPUTE_ABI_DIRECT_BUFFERS;
+   p.resource_binding_count = 1;
+   p.resource_kind[0] = AGX_APPLE9_COMPUTE_RESOURCE_SSBO;
+   p.resource_write_mask = 1;
+   /* The authored write1337 compiler result has SSBO write_mask=1 and
+    * writes_global=false; the latter describes raw global stores. */
+   p.writes_global = false;
+   p.local_size[0] = p.local_size[1] = p.local_size[2] = 1;
+   ASSERT_TRUE(agx_g15_compute_shader_supported(&p));
+   p.resource_read_mask = 1;
+   EXPECT_TRUE(agx_g15_compute_shader_supported(&p));
+   auto good = p;
+   for (unsigned field = 0; field < 13; ++field) {
+      p = good;
+      switch (field) {
+      case 0: p.abi = AGX_APPLE9_COMPUTE_ABI_DESCRIPTOR_TABLES; break;
+      case 1: p.resource_binding_count = 2; break;
+      case 2: p.resource_binding[0] = 1; break;
+      case 3: p.resource_kind[0] = AGX_APPLE9_COMPUTE_RESOURCE_UBO; break;
+      case 4: p.resource_read_mask = 2; break;
+      case 5: p.resource_write_mask = 0; break;
+      case 6: p.variable_local_size = true; break;
+      case 7: p.local_size[0] = 2; break;
+      case 8: p.required_threadgroup_memory_bytes = 128; break;
+      case 9: p.scratch_size = 16; break;
+      case 10: p.preamble_size = 2; break;
+      case 11: p.atomic_frame_size = 4; break;
+      case 12: p.writes_global = true; break;
+      }
+      EXPECT_FALSE(agx_g15_compute_shader_supported(&p));
+   }
+}
