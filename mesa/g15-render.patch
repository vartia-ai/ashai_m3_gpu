+TEST(G15Graphics, LinearRgba8TargetsUpTo256AreAdmitted)
+{
+   auto check = [](unsigned w, unsigned h, unsigned layers, unsigned samples,
+                   unsigned level, unsigned first, unsigned last, uint64_t stride,
+                   uint64_t size, bool rgba8, bool linear) {
+      return agx_g15_graphics_target_supported(w, h, layers, samples, level,
+                                              first, last, stride, size, rgba8, linear);
+   };
+   ASSERT_TRUE(check(128,128,1,1,0,0,0,512,65536,true,true));
+   EXPECT_TRUE(check(160,160,1,1,0,0,0,640,102400,true,true));
+   EXPECT_TRUE(check(256,256,1,1,0,0,0,1024,262144,true,true));
+   EXPECT_TRUE(check(200,120,1,1,0,0,0,896,107520,true,true));
+   EXPECT_TRUE(check(1,1,1,1,0,0,0,128,128,true,true));
+   EXPECT_FALSE(check(200,120,1,1,0,0,0,800,96000,true,true));
+   EXPECT_FALSE(check(257,128,1,1,0,0,0,1152,147456,true,true));
+   EXPECT_FALSE(check(128,257,1,1,0,0,0,512,131584,true,true));
+   EXPECT_FALSE(check(0,128,1,1,0,0,0,0,0,true,true));
+   EXPECT_FALSE(check(128,128,2,1,0,0,0,512,65536,true,true));
+   EXPECT_FALSE(check(128,128,1,2,0,0,0,512,65536,true,true));
+   EXPECT_FALSE(check(128,128,1,1,1,0,0,512,65536,true,true));
+   /* A level above 0 only for GPU-tiled targets (no linear stride). */
+   EXPECT_TRUE(check(64,64,1,1,1,0,0,0,0,true,false));
+   EXPECT_FALSE(check(128,128,1,1,0,1,1,512,65536,true,true));
+   EXPECT_FALSE(check(128,128,1,1,0,0,0,1024,65536,true,true));
+   EXPECT_FALSE(check(128,128,1,1,0,0,0,512,65535,true,true));
+   EXPECT_FALSE(check(128,128,1,1,0,0,0,512,65536,false,true));
+   EXPECT_FALSE(check(128,128,1,1,0,0,0,512,65536,true,false));
+}
