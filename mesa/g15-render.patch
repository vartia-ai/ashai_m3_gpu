diff --git a/src/asahi/compiler/test/apple9-depth-fixtures.c b/src/asahi/compiler/test/apple9-depth-fixtures.c
new file mode 100644
index 0000000..645edcd
--- /dev/null
+++ b/src/asahi/compiler/test/apple9-depth-fixtures.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: MIT */
+#include "agx_compile_apple9.h"
+#include "compiler/nir/nir_builder.h"
+#include "gallium/drivers/asahi/agx_apple9.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static bool
+write_case(const char *directory, const char *name, bool early, bool exports,
+           bool discard)
+{
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_FRAGMENT, &agx_nir_options, "depth_fixture_%s", name);
+   b.shader->info.fs.early_fragment_tests = early;
+   b.shader->info.io_lowered = true;
+   if (discard)
+      nir_demote(&b);
+   nir_store_output(&b, nir_imm_vec4(&b, early ? 0 : 1, early ? 1 : 0, 0, 1),
+                    nir_imm_int(&b, 0), .write_mask = 15,
+                    .src_type = nir_type_float32,
+                    .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+   if (exports)
+      nir_store_output(&b, nir_imm_float(&b, 0.25), nir_imm_int(&b, 0),
+                       .write_mask = 1, .src_type = nir_type_float32,
+                       .io_semantics = {.location = FRAG_RESULT_DEPTH, .num_slots = 1});
+   nir_shader_gather_info(b.shader, nir_shader_get_entrypoint(b.shader));
+   nir_validate_shader(b.shader, "Apple9 depth fixture input");
+   char path[4096];
+   snprintf(path, sizeof(path), "%s/%s.nir", directory, name);
+   FILE *nir = fopen(path, "w");
+   if (!nir) { perror(path); ralloc_free(b.shader); return false; }
+   nir_print_shader(b.shader, nir);
+   bool ok = !ferror(nir);
+   ok = fclose(nir) == 0 && ok;
+   struct agx_shader_part compiled = {0};
+   const char *reason = NULL;
+   if (ok)
+      ok = agx_compile_apple9_fragment(b.shader, &compiled, &reason);
+   if (!ok) {
+      fprintf(stderr, "depth fixture %s failed: %s\n", name, reason ? reason : "NIR output failed");
+      ralloc_free(b.shader);
+      free(compiled.binary);
+      return false;
+   }
+   const struct agx_shader_info *info = &compiled.info;
+   struct agx_apple9_render_stage stage = {
+      .binary = compiled.binary,
+      .binary_size = info->binary_size,
+      .publication_count_valid = true,
+      .publication_count = info->apple9_publication_count,
+      .preamble_size = info->apple9_preamble_size,
+      .scratch_size = info->scratch_size,
+      .render_targets = 1,
+      .writes_depth = info->depth_layout != FRAG_DEPTH_LAYOUT_UNCHANGED,
+      .early_fragment_tests = info->early_fragment_tests,
+      .uses_discard = info->apple9_uses_discard,
+      .actual_discard = info->apple9_actual_discard,
+      .reads_tile = info->apple9_reads_tile,
+      .apple9_reads_z = info->apple9_reads_z,
+   };
+   snprintf(path, sizeof(path), "%s/%s.bin", directory, name);
+   FILE *binary = fopen(path, "wb");
+   if (!binary) { perror(path); ok = false; }
+   else {
+      ok = fwrite(compiled.binary, 1, info->binary_size, binary) == info->binary_size;
+      ok = fclose(binary) == 0 && ok;
+   }
+   snprintf(path, sizeof(path), "%s/%s.json", directory, name);
+   FILE *json = fopen(path, "w");
+   if (!json) { perror(path); ok = false; }
+   else {
+      fprintf(json,
+              "{\"schema\":\"apple9-depth-compiler-probe-v1\",\"case\":\"%s\","
+              "\"requested_early\":%s,\"requested_export\":%s,"
+              "\"early_fragment_tests\":%s,\"depth_layout\":%u,"
+              "\"binary_size\":%u,\"publication_count\":%u,\"scratch_size\":%u,"
+              "\"actual_discard\":%s,\"uses_discard\":%s,"
+              "\"gate_supported\":%s,\"target_executed\":false}\n",
+              name, early ? "true" : "false", exports ? "true" : "false",
+              info->early_fragment_tests ? "true" : "false", info->depth_layout,
+              info->binary_size, info->apple9_publication_count, info->scratch_size,
+              info->apple9_actual_discard ? "true" : "false",
+              info->apple9_uses_discard ? "true" : "false",
+              agx_g15_graphics_stage_supported(&stage, true) ? "true" : "false");
+      ok = !ferror(json) && ok;
+      ok = fclose(json) == 0 && ok;
+   }
+   printf("APPLE9_DEPTH_COMPILED %s early=%u depth_layout=%u gate=%u bytes=%u\n",
+          name, info->early_fragment_tests, info->depth_layout,
+          agx_g15_graphics_stage_supported(&stage, true), info->binary_size);
+   free(compiled.binary);
+   ralloc_free(b.shader);
+   return ok;
+}
+
+int
+main(int argc, char **argv)
+{
+   if (argc != 2 || strlen(argv[1]) > 4000) {
+      fprintf(stderr, "usage: %s OUTPUT_DIRECTORY\n", argv[0]);
+      return 2;
+   }
+   glsl_type_singleton_init_or_ref();
+   bool ok = write_case(argv[1], "raster", false, false, false) &&
+             write_case(argv[1], "early", true, false, false) &&
+             write_case(argv[1], "late-export", false, true, false) &&
+             write_case(argv[1], "early-export", true, true, false) &&
+             write_case(argv[1], "depth-discard", false, true, true);
+   glsl_type_singleton_decref();
+   return ok ? EXIT_SUCCESS : EXIT_FAILURE;
+}
