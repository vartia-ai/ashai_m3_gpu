+/* SPDX-License-Identifier: MIT */
+#include "agx_compile_apple9.h"
+#include "compiler/nir/nir_builder.h"
+#include "gallium/drivers/asahi/agx_apple9.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+int
+main(int argc, char **argv)
+{
+   if (argc != 2)
+      return 2;
+   glsl_type_singleton_init_or_ref();
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_FRAGMENT, &agx_nir_options, "fs_progress");
+   b.shader->info.io_lowered = true;
+   b.shader->info.num_ssbos = 1;
+   nir_def *bary = nir_load_barycentric_pixel(&b, 32,
+                                             .interp_mode = INTERP_MODE_SMOOTH);
+   nir_def *index = nir_load_interpolated_input(
+      &b, 1, 32, bary, nir_imm_int(&b, 0),
+      .io_semantics = {.location = VARYING_SLOT_VAR0, .num_slots = 1},
+      .dest_type = nir_type_float32);
+   nir_def *pixel = nir_load_pixel_coord(&b);
+   nir_push_if(&b, nir_iand(&b,
+      nir_ieq_imm(&b, nir_channel(&b, pixel, 0), 34),
+      nir_ieq_imm(&b, nir_channel(&b, pixel, 1), 34)));
+   nir_def *offset = nir_ishl_imm(&b, nir_f2u32(&b,
+                                 nir_fadd_imm(&b, index, 0.5f)), 2);
+   nir_store_ssbo(&b, nir_imm_int(&b, 1), nir_imm_int(&b, 0), offset,
+                  .write_mask = 1, .align_mul = 4);
+   nir_pop_if(&b, NULL);
+   nir_def *colour = nir_load_interpolated_input(
+      &b, 4, 32, bary, nir_imm_int(&b, 0),
+      .io_semantics = {.location = VARYING_SLOT_VAR1, .num_slots = 1},
+      .dest_type = nir_type_float32);
+   nir_store_output(&b, colour, nir_imm_int(&b, 0),
+      .write_mask = 15, .src_type = nir_type_float32,
+      .io_semantics = {.location = FRAG_RESULT_DATA0, .num_slots = 1});
+   nir_shader_gather_info(b.shader, nir_shader_get_entrypoint(b.shader));
+   nir_validate_shader(b.shader, "FS progress fixture");
+   struct agx_shader_part compiled = {0};
+   const char *reason = NULL;
+   bool ok = agx_compile_apple9_fragment(b.shader, &compiled, &reason);
+   if (!ok) {
+      fprintf(stderr, "FS_PROGRESS_COMPILE_FAIL %s\n", reason);
+   } else {
+      FILE *file = fopen(argv[1], "wb");
+      ok = file && fwrite(compiled.binary, 1, compiled.info.binary_size, file) ==
+                   compiled.info.binary_size;
+      if (file) ok = fclose(file) == 0 && ok;
+      const struct agx_shader_info *i = &compiled.info;
+      printf("FS_PROGRESS_COMPILED bytes=%u scratch=%u resources=%u ssbo=%#x writes=%#x binding0=%u publication=%u preamble=%u merge_disabled=%u\n",
+         i->binary_size, i->scratch_size, i->apple9_resource_count,
+         i->apple9_resource_ssbo_mask, i->apple9_resource_write_mask,
+         i->apple9_resource_binding[0], i->apple9_publication_count,
+         i->apple9_preamble_size, i->disable_tri_merging);
+      struct agx_apple9_render_stage stage = {
+         .binary = compiled.binary, .binary_size = i->binary_size,
+         .publication_count_valid = true,
+         .publication_count = i->apple9_publication_count,
+         .preamble_size = i->apple9_preamble_size,
+         .scratch_size = i->scratch_size,
+         .render_targets = 1, .varying_components = 5,
+         .resource_count = i->apple9_resource_count,
+         .resource_ssbo_mask = i->apple9_resource_ssbo_mask,
+         .resource_write_mask = i->apple9_resource_write_mask,
+      };
+      memcpy(stage.resource_binding, i->apple9_resource_binding,
+             sizeof(stage.resource_binding));
+      unsetenv("ASAHI_G15_FS_PROGRESS");
+      bool gates = !agx_g15_graphics_stage_allowed(&stage, true);
+      setenv("ASAHI_G15_ALLOW", "all", 1);
+      gates &= !agx_g15_graphics_stage_allowed(&stage, true);
+      setenv("ASAHI_G15_FS_PROGRESS", "1", 1);
+      gates &= agx_g15_graphics_stage_allowed(&stage, true) &&
+               stage.resource_ssbo_mask == 1 && stage.resource_write_mask == 1;
+      /* The GLSL frontend introduces a UBO at API binding zero as well.
+       * Resource masks index compact table slots, not API binding numbers. */
+      struct agx_apple9_render_stage with_ubo = stage;
+      with_ubo.resource_count = 2;
+      with_ubo.resource_binding[1] = 0;
+      with_ubo.resource_ssbo_mask = with_ubo.resource_write_mask = 2;
+      gates &= agx_g15_graphics_stage_allowed(&with_ubo, true) &&
+               with_ubo.resource_ssbo_mask == 2 && with_ubo.resource_write_mask == 2;
+      with_ubo.resource_binding[1] = 1;
+      gates &= !agx_g15_graphics_stage_allowed(&with_ubo, true);
+      with_ubo.resource_binding[1] = 0;
+      with_ubo.resource_write_mask = 3;
+      gates &= !agx_g15_graphics_stage_allowed(&with_ubo, true);
+      stage.resource_binding[0] = 1;
+      gates &= !agx_g15_graphics_stage_allowed(&stage, true);
+      stage.resource_binding[0] = 0;
+      stage.resource_write_mask = 3;
+      gates &= !agx_g15_graphics_stage_allowed(&stage, true);
+      stage.resource_write_mask = 1;
+      stage.resource_ssbo_mask = 3;
+      gates &= !agx_g15_graphics_stage_allowed(&stage, true);
+      stage.resource_ssbo_mask = 1;
+      stage.image_mask = 1;
+      gates &= !agx_g15_graphics_stage_allowed(&stage, true);
+      stage.image_mask = 0;
+      gates &= !agx_g15_graphics_stage_allowed(&stage, false);
+      setenv("ASAHI_G15_FS_PROGRESS", "0", 1);
+      gates &= !agx_g15_graphics_stage_allowed(&stage, true);
+      printf("FS_PROGRESS_GATES %s default_off=1 allow_all_off=1 diagnostic_on=1 bad_binding_off=1 extra_write_off=1 extra_ssbo_off=1 images_off=1 vertex_off=1 explicit_zero_off=1 metadata_preserved=1 frontend_ubo_on=1 compact_bad_binding_off=1 ubo_write_off=1\n",
+             gates ? "PASS" : "FAIL");
+      ok = ok && gates;
+      ok = ok && !i->scratch_size && i->apple9_resource_ssbo_mask == 1 &&
+           i->apple9_resource_write_mask == 1 && i->apple9_resource_binding[0] == 0;
+   }
+   free(compiled.binary);
+   ralloc_free(b.shader);
+   glsl_type_singleton_decref();
+   return ok ? 0 : 1;
+}
diff --git a/src/asahi/compiler/test/apple9-runtime-fixtures.c b/src/asahi/compiler/test/apple9-runtime-fixtures.c
new file mode 100644
index 0000000..86d6040
--- /dev/null
+++ b/src/asahi/compiler/test/apple9-runtime-fixtures.c
@@ -0,0 +1,158 @@
+/* SPDX-License-Identifier: MIT */
+#include "agx_compile_apple9.h"
+#include "compiler/nir/nir_builder.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static bool
+write_binary(const char *path, const struct agx_shader_part *compiled)
+{
+   FILE *file = fopen(path, "wb");
+   if (!file)
+      return false;
+   bool ok = fwrite(compiled->binary, 1, compiled->info.binary_size, file) ==
+             compiled->info.binary_size;
+   return fclose(file) == 0 && ok;
+}
+
+static bool
+write_metadata(const char *path, const struct agx_shader_info *info,
+               const struct agx_apple9_compute_profile *profile, const char *fixture)
+{
+   FILE *file = fopen(path, "w");
+   if (!file)
+      return false;
+   fprintf(file,
+           "{\n  \"schema\": \"g15-compiled-runtime-fixture-raw-v1\",\n"
+           "  \"target_execution\": false,\n"
+           "  \"fixture\": {\"name\": \"%s\", \"stage\": \"compute\", "
+           "\"local_size\": [1,1,1], \"num_ssbos\": 1, \"binding\": 0, "
+           "\"align_mul\": 4, \"output_offset_bytes\": 64},\n"
+           "  \"info\": {\"binary_size\": %u, \"main_size\": %u, "
+           "\"nr_gprs\": %u, \"scratch_size\": %u, \"local_size\": %u, "
+           "\"workgroup_size\": [%u,%u,%u], \"apple9_publication_count\": %u, "
+           "\"apple9_preamble_offset\": %u, \"apple9_preamble_size\": %u},\n"
+           "  \"profile\": {\"abi\": %u, \"resource_binding_count\": %u,\n",
+           fixture, info->binary_size, info->main_size, (unsigned)info->nr_gprs,
+           info->scratch_size, (unsigned)info->local_size,
+           (unsigned)info->workgroup_size[0], (unsigned)info->workgroup_size[1],
+           (unsigned)info->workgroup_size[2],
+           (unsigned)info->apple9_publication_count, info->apple9_preamble_offset,
+           info->apple9_preamble_size, (unsigned)profile->abi,
+           (unsigned)profile->resource_binding_count);
+   fprintf(file, "    \"resource_binding\": [");
+   for (unsigned i = 0; i < profile->resource_binding_count; ++i)
+      fprintf(file, "%s%u", i ? "," : "", (unsigned)profile->resource_binding[i]);
+   fprintf(file, "], \"resource_kind\": [");
+   for (unsigned i = 0; i < profile->resource_binding_count; ++i)
+      fprintf(file, "%s%u", i ? "," : "", (unsigned)profile->resource_kind[i]);
+   fprintf(file,
+           "], \"resource_read_mask\": %u, \"resource_write_mask\": %u, "
+           "\"writes_global\": %s, \"variable_local_size\": %s, "
+           "\"local_size\": [%u,%u,%u], "
+           "\"required_threadgroup_memory_bytes\": %u, \"scratch_size\": %u, "
+           "\"preamble_offset\": %u, \"preamble_size\": %u, "
+           "\"atomic_frame_size\": %u, \"publication_count\": %u}\n}\n",
+           profile->resource_read_mask, profile->resource_write_mask,
+           profile->writes_global ? "true" : "false",
+           profile->variable_local_size ? "true" : "false",
+           profile->local_size[0], profile->local_size[1], profile->local_size[2],
+           profile->required_threadgroup_memory_bytes, profile->scratch_size,
+           profile->preamble_offset, profile->preamble_size,
+           (unsigned)profile->atomic_frame_size,
+           (unsigned)profile->publication_count);
+   bool ok = !ferror(file);
+   return fclose(file) == 0 && ok;
+}
+
+static void
+build_vector(nir_builder *b)
+{
+   nir_def *input = nir_load_ssbo(b, 4, 32, nir_imm_int(b, 0),
+                                  nir_imm_int(b, 0), .align_mul = 4);
+   nir_def *value = nir_iadd_imm(b, nir_imul_imm(b, input, 3), 7);
+   nir_store_ssbo(b, value, nir_imm_int(b, 0), nir_imm_int(b, 64),
+                  .write_mask = 15, .align_mul = 4);
+}
+
+static void
+build_branch_loop(nir_builder *b)
+{
+   nir_def *binding = nir_imm_int(b, 0);
+   nir_def *limit = nir_umin(b, nir_load_ssbo(b, 1, 32, binding,
+      nir_imm_int(b, 0), .align_mul = 4), nir_imm_int(b, 8));
+   nir_def *selector = nir_load_ssbo(b, 1, 32, binding,
+      nir_imm_int(b, 4), .align_mul = 4);
+   nir_def *seed = nir_load_ssbo(b, 1, 32, binding,
+      nir_imm_int(b, 8), .align_mul = 4);
+   nir_variable *index = nir_local_variable_create(b->impl, glsl_uint_type(), "i");
+   nir_variable *sum = nir_local_variable_create(b->impl, glsl_uint_type(), "sum");
+   nir_store_var(b, index, nir_imm_int(b, 0), 1);
+   nir_store_var(b, sum, seed, 1);
+   nir_loop *loop = nir_push_loop(b);
+   loop->control = nir_loop_control_dont_unroll;
+   nir_def *i = nir_load_var(b, index);
+   nir_break_if(b, nir_uge(b, i, limit));
+   nir_def *offset = nir_iadd_imm(b, nir_ishl_imm(b, i, 2), 16);
+   nir_def *value = nir_load_ssbo(b, 1, 32, binding, offset, .align_mul = 4);
+   nir_push_if(b, nir_ine_imm(b, nir_iand_imm(b, nir_ixor(b, value, selector), 1), 0));
+   nir_store_var(b, sum, nir_iadd(b, nir_load_var(b, sum),
+      nir_iadd_imm(b, nir_imul_imm(b, value, 3), 7)), 1);
+   nir_store_ssbo(b, nir_imm_int(b, 1), binding, nir_imm_int(b, 72), .align_mul = 4);
+   nir_push_else(b, NULL);
+   nir_store_var(b, sum, nir_ixor(b, nir_load_var(b, sum),
+      nir_iadd_imm(b, value, 0x9e3779b9)), 1);
+   nir_store_ssbo(b, nir_imm_int(b, 2), binding, nir_imm_int(b, 72), .align_mul = 4);
+   nir_pop_if(b, NULL);
+   nir_store_var(b, index, nir_iadd_imm(b, i, 1), 1);
+   nir_pop_loop(b, loop);
+   nir_store_ssbo(b, nir_load_var(b, sum), binding,
+                  nir_imm_int(b, 64), .align_mul = 4);
+   nir_store_ssbo(b, nir_load_var(b, index), binding,
+                  nir_imm_int(b, 68), .align_mul = 4);
+}
+
+int
+main(int argc, char **argv)
+{
+   if (argc != 5 || (strcmp(argv[1], "vector") && strcmp(argv[1], "branch-loop")) ||
+       !strcmp(argv[2], argv[3]) || !strcmp(argv[2], argv[4]) || !strcmp(argv[3], argv[4])) {
+      fprintf(stderr, "usage: %s vector|branch-loop BODY.bin INPUT.nir METADATA.json\n", argv[0]);
+      return EXIT_FAILURE;
+   }
+   glsl_type_singleton_init_or_ref();
+   nir_builder b = nir_builder_init_simple_shader(
+      MESA_SHADER_COMPUTE, &agx_nir_options, "apple9_runtime_%s", argv[1]);
+   b.shader->info.workgroup_size[0] = 1;
+   b.shader->info.workgroup_size[1] = 1;
+   b.shader->info.workgroup_size[2] = 1;
+   b.shader->info.workgroup_size_variable = false;
+   b.shader->info.num_ssbos = 1;
+   if (!strcmp(argv[1], "vector"))
+      build_vector(&b);
+   else
+      build_branch_loop(&b);
+   nir_validate_shader(b.shader, "authored runtime fixture input");
+   FILE *file = fopen(argv[3], "w");
+   bool ok = file != NULL;
+   if (file) {
+      nir_print_shader(b.shader, file);
+      ok = !ferror(file);
+      ok = fclose(file) == 0 && ok;
+   }
+   struct agx_shader_part compiled = {0};
+   struct agx_apple9_compute_profile profile = {0};
+   const char *reason = NULL;
+   if (ok)
+      ok = agx_compile_apple9_tiny(b.shader, &compiled, &profile, &reason);
+   if (!ok)
+      fprintf(stderr, "Apple9 fixture failed: %s\n", reason ? reason : "output file error");
+   else
+      ok = write_binary(argv[2], &compiled) &&
+           write_metadata(argv[4], &compiled.info, &profile, argv[1]);
+   free(compiled.binary);
+   ralloc_free(b.shader);
+   glsl_type_singleton_decref();
+   return ok ? EXIT_SUCCESS : EXIT_FAILURE;
+}
