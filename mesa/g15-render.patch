+{
+   drm_asahi_params_global p = {};
+   p.gpu_generation = 15;
+   p.features = DRM_ASAHI_FEATURE_SOFT_FAULTS;
+   p.max_commands_per_submission = 1;
+   p.usc_window_start = AGX_G15_USC_USER_MIN;
