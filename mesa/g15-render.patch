@@ -0,0 +1,29 @@
+/* Copyright 2026 Vartia LLC
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef AGX_G15_GRAPHICS_NIR_H
+#define AGX_G15_GRAPHICS_NIR_H
+
+#include "compiler/nir/nir_builder.h"
+
+/* The G15 draw gate accepts only DrawArrays(first=0), one instance from
+ * instance zero, and draw ID zero. Specialize those frontend sysvals before
+ * the generic Apple9 pass would turn them into resource-table loads. */
+static inline bool
+agx_g15_lower_fixed_draw_sysval(nir_builder *b, nir_intrinsic_instr *intr,
+                               UNUSED void *data)
+{
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_first_vertex:
+   case nir_intrinsic_load_base_vertex:
+   case nir_intrinsic_load_base_instance:
+   case nir_intrinsic_load_draw_id:
+      b->cursor = nir_before_instr(&intr->instr);
+      nir_def_replace(&intr->def, nir_imm_intN_t(b, 0, intr->def.bit_size));
+      return true;
+   default:
+      return false;
+   }
+}
+
+#endif
