diff --git a/src/asahi/lib/agx_g15_compute.h b/src/asahi/lib/agx_g15_compute.h
new file mode 100644
index 0000000..c3a7f2c
--- /dev/null
+++ b/src/asahi/lib/agx_g15_compute.h
@@ -0,0 +1,79 @@
+/* Copyright 2026 Vartia LLC
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef AGX_G15_COMPUTE_H
+#define AGX_G15_COMPUTE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include "drm-uapi/asahi_drm.h"
+#include "agx_apple9_layout.h"
+#include "asahi/compiler/agx_apple9_profile.h"
+
+#define AGX_G15_USC_BASE (UINT64_C(1) << 40)
+#define AGX_G15_USC_USER_MIN (AGX_G15_USC_BASE + UINT64_C(0x10000000))
+#define AGX_G15_USC_END (AGX_G15_USC_BASE + (UINT64_C(1) << 32))
+#define AGX_G15_PAGE_SIZE UINT64_C(0x4000)
+
+/* An absent UAPI tail is compatible with older devices, but never enough to
+ * enable G15. The caller zeroes the query buffer before GET_PARAMS. */
+static inline bool
+agx_g15_compute_select(const struct drm_asahi_params_global *params,
+                       size_t returned_size, bool requested, bool virtio,
+                       bool *selected)
+{
+   if (!params || !selected)
+      return false;
+   *selected = false;
+   if (returned_size < offsetof(struct drm_asahi_params_global, usc_window_start))
+      return false;
+   if (params->gpu_generation != 15)
+      return true;
+   if (!requested || virtio ||
+       returned_size < offsetof(struct drm_asahi_params_global, render_context_start) ||
+       params->features != DRM_ASAHI_FEATURE_SOFT_FAULTS ||
+       params->max_commands_per_submission != 1 || params->max_attachments != 0)
+      return false;
+
+   uint64_t start = params->usc_window_start, end = params->usc_window_end;
+   if (start < AGX_G15_USC_USER_MIN || end > AGX_G15_USC_END || start >= end ||
+       ((start | end) & (AGX_G15_PAGE_SIZE - 1)) ||
+       (start & (AGX_APPLE9_ENTRY_ARENA_SIZE - 1)) ||
+       end - start < AGX_APPLE9_ENTRY_ARENA_SIZE + AGX_G15_PAGE_SIZE)
+      return false;
+   *selected = true;
+   return true;
+}
+
+static inline bool
+agx_g15_compute_shader_supported(const struct agx_apple9_compute_profile *p)
+{
+   return p && p->abi == AGX_APPLE9_COMPUTE_ABI_DIRECT_BUFFERS &&
+          p->resource_binding_count == 1 && p->resource_binding[0] == 0 &&
+          p->resource_kind[0] == AGX_APPLE9_COMPUTE_RESOURCE_SSBO &&
+          p->resource_write_mask == 1 && !(p->resource_read_mask & ~1u) &&
+          !p->writes_global && !p->variable_local_size &&
+          p->local_size[0] == 1 && p->local_size[1] == 1 && p->local_size[2] == 1 &&
+          !p->required_threadgroup_memory_bytes && !p->scratch_size &&
+          !p->preamble_size && !p->atomic_frame_size;
+}
+
+/* Keep cached entries and free-list positions arena-local. Only a launch
+ * boundary converts the actual entry GPUVA to the fixed USC-base offset. */
+static inline bool
+agx_apple9_entry_target_offset(uint64_t shader_base, uint64_t arena_address,
+                              uint32_t local_entry, uint32_t *offset)
+{
+   if (!offset || local_entry >= AGX_APPLE9_ENTRY_ARENA_SIZE ||
+       ((arena_address | local_entry) & 63) ||
+       arena_address < shader_base || arena_address > UINT64_MAX - local_entry)
+      return false;
+   uint64_t relative = arena_address + local_entry - shader_base;
+   if (relative > UINT32_MAX)
+      return false;
+   *offset = relative;
+   return true;
+}
+
+#endif
