+   EXPECT_TRUE(selected);
+   for (size_t size : {size_t(0), size_t(592), size_t(600), size_t(607)})
+      EXPECT_FALSE(agx_g15_compute_select(&p, size, true, false, &selected));
+   EXPECT_FALSE(agx_g15_compute_select(&p, 608, false, false, &selected));
+   EXPECT_FALSE(agx_g15_compute_select(&p, 608, true, true, &selected));
+   p.max_attachments = 1;
+   EXPECT_FALSE(agx_g15_compute_select(&p, 608, true, false, &selected));
+   p.max_attachments = 0;
+   p.max_commands_per_submission = 2;
+   EXPECT_FALSE(agx_g15_compute_select(&p, 608, true, false, &selected));
