diff --git a/src/compiler/glsl/tests/point_size_io_test.cpp b/src/compiler/glsl/tests/point_size_io_test.cpp
new file mode 100644
index 0000000..ab43bbb
--- /dev/null
+++ b/src/compiler/glsl/tests/point_size_io_test.cpp
@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: MIT */
+#include <gtest/gtest.h>
+#include "gl_nir_linker.h"
+#include "nir_builder.h"
+
+class point_size_io_test : public ::testing::Test {
+protected:
+   const nir_shader_compiler_options options = {};
+   nir_builder b;
+
+   void SetUp() override
+   {
+      glsl_type_singleton_init_or_ref();
+      b = nir_builder_init_simple_shader(MESA_SHADER_VERTEX, &options,
+                                         "point_size_io");
+      b.shader->info.io_lowered = true;
+   }
+
+   void TearDown() override
+   {
+      ralloc_free(b.shader);
+      glsl_type_singleton_decref();
+   }
+
+   void store(unsigned location, unsigned components)
+   {
+      nir_store_output(&b, nir_imm_zero(&b, components, 32), nir_imm_int(&b, 0),
+                       .write_mask = (1u << components) - 1,
+                       .src_type = nir_type_float32,
+                       .io_semantics = {.location = location, .num_slots = 1});
+   }
+
+   void prepare()
+   {
+      nir_shader_gather_info(b.shader, b.impl);
+      nir_recompute_io_bases(b.shader, nir_var_shader_in | nir_var_shader_out);
+   }
+
+   unsigned point_size_stores()
+   {
+      unsigned count = 0;
+      nir_foreach_block(block, b.impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            if (intr->intrinsic == nir_intrinsic_store_output &&
+                nir_intrinsic_io_semantics(intr).location == VARYING_SLOT_PSIZ) {
+               EXPECT_EQ(nir_intrinsic_io_semantics(intr).num_slots, 1u);
+               EXPECT_LT(nir_intrinsic_base(intr), b.shader->num_outputs);
+               count++;
+            }
+         }
+      }
+      return count;
+   }
+};
+
+TEST_F(point_size_io_test, point_size_then_edgeflag)
+{
+   store(VARYING_SLOT_POS, 4);
+   store(VARYING_SLOT_COL0, 4);
+   prepare();
+   ASSERT_EQ(b.shader->num_outputs, 2u);
+
+   ASSERT_TRUE(gl_nir_add_point_size(b.shader));
+   EXPECT_EQ(point_size_stores(), 1u);
+   ASSERT_EQ(b.shader->num_outputs, 3u);
+   ASSERT_EQ(b.shader->num_outputs,
+             util_bitcount64(b.shader->info.outputs_written));
+
+   ASSERT_TRUE(nir_lower_passthrough_edgeflags(b.shader));
+   EXPECT_EQ(b.shader->num_outputs, 4u);
+   nir_shader_gather_info(b.shader, b.impl);
+   EXPECT_TRUE(b.shader->info.outputs_written & VARYING_BIT_EDGE);
+   nir_validate_shader(b.shader, "point size followed by edgeflag");
+}
+
+TEST_F(point_size_io_test, no_position_store)
+{
+   store(VARYING_SLOT_COL0, 4);
+   prepare();
+   ASSERT_TRUE(gl_nir_add_point_size(b.shader));
+   EXPECT_EQ(point_size_stores(), 1u);
+   EXPECT_EQ(b.shader->num_outputs, 2u);
+   nir_validate_shader(b.shader, "point size without position");
+}
+
+TEST_F(point_size_io_test, multiple_position_stores)
+{
+   store(VARYING_SLOT_POS, 4);
+   store(VARYING_SLOT_POS, 4);
+   prepare();
+   ASSERT_TRUE(gl_nir_add_point_size(b.shader));
+   EXPECT_EQ(point_size_stores(), 2u);
+   EXPECT_EQ(b.shader->num_outputs, 2u);
+   nir_validate_shader(b.shader, "point size after both position stores");
+}
