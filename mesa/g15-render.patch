+      p.usc_window_end = end;
+      bool selected = true;
+      EXPECT_FALSE(agx_g15_compute_select(&p, 608, true, false, &selected));
+      EXPECT_FALSE(selected);
+   };
+   reject(0, 0);
+   reject(AGX_G15_USC_USER_MIN - AGX_G15_PAGE_SIZE, AGX_G15_USC_END);
+   reject(AGX_G15_USC_USER_MIN + AGX_G15_PAGE_SIZE, AGX_G15_USC_END);
+   reject(AGX_G15_USC_USER_MIN, AGX_G15_USC_END + AGX_G15_PAGE_SIZE);
+   reject(AGX_G15_USC_USER_MIN, AGX_G15_USC_END - 1);
+   reject(AGX_G15_USC_END, AGX_G15_USC_USER_MIN);
+   reject(AGX_G15_USC_USER_MIN, AGX_G15_USC_USER_MIN);
+   reject(AGX_G15_USC_USER_MIN,
+          AGX_G15_USC_USER_MIN + AGX_APPLE9_ENTRY_ARENA_SIZE);
+}
+
+TEST(G15Compute, RealVmaArenaGuardAndLocalFreeRemainBounded)
+{
+   util_vma_heap usc, entries;
+   const uint64_t reserved = AGX_APPLE9_ENTRY_ARENA_SIZE + AGX_G15_PAGE_SIZE;
+   util_vma_heap_init(&usc, AGX_G15_USC_USER_MIN, reserved);
+   usc.alloc_high = false;
+   uint64_t arena = util_vma_heap_alloc(&usc, reserved, AGX_APPLE9_ENTRY_ARENA_SIZE);
+   ASSERT_EQ(arena, AGX_G15_USC_USER_MIN);
+   EXPECT_EQ(util_vma_heap_alloc(&usc, AGX_G15_PAGE_SIZE, AGX_G15_PAGE_SIZE), 0u);
+   util_vma_heap_init(&entries, AGX_APPLE9_ENTRY_HEADER_SIZE,
+                      AGX_APPLE9_ENTRY_ARENA_SIZE - AGX_APPLE9_ENTRY_HEADER_SIZE);
+   entries.alloc_high = false;
+   uint32_t block = util_vma_heap_alloc(&entries, AGX_APPLE9_ENTRY_BLOCK_SIZE, 64);
+   ASSERT_EQ(block, 0x340u);
+   uint32_t local = block + AGX_APPLE9_ENTRY_CODE_OFFSET, target = 0;
+   ASSERT_TRUE(agx_apple9_entry_target_offset(AGX_G15_USC_BASE, arena, local, &target));
+   EXPECT_EQ(target, 0x100003c0u);
+   util_vma_heap_free(&entries, local - AGX_APPLE9_ENTRY_CODE_OFFSET,
+                      AGX_APPLE9_ENTRY_BLOCK_SIZE);
+   EXPECT_EQ(util_vma_heap_alloc(&entries, AGX_APPLE9_ENTRY_BLOCK_SIZE, 64), block);
+   util_vma_heap_finish(&entries);
+   util_vma_heap_free(&usc, arena, reserved);
+   EXPECT_EQ(util_vma_heap_alloc(&usc, reserved, AGX_APPLE9_ENTRY_ARENA_SIZE), arena);
+   util_vma_heap_finish(&usc);
+}
+
+TEST(G15Compute, EntryConversionPreservesCompactAndRejectsWithoutWriting)
+{
+   uint32_t target = 0;
+   ASSERT_TRUE(agx_apple9_entry_target_offset(AGX_G15_USC_BASE, AGX_G15_USC_BASE,
+                                             0x3c0, &target));
+   EXPECT_EQ(target, 0x3c0u);
+   for (auto arena : {AGX_G15_USC_BASE - 64, AGX_G15_USC_BASE + 1,
+                      AGX_G15_USC_END, UINT64_MAX - 63}) {
+      target = 0xface;
+      EXPECT_FALSE(agx_apple9_entry_target_offset(AGX_G15_USC_BASE, arena, 0x3c0, &target));
+      EXPECT_EQ(target, 0xfaceu);
+   }
+   for (uint32_t local : {1u, 63u, AGX_APPLE9_ENTRY_ARENA_SIZE}) {
+      target = 0xface;
+      EXPECT_FALSE(agx_apple9_entry_target_offset(AGX_G15_USC_BASE,
+                                                 AGX_G15_USC_USER_MIN, local, &target));
+      EXPECT_EQ(target, 0xfaceu);
+   }
+}
