+static int atcphy_t8122_dp_run(struct apple_atcphy *atcphy, const char *name,
+			       const struct t8122_dp_step *steps, size_t n)
+{
+	int ret;
+	u32 reg;
+
+	for (size_t i = 0; i < n; i++) {
+		const struct t8122_dp_step *s = &steps[i];
+
+		switch (s->op) {
+		case T8122_DP_RMW:
+			core_mask32(atcphy, s->reg, s->a, s->b);
+			udelay(10); /* the trace gives order, not settle times */
+			break;
+		case T8122_DP_WR:
+			writel(s->b, atcphy->regs.core + s->reg);
+			udelay(10);
+			break;
+		case T8122_DP_POLL:
+			ret = readl_poll_timeout(atcphy->regs.core + s->reg, reg,
+						 (reg & s->a) == s->b, 10, 10000);
+			if (ret) {
+				dev_err(atcphy->dev, "t8122 %s step %zu: %05x = %08x, want %08x/%08x\n",
+					name, i, s->reg, reg, s->a, s->b);
+				return ret;
+			}
+			break;
+		}
+	}
+
+	return 0;
+}
