+		return apple_dcp_listed_by(dev->of_node, dcp);
+
+	for_each_compatible_node(np, NULL, "apple,display-subsystem") {
+		if (np != dev->of_node && apple_dcp_listed_by(np, dcp)) {
+			of_node_put(np);
+			return false;
+		}
+	}
+	return true;
+}
