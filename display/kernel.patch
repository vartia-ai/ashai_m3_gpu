diff --git a/drivers/gpu/drm/apple/j613_dispext_overlay.c b/drivers/gpu/drm/apple/j613_dispext_overlay.c
new file mode 100644
index 000000000..a41464c1c
--- /dev/null
+++ b/drivers/gpu/drm/apple/j613_dispext_overlay.c
@@ -0,0 +1,745 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * External display for the J613 (M3 MacBook Air) until the device tree
+ * describes it: wire one USB-C port's DisplayPort alt mode to dcpext by
+ * editing the live device tree.
+ *
+ * Loading the module with no parameters changes nothing: stage=0 only checks
+ * the live tree, reports whether m1n1 reserved dcpext's firmware, and logs the
+ * dispext power-state registers. Nothing powers dcpext before stage=2.
+ *
+ *   stage=1  add the port's display crossbar node (atcN-dpxbar). Its driver
+ *            only maps the registers at probe; dcpext stays disabled.
+ *   stage=2  also enable dcpext with its DARTs and mailbox, reuse its
+ *            boot-reserved firmware segments, wire the port's DP PHY and
+ *            crossbar, give it a DRM device of its own ("m3gpu,dcps"), and
+ *            name it as the USB-C connector's "displayport" so the PD
+ *            controller's HPD reaches it. This powers the dispext domains.
+ *
+ * Stage 2 needs an m1n1 that reserves dcpext's firmware segments from the
+ * live ADT ("m3gpu,firmware-reservation-version" = 1), the matching appledrm
+ * (second display-subsystem support), and the tipd/sn201202x modules of the
+ * same tree for HPD. Load it before the PD controller driver binds: HPD is
+ * forwarded on PD events, so with a monitor already plugged a late stage 2
+ * sees it only after a replug.
+ *
+ * Values are this machine's (J613, macOS 14.7 system firmware). Each table
+ * names the ADT node it comes from; the ADT reg addresses below 0x130000000
+ * are /arm-io relative and appear here translated (+0x210000000).
+ *
+ * The tree changes stay for the life of the boot; unloading the module does
+ * not revert them (that would unbind a running DCP).
+ */
+
+#include <linux/io.h>
+#include <linux/ioport.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/sizes.h>
+#include <linux/string.h>
+
+#define DX "j613_dispext: "
+
+static uint stage;
+module_param(stage, uint, 0444);
+MODULE_PARM_DESC(stage, "0: check and log only (default); 1: add the crossbar node; 2: also enable dcpext");
+
+static uint port = 1;
+module_param(port, uint, 0444);
+MODULE_PARM_DESC(port, "USB-C port: 1 = left-front (hpm1, atc1, default, tested), 0 = left-back (hpm0, atc0, untested)");
+
+/*
+ * Crossbar state for dcpext. macOS 14.8.9 selects 2 (atc1-dpxbar +0x30 =
+ * 0x200200, J613 trace); 1, the ADT's dp-switch-ufp-endpoint, leaves AUX dead.
+ */
+static uint xbar_state = 2;
+module_param(xbar_state, uint, 0444);
+MODULE_PARM_DESC(xbar_state, "Display crossbar state for dcpext (default 2, as macOS)");
+
+/* Live-tree paths of the nodes this module edits (all in t8122.dtsi). */
+#define DX_DCP		"/soc/dcp@28ec00000"
+#define DX_DCPEXT	"/soc/dcp@31ac00000"
+#define DX_DCPEXT_DART	"/soc/iommu@31930c000"
+#define DX_DISPEXT_DART	"/soc/iommu@319304000"
+#define DX_DCPEXT_MBOX	"/soc/mbox@31ac08000"
+#define DX_PMGR_DCP	"/soc/power-management@2d03d0000"
+#define DX_SOC		"/soc"
+#define DX_RMEM		"/reserved-memory"
+#define DX_MASTER_NAME	"dispext-subsystem"
+
+/* New nodes get phandles from here up (skipping any in use). */
+#define DX_PHANDLE_BASE	0xd15e0001
+
+#define PHY_TYPE_DP	6	/* include/dt-bindings/phy/phy.h */
+
+struct dx_port {
+	const char *connector;	/* sn201202x connector node */
+	const char *atcphy;
+	u64 xbar_base;		/* ADT /arm-io/atcN-dpxbar reg */
+	const char *xbar_name;
+	u32 dptx_phy;		/* ADT /arm-io/atcN-dpphy dp-switch-dfp-endpoint */
+};
+
+/*
+ * ADT /arm-io/nub-spmi-a0/hpm0 (port-number 1, left-back) pairs with
+ * atc0-dpphy (port-number 1, atc-phy = atc-phy0, dpxbar-parent atc0-dpxbar);
+ * hpm1 (port-number 2, left-front) with atc1-dpphy and atc1-dpxbar.
+ */
+static const struct dx_port dx_ports[] = {
+	{ "/soc/spmi@2e4908000/usb-pd@c/connector", "/soc/phy@703000000",
+	  0x70304c000ULL, "mux@70304c000", 0 },
+	{ "/soc/spmi@2e4908000/usb-pd@a/connector", "/soc/phy@b03000000",
+	  0xb0304c000ULL, "mux@b0304c000", 1 },
+};
+
+/*
+ * dcpext registers in ADT order: /arm-io/dcpext reg[0] (coproc), then
+ * /arm-io/dispext0 reg[0..4] (disp-0..disp-4); dispext0 reg[5], the PMGR
+ * dcp-fw block, is the bw-scratch entry below (index 5). The base tree's
+ * dcpext node lists only four disp regions (it drops reg[1], 0x318800000),
+ * which would shift the firmware's register indices; the internal dcp node
+ * keeps all five.
+ */
+static const u32 dx_dcpext_reg[] = {
+	0x3, 0x1ac00000, 0x0, 0x4000,
+	0x3, 0x18000000, 0x0, 0x690000,
+	0x3, 0x18800000, 0x0, 0x690000,
+	0x3, 0x19320000, 0x0, 0x4000,
+	0x3, 0x19344000, 0x0, 0x4000,
+	0x3, 0x1a800000, 0x0, 0x800000,
+};
+static const char dx_dcpext_reg_names[] =
+	"coproc\0disp-0\0disp-1\0disp-2\0disp-3\0disp-4";
+
+/*
+ * PMGR scratch word for the RT bandwidth request. Not in the ADT: the
+ * internal dcp uses 0x908 (works on this machine); dcpext is the next word,
+ * following the +8 stride of the t8112 (0x5d8/0x5e0) and t600x
+ * (0x988/0x990/...) trees.
+ */
+#define DX_BW_SCRATCH_INDEX	5
+#define DX_BW_SCRATCH_OFFSET	0x910
+
+/*
+ * The matching m1n1 reserves these in live ADT order before Linux starts.
+ * Physical addresses must never be taken from an earlier boot's ADT dump.
+ */
+struct dx_seg {
+	const char *name;
+	u64 phys, iova, size;
+	u32 phandle;
+};
+
+/* In m1n1's memory-region order, which is the live ADT's segment-ranges order */
+static struct dx_seg dx_segs[] = {
+	{ .name = "dcpext-text" },
+	{ .name = "dcpext-data" },
+	{ .name = "dcpext-oslog" },
+	{ .name = "dcpext-region74" },
+};
+
+/*
+ * DART window: ADT /arm-io/dart-dcpext and dart-dispext0 have vm-base
+ * 0x10000000000 and vm-size 0x1000000000, the same as the internal display
+ * DARTs, which the base tree gives "apple,dma-range" and one-cell iommus.
+ * The dispext DARTs get the same (the base tree's five-cell windows start
+ * at 0x800000000 and would not cover the firmware's IOVAs). Stream IDs:
+ * mapper-dcpext reg = 5, mapper-dispext0 reg = 0, mapper-dispext0-piodma
+ * reg = 4.
+ */
+static const u32 dx_dart_range[] = { 0x100, 0x0, 0x10, 0x0 };
+#define DX_SID_DCPEXT	5
+#define DX_SID_DISPEXT	0
+#define DX_SID_PIODMA	4
+
+/* PMGR power states read in stage 0 (t8122-pmgr.dtsi labels). */
+static const char *const dx_pwrstates[] = { "dispext_sys", "dispext_fe", "dispext_cpu" };
+
+#define PS_ACTUAL(v)	(((v) >> 4) & 0xf)
+#define PS_TARGET(v)	((v) & 0xf)
+
+struct dx_ctx {
+	const struct dx_port *port;
+	struct device_node *dcp, *dcpext, *dcpext_dart, *dispext_dart, *mbox;
+	struct device_node *pmgr_dcp, *atcphy, *connector, *soc, *rmem;
+	u32 atc_pd;		/* atcphy's power domain phandle */
+	u32 fw_version[3], fw_compat[3];
+};
+
+static struct of_changeset dx_xbar_cs, dx_ext_cs;
+
+static void dx_put(struct dx_ctx *c)
+{
+	of_node_put(c->dcp);
+	of_node_put(c->dcpext);
+	of_node_put(c->dcpext_dart);
+	of_node_put(c->dispext_dart);
+	of_node_put(c->mbox);
+	of_node_put(c->pmgr_dcp);
+	of_node_put(c->atcphy);
+	of_node_put(c->connector);
+	of_node_put(c->soc);
+	of_node_put(c->rmem);
+}
+
+static struct device_node *dx_node(const char *path, const char *compat)
+{
+	struct device_node *np = of_find_node_by_path(path);
+
+	if (!np) {
+		pr_err(DX "%s not found\n", path);
+		return NULL;
+	}
+	if (compat && !of_device_is_compatible(np, compat)) {
+		pr_err(DX "%pOF is not %s\n", np, compat);
+		of_node_put(np);
+		return NULL;
+	}
+	return np;
+}
+
+static bool dx_reg_is(struct device_node *np, u64 want)
+{
+	struct resource res;
+
+	if (!of_address_to_resource(np, 0, &res) && res.start == want)
+		return true;
+	pr_err(DX "%pOF: unexpected reg (want %#llx)\n", np, want);
+	return false;
+}
+
+static bool dx_disabled(struct device_node *np)
+{
+	if (!of_device_is_available(np))
+		return true;
+	pr_err(DX "%pOF is already enabled\n", np);
+	return false;
+}
+
+/* The internal DCP's firmware properties (set by m1n1) must say 14.7.0. */
+static int dx_check_firmware(struct dx_ctx *c)
+{
+	static const u32 v14_7[3] = { 14, 7, 0 };
+
+	if (of_property_read_u32_array(c->dcp, "apple,firmware-version", c->fw_version, 3) ||
+	    of_property_read_u32_array(c->dcp, "apple,firmware-compat", c->fw_compat, 3) ||
+	    memcmp(c->fw_version, v14_7, sizeof(v14_7)) ||
+	    memcmp(c->fw_compat, v14_7, sizeof(v14_7))) {
+		pr_err(DX "%pOF firmware is not 14.7.0; refusing\n", c->dcp);
+		return -ENODEV;
+	}
+	return 0;
+}
+
+/* Log every segment that is (partly) System RAM; return how many are. */
+static int dx_check_segments(void)
+{
+	int i, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(dx_segs); i++) {
+		const struct dx_seg *s = &dx_segs[i];
+		int r = region_intersects(s->phys, s->size, IORESOURCE_SYSTEM_RAM,
+					  IORES_DESC_NONE);
+
+		if (r == REGION_DISJOINT) {
+			pr_info(DX "segment %s %#llx+%#llx is outside System RAM\n",
+				s->name, s->phys, s->size);
+			continue;
+		}
+		pr_warn(DX "segment %s %#llx+%#llx is %s System RAM\n", s->name, s->phys,
+			s->size, r == REGION_INTERSECTS ? "inside" : "partly in");
+		n++;
+	}
+	return n;
+}
+
+static int dx_lookup(struct dx_ctx *c)
+{
+	const struct dx_port *p = c->port;
+	u32 cells;
+
+	c->dcp = dx_node(DX_DCP, "apple,dcp");
+	c->dcpext = dx_node(DX_DCPEXT, "apple,dcpext");
+	c->dcpext_dart = dx_node(DX_DCPEXT_DART, "apple,t8110-dart");
+	c->dispext_dart = dx_node(DX_DISPEXT_DART, "apple,t8110-dart");
+	c->mbox = dx_node(DX_DCPEXT_MBOX, "apple,asc-mailbox-v4");
+	c->pmgr_dcp = dx_node(DX_PMGR_DCP, NULL);
+	c->atcphy = dx_node(p->atcphy, "apple,t8122-atcphy");
+	c->connector = dx_node(p->connector, "usb-c-connector");
+	c->soc = dx_node(DX_SOC, NULL);
+	c->rmem = dx_node(DX_RMEM, NULL);
+	if (!c->dcp || !c->dcpext || !c->dcpext_dart || !c->dispext_dart || !c->mbox ||
+	    !c->pmgr_dcp || !c->atcphy || !c->connector || !c->soc || !c->rmem)
+		return -ENODEV;
+
+	if (!dx_reg_is(c->dcpext, 0x31ac00000ULL) || !dx_reg_is(c->dcpext_dart, 0x31930c000ULL) ||
+	    !dx_reg_is(c->dispext_dart, 0x319304000ULL) || !dx_reg_is(c->mbox, 0x31ac08000ULL) ||
+	    !dx_reg_is(c->pmgr_dcp, 0x2d03d0000ULL))
+		return -ENODEV;
+
+	if (of_property_read_u32(c->pmgr_dcp, "#apple,bw-scratch-cells", &cells) || cells != 3) {
+		pr_err(DX "%pOF has no 3-cell bw-scratch\n", c->pmgr_dcp);
+		return -ENODEV;
+	}
+	if (!c->dcpext->phandle || !c->dcpext_dart->phandle || !c->dispext_dart->phandle ||
+	    !c->mbox->phandle || !c->pmgr_dcp->phandle || !c->atcphy->phandle) {
+		pr_err(DX "a referenced node has no phandle\n");
+		return -ENODEV;
+	}
+	if (of_property_read_u32(c->atcphy, "power-domains", &c->atc_pd)) {
+		pr_err(DX "%pOF has no power domain\n", c->atcphy);
+		return -ENODEV;
+	}
+	return dx_check_firmware(c);
+}
+
+/* Read-only: log the dispext power states (PMGR, always on, non-posted). */
+static void dx_log_power(void)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(dx_pwrstates); i++) {
+		struct device_node *np;
+		struct resource res;
+		const char *label;
+		void __iomem *reg;
+		u32 off, v;
+
+		for_each_compatible_node(np, NULL, "apple,t8122-pmgr-pwrstate") {
+			if (!of_property_read_string(np, "label", &label) &&
+			    !strcmp(label, dx_pwrstates[i]))
+				break;
+		}
+		if (!np || of_property_read_u32(np, "reg", &off) ||
+		    of_address_to_resource(np->parent, 0, &res) || res.start != 0x2d0700000ULL) {
+			pr_warn(DX "power state %s not found\n", dx_pwrstates[i]);
+			of_node_put(np);
+			continue;
+		}
+		of_node_put(np);
+		reg = ioremap_np(res.start + off, 4);
+		if (!reg)
+			continue;
+		v = readl(reg);
+		iounmap(reg);
+		pr_info(DX "PMGR %s %#llx = 0x%08x (target %u, actual %u, min %u%s%s)\n",
+			dx_pwrstates[i], res.start + off, v, PS_TARGET(v), PS_ACTUAL(v),
+			(v >> 16) & 0xf, v & BIT(8) ? ", was power-gated" : "",
+			v & BIT(9) ? ", was clock-gated" : "");
+	}
+}
+
+static u32 dx_new_phandle(void)
+{
+	static u32 next = DX_PHANDLE_BASE;
+	struct device_node *np;
+
+	while ((np = of_find_node_by_phandle(next))) {
+		of_node_put(np);
+		next++;
+	}
+	return next++;
+}
+
+/*
+ * Add or replace a property on an existing node. The property is never
+ * freed: the changeset is not reverted (test scaffolding).
+ */
+static int dx_set(struct of_changeset *cs, struct device_node *np, const char *name,
+		  const void *val, int len)
+{
+	struct property *pp = kzalloc(sizeof(*pp), GFP_KERNEL);
+
+	if (!pp)
+		return -ENOMEM;
+	pp->name = kstrdup(name, GFP_KERNEL);
+	pp->value = kmemdup(val, len ?: 1, GFP_KERNEL);
+	pp->length = len;
+	if (!pp->name || !pp->value) {
+		kfree(pp->name);
+		kfree(pp->value);
+		kfree(pp);
+		return -ENOMEM;
+	}
+	return of_changeset_update_property(cs, np, pp);
+}
+
+static int dx_set_u32s(struct of_changeset *cs, struct device_node *np, const char *name,
+		       const u32 *vals, int n)
+{
+	__be32 *be = kcalloc(n, sizeof(*be), GFP_KERNEL);
+	int i, ret;
+
+	if (!be)
+		return -ENOMEM;
+	for (i = 0; i < n; i++)
+		be[i] = cpu_to_be32(vals[i]);
+	ret = dx_set(cs, np, name, be, n * sizeof(*be));
+	kfree(be);
+	return ret;
+}
+
+static int dx_set_u32(struct of_changeset *cs, struct device_node *np, const char *name, u32 v)
+{
+	return dx_set_u32s(cs, np, name, &v, 1);
+}
+
+static int dx_set_str(struct of_changeset *cs, struct device_node *np, const char *name,
+		      const char *s)
+{
+	return dx_set(cs, np, name, s, strlen(s) + 1);
+}
+
+static struct device_node *dx_find_child(struct device_node *parent, const char *name)
+{
+	struct device_node *np;
+
+	for_each_child_of_node(parent, np)
+		if (!strcmp(kbasename(np->full_name), name))
+			return np;
+	return NULL;
+}
+
+/* Stage 1: the port's crossbar, compatible with the t6020 interface. */
+static int dx_add_xbar(struct dx_ctx *c, u32 *xbar_ph)
+{
+	static const char *const compat[] = {
+		"apple,t8122-display-crossbar", "apple,t6020-display-crossbar",
+	};
+	const struct dx_port *p = c->port;
+	u32 reg[4] = { upper_32_bits(p->xbar_base), lower_32_bits(p->xbar_base), 0, 0x4000 };
+	struct device_node *np;
+	int ret;
+
+	np = dx_find_child(c->soc, p->xbar_name);
+	if (np) {
+		ret = of_device_is_compatible(np, compat[0]) && np->phandle ? 0 : -EEXIST;
+		*xbar_ph = np->phandle;
+		if (ret)
+			pr_err(DX "%pOF exists but is not ours\n", np);
+		else
+			pr_info(DX "crossbar %pOF already added\n", np);
+		of_node_put(np);
+		return ret;
+	}
+
+	*xbar_ph = dx_new_phandle();
+	of_changeset_init(&dx_xbar_cs);
+	np = of_changeset_create_node(&dx_xbar_cs, c->soc, p->xbar_name);
+	ret = np ? 0 : -ENOMEM;
+	if (!ret)
+		ret = of_changeset_add_prop_string_array(&dx_xbar_cs, np, "compatible", compat,
+							 ARRAY_SIZE(compat));
+	if (!ret)
+		ret = of_changeset_add_prop_u32_array(&dx_xbar_cs, np, "reg", reg, ARRAY_SIZE(reg));
+	if (!ret)
+		ret = of_changeset_add_prop_u32(&dx_xbar_cs, np, "#mux-control-cells", 1);
+	if (!ret)
+		ret = of_changeset_add_prop_u32(&dx_xbar_cs, np, "power-domains", c->atc_pd);
+	if (!ret)
+		ret = of_changeset_add_prop_u32(&dx_xbar_cs, np, "phandle", *xbar_ph);
+	/*
+	 * create_node queues ATTACH before the property entries. The OF core
+	 * caches np->phandle at ATTACH, so attach only after its properties have
+	 * been applied; otherwise the visible phandle property cannot be resolved.
+	 */
+	if (!ret) {
+		struct of_changeset_entry *attach;
+
+		attach = list_first_entry(&dx_xbar_cs.entries,
+					  struct of_changeset_entry, node);
+		if (attach->action != OF_RECONFIG_ATTACH_NODE || attach->np != np)
+			ret = -EINVAL;
+		else
+			list_move_tail(&attach->node, &dx_xbar_cs.entries);
+	}
+	if (!ret)
+		ret = of_changeset_apply(&dx_xbar_cs);
+	if (!ret) {
+		struct device_node *resolved = of_find_node_by_phandle(*xbar_ph);
+
+		if (resolved != np) {
+			pr_err(DX "crossbar phandle %#x does not resolve; refusing dcpext\n",
+			       *xbar_ph);
+			ret = -EINVAL;
+		}
+		of_node_put(resolved);
+	}
+	of_node_put(np);
+	if (ret) {
+		of_changeset_destroy(&dx_xbar_cs);
+		pr_err(DX "crossbar not usable: %d\n", ret);
+		return ret;
+	}
+	pr_info(DX "added %pOF/%s (%#llx, phandle %#x)\n", c->soc, p->xbar_name, p->xbar_base,
+		*xbar_ph);
+	return 0;
+}
+
+/* Consume reservations created at boot; runtime DT edits cannot reserve RAM. */
+static int dx_load_segments(struct dx_ctx *c)
+{
+	u32 version;
+	int i;
+
+	if (of_property_read_u32(c->dcpext, "m3gpu,firmware-reservation-version", &version) ||
+	    version != 1) {
+		pr_err(DX "matching m1n1 firmware reservations missing; refusing\n");
+		return -ENODEV;
+	}
+	if (of_count_phandle_with_args(c->dcpext, "memory-region", NULL) != ARRAY_SIZE(dx_segs)) {
+		pr_err(DX "unexpected dcpext firmware segment count; refusing\n");
+		return -EINVAL;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(dx_segs); i++) {
+		struct dx_seg *s = &dx_segs[i];
+		struct device_node *np;
+		struct resource res;
+		const __be32 *maps;
+		int len, j, matches = 0, ret = 0;
+
+		np = of_parse_phandle(c->dcpext, "memory-region", i);
+		if (!np)
+			return -EINVAL;
+		if (np->parent != c->rmem || !np->phandle ||
+		    !of_device_is_compatible(np, "apple,asc-mem") ||
+		    !of_property_present(np, "no-map") ||
+		    of_address_to_resource(np, 0, &res)) {
+			ret = -EINVAL;
+			goto put_segment;
+		}
+		s->phys = res.start;
+		s->size = resource_size(&res);
+		s->phandle = np->phandle;
+		maps = of_get_property(np, "iommu-addresses", &len);
+		/* Every target here has two address cells and two size cells. */
+		if (!maps || len <= 0 || len % (5 * sizeof(*maps))) {
+			ret = -EINVAL;
+			goto put_segment;
+		}
+		for (j = 0; j < len / sizeof(*maps); j += 5) {
+			if (be32_to_cpup(maps + j) != c->dcpext->phandle)
+				continue;
+			s->iova = of_read_number(maps + j + 1, 2);
+			if (of_read_number(maps + j + 3, 2) != s->size) {
+				ret = -EINVAL;
+				goto put_segment;
+			}
+			matches++;
+		}
+		if (matches != 1 || !s->phys || !s->iova || !s->size ||
+		    ((s->phys | s->iova | s->size) & (SZ_16K - 1)) ||
+		    s->phys + s->size < s->phys || s->iova + s->size < s->iova)
+			ret = -EINVAL;
+put_segment:
+		of_node_put(np);
+		if (ret) {
+			pr_err(DX "invalid boot reservation for %s; refusing\n", s->name);
+			return ret;
+		}
+		pr_info(DX "boot reservation %s: phys %#llx iova %#llx size %#llx\n",
+			s->name, s->phys, s->iova, s->size);
+	}
+	return 0;
+}
+
+/* Stage 2: dcpext, its DARTs, mailbox and DRM device, and the HPD link. */
+static int dx_add_dcpext(struct dx_ctx *c, u32 xbar_ph)
+{
+	static const char seg_names[] =
+		"dcpext-text\0dcpext-data\0dcpext-oslog\0dcpext-region74";
+	struct of_changeset *cs = &dx_ext_cs;
+	u32 seg_ph[ARRAY_SIZE(dx_segs)];
+	struct device_node *piodma, *np = NULL;
+	int ret;
+
+	if (!dx_disabled(c->dcpext) || !dx_disabled(c->dcpext_dart) ||
+	    !dx_disabled(c->dispext_dart) || !dx_disabled(c->mbox))
+		return -EEXIST;
+	if ((np = dx_find_child(c->soc, DX_MASTER_NAME))) {
+		pr_err(DX "%pOF already exists\n", np);
+		of_node_put(np);
+		return -EEXIST;
+	}
+	if (of_property_present(c->connector, "displayport")) {
+		pr_err(DX "%pOF already has a displayport link\n", c->connector);
+		return -EEXIST;
+	}
+	piodma = of_get_child_by_name(c->dcpext, "piodma");
+	if (!piodma) {
+		pr_err(DX "%pOF has no piodma node\n", c->dcpext);
+		return -ENODEV;
+	}
+
+	of_changeset_init(cs);
+	for (int i = 0; i < ARRAY_SIZE(dx_segs); i++)
+		seg_ph[i] = dx_segs[i].phandle;
+	ret = 0;
+
+	/* DARTs: the internal display's DART layout (see dx_dart_range). */
+	if (!ret)
+		ret = dx_set_u32(cs, c->dcpext_dart, "#iommu-cells", 1);
+	if (!ret)
+		ret = dx_set_u32s(cs, c->dcpext_dart, "apple,dma-range", dx_dart_range, 4);
+	if (!ret)
+		ret = dx_set_u32(cs, c->dispext_dart, "#iommu-cells", 1);
+	if (!ret)
+		ret = dx_set_u32s(cs, c->dispext_dart, "apple,dma-range", dx_dart_range, 4);
+	if (!ret)
+		ret = dx_set_str(cs, c->dcpext_dart, "status", "okay");
+	if (!ret)
+		ret = dx_set_str(cs, c->dispext_dart, "status", "okay");
+	if (!ret)
+		ret = dx_set_str(cs, c->mbox, "status", "okay");
+
+	/* dcpext itself; status last so the device sees every property. */
+	if (!ret) {
+		u32 v[2] = { c->dispext_dart->phandle, DX_SID_PIODMA };
+
+		ret = dx_set_u32s(cs, piodma, "iommus", v, 2);
+	}
+	if (!ret) {
+		u32 v[2] = { c->dcpext_dart->phandle, DX_SID_DCPEXT };
+
+		ret = dx_set_u32s(cs, c->dcpext, "iommus", v, 2);
+	}
+	if (!ret)
+		ret = dx_set_u32s(cs, c->dcpext, "reg", dx_dcpext_reg, ARRAY_SIZE(dx_dcpext_reg));
+	if (!ret)
+		ret = dx_set(cs, c->dcpext, "reg-names", dx_dcpext_reg_names,
+			     sizeof(dx_dcpext_reg_names));
+	if (!ret) {
+		u32 v[4] = { c->pmgr_dcp->phandle, 0, DX_BW_SCRATCH_INDEX, DX_BW_SCRATCH_OFFSET };
+
+		ret = dx_set_u32s(cs, c->dcpext, "apple,bw-scratch", v, 4);
+	}
+	if (!ret)
+		ret = dx_set_u32s(cs, c->dcpext, "memory-region", seg_ph, ARRAY_SIZE(seg_ph));
+	if (!ret)
+		ret = dx_set(cs, c->dcpext, "memory-region-names", seg_names, sizeof(seg_names));
+	if (!ret)
+		ret = dx_set_u32s(cs, c->dcpext, "apple,firmware-version", c->fw_version, 3);
+	if (!ret)
+		ret = dx_set_u32s(cs, c->dcpext, "apple,firmware-compat", c->fw_compat, 3);
+	if (!ret)
+		ret = dx_set_str(cs, c->dcpext, "apple,connector-type", "DP");
+	if (!ret) {
+		u32 v[2] = { c->atcphy->phandle, PHY_TYPE_DP };
+
+		ret = dx_set_u32s(cs, c->dcpext, "phys", v, 2);
+	}
+	if (!ret)
+		ret = dx_set_str(cs, c->dcpext, "phy-names", "dp-phy");
+	if (!ret) {
+		u32 v[2] = { xbar_ph, 0 };	/* mux 0 = the port's DP PHY input */
+
+		ret = dx_set_u32s(cs, c->dcpext, "mux-controls", v, 2);
+	}
+	if (!ret)
+		ret = dx_set_str(cs, c->dcpext, "mux-control-names", "dp-xbar");
+	if (!ret)
+		ret = dx_set_u32(cs, c->dcpext, "mux-index", xbar_state);
+	if (!ret)
+		ret = dx_set_u32(cs, c->dcpext, "apple,dptx-phy", c->port->dptx_phy);
+	if (!ret)
+		ret = dx_set_str(cs, c->dcpext, "status", "okay");
+
+	/* HPD from the PD controller (tipd cd321x_dp_hpd_work) */
+	if (!ret)
+		ret = dx_set_u32(cs, c->connector, "displayport", c->dcpext->phandle);
+
+	/* A DRM device of its own: the boot-time one cannot gain a DCP. */
+	if (!ret) {
+		np = of_changeset_create_node(cs, c->soc, DX_MASTER_NAME);
+		ret = np ? 0 : -ENOMEM;
+	}
+	if (!ret)
+		ret = of_changeset_add_prop_string(cs, np, "compatible", "apple,display-subsystem");
+	if (!ret) {
+		u32 v[2] = { c->dispext_dart->phandle, DX_SID_DISPEXT };
+
+		ret = of_changeset_add_prop_u32_array(cs, np, "iommus", v, 2);
+	}
+	if (!ret)
+		ret = of_changeset_add_prop_u32(cs, np, "m3gpu,dcps", c->dcpext->phandle);
+	of_node_put(np);
+	of_node_put(piodma);
+
+	if (!ret)
+		ret = of_changeset_apply(cs);
+	if (ret) {
+		of_changeset_destroy(cs);
+		pr_err(DX "dcpext not enabled: %d\n", ret);
+		return ret;
+	}
+	pr_info(DX "dcpext enabled on port %u (dptx-phy %u, crossbar state %u)\n", port,
+		c->port->dptx_phy, xbar_state);
+	return 0;
+}
+
+static int __init dx_init(void)
+{
+	struct dx_ctx c = {};
+	u32 xbar_ph = 0;
+	int ret, in_ram;
+
+	if (!of_machine_is_compatible("apple,j613"))
+		return -ENODEV;
+	if (stage > 2 || port >= ARRAY_SIZE(dx_ports) || xbar_state >= 4)
+		return -EINVAL;
+	c.port = &dx_ports[port];
+
+	/* Read-only, needs no other check: always logged. */
+	dx_log_power();
+
+	ret = dx_lookup(&c);
+	if (ret)
+		goto out;
+	/* Only stage 2 needs the boot reservations; the checks just report them. */
+	ret = dx_load_segments(&c);
+	if (ret && stage >= 2)
+		goto out;
+	in_ram = ret ? -1 : dx_check_segments();
+	ret = 0;
+	pr_info(DX "port %u: %pOF, %pOF; dcpext %s; DCP firmware %u.%u.%u; %s\n",
+		port, c.connector, c.atcphy,
+		of_device_is_available(c.dcpext) ? "enabled" : "disabled", c.fw_version[0],
+		c.fw_version[1], c.fw_version[2],
+		in_ram < 0 ? "no m1n1 firmware reservations (stage 2 would be refused)" :
+		in_ram ? "firmware segments in System RAM" : "firmware segments reserved");
+
+	if (stage == 0) {
+		pr_info(DX "stage 0: checks done, tree unchanged\n");
+		goto out;
+	}
+	/* Only the dcpext power-up depends on the segments; refuse before any change. */
+	if (stage >= 2 && in_ram) {
+		pr_err(DX "stage 2 refused: %d firmware segment(s) in System RAM, tree unchanged\n",
+		       in_ram);
+		ret = -EFAULT;
+		goto out;
+	}
+	ret = dx_add_xbar(&c, &xbar_ph);
+	if (!ret && stage >= 2)
+		ret = dx_add_dcpext(&c, xbar_ph);
+out:
+	dx_put(&c);
+	return ret;
+}
+module_init(dx_init);
+
+static void __exit dx_exit(void)
+{
+	pr_info(DX "unloaded; device tree changes stay until reboot\n");
+}
+module_exit(dx_exit);
+
+MODULE_DESCRIPTION("J613 external display (USB-C DP alt mode) device tree overlay");
+MODULE_LICENSE("Dual MIT/GPL");
