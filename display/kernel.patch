+static int atcphy_dp_configure_t8122(struct apple_atcphy *atcphy, enum atcphy_dp_link_rate lr)
+{
+	int ret;
+
+	/* the table programs lane 1 as DP: the trace's (unswapped) orientation */
+	if (atcphy->swap_lanes) {
+		dev_err(atcphy->dev, "t8122: DP link setup only known for the unswapped orientation\n");
+		return -EINVAL;
+	}
+
+	if (lr != ATCPHY_DP_LINK_RATE_HBR2) {
+		dev_err(atcphy->dev, "t8122: only HBR2 link setup is known (asked %d)\n", lr);
+		return -EINVAL;
+	}
+
+	/* macOS enters with byte clock in reset, clocks enabled, no selectors */
+	core_mask32(atcphy, ACIOPHY_LANE_DP_CFG_BLK_TX_DP_CTRL0, GENMASK(15, 0),
+		    DPRX_PCLK_ENABLE | DPTX_PCLK2_ENABLE | DPTX_PCLK1_ENABLE | DP_PMA_BYTECLK_RESET);
+
+	ret = atcphy_t8122_dp_run(atcphy, "hbr2", t8122_dp_hbr2, ARRAY_SIZE(t8122_dp_hbr2));
+	if (ret)
+		return ret;
+
+	atcphy->dp_link_rate = lr;
+	return 0;
+}
