+/*
+ * J613: reserve the external DCP's live firmware segments before Linux can
+ * allocate them. dcpext and its DARTs stay disabled; j613_dispext_overlay
+ * supplies their wiring and explicitly controls power-up.
+ */
+static int dt_reserve_j613_dcpext_firmware(void)
+{
+    const char *path = "/soc/dcp@31ac00000";
+    const char *adt_path = "/arm-io/dcpext/iop-dcpext-nub";
+    const struct adt_segment_ranges *seg;
+    u32 len = 0;
+    int ret, node;
+
+    if (fdt_node_check_compatible(dt, 0, "apple,j613"))
+        return 0;
+
+    node = fdt_path_offset(dt, path);
+    if (node < 0 || fdt_node_check_compatible(dt, node, "apple,t8122-dcpext"))
+        bail("FDT: J613 dcpext node missing or incompatible\n");
+
+    const char *status = fdt_getprop(dt, node, "status", &ret);
+    if (!status || ret != sizeof("disabled") || memcmp(status, "disabled", ret))
+        bail("FDT: J613 dcpext is not disabled; skipping local reservation\n");
+    if (fdt_getprop(dt, node, "memory-region", NULL))
+        bail("FDT: J613 dcpext already has memory-region; skipping local reservation\n");
+
+    node = adt_path_offset(adt, adt_path);
+    if (node < 0)
+        bail("ADT: J613 dcpext firmware not found\n");
+    seg = adt_getprop(adt, node, "segment-ranges", &len);
+    if (!seg || !len || len % sizeof(*seg) || len / sizeof(*seg) > 16)
+        bail("ADT: invalid J613 dcpext segment-ranges\n");
+
+    /* Validate every segment before modifying the FDT. */
+    for (unsigned i = 0; i < len / sizeof(*seg); i++) {
+        u64 size = ALIGN_UP((u64)seg[i].size, SZ_16K);
+
+        if (!seg[i].phys || !seg[i].remap || !size ||
+            (seg[i].phys & (SZ_16K - 1)) || (seg[i].remap & (SZ_16K - 1)) ||
+            seg[i].phys + size < seg[i].phys || seg[i].remap + size < seg[i].remap)
+            bail("ADT: invalid J613 dcpext segment %u\n", i);
+    }
+
+    ret = dt_reserve_asc_firmware(adt_path, NULL, path, true, 0);
+    if (ret)
+        return ret;
+
+    node = fdt_path_offset(dt, path);
+    if (node < 0)
+        return node;
+    ret = fdt_setprop_u32(dt, node, "m3gpu,firmware-reservation-version", 1);
+    if (ret)
+        return ret;
+
+    printf("FDT: J613 dcpext reserved %zu live firmware segments; controller stays disabled\n",
+           len / sizeof(*seg));
+    return 0;
+}
