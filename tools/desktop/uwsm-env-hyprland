# M3 GPU (G15, m3gpu project): on the G15 kernel (release *-display-driver-g15), load the
# G15 GPU driver and run this Hyprland session on the G15 Mesa. On any other
# kernel, or on a test-harness boot, this file does nothing. To disable:
# delete this file.
# A test-harness boot (tools/j613-live.sh leaves this marker before it
# reboots and removes it when done) loads its own driver: leave it alone.
case "$(uname -r)" in *-display-driver-g15) g15_kernel=1 ;; *) g15_kernel= ;; esac
if [ -n "$g15_kernel" ] && [ ! -e "$HOME/.cache/m3gpu-harness-boot" ]; then
    sudo -n /usr/local/sbin/g15-load >/tmp/g15-load.log 2>&1
    if grep -q '^asahi ' /proc/modules; then
        G15_MESA=${G15_MESA:-$HOME/g15-mesa}
        export LD_LIBRARY_PATH="$G15_MESA/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        export GBM_BACKENDS_PATH="$G15_MESA/lib/gbm"
        export __EGL_VENDOR_LIBRARY_FILENAMES="$G15_MESA/50_g15_mesa.json"
        export ASAHI_G15_GRAPHICS=1
        export AQ_DRM_DEVICES=/dev/dri/card1
    else
        # Driver not loaded: keep the session on the CPU renderer.
        export MESA_LOADER_DRIVER_OVERRIDE=kms_swrast LIBGL_ALWAYS_SOFTWARE=1
    fi
fi
