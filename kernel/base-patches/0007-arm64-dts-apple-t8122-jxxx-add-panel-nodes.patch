+++ b/arch/arm64/boot/dts/apple/t8122-jxxx.dtsi
@@ -62,6 +62,13 @@ memory@800000000 {
 	};
 };
 
+&dcp {
+	panel: panel {
+		apple,max-brightness = <500>;
+	};
+};
+
+
 &serial0 {
 	status = "okay";
 };
