@@ -31,6 +31,13 @@ led-0 {
 	};
 };
 
+&panel {
+	compatible = "apple,panel-j613", "apple,panel";
+	width-mm = <290>;
+	height-mm = <189>;
+	adj-height-mm = <181>;
+};
+
 &wifi0 {
 	brcm,board-type = "apple,dnieper";
 };
diff --git a/arch/arm64/boot/dts/apple/t8122-j615.dts b/arch/arm64/boot/dts/apple/t8122-j615.dts
