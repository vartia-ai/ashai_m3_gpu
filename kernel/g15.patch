+            Ok(Some(p)) => p,
+            _ => return,
+        };
+        // SAFETY: offsets inside the mapped page.
+        let rd = |va: u64| unsafe { core::ptr::read_volatile(wc.add((va - PAGE_A) as usize) as *const u64) };
+        let sample = || {
+            let mut w = [0u64; 10];
+            w[0] = rd(0xfffffc00000a8c78);
+            w[1] = rd(0xfffffc00000a8d70);
+            for u in 0..8u64 {
+                w[2 + u as usize] = rd(0xfffffc00000a8f40 + 8 * u);
+            }
+            w
+        };
+        let mut log: KVec<(i64, [u64; 10])> = KVec::new();
+        let _ = log.reserve(64, GFP_KERNEL);
+        let mut last = [u64::MAX; 10];
+        // SAFETY: plain time reads.
+        let t0 = unsafe { kernel::bindings::ktime_get() };
+        loop {
+            let t = unsafe { kernel::bindings::ktime_get() } - t0;
+            let w = sample();
+            if w != last && log.len() < 64 {
+                let _ = log.push((t, w), GFP_KERNEL);
+                last = w;
+            }
+            if t > 2_000_000 {
+                break;
+            }
+            // SAFETY: busy-wait only.
+            unsafe { kernel::bindings::__udelay(1) };
+        }
+        // SAFETY: from memremap above.
+        unsafe { kernel::bindings::memunmap(wc as *mut _) };
