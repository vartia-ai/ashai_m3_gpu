+/// SKU stream slots for one channel: one special-range-8 mapping of
+/// `slot_count * slot_stride` bytes rounded up to the 16-KiB page (E103:
+/// 0xf0 x 0x300 -> 0x30000 for Compute).
+#[allow(dead_code)]
+pub(super) struct G15PipeSkuBacking {
+    backing: alloc::G15SharedGpuArray<u8>,
+    slot_count: usize,
+    slot_stride: usize,
+}
+
+#[allow(dead_code)]
+impl G15PipeSkuBacking {
+    fn new(
+        dev: &AsahiDevice,
+        bank1: mmu::G15SharedBank1,
+        mapping_notifier: Arc<Mutex<mmu::G15MappingNotifier>>,
+        slot_count: usize,
+        slot_stride: usize,
+    ) -> Result<Self> {
+        let bytes = slot_count
+            .checked_mul(slot_stride)
+            .and_then(|bytes| bytes.checked_add(mmu::UAT_PGSZ - 1))
+            .ok_or(EOVERFLOW)?
+            & !mmu::UAT_PGMSK;
+        let mut allocator = alloc::G15SharedBank1Allocator::new_range8(
+            dev,
+            bank1,
+            mmu::UAT_PGSZ,
+            true,
+            Some(mapping_notifier),
+        );
+        let backing = allocator.array_empty_shared_data::<u8>(bytes)?;
+        let base: u64 = backing.weak_pointer().into();
+        if backing.len() != bytes || base & mmu::UAT_PGMSK as u64 != 0 {
+            return Err(EIO);
+        }
+        if backing.as_slice().iter().any(|byte| *byte != 0) {
+            return Err(EIO);
+        }
+
+        Ok(Self {
+            backing,
+            slot_count,
+            slot_stride,
+        })
+    }
+
+    /// Resolve one already-retired slot address without writing the backing.
+    fn reserve_retired_slot(&self, index: usize) -> Result<G15PipeSkuSlot> {
+        if index >= self.slot_count {
+            return Err(EINVAL);
+        }
+        let start = index.checked_mul(self.slot_stride).ok_or(EOVERFLOW)?;
+        let end = start.checked_add(self.slot_stride).ok_or(EOVERFLOW)?;
+        if end > self.backing.len() {
+            return Err(EIO);
+        }
+        let base: u64 = self.backing.weak_pointer().into();
+        let fwva = base.checked_add(start as u64).ok_or(EOVERFLOW)?;
+        Ok(G15PipeSkuSlot {
+            index: index.try_into().map_err(|_| EOVERFLOW)?,
+            fwva,
+        })
+    }
+
+    /// Copy a finalized stream into a previously reserved slot. The
+    /// reservation is re-derived first so an index/FWVA mismatch fails closed,
+    /// and the whole slot is cleared before the copy.
+    fn write_reserved_slot(
+        &mut self,
+        reserved: G15PipeSkuSlot,
+        stream: &[u8],
+    ) -> Result<G15PipeSkuWritten> {
+        if stream.is_empty() || stream.len() > self.slot_stride {
+            return Err(EINVAL);
+        }
+        let expected = self.reserve_retired_slot(reserved.index())?;
+        if expected.fwva() != reserved.fwva() {
+            return Err(EIO);
+        }
+        let start = reserved
+            .index()
+            .checked_mul(self.slot_stride)
+            .ok_or(EOVERFLOW)?;
+        let end = start.checked_add(self.slot_stride).ok_or(EOVERFLOW)?;
+        let slot = &mut self.backing.as_mut_slice()[start..end];
+        for byte in slot.iter_mut() {
+            *byte = 0;
+        }
+        slot[..stream.len()].copy_from_slice(stream);
+        if slot[stream.len()..].iter().any(|byte| *byte != 0) {
+            return Err(EIO);
+        }
+        // F2 experiment (`g15_sku_clean`): push the slot to the point of
+        // coherency before the firmware may read it.
+        if *crate::module_parameters::g15_sku_clean.value() != 0 {
+            super::g15_resources::g15_clean_to_poc(slot.as_ptr() as usize, slot.len());
+        }
+        Ok(G15PipeSkuWritten {
+            fwva: reserved.fwva(),
+            size: stream.len().try_into().map_err(|_| EOVERFLOW)?,
+        })
+    }
+}
