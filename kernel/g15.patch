+#[allow(dead_code)]
+struct PmpDriver(Arc<PmpData>);
+
+impl Drop for PmpDriver {
+    fn drop(&mut self) {
+        // The PMP keeps running after unbind and still owns its buffers.
+        core::mem::forget(self.0.clone());
+        dev_warn!(self.0.dev, "PMP unbound while running; its buffers are leaked\n");
+    }
+}
