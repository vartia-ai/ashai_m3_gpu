+/// One lazily assembled TA (Vertex) or 3D (Fragment) G15 channel.
+///
+/// Built by `ensure` from a [`G15PipeProfile`]; owns the same resource set as
+/// the Compute channel and implements the same selected-channel transport.
+/// There is no submission caller yet.
+#[versions(AGX)]
+#[allow(dead_code)]
+pub(crate) struct G15RenderChannel {
+    // Channel-local resources and guards drop before the UMA reference, as in
+    // the Compute channel.
+    owners: KBox<G15PipeChannelOwners>,
+    guards: G15PipeGuards::ver,
+    fw_channel_resources: buffer::G15FirmwareChannelResourceLeases,
+    scheduler_publication: Arc<super::G15SchedulerPublication>,
+    commands_submitted: bool,
+    /// Whether this channel's first submission started the queue's
+    /// scheduler publication.
+    owns_scheduler_publication: bool,
+    uma: G15RenderUma,
