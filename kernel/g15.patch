+    fn validate_rejects() {
+        let f = fx();
+        let mut prof = profile(&f);
+        prof.ready = false;
+        assert_eq!(prof.validate(), Err(EINVAL));
+        let mut prof = profile(&f);
+        prof.unresolved = 1;
+        assert_eq!(prof.validate(), Err(EINVAL));
+        for kind in [G15ViewKind::EvidenceDryRun, G15ViewKind::Trial] {
+            let mut prof = prof;
+            prof.kind = kind;
+            assert_eq!(prof.validate(), Ok(()));
+            prof.ready = false;
+            assert_eq!(prof.validate(), Err(EINVAL));
+        }
+
+        // Register chain: 0x500 -> 0x300 -> 0x200.
+        let mut ta = ta_entries().to_vec();
+        ta.push(e(0x500, 0, from_reg(G15Engine::Ta, 0x300, 0, 0)));
+        let mut prof = profile(&f);
+        prof.ta_regs.entries = &ta;
+        assert_eq!(prof.validate(), Err(EINVAL));
+
+        // Duplicate register.
+        let mut ta = ta_entries().to_vec();
+        ta.push(e(0x100, 0, G15Prov::Native));
+        let mut prof = profile(&f);
+        prof.ta_regs.entries = &ta;
+        assert_eq!(prof.validate(), Err(EINVAL));
+
+        // Unresolved register.
+        let mut ta = ta_entries().to_vec();
+        ta[0].prov = G15Prov::Unresolved;
+        let mut prof = profile(&f);
+        prof.ta_regs.entries = &ta;
+        assert_eq!(prof.validate(), Err(EINVAL));
+
+        // Overlapping, out-of-bounds, wrong-native and bad-width patches.
+        let bad: [&[G15Patch]; 4] = [
+            &[p(0x04, 8, 0xaaaa_0080, G15Prov::Native), p(0x08, 4, 0, G15Prov::Native)],
+            &[p(0x3c, 8, 0, G15Prov::Native)],
+            &[p(0x04, 8, 1, G15Prov::Native)],
+            &[p(0x14, 2, 3, full(G15RelocTarget::Tpc, 0))],
+        ];
+        for patches in bad {
+            let mut prof = profile(&f);
+            prof.frag_sku.image.patches = patches;
+            assert_eq!(prof.validate(), Err(EINVAL));
+        }
+
+        // Too many registers.
+        let many = [e(0, 0, G15Prov::Native); G15_REG_LIST_MAX + 1];
+        let mut prof = profile(&f);
+        prof.frag_regs.entries = &many;
+        assert_eq!(prof.validate(), Err(EINVAL));
+    }
