+/// Whether this render is relinked (G2): `g15_relink=2` every render,
+/// `g15_relink=1` only renders Mesa marked `DRM_ASAHI_RENDER_G15_LONG_LISTS`.
+pub(crate) fn g15_relink_wanted(user: &G15UserRender) -> bool {
+    match *module_parameters::g15_relink.value() {
+        0 => false,
+        1 => user.long_lists(),
+        _ => true,
+    }
+}
