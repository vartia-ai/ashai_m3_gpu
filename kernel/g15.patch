+    /// A helper struct for managed IoSysMapRef structs which point to a [`Vec`].
+    pub struct VecIoSysMap<T: AsBytes + FromBytes + Clone + PartialEq> {
+        map: RawIoSysMap<T>,
+        vec: KVec<T>,
