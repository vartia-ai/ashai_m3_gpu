+#[versions(AGX)]
+#[allow(dead_code)]
+impl QueueInner::ver {
+    /// The G15 Compute command of `submit` (R47 user launch or the stock
+    /// empty launch). The submit gate admits no attachment command, so the
+    /// command's attachment set is empty. Not inlined: keeps its temporaries
+    /// out of the submit frame.
+    #[inline(never)]
+    fn g15_submit_compute(
+        &mut self,
+        job: &mut sched::Job<QueueJob::ver>,
+        compute: &uapi::drm_asahi_cmd_compute,
+        objects: Pin<&xarray::XArray<KBox<file::Object>>>,
+        id: u64,
+    ) -> Result {
+        #[ver(G != G15)]
+        {
+            let _ = (job, compute, objects, id);
+            return Err(ENODEV);
+        }
+
+        #[ver(G == G15)]
+        {
+            let compute_attachments: microseq::Attachments = Default::default();
+            // R47: a user launch brings its own program and
+            // parameters and writes the per-queue output buffer.
+            // K7: waits here while any other G15 job is in flight.
+            job.g15_job_slot = Some(G15JobSlot::acquire(&self.dev, self.g15_vm_id)?);
+            // I05: an ordinary compute writes user BOs only. It arms no
+            // status and has no UOUT, and READBACK on this queue answers
+            // ENODATA until the next user launch or render.
+            if g15_is_ordinary(compute) {
+                job.g15_ordinary = true;
+                self.g15_user_output = None;
+                self.g15_last_render_target = None;
+            }
+            let user = if compute.flags == uapi::DRM_ASAHI_COMPUTE_G15_USER_LAUNCH {
+                Some(launch_input::UserLaunch::read(compute.cdm_ctrl_stream_base)?)
+            } else {
+                None
+            };
+            let output_va = match user.as_ref() {
+                Some(launch) => {
+                    if self.g15_user_status.busy.load(Ordering::Acquire) {
+                        return Err(EBUSY);
+                    }
+                    if self.g15_user_output.is_none() {
+                        let heap = self._g15_range5_ppl308.as_ref().ok_or(EINVAL)?;
+                        self.g15_user_output = Some(
+                            heap.lock().array_empty_tagged::<u8>(
+                                uapi::DRM_ASAHI_G15_MAX_OUTPUT as usize,
+                                b"UOUT",
+                            )?,
+                        );
+                    }
+                    let out = self.g15_user_output.as_mut().ok_or(EINVAL)?;
+                    let canary = launch.canary().to_le_bytes();
+                    for word in out.as_mut_slice()[..launch.output_size()].chunks_exact_mut(4) {
+                        word.copy_from_slice(&canary);
+                    }
+                    self.g15_last_render_target = None;
+                    // W8f: any failure from here until the
+                    // command is published drops the guard with
+                    // `job`, which clears `busy` again.
+                    job.g15_user_status = Some(G15UserBusy::arm(
+                        &self.g15_user_status,
+                        launch.output_size() as u32,
+                    )?);
+                    Some(out.gpu_va().get())
+                }
+                None => None,
+            };
+            self.prepare_g15_stock_empty_workqueue_unpublished(
+                job,
+                compute,
+                &compute_attachments,
+                objects,
+                id,
+                false,
+                user.as_ref().zip(output_va),
+            )
+        }
+    }
+
+    /// Assemble the exact owner tiers for the future first normal
+    /// non-foreground J615 CL/Compute channel, but return only a private host
+    /// object with no WorkQueue/submit attachment and no firmware-command
+    /// writer. Foreground-priority policy remains a separate future bridge.
+    fn g15_assemble_unpublished_nonforeground_compute_channel(
+        &self,
+        gpu: &gpu::GpuManager::ver,
+    ) -> Result<G15UnpublishedComputeChannel::ver> {
+        #[ver(G != G15)]
+        {
+            let _ = gpu;
+            return Err(EINVAL);
+        }
+
+        #[ver(G == G15)]
+        {
+            // Pool selection, channel-resource selection and initialization,
+            // channel owners and guards, in that order (see
+            // `g15_assemble_pipe_channel`).
+            let parts = self
+                .g15_assemble_pipe_channel(gpu, &g15_channel::G15PipeProfile::J615_COMPUTE, None)?;
+            let g15_channel::G15PipeChannelParts::ver {
+                owners,
+                guards,
+                fw_channel_resources,
+                pool,
+            } = parts;
+            // J615_COMPUTE always selects the shared Compute pool.
+            let pool = pool.ok_or(EIO)?;
+
+            Ok(G15UnpublishedComputeChannel::ver {
+                pool,
+                owners: G15StockEmptyComputeChannelOwners { core: owners },
+                guards: G15StockEmptyAssetGuards::ver { pipe: guards },
+                _fw_channel_resources: fw_channel_resources,
+                _scheduler_publication: self._g15_scheduler_publication.clone(),
+                commands_submitted: false,
+                owns_scheduler_publication: false,
+            })
+        }
+    }
+}
