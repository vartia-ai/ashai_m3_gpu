+/// Provenance: these bytes were observed on one J613 with the macOS 14.7 GPU
+/// firmware (the only machine and firmware the G15 path starts on).
+///
+/// Exact q4 +0x0a5..+0x26e bytes captured before the successful early
+/// write1337 submission on this J613. The SHA-256 of the returned byte array
+/// is a48e3e5fe370404984bdef3bca9ef4103dd3fa0a742e7736255468dba3794699.
+/// The repeated masks cover the same 10-USC topology used by this machine.
+fn g15_j613_q4_pad_0a5() -> Pad<0x1ca> {
+    let mut data = [0u8; 0x1ca];
+
+    data[0x0f3..0x113].fill(0xff);
+    data[0x115] = 0x08;
+    for offset in [0x11b, 0x11f, 0x123, 0x127] {
+        data[offset..offset + 3].copy_from_slice(&[0xff, 0xff, 0x3f]);
+    }
+    data[0x141] = 0x3f;
+
+    data[0x16a] = 0x20;
+    data[0x16b..0x18b].fill(0xff);
+    for i in 0..16 {
+        data[0x18b + i * 2..0x18d + i * 2].copy_from_slice(&[0x07, 0x0f]);
+    }
+    for i in 0..7 {
+        data[0x1ab + i * 4..0x1af + i * 4]
+            .copy_from_slice(&[0xff, 0xff, 0xff, 0x03]);
+    }
+    data[0x1c7..0x1ca].fill(0xff);
+
+    Pad::new(data)
+}
+
+/// q4 +0x270..+0x7a7: the rest of curve 1's t3 table, then curve 2 and its
+/// trailer from +0x450. The remaining bytes through +0x7a7 are zero in the
+/// native pre-publication image.
+fn g15_q4_pad_270(curve: &G15Curve) -> Pad<0x538> {
+    let mut data = [0u8; 0x538];
+    let mut put = |off: usize, bytes: &[u8]| data[off..off + bytes.len()].copy_from_slice(bytes);
+
+    for i in 0..0x78 {
+        put(i * 4, &0x03ff_ffffu32.to_le_bytes());
+    }
+    put(0x1e0, &G15_CURVE2_HEADER.to_le_bytes());
+    for i in 0..16 {
+        put(0x1e8 + i * 2, &curve.t1[i].to_le_bytes());
+        put(0x208 + i * 2, &curve.t2[i].to_le_bytes());
+    }
+    for (row, words) in curve.t3.iter().enumerate() {
+        for (i, word) in words.iter().enumerate() {
+            put(0x228 + row * 0x40 + i * 4, &word.to_le_bytes());
+        }
+    }
+    // Curve 2 trailer: two zero words, then 0xc00000 (meaning unknown).
+    put(0x430, &0x00c0_0000u32.to_le_bytes());
+
+    Pad::new(data)
+}
+
+/// G15 curve-2 header, as in HwDataA DPE +0x384 and q4 +0x450.
+const G15_CURVE2_HEADER: u64 = 0xa000_0000_0000_0017;
+
+/// Power-model curve 2 (t1, t2, t3) from the static curve constants and the
+/// ADT performance states, in the HwDataShared2Curve layout used by both the
+/// G15 HwDataA DPE block and q4. Rows with a zero t3 scale keep the fill.
+#[derive(Clone, Copy)]
+struct G15Curve {
+    t1: [u16; 16],
+    t2: [i16; 16],
+    t3: [[u32; 16]; 8],
+}
+
+fn g15_curve2(cfg: &'static hw::HwConfig, pwr: &hw::PwrConfig) -> Result<G15Curve> {
+    let curve_cfg = cfg.shared2_curves.as_ref().ok_or(EINVAL)?;
+    let states = &pwr.perf_states;
+    if states.len() > 16
+        || curve_cfg.t2.len() != states.len()
+        || curve_cfg.t3_coefs.len() != states.len()
+        || curve_cfg.t3_scales.len() > 8
+    {
+        return Err(EINVAL);
+    }
+    let mut curve = G15Curve {
+        t1: [0xffff; 16],
+        t2: [curve_cfg.t2[0]; 16],
+        t3: [[0x3ff_ffff; 16]; 8],
+    };
+    curve.t2[..curve_cfg.t2.len()].copy_from_slice(curve_cfg.t2);
+    for (i, ps) in states.iter().enumerate() {
+        let coef = curve_cfg.t3_coefs[i] as u64;
+        if coef == 0 {
+            continue;
+        }
+        let f_khz = (ps.freq_hz / 1000) as u64;
+        let v_max = ps.max_volt_mv() as u64;
+        curve.t1[i] = (1_000_000_000 * curve_cfg.t1_coef as u64 / (f_khz * v_max)).try_into()?;
+        for (row, scale) in curve_cfg.t3_scales.iter().enumerate() {
+            if *scale != 0 {
+                curve.t3[row][i] =
+                    (coef * 1_000_000_100 * *scale as u64 / (f_khz * v_max * 6)).try_into()?;
+            }
+        }
+    }
+    let t1_fill = curve.t1[0];
+    curve.t1[states.len()..].fill(t1_fill);
+    Ok(curve)
+}
