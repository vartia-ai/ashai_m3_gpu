+/// `g15_job_timing`: CLOCK_MONOTONIC ns of the latest render submit's entry
+/// (one G15 job at a time, so the next build reads its own).
+pub(crate) static G15_T_SUBMIT_IN: AtomicU64 = AtomicU64::new(0);
+
+/// `g15_reseed_min_age_us` statistics: waits, total ns, max ns.
+pub(crate) static G15_RETIRE_WAITS: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+
+/// CLOCK_MONOTONIC ns of the latest render job's finish (`g15_min_gap_us`).
+static G15_T_LAST_FIN: AtomicU64 = AtomicU64::new(0);
+
+/// The ARM system counter (CNTVCT_EL0, 24 MHz), the clock of the firmware's
+/// completion stamps.
+pub(crate) fn g15_cntvct() -> u64 {
+    let v: u64;
+    // SAFETY: reading the virtual counter has no side effects.
+    // 1 GHz on this machine (both counters); the firmware's stamps share its
+    // epoch at 24 MHz: stamp = ticks * 24 / 1000.
+    unsafe { core::arch::asm!("isb", "mrs {0}, cntpct_el0", out(reg) v) };
+    v
+}
+
+/// CLOCK_MONOTONIC in ns, as userspace's clock_gettime reads it.
+pub(crate) fn g15_now_ns() -> u64 {
+    // SAFETY: plain time read.
+    unsafe { kernel::bindings::ktime_get() as u64 }
+}
+
+/// F2 containment (`g15_reseed_min_age_us`): the firmware keeps retiring the
+/// previous render for ~100-300 us after its completion callback. Called right
+/// after the device slot is taken, before anything is collected, allocated,
+/// placed or reseeded, so nothing the previous render used is reused inside
+/// that window. No host-visible end-of-retirement field is known yet.
+fn g15_wait_retire_age() {
+    let age = u64::from((*module_parameters::g15_reseed_min_age_us.value()).min(10_000)) * 1000;
+    if age == 0 {
+        return;
+    }
+    let ready = G15_T_LAST_FIN.load(Ordering::Acquire).saturating_add(age);
+    let now = g15_now_ns();
+    if ready > now {
+        G15_RETIRE_WAITS[0].fetch_add(1, Ordering::Relaxed);
+        G15_RETIRE_WAITS[1].fetch_add(ready - now, Ordering::Relaxed);
+        G15_RETIRE_WAITS[2].fetch_max(ready - now, Ordering::Relaxed);
+        kernel::time::delay::udelay(kernel::time::Delta::from_micros((ready - now).div_ceil(1000) as i64));
+    }
+}
+
+/// G15 teardown/unbind arm (`g15_teardown_age_us`): wait until that long
+/// after the last job's completion before a teardown or unmap proceeds (the
+/// previous job's work can continue after its completion callback).
+/// Counters: [waits, total ns, max ns] for debugfs.
+pub(crate) static G15_TEARDOWN_AGE: [AtomicU64; 3] = [AtomicU64::new(0), AtomicU64::new(0), AtomicU64::new(0)];
+
+pub(crate) fn g15_wait_teardown_age() {
+    let age = u64::from((*module_parameters::g15_teardown_age_us.value()).min(10_000)) * 1000;
+    if age == 0 {
+        return;
+    }
+    let ready = G15_T_LAST_FIN.load(Ordering::Acquire).saturating_add(age);
+    let now = g15_now_ns();
+    if ready > now {
+        G15_TEARDOWN_AGE[0].fetch_add(1, Ordering::Relaxed);
+        G15_TEARDOWN_AGE[1].fetch_add(ready - now, Ordering::Relaxed);
+        G15_TEARDOWN_AGE[2].fetch_max(ready - now, Ordering::Relaxed);
+        kernel::time::delay::udelay(kernel::time::Delta::from_micros((ready - now).div_ceil(1000) as i64));
+    }
+}
