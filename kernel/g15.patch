+/// Where one command's firmware SKU timing state
+/// (`fw::job::raw::G15SkuTimingState`) lives in its CPU-mapped command
+/// object. Its completion stamp goes to the dump only.
+#[derive(Clone, Copy)]
+struct G15CommandTiming {
+    pipe: PipeType,
+    /// CPU address of the timing state; 0 if unavailable.
+    addr: usize,
+    /// CPU address of the 3D command's `tvb_overflow_count`; 0 for TA.
+    overflow_addr: usize,
+    /// CPU address of the 3D command's partial render count; 0 for TA.
+    partials_addr: usize,
+}
+
+impl G15CommandTiming {
+    /// Completion stamp (+0x08) of either pipe's command.
+    fn read(&self) -> u64 {
+        let off = core::mem::offset_of!(fw::job::raw::G15SkuTimingState, complete_timestamp);
+        let addr = self.addr + off;
+        if self.addr == 0 || addr % 8 != 0 {
+            return 0;
+        }
+        // SAFETY: the callback runs from `SubmittedWork::complete()`, while
+        // the WorkQueue still owns this command object; its CPU mapping is
+        // valid and the firmware has finished with the command.
+        unsafe { core::ptr::read_volatile(addr as *const u64) }
+    }
+
+    /// The 3D command's `tvb_overflow_count` (+0xb64), 0 for TA.
+    fn read_overflow(&self) -> u32 {
+        if self.overflow_addr == 0 || self.overflow_addr % 4 != 0 {
+            return 0;
+        }
+        // SAFETY: as for `read`.
+        unsafe { core::ptr::read_volatile(self.overflow_addr as *const u32) }
+    }
+
+    /// The 3D command's partial render count (+0xb74), 0 for TA.
+    fn read_partials(&self) -> u32 {
+        if self.partials_addr == 0 || self.partials_addr % 4 != 0 {
+            return 0;
+        }
+        // SAFETY: as for `read`.
+        unsafe { core::ptr::read_volatile(self.partials_addr as *const u32) }
+    }
+}
