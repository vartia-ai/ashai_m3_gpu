+/// Event-control and SKU retirement guards for one channel.
+#[versions(AGX)]
+#[allow(dead_code)]
+pub(super) struct G15PipeGuards {
+    event: G15EventControlRetirementGuards::ver,
+    sku: G15SkuRetirementGuards::ver,
+}
+
+#[versions(AGX)]
+#[allow(dead_code)]
+impl G15PipeGuards::ver {
+    fn new(profile: &G15PipeProfile) -> Result<Self> {
+        Ok(Self {
+            event: G15EventControlRetirementGuards::ver::new()?,
+            sku: G15SkuRetirementGuards::ver::new(profile.sku_slot_count)?,
+        })
+    }
+
+    /// Acquire the command fence reference first, then bind the next
+    /// event-control state and a retired SKU slot to it. Apple selects exactly
+    /// the next command-buffer state and waits for it to finish; it does not
+    /// skip a busy event-control slot. Every error drops the arm after
+    /// rolling back what was bound. Returns `(arm, event_index, sku_index)`.
+    pub(super) fn bind_phase1(
+        &mut self,
+        owners: &mut G15PipeChannelOwners,
+        fence: &UserFence<super::JobFence::ver>,
+    ) -> Result<(super::G15CommandFenceArm::ver, usize, usize)> {
+        let arm = super::G15CommandFenceArm::ver::new(fence);
+
+        let event_index = owners.event_control.next_index();
+        if !self.event.try_finish(event_index)? {
+            return Err(EBUSY);
+        }
+        if owners.event_control.advance_index() != event_index {
+            return Err(EIO);
+        }
+        self.event.bind_inflight(event_index, arm.fence())?;
+
+        let sku_index = match self.sku.select_and_bind(arm.fence()) {
+            Ok(index) => index,
+            Err(err) => {
+                self.event.rollback_bound(event_index);
+                return Err(err);
+            }
+        };
+
+        Ok((arm, event_index, sku_index))
+    }
+
+    /// Release both bindings of a command that never reached firmware.
+    pub(super) fn rollback(&mut self, event_index: usize, sku_index: usize) {
+        self.event.rollback_bound(event_index);
+        self.sku.rollback_bound(sku_index);
+    }
+
+    pub(super) fn scrub_completed(&mut self) {
+        self.sku.scrub_completed();
+    }
+}
