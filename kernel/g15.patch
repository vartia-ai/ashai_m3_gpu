+#[versions(AGX)]
+#[allow(dead_code)]
+impl super::QueueInner::ver {
+    /// Assemble one channel for `profile`, in the Compute channel's order:
+    /// UMA pool selection, global channel-resource selection, channel-state
+    /// initialization, channel owners, retirement guards.
+    ///
+    /// `render_uma_backing` is the VM's render UMA pool heap; required for
+    /// a `RenderPool` profile, `None` otherwise.
+    pub(super) fn g15_assemble_pipe_channel(
+        &self,
+        gpu: &gpu::GpuManager::ver,
+        profile: &G15PipeProfile,
+        render_uma_backing: Option<&Arc<Mutex<alloc::DefaultAllocator>>>,
+    ) -> Result<G15PipeChannelParts::ver> {
+        #[ver(G != G15)]
+        {
+            let _ = (gpu, profile, render_uma_backing);
+            return Err(EINVAL);
+        }
+
+        #[ver(G == G15)]
+        {
+            profile.validate()?;
+            let container = self._g15_uma_shared_pools.as_ref().ok_or(EINVAL)?;
+            let range5_cached = self._g15_range5_cached.as_ref().ok_or(EINVAL)?;
+            let range5_backing = self._g15_range5_prime_ppl308.as_ref().ok_or(EINVAL)?;
+            let range5_uncached = self._g15_range5_uncached.as_ref().ok_or(EINVAL)?;
+            let bank1 = self._g15_shared_bank1.as_ref().ok_or(EINVAL)?.clone();
+            let mapping_notifier = self
+                ._g15_mapping_notifier
+                .as_ref()
+                .ok_or(EINVAL)?
+                .clone();
+            crate::debug::g15_stage(format_args!(
+                "assemble {:?}: profile validated, arenas resolved; UMA pool select/create next",
+                profile.pipe
+            ))?;
+
+            // Pool selection/replacement is one client-container transaction.
+            // A reused pool consumes no new identity; a replacement consumes the
+            // next device-global identity before FList construction, as Apple.
+            let pool = match profile.uma {
+                G15PipeUmaSource::SharedComputePool => Some(gpu.g15_select_or_create_compute_pool(
+                    container,
+                    range5_cached,
+                    range5_backing,
+                    bank1.clone(),
+                    mapping_notifier.clone(),
+                )?),
+                G15PipeUmaSource::None => None,
+                G15PipeUmaSource::RenderPool { .. } => Some(gpu.g15_select_or_create_render_pool(
+                    container,
+                    profile.uma_priority_class,
+                    profile.uma.render_population().ok_or(EINVAL)?,
+                    range5_cached,
+                    render_uma_backing.ok_or(EINVAL)?,
+                    bank1.clone(),
+                    mapping_notifier.clone(),
+                )?),
+            };
+            crate::debug::g15_stage(format_args!(
+                "assemble {:?}: UMA pool selected/created ({})",
+                profile.pipe,
+                pool.is_some()
+            ))?;
+
+            // Exact AGXChannel::init() releases the shared-container selection
+            // lock before continuing with channel-local resources. `pool` now
+            // owns the modeled direct/active reference while this allocation
+            // proceeds independently. E153 acquires and initializes the three
+            // real accelerator-global selected resources here, at channel
+            // lifetime, using the already-initialized Queue timestamp/scheduler
+            // leases. Any later failure drops all three selections.
+            let fw_channel_resources = gpu.g15_select_channel_resources()?;
+            crate::debug::g15_stage(format_args!(
+                "assemble {:?}: fw channel resources selected",
+                profile.pipe
+            ))?;
+            let queue_resources = self._g15_fw_queue_resources.as_ref().ok_or(EIO)?;
+            let initialized_channel_resources = match profile.channel {
+                // E154: QueueInfo +0x50 is the owning process identity and the
+                // normal non-foreground updatePriority() branch selects
+                // effective type 2, for which chooseCLWorkQueue() supplies
+                // literal QoS 2. Linux has no IOGPU foreground entitlement
+                // model, so this stays fail-closed to that profile.
+                // R36 controlled replay: the successful early-native capture
+                // publishes process identity 0x120 in the selected QueueInfo.
+                G15PipeChannelInit::J615Cl => fw_channel_resources.initialize_j615_cl(
+                    queue_resources,
+                    0x120,
+                    fw::workqueue::G15_J615_NONFOREGROUND_EFFECTIVE_PRIORITY,
+                    fw::workqueue::G15_J615_NONFOREGROUND_CL_QOS_ARGUMENT,
+                    self.g15_transport_priority,
+                )?,
+                G15PipeChannelInit::Explicit(image) => {
+                    crate::debug::g15_stage(format_args!(
+                        "assemble {:?}: channel image pid {} +0xac {} ring {} prio {:x?}",
+                        profile.pipe,
+                        self._g15_owner_pid,
+                        image.byte_ac,
+                        image.ring_size_50,
+                        image.priority
+                    ))?;
+                    // Channel-state +0x50 is the owning process identity
+                    // (Apple: IOGPUDevice +0x60, proc_pid). The profile's
+                    // value is the native client's pid (282 in
+                    // capture-triangle-1), evidence only; Linux derives it
+                    // from this client, captured at DRM file open.
+                    let mut image = image;
+                    image.owner_pid_50 = self._g15_owner_pid;
+                    fw_channel_resources.initialize_j615_pipe(queue_resources, &image)?
+                }
+            };
+            crate::debug::g15_stage(format_args!(
+                "assemble {:?}: channel resources initialized",
+                profile.pipe
+            ))?;
+            let firmware_state_fwva: u64 = match profile.firmware_state {
+                G15FirmwareStateSlice::Vertex => {
+                    gpu.initdata.runtime_pointers.g15_stats_vtx.weak_pointer().into()
+                }
+                G15FirmwareStateSlice::Fragment => {
+                    gpu.initdata.runtime_pointers.g15_stats_frag.weak_pointer().into()
+                }
+                G15FirmwareStateSlice::Compute => {
+                    gpu.initdata.runtime_pointers.g15_stats_comp.weak_pointer().into()
+                }
+            };
+            let owners = {
+                let mut range5_uncached = range5_uncached.lock();
+                G15PipeChannelOwners::new(
+                    &self.dev,
+                    profile,
+                    firmware_state_fwva,
+                    initialized_channel_resources,
+                    &mut range5_uncached,
+                    bank1,
+                    mapping_notifier,
+                )?
+            };
+            crate::debug::g15_stage(format_args!("assemble {:?}: owners built", profile.pipe))?;
+            let guards = G15PipeGuards::ver::new(profile)?;
+            crate::debug::g15_stage(format_args!("assemble {:?}: guards built", profile.pipe))?;
+
+            Ok(G15PipeChannelParts::ver {
+                owners,
+                guards,
+                fw_channel_resources,
+                pool,
+            })
+        }
+    }
+}
