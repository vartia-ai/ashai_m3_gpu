+/// Parse `blob` straight into a heap profile, never a by-value one: the
+/// profile is ~3 KiB.
+#[inline(never)]
+fn parse_kernel_profile(blob: &[u8]) -> Result<KBox<G15KernelProfile>> {
+    let mut p = KBox::write(KBox::new_uninit(GFP_KERNEL)?, G15KernelProfile::blank());
+    p.parse_into(blob)?;
+    Ok(p)
+}
