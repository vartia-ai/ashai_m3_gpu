+/// Narrow read token: completion keeps the same resources alive; consuming
+/// this extra Arc at the first callback does not move or unmap a payload.
+#[versions(AGX)]
+#[allow(dead_code)]
+pub(super) struct G15SelectedPayloadSnapshot {
+    done: Arc<Mutex<Option<G15RenderPairFinal::ver>>>,
+    prepared: G15PreparedPayloadSnapshot,
+}
