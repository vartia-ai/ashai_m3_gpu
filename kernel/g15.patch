+//! G15 per-pipe channel transport and pools.
+//!
+//! The R47 Compute channel owns a selected firmware channel (channel state,
+//! uncached and cached channel memory), 36 event-control states with their
+//! stamps, a rotating SKU slot pool, a HWMetrics ring, an optional
+//! channel-command resource and a UMA (FList) lease. This module holds those
+//! pieces in pipe-generic form, parameterized by a [`G15PipeProfile`].
+//!
+//! The Compute channel in `mod.rs` is built from these same pieces with
+//! [`G15PipeProfile::J615_COMPUTE`], which carries the exact values the
+//! Compute path used before this split. TA (Vertex) and 3D (Fragment)
+//! channels use [`G15RenderChannel`], whose profile values come from the
+//! native render capture (I03) and are not known yet.
+
+use kernel::dma_fence::*;
+use kernel::prelude::*;
+use kernel::{
+    new_mutex,
+    sync::{
+        Arc,
+        Mutex, //
+    },
+};
+
+use crate::driver::{AsahiDevRef, AsahiDevice};
+use crate::fw::types::*;
+use crate::{
+    alloc,
+    buffer,
+    channel::PipeType,
+    fw,
+    gpu,
+    mmu,
+    workqueue, //
+};
