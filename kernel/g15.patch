+                let mut vas = KVec::with_capacity(fixed.len(), GFP_KERNEL)?;
+                let mut res = KVec::with_capacity(fixed.len(), GFP_KERNEL)?;
+                for (index, mut r) in core::mem::take(&mut fixed).into_iter() {
+                    r.zero_with_stores()?;
+                    vas.push((index, r.gpu_va(), r.len()), GFP_KERNEL)?;
+                    res.push(r, GFP_KERNEL)?;
+                }
+                let res = KBox::pin_init(new_mutex!(res, "g15_persistent_fixed"), GFP_KERNEL)?;
+                let p = Arc::new(G15PersistentFixed { vas, _res: res }, GFP_KERNEL)?;
+                windows.persistent_fixed = Some(p.clone());
+                persistent = Some(p);
+            }
+        }
+        g15_stage(format_args!("prepare: all fixed sections placed; TA channel ensure next"))?;
+        let ta = super::g15_channel::G15RenderChannel::ver::ensure(
+            self,
+            gpu,
+            &kp.pipe(PipeType::Vertex)?,
+        )?;
+        g15_stage(format_args!("prepare: TA channel ensured"))?;
+        let frag = super::g15_channel::G15RenderChannel::ver::ensure(
+            self,
+            gpu,
+            &kp.pipe(PipeType::Fragment)?,
+        )?;
+        g15_stage(format_args!("prepare: 3D channel ensured; prepare done"))?;
+        Ok(G15PreparedRender::ver {
+            profile,
+            channels: [ta, frag],
+            fixed,
+            persistent,
+        })
+        }
+    }
+
+    /// I09 R1 (HYBRID render): `[base, base + G15_HYBRID_VDM_SPAN)` must be
+    /// 4-byte aligned at `base`, inside the user part of the render-context
+    /// aperture (from `DRM_ASAHI_G15_RENDER_CONTEXT_USER_START`), clear of
+    /// the VM's kernel range and of its native VA windows (those created and
+    /// those `kp` will create), and in VM_BIND READ mappings: the I05 K3
+    /// checks. EINVAL otherwise. Like K3, it does not check what the stream
+    /// addresses, and a racing unbind can still remove it after the check.
+    /// Not inlined.
+    #[inline(never)]
+    fn g15_check_user_vdm(&self, kp: &G15KernelProfile, base: u64) -> Result {
+        let range = base..base.checked_add(G15_HYBRID_VDM_SPAN).ok_or(EINVAL)?;
+        // I09 R8: the user part of the aperture, as GET_PARAMS advertises.
+        let ok = base & 3 == 0
+            && uapi::DRM_ASAHI_G15_RENDER_CONTEXT_USER_START as u64 <= range.start
+            && range.end <= G15_RENDER_CONTEXT.end
+            && self.g15_user_range_ok(kp, &range, false)?;
+        if !ok {
+            dev_err!(
+                self.dev.as_ref(),
+                "G15 I09: user VDM stream {:#x}..{:#x} is not a VM_BIND READ mapping in the render context aperture\n",
+                range.start,
+                range.end
+            );
+            return Err(EINVAL);
+        }
+        Ok(())
+    }
+
+    /// I09 R5 (HYBRID render with a user render target): `[base, base +
+    /// size)` must be clear of the VM's kernel range and of its native VA
+    /// windows (those created and those `kp` will create), and in VM_BIND
+    /// READ|WRITE mappings (the user range or the USC window). The command
+    /// parser already checked alignment and size. EINVAL otherwise. As for
+    /// the VDM stream, what the payload writes is not checked, and a racing
+    /// unbind can still remove the target after the check. Not inlined.
+    #[inline(never)]
+    fn g15_check_user_rt(&self, kp: &G15KernelProfile, base: u64, size: u64) -> Result {
+        let range = base..base.checked_add(size).ok_or(EINVAL)?;
+        if !self.g15_user_range_ok(kp, &range, true)? {
+            dev_err!(
+                self.dev.as_ref(),
+                "G15 I09: user render target {:#x}..{:#x} is not a VM_BIND READ|WRITE mapping outside the kernel VAs\n",
+                range.start,
+                range.end
+            );
+            return Err(EINVAL);
+        }
+        Ok(())
+    }
+
+    /// The I05 K3 checks shared by the HYBRID user ranges: `range` lies
+    /// clear of the profile's native VA windows and the VM's kernel VAs and
+    /// is bound READ (`writable`: READ|WRITE) throughout. Not inlined.
+    #[inline(never)]
+    fn g15_user_range_ok(
+        &self,
+        kp: &G15KernelProfile,
+        range: &Range<u64>,
+        writable: bool,
+    ) -> Result<bool> {
+        #[ver(G != G15)]
+        {
+            let _ = (kp, range, writable);
+            return Err(ENODEV);
+        }
+
+        #[ver(G == G15)]
+        {
+            let overlaps = |r: &Range<u64>| range.start < r.end && r.start < range.end;
+            if kp.windows().iter().any(|w| overlaps(&(w.start..w.end))) {
+                return Ok(false);
+            }
+            let windows = self.inner.g15_render_windows.as_ref().ok_or(EINVAL)?;
+            if !windows.lock().outside_kernel_vas(range) {
+                return Ok(false);
+            }
+            if writable {
+                self.vm.user_range_writable(range.clone())
+            } else {
+                self.vm.user_range_readable(range.clone())
+            }
+        }
+    }
+}
+
+#[versions(AGX)]
+// G15-only; the other generations compile it without a caller.
+#[allow(dead_code)]
+impl super::QueueInner::ver {
+    /// Build one G15 user render into `job` (see the module documentation).
+    pub(super) fn g15_submit_user_render(
+        &mut self,
+        vm: &mmu::Vm,
+        job: &mut Job<super::QueueJob::ver>,
+        gpu: &gpu::GpuManager::ver,
+        user: &G15UserRender,
+        prepared: G15PreparedRender::ver,
+        id: u64,
+    ) -> Result {
+        #[ver(G != G15)]
+        {
+            let _ = (vm, job, gpu, user, prepared, id);
+            return Err(ENODEV);
+        }
+
+        #[ver(G == G15)]
+        {
+            let _m_fn = G15StageMark("submit fn locals all dropped (channel refs, profile)");
+            let G15PreparedRender::ver {
+                profile: kernel_profile,
+                channels: [ta_channel, frag_channel],
+                fixed,
+                persistent,
+            } = prepared;
+            let kp: &G15KernelProfile = &kernel_profile;
+            // One read of each switch for the whole submit: they decide both
+            // the evidence-only/TRIAL bypass and the publication decision
+            // below, so neither can change mid-submit.
+            let dry_run = *module_parameters::g15_render_dry_run.value() != 0;
+            let trial_enabled = *module_parameters::g15_render_trial.value() != 0;
+            let profile = render_profile(kp, dry_run, trial_enabled)?;
+            if let Some(b) = kp.trial_binding() {
+                // `b` is a core::fmt::Display (render_profile.rs is host-built).
+                dev_info!(self.dev.as_ref(), "G15 render TRIAL {}\n", format_args!("{}", b));
+            }
+            profile.validate()?;
+            g15_stage(format_args!("submit: entry, profile rendered and validated"))?;
+            // Program/USC addresses are offsets from the range-5 base
+            // (0x100_0000_0000); VDM/TVB use their own range-1 window base,
+            // which only the profile's relocations name.
+            if self.usc_exec_base != mmu::G15_GART_RANGE5.start {
+                return Err(EINVAL);
+            }
+            // K7: waits while any other G15 job is in flight. A job's
+            // completion clears this queue's `busy` before it frees the slot,
+            // so the check after the wait fails only on a lost guard.
+            job.g15_job_slot = Some(G15JobSlot::acquire(&self.dev, self.g15_vm_id)?);
+            g15_wait_retire_age();
+            let t_slot = g15_now_ns();
+            if self.g15_user_status.busy.load(Ordering::Acquire) {
+                return Err(EBUSY);
+            }
+            g15_stage(format_args!("submit: job slot acquired"))?;
+
+            let dev: &AsahiDevice = &self.dev;
+            let _m_windows = G15StageMark("VA windows ref dropped");
+            let windows_owner = self.g15_render_windows.as_ref().ok_or(EINVAL)?.clone();
+            let mut windows = windows_owner.lock();
+            windows.ensure(dev, vm, kp.windows())?;
+            windows.collect_garbage();
+            g15_stage(format_args!("submit: VA windows ensured, garbage collected"))?;
+            let heaps = G15RenderHeaps {
+                dev,
+                range5_code: &self._g15_range5_code,
+                range5_ppl308: &self._g15_range5_ppl308,
+                range5_uncached: &self._g15_range5_uncached,
+                range5_cached: &self._g15_range5_cached,
+                range5_prime_code: &self._g15_range5_prime_code,
+                range5_prime_ppl308: &self._g15_range5_prime_ppl308,
+                bank1: &self._g15_shared_bank1,
+                mapping_notifier: &self._g15_mapping_notifier,
+                windows: &windows.windows,
+                vm: Some(vm),
+            };
+
+            Self::g15_render_queue_state(
+                &mut self.g15_render_queue,
+                &self.buffer,
+                &(*self.dev).g15_pb_slots,
+                &heaps,
+                kp,
+            )?;
+            let _m_queue_res = G15StageMark("queue resources ref dropped (queue keeps them)");
+            let queue_res = self.g15_render_queue.as_ref().ok_or(EIO)?.res.clone();
+            g15_stage(format_args!("submit: queue resources ready"))?;
+
+            // Breadcrumb slot: declared here so it drops where the mark
+            // always did; the stage arms it right before the allocation.
+            let mut _m_res = None;
+            let mut res = Self::g15_pass_resources(
+                &mut self.g15_last_render_target,
+                &heaps,
+                &queue_res,
+                kp,
+                user,
+                &mut _m_res,
+            )?;
+            g15_stage(format_args!("submit: pass resources built"))?;
+            // I09 R5: no driver-owned target for a user render target.
+            let rt = res.render_target();
+            if let Some(rt) = rt.as_ref() {
+                if rt.bytes_per_row() as usize != user.stride()
+                    || rt.height() != u32::from(user.height())
+                {
+                    return Err(EINVAL);
+                }
+            }
+
+            // W9 sections: place all (they may point at each other), then
+            // copy and relocate each into its allocation. Fixed sections were
+            // mapped at their native VA before anything else.
+            let sections = user.sections();
+            let mut section_vas = KVec::with_capacity(sections.len(), GFP_KERNEL)?;
+            let mut payload_index = KVec::with_capacity(sections.len(), GFP_KERNEL)?;
+            let _m_fixed = G15StageMark("unadopted fixed sections dropped");
+            Self::g15_place_sections(
+                &mut res,
+                &heaps,
+                kp,
+                user,
+                fixed,
+                persistent.as_deref(),
+                &mut section_vas,
+                &mut payload_index,
+            )?;
+            // F2 discriminator (`g15_evict_kib`): write this much unrelated
+            // kernel memory before publish (cache pressure only).
+            // F2 diagnostic (`g15_retire_trace`): what firmware-shared state
+            // changes in the 300 us after the previous job completed.
+            if *module_parameters::g15_retire_trace.value() != 0 {
+                static N: core::sync::atomic::AtomicU32 = core::sync::atomic::AtomicU32::new(0);
+                if N.fetch_add(1, Ordering::Relaxed) < 24 {
+                    let mut a = KVec::new();
+                    let mut b = KVec::new();
+                    gpu.g15_retire_words(&mut a)?;
+                    for step in 0..6 {
+                        kernel::time::delay::udelay(kernel::time::Delta::from_micros(50));
+                        b.clear();
+                        gpu.g15_retire_words(&mut b)?;
+                        for (i, (x, y)) in a.iter().zip(b.iter()).enumerate() {
+                            if x != y {
+                                dev_info!(self.dev.as_ref(), "G15 retire job={} +{}us word {} ({}): {:#x} -> {:#x}\n",
+                                    id, 50 * (step + 1), i,
+                                    if i < 0x154 { "q22" } else { "q4" }, x, y);
+                            }
+                        }
+                        core::mem::swap(&mut a, &mut b);
+                    }
+                }
+            }
+            // `g15_pre_delay_us`: the same position, time only (no memory).
+            let us = (*module_parameters::g15_pre_delay_us.value()).min(10_000);
+            if us != 0 {
+                kernel::time::delay::udelay(kernel::time::Delta::from_micros(us.into()));
+            }
+            let kib = (*module_parameters::g15_evict_kib.value()).min(65536) as usize;
+            if kib != 0 {
+                let mut scratch = KVVec::<u8>::with_capacity(kib * 1024, GFP_KERNEL)?;
+                scratch.resize(kib * 1024, 0x5a, GFP_KERNEL)?;
+                for (i, b) in scratch.iter_mut().enumerate().step_by(64) {
+                    // SAFETY: a valid exclusive reference.
+                    unsafe { core::ptr::write_volatile(b, i as u8) };
+                }
+            }
+            if let Some(p) = persistent {
+                // F2 split: mode 2 still clears them each pass, here under
+                // the device slot, after the previous job retired.
+                if *module_parameters::g15_persist_fixed.value() == 2 {
+                    p.clear()?;
+                }
+                res.hold_persistent_fixed(p);
+            }
+            let rt_va = res.render_target_va();
+            let payload = Self::g15_relocate_sections(
+                &mut res,
+                user,
+                &section_vas,
+                &payload_index,
+                rt_va,
+            )?;
+
+            // GPU timing record (TA +0x8b0, 3D +0xbf8/+0xc00): owned here,
+            // per pass, zeroed, placed by the profile; kept until both
+            // commands retired.
+            let _m_timing = G15StageMark("timing record dropped");
+            let timing = self.g15_render_queue.as_ref().ok_or(EIO)?.timing.clone();
+            g15_stage(format_args!("submit: timing record at {:#x}", timing.gpu_va()))?;
+            core::mem::drop(windows);
+
+            // W5 phase 1: one lease set per pipe, each arming one fence
+            // reference and taking the pipe's UMA reference, in
+            // publication order (native takes the 3D reference first).
+            // W8f: taking the reference does not write the shared pool's
+            // coherency epoch; `QueueJob::run` writes it per command just
+            // before that command's publication, so a dry run or a submit
+            // that fails before publication leaves it untouched.
+            let new_leases = |channel: &Arc<Mutex<Option<super::g15_channel::G15RenderChannel::ver>>>,
+                              name: &str| {
+                // The box first, so that no allocation can fail once the
+                // leases are armed.
+                let slot = KBox::new_uninit(GFP_KERNEL)?;
+                let l = KBox::write(
+                    slot,
+                    super::g15_channel::G15RenderJobLeases::ver::new(channel.clone(), &job.fence)?,
+                );
+                // A stop here drops `l`, which aborts the lease.
+                g15_stage(format_args!("submit: {} leases taken", name))?;
+                Ok::<_, Error>(l)
+            };
+            let _m_leases = G15StageMark("both lease sets dropped (aborted)");
+            let (ta_leases, frag_leases) = match G15_RENDER_PUBLISH_ORDER {
+                G15RenderPublishOrder::FragmentFirst => {
+                    let frag = new_leases(&frag_channel, "3D")?;
+                    (new_leases(&ta_channel, "TA")?, frag)
+                }
+                G15RenderPublishOrder::TaFirst => {
+                    let ta = new_leases(&ta_channel, "TA")?;
+                    (ta, new_leases(&frag_channel, "3D")?)
+                }
+            };
+            // Breadcrumb slot, armed by the stage (see `_m_res`).
+            let mut _m_pair = None;
+            let (pair, tables, [ta_sku, frag_sku]) = self.g15_build_render_pair(
+                job,
+                gpu,
+                kp,
+                &profile,
+                &res,
+                &queue_res,
+                &timing,
+                (&ta_leases, &frag_leases),
+                &payload,
+                user.user_regs(),
+                &mut _m_pair,
+            )?;
+            let vm_slot = job.vm_bind.slot();
+            g15_stage(format_args!(
+                "submit: commands built (TA {:#x} 3D {:#x})",
+                pair.ta.command_fwva, pair.frag.command_fwva
+            ))?;
+            // W5 phase 2: the SKU streams embed the command FWVAs.
+            let mut ta_leases = ta_leases;
+            let mut frag_leases = frag_leases;
+            if pair.ta.sku_fwva != ta_sku || pair.frag.sku_fwva != frag_sku {
+                return Err(EIO);
+            }
+            ta_leases.write_sku(&pair.ta.sku)?;
+            g15_stage(format_args!("submit: TA SKU written"))?;
+            frag_leases.write_sku(&pair.frag.sku)?;
+            g15_stage(format_args!("submit: 3D SKU written"))?;
+
+            let payload_dump_enabled = *module_parameters::g15_render_dump.value() != 0
+                && *module_parameters::g15_render_payload_dump.value() != 0;
+            let mut dump_ta_command = None;
+            if dry_run || *module_parameters::g15_render_dump.value() != 0 {
+                dump_ta_command = Some(self.g15_dump_render(id, &pair, &tables, &queue_res)?);
+            }
+            g15_stage(format_args!("submit: built; dry-run cancel/publish decision next"))?;
+            if !kp.may_publish(dry_run, trial_enabled) {
+                // Nothing reached a firmware-visible ring or table. Dropping
+                // the leases aborts them and releases their fence references.
+                // An evidence-only profile, or a TRIAL one without the trial
+                // switch, can only reach this point in a dry run; this test
+                // also keeps them from ever publishing.
+                crate::debug::g15_trace(format_args!("submit: dry-run cancel, rollback begins"));
+                return Err(ECANCELED);
+            }
+            let prepared_payload = if payload_dump_enabled {
+                let p = G15PreparedPayloadSnapshot::new(&res, user, &payload_index,
+                    id, vm_slot, pair.ta.command_fwva, pair.frag.command_fwva)?;
+                super::g15_render::G15RenderDump::reserve_selected(
+                    &mut *self.dev.g15_render_last.lock(), p.ta, p.bytes.len() - 16)?;
+                Some(p)
+            } else { None };
+            if *module_parameters::g15_render_dump.value() != 0 {
+                gpu.g15_recovery_snapshot("before render publish");
+            }
+            // F2 experiment (`g15_min_gap_us`): publish no sooner than this
+            // long after the previous render job finished.
+            // Capped at 10 ms: the wait busy-loops in the submit ioctl.
+            let gap = u64::from((*module_parameters::g15_min_gap_us.value()).min(10_000)) * 1000;
+            if gap != 0 {
+                let ready = G15_T_LAST_FIN.load(Ordering::Acquire).saturating_add(gap);
+                let now = g15_now_ns();
+                if ready > now {
+                    kernel::time::delay::udelay(kernel::time::Delta::from_micros(
+                        (ready - now).div_ceil(1000) as i64,
+                    ));
+                }
+            }
+            Self::g15_publish_render_state(
+                &mut self.g15_render_queue,
+                gpu,
+                &queue_res,
+                &ta_channel,
+                &frag_channel,
+            )?;
+            let t_pub = g15_now_ns();
+            let c_pub = g15_cntvct();
+
+            let ta_slot: G15RenderLeaseSlot::ver = arc_mutex(
+                Some(ta_leases),
+                kernel::c_str!("g15_render_ta_leases"),
+                kernel::static_lock_class!(),
+            )?;
+            let frag_slot: G15RenderLeaseSlot::ver = arc_mutex(
+                Some(frag_leases),
+                kernel::c_str!("g15_render_frag_leases"),
+                kernel::static_lock_class!(),
+            )?;
+            let reservation = gpu::G15SubmissionReservation::new()?;
+            // W8f: `busy` is set from here on. The guard lives in the pair
+            // state the completion callbacks share; if the job fails or is
+            // dropped before both callbacks ran, the pair state drops and
+            // the guard clears `busy` again.
+            // I09 R5 (the I05 K4 analogue): a user render target has no
+            // kernel output; completion is the fence's alone, so READBACK
+            // returns nothing for it.
+            let output_size = if rt.is_some() { user.target_size() as u32 } else { 0 };
+            let user_busy = G15UserBusy::arm(&self.g15_user_status, output_size)?;
+            // G2 workaround: what the relinker reads and writes for this pass.
+            // Enabled but unbuildable fails the submit here, before anything
+            // is published, rather than silently skipping the relink.
+            let relink = if g15_relink_wanted(user) {
+                let [tilemap, tpc] = res.relink_views().ok_or(EINVAL)?;
+                let blocks = res.queue().tvb().views();
+                let arena = res.queue().tvb().arena_views();
+                if blocks.is_empty() || arena.is_empty() {
+                    return Err(EINVAL);
+                }
+                Some(KBox::new(
+                    super::g15_relink::G15RelinkPlan { tilemap, tpc, blocks, arena },
+                    GFP_KERNEL,
+                )?)
+            } else {
+                None
+            };
+            // C53: cache every possible TVB leaf PTE before either pipe is
+            // published. The mappings cannot change while this job retains
+            // VmBind; finish() later reads TPC and selects the consumed page.
+            let tvb_pa_probe = {
+                let limit = u64::from((*module_parameters::g15_tvb_pa_probe.value()).min(8));
+                if limit != 0 && G15_TVB_PA_PROBE_JOBS.fetch_add(1, Ordering::Relaxed) < limit {
+                    let [_, tpc] = res.relink_views().ok_or(EINVAL)?;
+                    let blocks = res.queue().tvb().views();
+                    if blocks.is_empty() {
+                        return Err(EINVAL);
+                    }
+                    let page_count = blocks.len().checked_mul(2).ok_or(EOVERFLOW)?;
+                    let mut pages = KVec::with_capacity(page_count, GFP_KERNEL)?;
+                    for block in blocks.iter() {
+                        if block.gpu & mmu::UAT_PGMSK as u64 != 0
+                            || block.len % mmu::UAT_PGSZ != 0
+                        {
+                            return Err(EINVAL);
+                        }
+                        for off in (0..block.len).step_by(mmu::UAT_PGSZ) {
+                            let page = block.gpu.checked_add(off as u64).ok_or(EOVERFLOW)?;
+                            let (pte, phys) = job.vm_bind.leaf_pte(page)?.ok_or(EIO)?;
+                            pages.push((page, pte, phys), GFP_KERNEL)?;
+                        }
+                    }
+                    Some(G15TvbPaProbe { tpc, pages })
+                } else {
+                    None
+                }
+            };
+            let done = arc_mutex(
+                Some(G15RenderPairFinal::ver {
+                    dev: self.dev.clone(),
+                    job_id: id,
+                    remaining: 2,
+                    error: None,
+                    ta_complete: 0,
+                    frag_complete: 0,
+                    t: [G15_T_SUBMIT_IN.load(Ordering::Relaxed), t_slot, t_pub, 0, 0],
+                    c: [c_pub, 0, 0],
+                    frag_tvb_overflow: 0,
+                    frag_partials: 0,
+                    dump_ta_command,
+                    user_busy: Some(user_busy),
+                    job_slot: job.g15_job_slot.take(),
+                    reservation: reservation.clone(),
+                    fence: job.fence.clone(),
+                    channels: [ta_channel, frag_channel],
+                    timing,
+                    snapshot_buffer: self.buffer.clone(),
+                    tvb_pa_probe,
+                    _resources: res,
+                }),
+                kernel::c_str!("g15_render_pair"),
+                kernel::static_lock_class!(),
+            )?;
+
+            let payload_snapshot = prepared_payload.map(|prepared| G15SelectedPayloadSnapshot::ver {
+                done: done.clone(), prepared,
+            });
+            job.g15_serial_job = relink.is_some()
+                || *module_parameters::g15_render_serial.value() != 0;
+            job.g15_relink_job = relink.is_some();
+            Self::g15_queue_render_commands(job, vm_slot, pair, done, &ta_slot, &frag_slot)?;
+            job.g15_render_payload_snapshot = payload_snapshot;
+            job.g15_relink = relink;
+
+            job.g15_render_leases = Some([ta_slot, frag_slot]);
+            job.g15_render_dump_ta = dump_ta_command;
+            job.g15_submission = Some(reservation);
+            self.g15_last_render_target = rt;
+            Ok(())
+        }
+    }
+}
+
+/// Stages of `g15_submit_user_render`, each run once in its order. Not
+/// inlined: their temporaries stay out of the submit frame, which is live
+/// down to the allocators. Locals with an observable drop (breadcrumb marks,
+/// GPU resources) stay in the caller, so the rollback order is unchanged.
+#[versions(AGX)]
+// G15-only; the other generations compile it without a caller.
+#[allow(dead_code)]
+impl super::QueueInner::ver {
+    /// W6 per-queue objects, built once; a later submit must carry the same
+    /// queue-scoped profile.
+    #[inline(never)]
+    fn g15_render_queue_state(
+        state: &mut Option<G15QueueRenderState>,
+        buffer: &crate::buffer::Buffer::ver,
+        pb_slots: &G15PbSlotAllocator,
+        heaps: &G15RenderHeaps<'_>,
+        kp: &G15KernelProfile,
+    ) -> Result {
+        match state.as_ref() {
+            Some(state) if state.key != kp.queue_key() => return Err(EBUSY),
+            Some(_) => {}
+            None => {
+                g15_stage(format_args!("submit: building queue resources"))?;
+                // The profile view (~570 bytes) stays off the stack.
+                let profile = KBox::write(KBox::new_uninit(GFP_KERNEL)?, kp.queue_resources());
+                let res =
+                    G15RenderQueueResources::new(heaps, pb_slots, buffer.info_fwva(), &profile)?;
+                // BufferInfo names the native TVB blocks by page ID,
+                // with the profile's max_blocks and page_list_size, and
+                // +0x1c points at the queue's TVB page list (RESOURCE
+                // 12), which `res` keeps alive for every pass.
+                g15_stage(format_args!("submit: queue resources built"))?;
+                let (max_blocks, page_list_size) = kp.buffer_info_limits()?;
+                buffer.g15_install_native_blocks(
+                    res.tvb().ids(),
+                    max_blocks,
+                    page_list_size,
+                    res.tvb().page_list(),
+                )?;
+                g15_stage(format_args!("submit: BufferInfo native TVB blocks installed"))?;
+                let w = buffer.g15_info_words();
+                pr_info!("G15 BufferInfo after install: {:x?}\n", &w[..]);
+                // C9 (`g15_fw_sched_probe=2`): the page list as the GPU will
+                // first see it, before any TA publication of this queue.
+                if *module_parameters::g15_fw_sched_probe.value() == 2 {
+                    if let Some(list) = res.tvb().page_list_bytes() {
+                        g15_page_list_rows("pre", list);
+                    }
+                }
+                let timing = Arc::new(G15RenderTimingRecord::new(heaps, &kp.timing_record())?, GFP_KERNEL)?;
+                *state = Some(G15QueueRenderState {
+                    timing,
+                    key: kp.queue_key(),
+                    res,
+                    pb_published: false,
+                });
+            }
+        }
+        Ok(())
+    }
+
+    /// Release the previous render target, then allocate this pass's
+    /// resources. The caller's `m_res` breadcrumb slot is armed right before
+    /// the allocation, where the submit declared it.
+    #[inline(never)]
+    fn g15_pass_resources(
+        last_render_target: &mut Option<Arc<G15RenderTargetBo>>,
+        heaps: &G15RenderHeaps<'_>,
+        queue_res: &Arc<G15RenderQueueResources>,
+        kp: &G15KernelProfile,
+        user: &G15UserRender,
+        m_res: &mut Option<G15StageMark>,
+    ) -> Result<KBox<G15RenderResources>> {
+        // W6 consistency check only: the profile sizes are what gets
+        // allocated. 32x32 utiles give the smallest tree minimum.
+        // SAFETY: drm_asahi_cmd_render is plain old data (AnyBitPattern).
+        let mut shape: uapi::drm_asahi_cmd_render = unsafe { core::mem::zeroed() };
+        shape.width_px = user.width();
+        shape.height_px = user.height();
+        shape.layers = 1;
+        shape.utile_width_px = 32;
+        shape.utile_height_px = 32;
+        let tile_info = super::QueueInner::ver::get_tiling_params(&shape, 1)?;
+        // The render target sits at its fixed native VA; the previous
+        // pass's target (kept for READBACK) must release that range
+        // first. The previous pass has retired (`busy` is clear).
+        *last_render_target = None;
+        g15_stage(format_args!("submit: previous render target released"))?;
+        *m_res = Some(G15StageMark(
+            "pass resources dropped (payloads incl. fixed, RT, TPC, tilemap, heapmeta, preempt, ctxswitch)",
+        ));
+        // The profile view (~700 bytes) stays off the stack.
+        let profile = KBox::write(KBox::new_uninit(GFP_KERNEL)?, kp.pass_resources());
+        // I09 R5: a user render target replaces the driver-owned one (and
+        // its canary fill); the profile's RESOURCE 10 / VALUE 14 go unused.
+        let target = match user.user_rt() {
+            Some(rt) => G15PassTarget::User(rt.base),
+            None => G15PassTarget::Driver {
+                canary: Some(user.canary()),
+            },
+        };
+        G15RenderResources::new(heaps, queue_res.clone(), &tile_info, &profile, target)
+    }
+
+    /// W9 sections: place all (they may point at each other). Fixed sections
+    /// were mapped at their native VA before anything else and are adopted
+    /// here; one that is not adopted drops on return, as the caller's
+    /// iterator over them did.
+    #[inline(never)]
+    fn g15_place_sections(
+        res: &mut G15RenderResources,
+        heaps: &G15RenderHeaps<'_>,
+        kp: &G15KernelProfile,
+        user: &G15UserRender,
+        fixed: KVec<(usize, G15Resource)>,
+        persistent: Option<&G15PersistentFixed>,
+        section_vas: &mut KVec<u64>,
+        payload_index: &mut KVec<usize>,
+    ) -> Result {
+        let mut fixed = fixed.into_iter().peekable();
+        for (i, s) in user.sections().iter().enumerate() {
+            // F2: a persistent fixed section has no payload of this pass
+            // (index usize::MAX: nothing is written to it).
+            if let Some(&(_, va, _)) = persistent.and_then(|p| p.vas.iter().find(|(fi, _, _)| *fi == i)) {
+                section_vas.push(va, GFP_KERNEL)?;
+                payload_index.push(usize::MAX, GFP_KERNEL)?;
+                continue;
+            }
+            let (index, va) = match fixed.next_if(|(fi, _)| *fi == i) {
+                Some((_, r)) => {
+                    let va = r.gpu_va();
+                    (res.adopt_user_payload(r)?, va)
+                }
+                None => {
+                    let req = kp.placement(s.role, s.len(), s.align);
+                    res.add_user_payload_zeroed(heaps, &req, s.len())?
+                }
+            };
+            section_vas.push(va, GFP_KERNEL)?;
+            payload_index.push(index, GFP_KERNEL)?;
+            g15_stage(format_args!(
+                "submit: section {} ({:?}, {}) placed at {:#x}",
+                i,
+                s.role,
+                if s.fixed { "fixed, adopted" } else { "heap" },
+                va
+            ))?;
+        }
+        if fixed.next().is_some() {
+            return Err(EIO);
+        }
+        Ok(())
+    }
+
+    /// W9 sections: copy and relocate each placed section into its
+    /// allocation.
+    #[inline(never)]
+    fn g15_relocate_sections(
+        res: &mut G15RenderResources,
+        user: &G15UserRender,
+        section_vas: &KVec<u64>,
+        payload_index: &KVec<usize>,
+        render_target: u64,
+    ) -> Result<G15PayloadRefs> {
+        let addresses = RenderAddresses {
+            sections: section_vas,
+            render_target,
+            usc_exec_base: mmu::G15_GART_RANGE5.start,
+        };
+        for (section, &index) in payload_index.iter().enumerate() {
+            if index == usize::MAX {
+                // F2: persistent, already clear.
+                continue;
+            }
+            if user.sections_zeroed() && *module_parameters::g15_legacy_relocate.value() == 0 {
+                // R9 built-in sections are all zero. Clear in place: a split
+                // placement's staging copy cost ~250 us per render (F1).
+                // Not skippable: without this second write the firmware
+                // crashed after ~4,000 mixed renders (f2ab-ec11d30bf); the
+                // cause (stale GPU writes or write visibility) is open.
+                res.zero_user_payload(index)?;
+            } else {
+                res.write_user_payload(index, |dst| user.apply_section(section, &addresses, dst))?;
+            }
+            // G2: natively the CPU leaves AXFB (0x16461/0x16090, 0x100_0073_8000)
+            // +0x600 = 00 00 00 60 5b 03 00 00; reproducing it was negative
+            // (g2axfbab-114212). DC CVAC of every kernel-written pass input
+            // did not move the per-tile cliff either (g2clean-123544).
+            g15_stage(format_args!(
+                "submit: section {} copied/relocated (scatter if split)",
+                section
+            ))?;
+        }
+        let first = |role: Role| user.find(role).map(|i| section_vas[i]);
+        Ok(G15PayloadRefs {
+            // I09 R1: a HYBRID render has no VDM section.
+            vdm_stream: user.user_vdm().or(first(Role::Vdm)),
+            usc_vertex: first(Role::VsUsc),
+            usc_fragment: first(Role::FsUsc),
+            usc_background: first(Role::BgUsc),
+            usc_eot: first(Role::EotUsc),
+            eot_state_loader: None,
+            pbe_descriptors: first(Role::Pbe),
+            uniforms: first(Role::Uniforms),
+        })
+    }
+
+    /// Read both lease sets, build the engine inputs, then Barrier, 3D,
+    /// InitBuffer and TA (W4). The caller's `m_pair` breadcrumb slot is armed
+    /// right before the build, where the submit declared it. Also returns
+    /// the TA and 3D SKU slot FWVAs of the leases.
+    #[inline(never)]
+    #[allow(clippy::too_many_arguments)]
+    fn g15_build_render_pair(
+        &self,
+        job: &mut Job<super::QueueJob::ver>,
+        gpu: &gpu::GpuManager::ver,
+        kp: &G15KernelProfile,
+        profile: &fw::g15_render::G15RenderProfile<'_>,
+        res: &G15RenderResources,
+        queue_res: &G15RenderQueueResources,
+        timing: &G15RenderTimingRecord,
+        (ta_leases, frag_leases): (
+            &super::g15_channel::G15RenderJobLeases::ver,
+            &super::g15_channel::G15RenderJobLeases::ver,
+        ),
+        payload: &G15PayloadRefs,
+        user_regs: Option<&crate::render_input::G15UserRegFields>,
+        m_pair: &mut Option<G15StageMark>,
+    ) -> Result<(
+        KBox<super::g15_render::G15RenderPair>,
+        KBox<super::g15_render::G15RenderTables>,
+        [u64; 2],
+    )> {
+        #[ver(G != G15)]
+        {
+            let _ = (job, gpu, kp, profile, res, queue_res, timing, ta_leases, frag_leases);
+            let _ = (payload, user_regs, m_pair);
+            return Err(ENODEV);
+        }
+
+        #[ver(G == G15)]
+        {
+            let (tl, fl) = (ta_leases.leases()?, frag_leases.leases()?);
+            g15_stage(format_args!(
+                "submit: leases read (TA sku {:#x} evctl {:#x}; 3D sku {:#x} evctl {:#x})",
+                tl.sku_slot_fwva, tl.evctl_fwva, fl.sku_slot_fwva, fl.evctl_fwva
+            ))?;
+
+            let ev_ta = job.get_vtx()?.event_info();
+            let ev_frag = job.get_frag()?.event_info();
+            let vm_slot = job.vm_bind.slot();
+
+            // Native TA +0x14 and 3D +0x20 name one event-control block for
+            // the pair; use the 3D lease's (3D is published first). TODO(W5):
+            // the TA lease still binds a state of its own.
+            let evctl = fl.evctl_fwva;
+            let ta = engine_inputs(
+                &tl,
+                evctl,
+                ev_ta.stamp_pointer.into(),
+                ev_ta.fw_stamp_pointer.into(),
+                ev_ta.value.next().raw(),
+                ev_ta.slot,
+                ev_ta.event_seq,
+            )?;
+            let frag = engine_inputs(
+                &fl,
+                evctl,
+                ev_frag.stamp_pointer.into(),
+                ev_frag.fw_stamp_pointer.into(),
+                ev_frag.value.next().raw(),
+                ev_frag.slot,
+                ev_frag.event_seq,
+            )?;
+
+            g15_stage(format_args!("submit: engine inputs built"))?;
+            let pm_index = {
+                let current = self
+                    .g15_pm_record_index
+                    .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |c| {
+                        Some(crate::buffer::g15_j615_pm_next_record_index(c))
+                    })
+                    .map_err(|_| EIO)?;
+                crate::buffer::g15_j615_pm_next_record_index(current)
+            };
+            let refs = res.refs();
+            let pm = queue_res.pm();
+            let pass = G15PassRefs {
+                buffer_info: self.buffer.info_fwva(),
+                pm_record: pm.record_va(pm_index),
+                pm_state: refs.pm_state,
+                pm_scene_slice: Some(pm.scene_slice_va(pm_index)?),
+                pm_page_metrics: Some(pm.page_metrics_va(pm_index)),
+                ctxswitch: refs.ctxswitch,
+                ctxswitch_secondary: refs.ctxswitch_secondary,
+                tilemap: refs.tilemap,
+                heapmeta: refs.heapmeta,
+                layermeta: None,
+                tpc: refs.tpc.0,
+                tpc_size: refs.tpc.1 as u64,
+                ta_payload: Some(self.g15_ta_object_payload.gpu_pointer().into()),
+                render_target: refs.render_target,
+                timing_record: timing.gpu_va(),
+                uma_uncached_state: None,
+                stats_ta: gpu.initdata.runtime_pointers.g15_stats_vtx.weak_pointer().into(),
+                stats_frag: gpu.initdata.runtime_pointers.g15_stats_frag.weak_pointer().into(),
+            };
+            // Apple allocates the 3D descriptor before the TA descriptor from
+            // one sequence; the 3D counter is n and TA n + 1.
+            let uuid_frag = common::next_g15_command_uuid();
+            let uuid_ta = common::next_g15_command_uuid();
+            let counter_frag = self.counter.fetch_add(2, Ordering::Relaxed);
+            // I09 R3: USER_REGS register values, written over the profile's
+            // N entries by the builder.
+            let mut user_overrides = user_regs.map(boxed_user_reg_overrides).transpose()?;
+            // Every consumer of the PB descriptor names this queue's leased
+            // slot, as native does (TA 0x1c830 / 3D 0x1c838 here; RunVertex
+            // +0x1c and InitBuffer +0x8 below). The profile has them all 0;
+            // with several clients every queue then read slot 0's descriptor
+            // and the fragment pass used another queue's PB base (the
+            // multi-process faults, tppbfix-191227).
+            {
+                let slot = u64::from(res.refs().pb_slot);
+                let mut v = user_overrides.take().unwrap_or_default();
+                for (engine, reg) in [(fw::g15_render::G15Engine::Ta, 0x1c830u32), (fw::g15_render::G15Engine::Frag, 0x1c838)] {
+                    v.push(
+                        fw::g15_render::G15RegOverride {
+                            reg: fw::g15_render::G15RegRef { engine, reg },
+                            value: slot,
+                            mask: u64::MAX,
+                        },
+                        GFP_KERNEL,
+                    )?;
+                }
+                user_overrides = Some(v);
+            }
+            if user_overrides.is_some() {
+                g15_stage(format_args!(
+                    "submit: R3 user registers on ({} overrides)",
+                    user_overrides.as_ref().map_or(0, |o| o.len())
+                ))?;
+            }
+            let user_partial = user_regs.map_or([None, None], |f| [f.partial_bg, f.partial_eot]);
+            if user_partial.iter().any(Option::is_some) {
+                g15_stage(format_args!(
+                    "submit: partial programs from the command (bg {}, eot {})",
+                    user_partial[0].is_some(),
+                    user_partial[1].is_some()
+                ))?;
+            }
+            let inputs = G15RenderInputs {
+                profile,
+                ta,
+                frag,
+                pass,
+                payload: *payload,
+                id: G15Identity {
+                    counter_frag,
+                    context_id: vm_slot,
+                    ctx_generation: job.vm_bind.generation(),
+                    uuid_ta,
+                    uuid_frag,
+                    // TODO(W1): no Linux producer is known; replay the native
+                    // value from the profile.
+                    // G2 experiment (`g15_submission_tag`, 0: profile value):
+                    // the native x192 tag is 0x1000065 where the profile has 0x1e.
+                    submission_tag: match *module_parameters::g15_submission_tag.value() {
+                        0 => kp.submission_tag()?,
+                        t => u64::from(t),
+                    },
+                },
+                formulas: G15RegFormulas {
+                    pb_slot: Some(refs.pb_slot.into()),
+                    ..Default::default()
+                },
+                user_regs: user_overrides.as_deref().unwrap_or(&[]),
+                user_partial,
+                prelude: Some({
+                    // InitBuffer announces the installed TVB blocks
+                    // (native 2560x1664: 40), not the small profile's 11.
+                    let mut pre = kp.prelude()?;
+                    pre.init_buffer_block_count = queue_res.tvb().ids().count() as u32;
+                    pre.init_buffer_slot = u32::from(refs.pb_slot);
+                    pre
+                }),
+            };
+
+            g15_stage(format_args!("submit: inputs assembled; building commands"))?;
+            *m_pair = Some(G15StageMark("built commands and tables dropped"));
+            let mut alloc = gpu.alloc();
+            let (pair, tables) = build_g15_render(&mut alloc, &inputs)?;
+            Ok((pair, tables, [tl.sku_slot_fwva, fl.sku_slot_fwva]))
+        }
+    }
+
+    /// The pass's G15RDMP1 dump to debugfs. Returns the TA command FWVA the
+    /// dump starts with.
+    #[inline(never)]
+    fn g15_dump_render(
+        &self,
+        id: u64,
+        pair: &super::g15_render::G15RenderPair,
+        tables: &super::g15_render::G15RenderTables,
+        queue_res: &G15RenderQueueResources,
+    ) -> Result<u64> {
+        let mut dump = dump_g15_render(pair, tables)?;
+        queue_res.pm().dump(&mut dump)?;
+        if let Some((va, len)) = queue_res.tvb().page_list() {
+            dump.resource("tvb_page_list", va, len as u64)?;
+        }
+        let pb = queue_res.pb().descriptor();
+        for (i, name) in ["pb_desc_w0", "pb_desc_w1", "pb_desc_w2", "pb_desc_w3"]
+            .into_iter()
+            .enumerate()
+        {
+            dump.scalar(name, u64::from(pb.words[i].0))?;
+        }
+        *(*self.dev).g15_render_last.lock() = dump.finish();
+        dev_info!(
+            self.dev.as_ref(),
+            "J613 G15 render {}: built TA {:#x} 3D {:#x}, dump in debugfs asahi/g15_render_last\n",
+            id,
+            pair.ta.command_fwva,
+            pair.frag.command_fwva
+        );
+        g15_stage(format_args!("submit: debugfs dump written"))?;
+        Ok(pair.ta.command_fwva)
+    }
+
+    /// After the dry-run decision: the first firmware-visible writes of this
+    /// queue's render state.
+    #[inline(never)]
+    fn g15_publish_render_state(
+        state: &mut Option<G15QueueRenderState>,
+        gpu: &gpu::GpuManager::ver,
+        queue_res: &G15RenderQueueResources,
+        ta_channel: &Arc<Mutex<Option<super::g15_channel::G15RenderChannel::ver>>>,
+        frag_channel: &Arc<Mutex<Option<super::g15_channel::G15RenderChannel::ver>>>,
+    ) -> Result {
+        #[ver(G != G15)]
+        {
+            let _ = (state, gpu, queue_res, ta_channel, frag_channel);
+            return Err(ENODEV);
+        }
+
+        #[ver(G == G15)]
+        {
+            // A PB record with the literal native word 0 would name Apple's
+            // TVB page list; the parser already refuses such replay blobs.
+            if !queue_res.pb().publishable() {
+                return Err(EINVAL);
+            }
+
+            // First firmware-visible writes of this queue's render state:
+            // the render UMA pool's descriptor-table entry (TA and 3D share
+            // the pool; the leases above hold its reference, so its
+            // HardwareBuffer ID is fixed) and the PB descriptor.
+            let published_order = match G15_RENDER_PUBLISH_ORDER {
+                G15RenderPublishOrder::FragmentFirst => [frag_channel, ta_channel],
+                G15RenderPublishOrder::TaFirst => [ta_channel, frag_channel],
+            };
+            for channel in published_order {
+                (&*channel.lock()).as_ref().ok_or(EIO)?.publish_uma_descriptor(gpu)?;
+            }
+            let state = state.as_mut().ok_or(EIO)?;
+            if !state.pb_published {
+                gpu.g15_set_pb_descriptor(state.res.pb().slot(), state.res.pb().descriptor())?;
+                state.pb_published = true;
+            }
+            Ok(())
+        }
+    }
+
+    // G2 (per-tile list limit). G15 tile lists are 128-byte chunks starting at
+    // TPC head x 0x80 from the TVB base (0x10_0000_0000). A TPC entry is 8
+    // bytes: head (128-byte units), then 0xb0000000 | tail, where tail = 2 x the
+    // 0xa8 terminator's byte offset in the final chunk. The TA fills a chunk to
+    // +0x77 and links at +0x78 with a qword (target & 0xffffffff) | 0x69, target
+    // 0x80-aligned. macOS's fragment pass consumes a chunk's second 64-byte
+    // half; Linux's does not: a list whose content runs past byte 0x40 of a
+    // chunk hangs the fragment unit (firmware Timeout, no fault). Serializing
+    // TA->3D does not help (g2serA-170644); shortening the list or inserting a
+    // link at +0x38 to a fresh 128-byte chunk makes x168/x192 pass with every
+    // record (g2edit2-170931, g2link8b-173436). The OS discriminator remains
+    // unknown; firmware/internal state or physical backing remain possible.
+    /// Queue [Barrier, Fragment] on the 3D WorkQueue job and [InitBuffer,
+    /// Vertex] on the TA one, each command with its completion callback.
+    #[inline(never)]
+    fn g15_queue_render_commands(
+        job: &mut Job<super::QueueJob::ver>,
+        vm_slot: u32,
+        pair: KBox<super::g15_render::G15RenderPair>,
+        done: Arc<Mutex<Option<G15RenderPairFinal::ver>>>,
+        ta_slot: &G15RenderLeaseSlot::ver,
+        frag_slot: &G15RenderLeaseSlot::ver,
+    ) -> Result {
+        let super::super::queue::g15_render::G15RenderPair {
+            barrier,
+            frag: frag_cmd,
+            init_buffer,
+            ta: ta_cmd,
+        } = KBox::into_inner(pair);
+        let ta_timing = G15CommandTiming {
+            pipe: PipeType::Vertex,
+            addr: ta_cmd
+                .cmd
+                .with(|raw, _| core::ptr::addr_of!(raw.g15_sku_timing_8f8) as usize),
+            overflow_addr: 0,
+            partials_addr: 0,
+        };
+        // G2 `g15_render_serial`: the pair loop publishes 3D only after the
+        // TA command's completion stamp changes.
+        if job.g15_serial_job {
+            let off = core::mem::offset_of!(fw::job::raw::G15SkuTimingState, complete_timestamp);
+            // A relinked render waits for the TA's callback (its notification
+            // is armed on its own); plain serial mode waits for the stamp.
+            job.g15_serial = Some((ta_timing.addr + off, job.g15_relink_job));
+        }
+        let frag_timing = G15CommandTiming {
+            pipe: PipeType::Fragment,
+            addr: frag_cmd
+                .cmd
+                .with(|raw, _| core::ptr::addr_of!(raw.g15_sku_timing_c40) as usize),
+            overflow_addr: frag_cmd
+                .cmd
+                .with(|raw, _| core::ptr::addr_of!(raw.tvb_overflow_count) as usize),
+            partials_addr: frag_cmd
+                .cmd
+                .with(|raw, _| core::ptr::addr_of!(raw.g15_encoder_state.partial_render_count_b74) as usize),
+        };
+        // Partial-render diagnostic: if the watchdog fires while this pair
+        // is in flight, dump what the firmware wrote (read only; a
+        // fail-stop frees nothing, so every object is still mapped).
+        let rf_base = frag_cmd.cmd.with(|raw, _| raw as *const _ as usize);
+        let rf_len = frag_cmd.cmd.with(|raw, _| core::mem::size_of_val(raw));
+        if let Some(gpu) = (*job.dev).gpu.as_any().downcast_ref::<gpu::GpuManager::ver>() {
+            let snap_done = done.clone();
+            let snap_dev = job.dev.clone();
+            let f = move || {
+                let guard = snap_done.lock();
+                let Some(st) = (&*guard).as_ref() else { return };
+                let dump = |what: &str, base: usize, start: usize, end: usize| {
+                    for off in (start..end).step_by(16) {
+                        let mut w = [0u32; 4];
+                        for (i, x) in w.iter_mut().enumerate() {
+                            // SAFETY: inside the live, CPU-mapped object.
+                            *x = unsafe { core::ptr::read_volatile((base + off + 4 * i) as *const u32) };
+                        }
+                        if w.iter().any(|&x| x != 0) {
+                            dev_info!(snap_dev.as_ref(), "G15 watchdog snapshot job={} {} +{:#05x}: {:08x?}\n", st.job_id, what, off, w);
+                        }
+                    }
+                };
+                if rf_base != 0 && rf_len >= 0xc60 {
+                    dump("RunFragment", rf_base, 0x400, 0x560);
+                    dump("RunFragment", rf_base, 0xb60, 0xb80);
+                    // GPU start/end (+0xbf8/+0xc00): did the 3D pass start?
+                    dump("RunFragment", rf_base, 0xbf0, 0xc10);
+                    dump("RunFragment", rf_base, 0xc40, 0xc60);
+                }
+                dev_info!(snap_dev.as_ref(), "G15 watchdog snapshot job={} BufferInfo: {:08x?}\n", st.job_id, st.snapshot_buffer.g15_info_words());
+                // G2 (`g15_fw_sched_probe`): RGX state-3 status/enable/ack.
+                // Only here: the job is still running, so the GPU is powered;
+                // reading these while it is off raises an SError.
+                if *module_parameters::g15_fw_sched_probe.value() != 0 {
+                    let r = |o| snap_dev.resources.g15_sgx_peek32(o);
+                    dev_info!(snap_dev.as_ref(), "G15 watchdog snapshot job={} rgx 10a08={:#x} 10a10={:#x} 10a30={:#x} 10a38={:#x}\n",
+                        st.job_id, r(0x10a08), r(0x10a10), r(0x10a30), r(0x10a38));
+                }
+                for (name, b) in st._resources.tile_state() {
+                    if let Ok(b) = b {
+                        dump(name, b.as_ptr() as usize, 0, b.len().min(0x400) & !0xf);
+                    }
+                }
+                if let Some(list) = st._resources.queue().tvb().page_list_bytes() {
+                    super::g15_resources::g15_clean_to_poc(list.as_ptr() as usize, list.len());
+                    dump("TVB page list", list.as_ptr() as usize, 0, list.len() & !0xf);
+                }
+                if let Some(gpu) = (*snap_dev).gpu.as_any().downcast_ref::<gpu::GpuManager::ver>() {
+                    let sv = gpu.g15_stats_vtx_bytes(0x610);
+                    dump("stats vtx", sv.as_ptr() as usize, 0, sv.len() & !0xf);
+                    for (id, d) in gpu.g15_uma_descriptors_in_use() {
+                        dev_info!(snap_dev.as_ref(), "G15 watchdog snapshot job={} uma descriptor {}: {:x?}\n", st.job_id, id, d);
+                    }
+                }
+                let stats = st._resources.queue().pm().scene_stats_bytes();
+                dump("PM scene stats", stats.as_ptr() as usize, 0, stats.len().min(0x80) & !0xf);
+                let metrics = st._resources.queue().pm().page_metrics_bytes();
+                dump("PM page metrics", metrics.as_ptr() as usize, 0, metrics.len().min(0x140) & !0xf);
+                if let Ok(pool) = st._resources.queue().pm().pool_bytes() {
+                    let base = pool.as_ptr() as usize;
+                    dump("PM pool", base, 0, pool.len() & !0xf);
+                }
+            };
+            gpu.g15_set_watchdog_snapshot(KBox::new(f, GFP_KERNEL)?);
+        }
+        {
+            let frag_job = job.get_frag()?;
+            frag_job.add(barrier, vm_slot)?;
+            frag_job.add_cb(
+                frag_cmd.cmd,
+                vm_slot,
+                G15RenderPairFinal::ver::callback(done.clone(), frag_slot.clone(), frag_timing),
+            )?;
+            frag_job.next_seq();
+        }
+        {
+            let ta_job = job.get_vtx()?;
+            ta_job.add(init_buffer, vm_slot)?;
+            ta_job.add_cb(
+                ta_cmd.cmd,
+                vm_slot,
+                G15RenderPairFinal::ver::callback(done, ta_slot.clone(), ta_timing),
+            )?;
+            ta_job.next_seq();
+        }
+        Ok(())
+    }
+}
