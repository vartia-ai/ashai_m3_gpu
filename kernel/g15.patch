+/// Scene words of the G15 render PM records, from the kernel profile.
+///
+/// Capture 5 (all 80 records): `+0x28 = 0x220000 + 0x40 * (i % 36)` and
+/// `+0x30 = 0x220900`, i.e. a 0x40-byte per-scene stride (the host-derived
+/// [`g15_j615_pm_scene_slice_offset`] stride is 0x30), 36 modulo-selected
+/// slots and one shared slot after them. The words are offsets from the
+/// parameter-buffer base (the TVB page-ID base, eGartRange-1
+/// 0x10_0000_0000), so the scene page itself sits at that base plus
+/// `offset` (0x10_0022_0000).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15PmSceneGeometry {
+    /// Record `+0x28` of slot 0 (native 0x220000).
+    pub(crate) offset: u64,
+    /// Bytes per scene slot (native 0x40).
+    pub(crate) stride: u64,
+    /// Modulo-selected slots (native 36); the shared slot follows them.
+    pub(crate) slots: u32,
+}
+
+impl G15PmSceneGeometry {
+    /// Reject a geometry the records cannot express: the slot count must be
+    /// 1..=80, the stride a nonzero multiple of the 0x10 scene alignment.
+    pub(crate) fn validate(&self) -> Result {
+        let align = G15_PM_DEVICE_CONFIG.scene_alignment as u64;
+        if self.slots == 0
+            || self.slots as usize > G15_J615_PM_RECORD_COUNT
+            || self.stride == 0
+            || self.stride % align != 0
+        {
+            return Err(EINVAL);
+        }
+        self.offset.checked_add(self.bytes()? as u64).ok_or(EINVAL)?;
+        Ok(())
+    }
+
+    /// Bytes from slot 0 to the end of the shared slot.
+    pub(crate) fn bytes(&self) -> Result<usize> {
+        let n = u64::from(self.slots) + 1;
+        usize::try_from(self.stride.checked_mul(n).ok_or(EINVAL)?).map_err(|_| EINVAL)
+    }
+
+    /// Record `+0x28` of record `index`.
+    pub(crate) fn slice(&self, index: u32) -> Result<u64> {
+        let slot = u64::from(index % self.slots.max(1));
+        self.offset
+            .checked_add(slot.checked_mul(self.stride).ok_or(EINVAL)?)
+            .ok_or(EINVAL)
+    }
+
+    /// Record `+0x30` (the shared slot after the modulo-selected ones).
+    pub(crate) fn shared(&self) -> Result<u64> {
+        self.offset
+            .checked_add(u64::from(self.slots).checked_mul(self.stride).ok_or(EINVAL)?)
+            .ok_or(EINVAL)
+    }
+}
