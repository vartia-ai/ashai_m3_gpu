+
+/// Per-engine tables for one pass. The TA and 3D tables differ only in the
+/// values W3 names once but each pipe owns (UMA metrics, event sequence,
+/// evctl index, state sequence).
+pub(crate) struct G15RenderTables {
+    pub(crate) ta: G15EngineTables,
+    pub(crate) frag: G15EngineTables,
+}
+
+fn set_opt(t: &mut G15TargetTable, target: G15RelocTarget, va: Option<u64>) -> Result {
+    match va {
+        Some(va) => t.set(target, va),
+        None => Ok(()),
+    }
+}
+
+fn set_nz(t: &mut G15TargetTable, target: G15RelocTarget, va: u64) -> Result {
+    if va != 0 {
+        t.set(target, va)
+    } else {
+        Ok(())
+    }
+}
+
+fn set_scalar_opt(s: &mut G15ScalarTable, id: G15ScalarId, v: Option<u64>) -> Result {
+    match v {
+        Some(v) => s.set(id, v),
+        None => Ok(()),
+    }
+}
+
+impl G15RenderTables {
+    /// Empty tables for [`Self::fill`].
+    pub(crate) const fn blank() -> Self {
+        const EMPTY: G15EngineTables = G15EngineTables {
+            targets: G15TargetTable::new(),
+            scalars: G15ScalarTable::new(),
+        };
+        Self {
+            ta: EMPTY,
+            frag: EMPTY,
+        }
+    }
+
+    /// Fill [`Self::blank`] tables in place (they are ~1.5 KiB). Not inlined,
+    /// so its scratch tables stay out of `build_g15_render`'s frame.
+    #[inline(never)]
+    pub(crate) fn fill(&mut self, inp: &G15RenderInputs<'_>, allocs: &G15RenderAllocs) -> Result {
+        use G15RelocTarget as T;
+        use G15ScalarId as S;
+
+        // TA +0x14 and 3D +0x20 hold the same event-control block in every
+        // native pair; refuse leases that disagree.
+        if inp.ta.evctl_fwva != inp.frag.evctl_fwva {
+            return Err(EINVAL);
+        }
+        let p = &inp.pass;
+        let pl = &inp.payload;
+
+        let mut t = G15TargetTable::new();
+        t.set(T::TaCommand, allocs.ta_fwva())?;
+        t.set(T::FragCommand, allocs.frag_fwva())?;
+        t.set(T::TaSku, inp.ta.sku_slot_fwva)?;
+        t.set(T::FragSku, inp.frag.sku_slot_fwva)?;
+        t.set(T::BarrierCommand, allocs.barrier_fwva())?;
+        t.set(T::InitBufferCommand, allocs.init_buffer_fwva())?;
+        t.set(T::EventControl, inp.ta.evctl_fwva)?;
+        t.set(T::StampTa, inp.ta.stamp_fwva)?;
+        t.set(T::StampFrag, inp.frag.stamp_fwva)?;
+        t.set(T::FwStampTa, inp.ta.fw_stamp_fwva)?;
+        t.set(T::FwStampFrag, inp.frag.fw_stamp_fwva)?;
+        t.set(T::ChannelStateTa, inp.ta.channel_state_fwva)?;
+        t.set(T::ChannelStateFrag, inp.frag.channel_state_fwva)?;
+        t.set(T::FirmwareStateTa, inp.ta.firmware_state_fwva)?;
+        t.set(T::FirmwareStateFrag, inp.frag.firmware_state_fwva)?;
+        set_nz(&mut t, T::ChannelCommandRegionTa, inp.ta.command_region_fwva)?;
+        set_nz(&mut t, T::ChannelCommandRegionFrag, inp.frag.command_region_fwva)?;
+        t.set(T::BufferInfo, p.buffer_info)?;
+        t.set(T::PmRecord, p.pm_record)?;
+        t.set(T::PmState, p.pm_state)?;
+        set_opt(&mut t, T::PmSceneSlice, p.pm_scene_slice)?;
+        set_opt(&mut t, T::PmPageMetrics, p.pm_page_metrics)?;
+        // One page-pool state for both pipes (TA +0x8d6 == 3D +0xc1e natively).
+        set_nz(&mut t, T::UmaPoolState, inp.ta.uma.page_pool_state_fwva)?;
+        set_nz(&mut t, T::UmaPoolState, inp.frag.uma.page_pool_state_fwva)?;
+        set_opt(&mut t, T::UmaUncachedState, p.uma_uncached_state)?;
+        t.set(T::SegmentResourceList, p.timing_record)?;
+        t.set(T::TvbTilemap, p.tilemap)?;
+        t.set(T::TvbHeapmeta, p.heapmeta)?;
+        set_opt(&mut t, T::TvbLayermeta, p.layermeta)?;
+        t.set(T::Tpc, p.tpc)?;
+        t.set(T::CtxSwitch, p.ctxswitch)?;
+        set_opt(&mut t, T::TaPayload, p.ta_payload)?;
+        t.set(T::RenderTarget, p.render_target)?;
+        set_opt(&mut t, T::VdmStream, pl.vdm_stream)?;
+        set_opt(&mut t, T::UscVertex, pl.usc_vertex)?;
+        set_opt(&mut t, T::UscFragment, pl.usc_fragment)?;
+        set_opt(&mut t, T::UscBackground, pl.usc_background)?;
+        set_opt(&mut t, T::UscEndOfTile, pl.usc_eot)?;
+        set_opt(&mut t, T::EotStateLoader, pl.eot_state_loader)?;
+        set_opt(&mut t, T::PbeDescriptors, pl.pbe_descriptors)?;
+        set_opt(&mut t, T::Uniforms, pl.uniforms)?;
+        t.set(T::StatsTa, p.stats_ta)?;
+        t.set(T::StatsFrag, p.stats_frag)?;
+
+        let id = &inp.id;
+        let mut s = G15ScalarTable::new();
+        s.set(S::CounterFrag, id.counter_frag)?;
+        s.set(S::CounterTa, id.counter_frag.checked_add(1).ok_or(EOVERFLOW)?)?;
+        s.set(S::UuidTa, id.uuid_ta.into())?;
+        s.set(S::UuidFrag, id.uuid_frag.into())?;
+        s.set(S::StampValueTa, inp.ta.stamp_value.into())?;
+        s.set(S::StampValueFrag, inp.frag.stamp_value.into())?;
+        s.set(S::StampSlotTa, inp.ta.stamp_slot.into())?;
+        s.set(S::StampSlotFrag, inp.frag.stamp_slot.into())?;
+        s.set(S::ContextId, id.context_id.into())?;
+        s.set(S::CtxGeneration, id.ctx_generation.into())?;
+        s.set(S::SubmissionTag, id.submission_tag)?;
+        let f = &inp.formulas;
+        set_scalar_opt(&mut s, S::PbSlot, f.pb_slot)?;
+        set_scalar_opt(&mut s, S::FragTileConfig, f.frag_tile_config)?;
+        set_scalar_opt(&mut s, S::FragTilecfg, f.frag_tilecfg)?;
+        set_scalar_opt(&mut s, S::TaRenderTargetMax, f.ta_render_target_max)?;
+        set_scalar_opt(&mut s, S::TaDepthLevel, f.ta_depth_level)?;
+        set_scalar_opt(&mut s, S::TaStencilLevel, f.ta_stencil_level)?;
+        set_scalar_opt(&mut s, S::TaEncoderTag, f.ta_encoder_tag)?;
+        set_scalar_opt(&mut s, S::ClearState, f.clear_state)?;
+        set_scalar_opt(&mut s, S::PmMetricsReg, f.pm_metrics_reg)?;
+
+        let engine = |out: &mut G15EngineTables, e: &G15EngineInputs| -> Result {
+            let targets = &mut out.targets;
+            *targets = t.clone();
+            // Natively TA cmd +0x8ef == TA SKU +0x1a4 and 3D cmd +0xc37 ==
+            // 3D SKU +0x1bc: both names are this engine's current UMA
+            // HWMetrics record (W5 lease, an interior record address, not
+            // the page base). TA and 3D have separate rings; the native
+            // 3D == TA + 0x18000 is only allocation layout.
+            targets.set(T::UmaMetrics, e.hwmetrics_fwva)?;
+            targets.set(T::HwMetrics, e.hwmetrics_fwva)?;
+            let scalars = &mut out.scalars;
+            *scalars = s.clone();
+            scalars.set(S::EventSeq, e.event_seq.into())?;
+            // Compute's SKU passes the command's meta event_seq as the queue
+            // event sequence; render has no other source.
+            scalars.set(S::QueueEventSequence, e.event_seq.into())?;
+            scalars.set(S::EvctlIndex, e.evctl_index.into())?;
+            scalars.set(S::StateSequence, e.state_sequence.into())?;
+            Ok(())
+        };
+        engine(&mut self.ta, &inp.ta)?;
+        engine(&mut self.frag, &inp.frag)
+    }
+}
+
+fn read_le(b: &[u8], off: usize, width: usize) -> u64 {
+    b[off..off + width]
+        .iter()
+        .rev()
+        .fold(0u64, |acc, x| (acc << 8) | *x as u64)
+}
+
+fn write_le(b: &mut [u8], off: usize, width: usize, v: u64) {
+    for (i, x) in b[off..off + width].iter_mut().enumerate() {
+        *x = (v >> (8 * i)) as u8;
+    }
+}
+
+/// Typed field map applied over the serialized profile image.
+struct Overlay<'a> {
+    engine: &'static str,
+    img: &'a mut [u8],
+    tmpl: &'a G15ByteTemplate<'a>,
+}
+
+impl Overlay<'_> {
+    /// Write `v` at `off`. If the profile patches an overlapping range with
+    /// anything but a native value, it must be the same field and agree.
+    fn put(&mut self, off: usize, width: usize, v: u64) -> Result {
+        let end = off.checked_add(width).ok_or(EINVAL)?;
+        if !matches!(width, 1 | 2 | 4 | 8) || end > self.img.len() {
+            return Err(EINVAL);
+        }
+        if width < 8 && v >> (8 * width) != 0 {
+            return Err(EINVAL);
+        }
+        for p in self.tmpl.patches {
+            let (po, pe) = (p.offset as usize, p.offset as usize + p.width as usize);
+            if pe <= off || po >= end || p.prov == G15Prov::Native {
+                continue;
+            }
+            let profile = read_le(self.img, po, p.width as usize);
+            if po != off || p.width as usize != width || profile != v {
+                pr_err!(
+                    "g15_render: {} +{:#x}/{}: builder {:#x}, profile patch +{:#x}/{} = {:#x}\n",
+                    self.engine,
+                    off,
+                    width,
+                    v,
+                    po,
+                    p.width,
+                    profile
+                );
+                return Err(EINVAL);
+            }
+        }
+        write_le(self.img, off, width, v);
+        Ok(())
+    }
+
+    fn zero(&mut self, off: usize, len: usize) -> Result {
+        let end = off.checked_add(len).ok_or(EINVAL)?;
+        if end > self.img.len() {
+            return Err(EINVAL);
+        }
+        for p in self.tmpl.patches {
+            let (po, pe) = (p.offset as usize, p.offset as usize + p.width as usize);
+            if pe > off && po < end && !matches!(p.prov, G15Prov::Native | G15Prov::FwOwned) {
+                return Err(EINVAL);
+            }
+        }
+        self.img[off..end].fill(0);
+        Ok(())
+    }
+}
+
+/// Register sink writing 12-byte entries straight into a command image.
+struct ImgRegs<'a> {
+    img: &'a mut [u8],
+    base: usize,
+    count: usize,
+}
+
+impl G15RegSink for ImgRegs<'_> {
+    fn len(&self) -> usize {
+        self.count
+    }
+
+    fn push(&mut self, reg: u32, value: u64) {
+        let o = self.base + self.count * REG_STRIDE;
+        write_le(self.img, o, 4, reg.into());
+        write_le(self.img, o + 4, 8, value);
+        self.count += 1;
+    }
+
+    fn clear(&mut self) {
+        self.img[self.base..self.base + REG_SLOTS_BYTES].fill(0);
+        self.count = 0;
+    }
+}
+
+/// I09 R3: a user register value that differs from the profile's.
+/// Not inlined: keeps the formatting out of the command builders' frames.
+#[inline(never)]
+fn trace_user_reg(engine: &str, reg: u32, profile: u64, user: u64) {
+    crate::debug::g15_trace(format_args!(
+        "R3: {} reg {:#x}: profile {:#x}, user {:#x} (user value used)",
+        engine, reg, profile, user
+    ));
+}
+
+/// Emit `engine`'s register list at `ra` (RegisterArray offset in the image)
+/// and set its self-pointer, count and length. I09 R3: then write the
+/// `user_regs` values of this engine over their profile N entries, with a
+/// g15_trace line for each one that differs from the profile.
+fn emit_registers(
+    ov: &mut Overlay<'_>,
+    r: &G15Resolver<'_>,
+    engine: G15Engine,
+    ra: usize,
+    cmd_fwva: u64,
+    user_regs: &[G15RegOverride],
+) -> Result {
+    let list = match engine {
+        G15Engine::Ta => &r.profile.ta_regs,
+        G15Engine::Frag => &r.profile.frag_regs,
+    };
+    let mut sink = ImgRegs {
+        img: &mut *ov.img,
+        base: ra,
+        count: 0,
+    };
+    sink.clear();
+    let n = list.emit(r, &mut sink)?;
+    list.user_overrides(user_regs, |index, reg, profile, user| {
+        if profile != user {
+            trace_user_reg(ov.engine, reg, profile, user);
+        }
+        write_le(sink.img, ra + index * REG_STRIDE + 4, 8, user);
+    })?;
+    let addr = cmd_fwva.checked_add(ra as u64).ok_or(EOVERFLOW)?;
+    ov.put(ra + offset_of!(RegisterArray, addr), 8, addr)?;
+    ov.put(ra + offset_of!(RegisterArray, count), 2, n as u64)?;
+    ov.put(ra + offset_of!(RegisterArray, length), 2, (n * REG_STRIDE) as u64)?;
+    Ok(())
+}
+
+/// JobMeta words shared by both engines.
+fn put_meta(ov: &mut Overlay<'_>, meta: usize, e: &G15EngineInputs, uuid: u32) -> Result {
+    ov.put(meta + offset_of!(G15JobMeta, stamp), 8, e.stamp_fwva)?;
+    ov.put(meta + offset_of!(G15JobMeta, fw_stamp), 8, e.fw_stamp_fwva)?;
+    ov.put(meta + offset_of!(G15JobMeta, stamp_value), 4, e.stamp_value.into())?;
+    ov.put(meta + offset_of!(G15JobMeta, stamp_slot), 4, e.stamp_slot.into())?;
+    ov.put(meta + offset_of!(G15JobMeta, evctl_index), 4, e.evctl_index.into())?;
+    ov.put(meta + offset_of!(G15JobMeta, uuid), 4, uuid.into())?;
+    ov.put(meta + offset_of!(G15JobMeta, event_seq), 4, e.event_seq.into())?;
+    Ok(())
+}
+
+fn sku_stream(
+    t: &G15SkuTemplate<'_>,
+    r: &G15Resolver<'_>,
+    e: &G15EngineInputs,
+) -> Result<KVec<u8>> {
+    if e.sku_slot_bytes < t.image.bytes.len() {
+        return Err(EINVAL);
+    }
+    let mut out = KVec::with_capacity(e.sku_slot_bytes, GFP_KERNEL)?;
+    out.resize(e.sku_slot_bytes, 0, GFP_KERNEL)?;
+    let n = fw::g15_render::g15_serialize_sku(t, r, e.sku_slot_fwva, &mut out)?;
+    out.truncate(n as usize);
+    Ok(out)
+}
+
+fn serialize_cmd<R>(t: Option<&G15ByteTemplate<'_>>, r: &G15Resolver<'_>) -> Result<KVec<u8>> {
+    let t = t.ok_or(EINVAL)?;
+    let len = size_of::<R>();
+    if t.bytes.len() != len {
+        return Err(EINVAL);
+    }
+    let mut img = KVec::with_capacity(len, GFP_KERNEL)?;
+    img.resize(len, 0, GFP_KERNEL)?;
+    t.serialize(r, &mut img)?;
+    Ok(img)
+}
+
+fn materialize<T: GpuStruct>(a: CmdAlloc<T>, inner: T, img: &[u8]) -> Result<GpuObject<T>> {
+    if img.len() != size_of::<T::Raw<'static>>() {
+        return Err(EINVAL);
+    }
+    GpuObject::new_init_prealloc(
+        a,
+        |_ptr| inner,
+        |_inner, _ptr| {
+            // SAFETY: `img` has exactly the size of `T::Raw`, and every field
+            // that has a validity invariant (the command tag, the non-null
+            // RegisterArray and JobMeta stamp pointers) was written by the
+            // builder from a checked nonzero/structural value.
+            unsafe {
+                pin_init::pin_init_from_closure::<_, Error>(move |slot: *mut T::Raw<'_>| {
+                    core::ptr::copy_nonoverlapping(img.as_ptr(), slot as *mut u8, img.len());
+                    Ok(())
+                })
+            }
+        },
+    )
+}
+
+/// Build the TA command and its SKU stream into `a`.
+// Not inlined: keeps its command image work out of `build_g15_render`.
+#[inline(never)]
+pub(crate) fn build_ta(
+    a: CmdAlloc<G15RunVertex>,
+    inp: &G15RenderInputs<'_>,
+    tables: &G15RenderTables,
+) -> Result<G15BuiltCommand<G15RunVertex>> {
+    let profile = inp.profile;
+    profile.validate()?;
+    let cmd_fwva = alloc::Allocation::gpu_ptr(&a);
+    let tb = &tables.ta;
+    if tb.targets.get(G15RelocTarget::TaCommand)? != cmd_fwva {
+        return Err(EINVAL);
+    }
+    let r = G15Resolver {
+        profile,
+        targets: &tb.targets,
+        scalars: &tb.scalars,
+    };
+    let e = &inp.ta;
+    let p = &inp.pass;
+    let id = &inp.id;
+
+    let sku = sku_stream(&profile.ta_sku, &r, e)?;
+    let tmpl = profile.ta_cmd.as_ref().ok_or(EINVAL)?;
+    let mut img = serialize_cmd::<TaRaw>(Some(tmpl), &r)?;
+    let mut ov = Overlay {
+        engine: "TA",
+        img: &mut img,
+        tmpl,
+    };
+
+    // Structural: command tag.
+    ov.put(offset_of!(TaRaw, tag), 4, fw::workqueue::CommandType::RunVertex as u64)?;
+    // D
+    ov.put(offset_of!(TaRaw, counter), 8, id.counter_frag.checked_add(1).ok_or(EOVERFLOW)?)?;
+    ov.put(offset_of!(TaRaw, g15_context_id_c), 4, id.context_id.into())?;
+    // RunVertex +0x1c names the queue's PB descriptor slot, as native does
+    // (with the profile's 0, several clients shared slot 0's descriptor).
+    ov.put(offset_of!(TaRaw, buffer_slot), 4, inp.formulas.pb_slot.ok_or(EINVAL)?)?;
+    // R: header
+    ov.put(offset_of!(TaRaw, g15_event_control_fwva_14), 8, e.evctl_fwva)?;
+    ov.put(offset_of!(TaRaw, g15_buffer_info_fwva_24), 8, p.buffer_info)?;
+    ov.put(offset_of!(TaRaw, g15_pm_record_fwva_2c), 8, p.pm_record)?;
+    ov.put(offset_of!(TaRaw, g15_pm_state_fwva_34), 8, p.pm_state)?;
+    // N/D/R per register, from the profile.
+    emit_registers(
+        &mut ov,
+        &r,
+        G15Engine::Ta,
+        offset_of!(TaRaw, registers),
+        cmd_fwva,
+        inp.user_regs,
+    )?;
+    // TPC (R) and its size (D).
+    ov.put(offset_of!(TaRaw, g15_tpc_760), 8, p.tpc)?;
+    ov.put(offset_of!(TaRaw, tpc_size), 8, p.tpc_size)?;
+    // SKU stream (R) and size (D).
+    ov.put(offset_of!(TaRaw, g15_sku_fwva_770), 8, e.sku_slot_fwva)?;
+    ov.put(offset_of!(TaRaw, g15_sku_size_778), 4, sku.len() as u64)?;
+    // 3D stamp the TA command hands over (D, == 3D meta stamp_slot/value).
+    ov.put(offset_of!(TaRaw, fragment_stamp_slot), 4, inp.frag.stamp_slot.into())?;
+    ov.put(offset_of!(TaRaw, fragment_stamp_value), 4, inp.frag.stamp_value.into())?;
+    // R: context-switch secondary, encoded exactly as TA reg 0x10111 above
+    // (native: range-1 offset, not the raw VA).
+    let ctxswitch_secondary = r.reg_value(G15RegRef {
+        engine: G15Engine::Ta,
+        reg: 0x10111,
+    })?;
+    ov.put(offset_of!(TaRaw, g15_raw_render_60_7a8), 8, ctxswitch_secondary)?;
+    // D: per-submission tag (== 3D +0xb88).
+    ov.put(offset_of!(TaRaw, g15_raw_render_608_610_lo_840), 8, id.submission_tag)?;
+    put_meta(&mut ov, offset_of!(TaRaw, meta), e, id.uuid_ta)?;
+    // R: timing record start qword (== 3D +0xbf8).
+    ov.put(offset_of!(TaRaw, g15_segment_resource_list_fwva_8b0), 8, p.timing_record)?;
+    // UMA block: R pool state and metrics, D prepared and generation, N sizes.
+    ov.put(offset_of!(TaRaw, g15_uma_page_pool_state_fwva_8d6), 8, e.uma.page_pool_state_fwva)?;
+    ov.put(offset_of!(TaRaw, g15_uma_prepared_8de), 1, e.uma.prepared.into())?;
+    ov.put(offset_of!(TaRaw, g15_uma_min_pool_size_8df), 8, e.uma.min_pool_size)?;
+    ov.put(offset_of!(TaRaw, g15_uma_ideal_pool_size_8e7), 8, e.uma.ideal_pool_size)?;
+    ov.put(offset_of!(TaRaw, g15_uma_metrics_fwva_8ef), 8, e.hwmetrics_fwva)?;
+    ov.put(offset_of!(TaRaw, g15_context_id_generation_8f7), 1, id.ctx_generation.into())?;
+    // F
+    ov.zero(offset_of!(TaRaw, g15_sku_timing_8f8), size_of::<fw::job::raw::G15SkuTimingState>())?;
+    ov.zero(offset_of!(TaRaw, g15_tail_918), 8)?;
+
+    let cmd = materialize(a, G15RunVertex { _engine: G15Engine::Ta }, &img)?;
+    Ok(G15BuiltCommand {
+        cmd,
+        command_fwva: cmd_fwva,
+        pipe: PipeType::Vertex,
+        sku,
+        sku_fwva: e.sku_slot_fwva,
+        expect_stamp: (e.fw_stamp_fwva, e.stamp_value),
+    })
+}
+
+/// Build the 3D command and its SKU stream into `a`.
+// Not inlined: keeps its command image work out of `build_g15_render`.
+#[inline(never)]
+pub(crate) fn build_frag(
+    a: CmdAlloc<G15RunFragment>,
+    inp: &G15RenderInputs<'_>,
+    tables: &G15RenderTables,
+) -> Result<G15BuiltCommand<G15RunFragment>> {
+    let profile = inp.profile;
+    profile.validate()?;
+    let cmd_fwva = alloc::Allocation::gpu_ptr(&a);
+    let tb = &tables.frag;
+    if tb.targets.get(G15RelocTarget::FragCommand)? != cmd_fwva {
+        return Err(EINVAL);
+    }
+    let r = G15Resolver {
+        profile,
+        targets: &tb.targets,
+        scalars: &tb.scalars,
+    };
+    let e = &inp.frag;
+    let p = &inp.pass;
+    let id = &inp.id;
+
+    let sku = sku_stream(&profile.frag_sku, &r, e)?;
+    let tmpl = profile.frag_cmd.as_ref().ok_or(EINVAL)?;
+    let mut img = serialize_cmd::<FragRaw>(Some(tmpl), &r)?;
+    let mut ov = Overlay {
+        engine: "3D",
+        img: &mut img,
+        tmpl,
+    };
+
+    ov.put(offset_of!(FragRaw, tag), 4, fw::workqueue::CommandType::RunFragment as u64)?;
+    ov.put(offset_of!(FragRaw, counter), 8, id.counter_frag)?;
+    ov.put(offset_of!(FragRaw, g15_context_id_c), 4, id.context_id.into())?;
+    ov.put(offset_of!(FragRaw, g15_sku_fwva_14), 8, e.sku_slot_fwva)?;
+    ov.put(offset_of!(FragRaw, g15_sku_size_1c), 4, sku.len() as u64)?;
+    ov.put(offset_of!(FragRaw, g15_event_control_fwva_20), 8, e.evctl_fwva)?;
+    ov.put(offset_of!(FragRaw, g15_buffer_fwva_28), 8, p.buffer_info)?;
+    ov.put(offset_of!(FragRaw, g15_pm_record_fwva_30), 8, p.pm_record)?;
+    ov.put(offset_of!(FragRaw, g15_pm_state_fwva_38), 8, p.pm_state)?;
+    // R: +0x40 == reg 0x16429 == TA tilemap (reg 0x1c039 + 0x10_0000_0000).
+    ov.put(offset_of!(FragRaw, g15_rtm_298_addr_40), 8, p.tilemap)?;
+    emit_registers(
+        &mut ov,
+        &r,
+        G15Engine::Frag,
+        offset_of!(FragRaw, registers),
+        cmd_fwva,
+        inp.user_regs,
+    )?;
+    // D: JobParameters3 words that copy a 3D register (I09 R3: the value
+    // emitted, user overrides included; 0x15211 is one).
+    let jp3 = offset_of!(FragRaw, g15_job_params3);
+    for (off, reg) in G15_FRAG_PARAMS3_MIRRORS {
+        let v = r.reg_value_with(
+            G15RegRef {
+                engine: G15Engine::Frag,
+                reg,
+            },
+            inp.user_regs,
+        )?;
+        ov.put(jp3 + off, 8, v)?;
+    }
+    // I09 R4: RTM words that follow the target size in the native 128, 160,
+    // 256 and 200x120 captures: +0x68/+0x6c copy 0x15131/0x15139 (the
+    // command's isp_merge_upper_x/y) and +0x78 is the 32x32 tile count.
+    if !inp.user_regs.is_empty() {
+        let frag = |reg| {
+            r.reg_value_with(
+                G15RegRef {
+                    engine: G15Engine::Frag,
+                    reg,
+                },
+                inp.user_regs,
+            )
+        };
+        let rtm = offset_of!(FragRaw, g15_rtm_c0_cc_60);
+        ov.put(rtm + 8, 4, frag(0x15131)?)?;
+        ov.put(rtm + 12, 4, frag(0x15139)?)?;
+        let size = frag(0x15211)?;
+        let (tx, ty) = fw::g15_render::g15_tiles(size as u16, (size >> 32) as u16);
+        ov.put(offset_of!(FragRaw, g15_rtm_118_78), 4, tx * ty)?;
+        // Depth: +0xa50 copies ISP_ZLS_PIXELS (0x15321).
+        ov.put(offset_of!(FragRaw, g15_raw_render_2d8_a50), 8, frag(0x15321)?)?;
+    }
+    // Partial programs (native D32F/R4 captures): partial background spec
+    // and USC at JobParameters3 +0x928/+0x930, partial end-of-tile at
+    // +0xa14/+0xa1c. The USC words are full addresses (1 TiB base + offset).
+    let partial_words = [
+        (offset_of!(G15JobParameters3, desc_4b8_527_8d8) + 10 * 8, offset_of!(G15JobParameters3, desc_4b8_527_8d8) + 11 * 8),
+        (offset_of!(G15JobParameters3, desc_640_648_a14), offset_of!(G15JobParameters3, desc_640_648_a14) + 8),
+    ];
+    // The native partial background spec has 0xffff800000000000 above
+    // the 32-bit rsrc_spec (R9 capture, Codex); the partial EOT spec is 0.
+    const PARTIAL_SPEC_HIGH: [u64; 2] = [0xffff_8000_0000_0000, 0];
+    for ((program, (spec, usc)), high) in
+        inp.user_partial.iter().zip(partial_words).zip(PARTIAL_SPEC_HIGH)
+    {
+        if let Some([program_usc, rsrc]) = *program {
+            ov.put(jp3 + spec, 8, high | u64::from(rsrc))?;
+            ov.put(jp3 + usc, 8, (1u64 << 40) | u64::from(program_usc))?;
+        }
+    }
+    // F: firmware-active region, busy/overflow and +0xb68.
+    ov.zero(offset_of!(FragRaw, g15_zero_a58), 0x108)?;
+    ov.zero(offset_of!(FragRaw, busy_flag), 4)?;
+    ov.zero(offset_of!(FragRaw, tvb_overflow_count), 4)?;
+    ov.zero(offset_of!(FragRaw, unk_878), 4)?;
+    // D: per-submission tag (== TA +0x840).
+    ov.put(
+        offset_of!(FragRaw, g15_encoder_state) + offset_of!(G15EncoderState, raw_render_608_610_b88),
+        8,
+        id.submission_tag,
+    )?;
+    // D: context_id - 1 in every desktop sample.
+    ov.put(
+        offset_of!(FragRaw, g15_raw_render_5d9_b9c),
+        4,
+        id.context_id.checked_sub(1).ok_or(EINVAL)?.into(),
+    )?;
+    put_meta(&mut ov, offset_of!(FragRaw, meta), e, id.uuid_frag)?;
+    // R: timing record start qword, and its end qword (+8) at +0xc00.
+    ov.put(offset_of!(FragRaw, g15_segment_resource_list_fwva_bf8), 8, p.timing_record)?;
+    ov.put(
+        offset_of!(FragRaw, g15_block_fence_time0_fwva_c00),
+        8,
+        p.timing_record
+            .checked_add(super::g15_resources::G15RenderTimingRecord::END_OFFSET)
+            .ok_or(EINVAL)?,
+    )?;
+    ov.put(offset_of!(FragRaw, g15_uma_page_pool_state_fwva_c1e), 8, e.uma.page_pool_state_fwva)?;
+    ov.put(offset_of!(FragRaw, g15_uma_prepared_c26), 1, e.uma.prepared.into())?;
+    ov.put(offset_of!(FragRaw, g15_uma_min_pool_size_c27), 8, e.uma.min_pool_size)?;
+    ov.put(offset_of!(FragRaw, g15_uma_ideal_pool_size_c2f), 8, e.uma.ideal_pool_size)?;
+    ov.put(offset_of!(FragRaw, g15_uma_metrics_fwva_c37), 8, e.hwmetrics_fwva)?;
+    ov.put(offset_of!(FragRaw, g15_context_id_generation_c3f), 1, id.ctx_generation.into())?;
+    ov.zero(offset_of!(FragRaw, g15_sku_timing_c40), size_of::<fw::job::raw::G15SkuTimingState>())?;
+
+    let cmd = materialize(a, G15RunFragment { _engine: G15Engine::Frag }, &img)?;
+    Ok(G15BuiltCommand {
+        cmd,
+        command_fwva: cmd_fwva,
+        pipe: PipeType::Fragment,
+        sku,
+        sku_fwva: e.sku_slot_fwva,
+        expect_stamp: (e.fw_stamp_fwva, e.stamp_value),
+    })
+}
+
+/// Little-endian image builder for the two small prelude commands.
+struct Words<const N: usize>([u8; N]);
+
+impl<const N: usize> Words<N> {
+    fn put(&mut self, off: usize, width: usize, v: u64) -> Result {
+        if off + width > N || (width < 8 && v >> (8 * width) != 0) {
+            return Err(EINVAL);
+        }
+        write_le(&mut self.0, off, width, v);
+        Ok(())
+    }
+}
+
+/// Build the 3D-channel Barrier. Native (capture-triangle-1) relations:
+/// both wait pointers are the TA fw_stamp, the wait value/slot are the TA
+/// stamp value/slot, `uuid` is the 3D uuid, and `stamp_self` is a stamp
+/// value of the pass (0x100, equal to both pipes' values in the capture;
+/// taken from the 3D pipe here, as the legacy barrier does).
+// Not inlined: keeps its command image work out of `build_g15_render`.
+#[inline(never)]
+pub(crate) fn build_barrier(
+    a: CmdAlloc<G15Barrier>,
+    inp: &G15RenderInputs<'_>,
+) -> Result<GpuObject<G15Barrier>> {
+    use fw::workqueue::raw::BarrierG15V14_7 as B;
+    let pre = inp.prelude.as_ref().ok_or(EINVAL)?;
+    if inp.ta.fw_stamp_fwva == 0 {
+        return Err(EINVAL);
+    }
+    let mut w = Words([0u8; size_of::<B>()]);
+    w.put(offset_of!(B, tag), 4, fw::workqueue::CommandType::Barrier as u64)?;
+    w.put(offset_of!(B, wait_stamp), 8, inp.ta.fw_stamp_fwva)?;
+    w.put(offset_of!(B, wait_stamp_2), 8, inp.ta.fw_stamp_fwva)?;
+    w.put(offset_of!(B, wait_value), 4, inp.ta.stamp_value.into())?;
+    w.put(offset_of!(B, wait_slot), 4, inp.ta.stamp_slot.into())?;
+    w.put(offset_of!(B, stamp_self), 4, inp.frag.stamp_value.into())?;
+    w.put(offset_of!(B, uuid), 4, inp.id.uuid_frag.into())?;
+    w.put(offset_of!(B, external_barrier), 4, pre.barrier_external.into())?;
+    w.put(offset_of!(B, internal_barrier_type), 4, pre.barrier_internal_type.into())?;
+    materialize(a, G15Barrier {}, &w.0)
+}
+
+/// Build the TA-channel InitBuffer: context ID (D), Info (R) and the TA
+/// stamp value (D; native 0x100, equal for both pipes in the capture).
+// Not inlined: keeps its command image work out of `build_g15_render`.
+#[inline(never)]
+pub(crate) fn build_init_buffer(
+    a: CmdAlloc<G15InitBuffer>,
+    inp: &G15RenderInputs<'_>,
+) -> Result<GpuObject<G15InitBuffer>> {
+    use fw::buffer::raw::InitBufferG15V14_7 as I;
+    let pre = inp.prelude.as_ref().ok_or(EINVAL)?;
+    if inp.pass.buffer_info == 0 {
+        return Err(EINVAL);
+    }
+    let mut w = Words([0u8; size_of::<I<'static>>()]);
+    w.put(offset_of!(I<'static>, tag), 4, fw::workqueue::CommandType::InitBuffer as u64)?;
+    w.put(offset_of!(I<'static>, vm_slot), 4, inp.id.context_id.into())?;
+    w.put(offset_of!(I<'static>, buffer_slot), 4, pre.init_buffer_slot.into())?;
+    w.put(offset_of!(I<'static>, unk_c), 4, pre.init_buffer_unk_c.into())?;
+    w.put(offset_of!(I<'static>, block_count), 4, pre.init_buffer_block_count.into())?;
+    w.put(offset_of!(I<'static>, buffer), 8, inp.pass.buffer_info)?;
+    w.put(offset_of!(I<'static>, stamp_value), 4, inp.ta.stamp_value.into())?;
+    materialize(a, G15InitBuffer {}, &w.0)
+}
+
+/// Allocate and build one pass: Barrier, 3D command, InitBuffer, TA command.
+/// The pair and the tables are boxed (allocated before the commands): the
+/// submit keeps them across several stages, and the tables are only kept for
+/// the dump.
+pub(crate) fn build_g15_render(
+    alloc: &mut gpu::KernelAllocators,
+    inp: &G15RenderInputs<'_>,
+) -> Result<(KBox<G15RenderPair>, KBox<G15RenderTables>)> {
+    inp.profile.validate()?;
+    let pair = KBox::<G15RenderPair>::new_uninit(GFP_KERNEL)?;
+    let mut tables = KBox::write(KBox::new_uninit(GFP_KERNEL)?, G15RenderTables::blank());
+    let allocs = G15RenderAllocs::new(alloc)?;
+    tables.fill(inp, &allocs)?;
+    let G15RenderAllocs {
+        ta,
+        frag,
+        barrier,
+        init_buffer,
+    } = allocs;
+    let barrier = build_barrier(barrier, inp)?;
+    let frag = build_frag(frag, inp, &tables)?;
+    let init_buffer = build_init_buffer(init_buffer, inp)?;
+    let ta = build_ta(ta, inp, &tables)?;
+    Ok((
+        KBox::write(
+            pair,
+            G15RenderPair {
+                barrier,
+                frag,
+                init_buffer,
+                ta,
+            },
+        ),
+        tables,
+    ))
+}
+
+/// Copy of the CPU view of a built command.
+pub(crate) fn command_bytes<T: GpuStruct>(c: &GpuObject<T>) -> Result<KVec<u8>> {
+    c.with(|raw, _| {
+        let n = core::mem::size_of_val(raw);
+        // SAFETY: `raw` is the live, initialized mapping of the command;
+        // reading its bytes is valid for its whole size.
+        let b = unsafe { core::slice::from_raw_parts(raw as *const _ as *const u8, n) };
+        let mut v = KVec::with_capacity(n, GFP_KERNEL)?;
+        v.extend_from_slice(b, GFP_KERNEL)?;
+        Ok(v)
+    })
+}
+
+/// W7 `G15RDMP1` record types.
+#[repr(u32)]
+#[derive(Clone, Copy)]
+pub(crate) enum G15DumpType {
+    Object = 1,
+    Resource = 2,
+    Scalar = 3,
+}
+
+/// W7 `G15RDMP1` engine field.
+#[repr(u32)]
+#[derive(Clone, Copy)]
+pub(crate) enum G15DumpEngine {
+    None = 0,
+    Ta = 1,
+    Frag = 2,
+}
+
+/// Writer for the W7 `G15RDMP1` dump (`research/reuse/i04-render-diff-format.md`).
+pub(crate) struct G15RenderDump {
+    buf: KVec<u8>,
+    count: u32,
+}
+
+impl G15RenderDump {
+    pub(crate) fn new() -> Result<Self> {
+        let mut buf = KVec::new();
+        buf.extend_from_slice(b"G15RDMP1", GFP_KERNEL)?;
+        buf.extend_from_slice(&1u32.to_le_bytes(), GFP_KERNEL)?;
+        buf.extend_from_slice(&0u32.to_le_bytes(), GFP_KERNEL)?;
+        Ok(Self { buf, count: 0 })
+    }
+
+    fn record(
+        &mut self,
+        ty: G15DumpType,
+        eng: G15DumpEngine,
+        name: &str,
+        gpuva: u64,
+        value: u64,
+        payload: &[u8],
+    ) -> Result {
+        let n = name.as_bytes();
+        if n.len() > 32 || u32::try_from(payload.len()).is_err() {
+            return Err(EINVAL);
+        }
+        let mut name32 = [0u8; 32];
+        name32[..n.len()].copy_from_slice(n);
+        self.buf.extend_from_slice(&(ty as u32).to_le_bytes(), GFP_KERNEL)?;
+        self.buf.extend_from_slice(&(eng as u32).to_le_bytes(), GFP_KERNEL)?;
+        self.buf.extend_from_slice(&name32, GFP_KERNEL)?;
+        self.buf.extend_from_slice(&gpuva.to_le_bytes(), GFP_KERNEL)?;
+        self.buf.extend_from_slice(&value.to_le_bytes(), GFP_KERNEL)?;
+        self.buf.extend_from_slice(&(payload.len() as u32).to_le_bytes(), GFP_KERNEL)?;
+        self.buf.extend_from_slice(&0u32.to_le_bytes(), GFP_KERNEL)?;
+        self.buf.extend_from_slice(payload, GFP_KERNEL)?;
+        self.buf
+            .extend_from_slice(&[0u8; 8][..(8 - payload.len() % 8) % 8], GFP_KERNEL)?;
+        self.count += 1;
+        Ok(())
+    }
+
+    pub(crate) fn object(&mut self, e: G15DumpEngine, role: &str, gpuva: u64, b: &[u8]) -> Result {
+        self.record(G15DumpType::Object, e, role, gpuva, b.len() as u64, b)
+    }
+
+    /// Allocate object payload storage while preparing the job, before pipe locks.
+    pub(crate) fn object_storage(
+        &mut self, e: G15DumpEngine, name: &str, gpuva: u64, len: usize,
+    ) -> Result<core::ops::Range<usize>> {
+        let payload_len = u32::try_from(len).map_err(|_| EINVAL)?;
+        let start = self.buf.len();
+        self.record(G15DumpType::Object, e, name, gpuva, len as u64, &[])?;
+        let payload = self.buf.len();
+        self.buf.extend_with(len, 0, GFP_KERNEL)?;
+        self.buf.extend_with((8 - len % 8) % 8, 0, GFP_KERNEL)?;
+        self.buf[start + 56..start + 60].copy_from_slice(&payload_len.to_le_bytes());
+        Ok(payload..payload + len)
+    }
+
+    fn owns_ta(buf: &[u8], ta: u64) -> bool {
+        let le64 = |b: &[u8]| b.iter().rev().fold(0u64, |a, &x| (a << 8) | u64::from(x));
+        buf.len() >= 64 && &buf[..8] == b"G15RDMP1"
+            && le64(&buf[16..20]) == G15DumpType::Object as u64
+            && &buf[24..34] == b"ta_command" && buf[34] == 0
+            && le64(&buf[56..64]) == ta
+    }
+
+    /// Reserve the selected snapshot plus the existing publication scalars,
+    /// before any firmware table/ring publication. Refuse a stale pass dump.
+    pub(crate) fn reserve_selected(buf: &mut KVec<u8>, ta: u64, bytes: usize) -> Result {
+        if !Self::owns_ta(buf, ta) { return Err(EIO); }
+        buf.reserve(bytes.checked_add(1024).ok_or(EINVAL)?, GFP_KERNEL)?;
+        Ok(())
+    }
+
+    /// Append a prepared object batch without allocation at first before_publish.
+    /// No partial append or successful marker exists on stale/capacity errors.
+    pub(crate) fn append_selected(buf: &mut KVec<u8>, ta: u64, batch: &[u8]) -> Result {
+        if !Self::owns_ta(buf, ta) || batch.len() < 16 || &batch[..8] != b"G15RDMP1" {
+            return Err(EIO);
+        }
+        let tail = &batch[16..];
+        if buf.capacity() - buf.len() < tail.len() { return Err(ENOMEM); }
+        let count = u32::from_le_bytes(buf[12..16].try_into().map_err(|_| EINVAL)?);
+        let added = u32::from_le_bytes(batch[12..16].try_into().map_err(|_| EINVAL)?);
+        let total = count.checked_add(added).ok_or(EINVAL)?;
+        // KVec::reserve returns before allocator invocation when capacity suffices.
+        buf.extend_from_slice(tail, GFP_KERNEL)?;
+        buf[12..16].copy_from_slice(&total.to_le_bytes());
+        Ok(())
+    }
+
+    pub(crate) fn resource(&mut self, id: &str, gpuva: u64, size: u64) -> Result {
+        self.record(G15DumpType::Resource, G15DumpEngine::None, id, gpuva, size, &[])
+    }
+
+    pub(crate) fn scalar(&mut self, name: &str, v: u64) -> Result {
+        self.record(G15DumpType::Scalar, G15DumpEngine::None, name, 0, v, &[])
+    }
+
+    /// Append scalar records to a finished dump of the pass whose TA command
+    /// is at `ta_command_fwva` (the first record `dump_g15_render` writes).
+    /// Returns false, leaving `buf` alone, if `buf` holds another dump.
+    pub(crate) fn append_scalars(
+        buf: &mut KVec<u8>,
+        ta_command_fwva: u64,
+        scalars: &[(&str, u64)],
+    ) -> Result<bool> {
+        // Header 16 bytes, then type u32, engine u32, name[32], gpuva u64.
+        const FIRST_NAME: usize = 24;
+        const FIRST_GPUVA: usize = FIRST_NAME + 32;
+        let le64 = |b: &[u8]| b.iter().rev().fold(0u64, |a, &x| (a << 8) | u64::from(x));
+        let name = b"ta_command";
+        let ours = buf.len() >= FIRST_GPUVA + 8
+            && &buf[..8] == b"G15RDMP1"
+            && le64(&buf[16..20]) == G15DumpType::Object as u64
+            && &buf[FIRST_NAME..FIRST_NAME + name.len()] == name
+            && buf[FIRST_NAME + name.len()] == 0
+            && le64(&buf[FIRST_GPUVA..FIRST_GPUVA + 8]) == ta_command_fwva;
+        if !ours {
+            return Ok(false);
+        }
+        let count = u32::try_from(le64(&buf[12..16])).map_err(|_| EINVAL)?;
+        let mut d = Self {
+            buf: core::mem::take(buf),
+            count,
+        };
+        let mut result = Ok(true);
+        for &(n, v) in scalars {
+            if let Err(err) = d.scalar(n, v) {
+                result = Err(err);
+                break;
+            }
+        }
+        *buf = d.finish();
+        result
+    }
+
+    pub(crate) fn finish(mut self) -> KVec<u8> {
+        self.buf[12..16].copy_from_slice(&self.count.to_le_bytes());
+        self.buf
+    }
+}
+
+/// Dump one built pass for the W7 byte-compare: both commands and SKU
+/// streams as objects, every supplied relocation target as a resource
+/// (size 0 where the builder does not know it) and every scalar. Values the
+/// two engines hold separately appear once per engine, with a `_frag` suffix
+/// for the 3D copy when it differs.
+/// The returned dump is unfinished, so the caller can append the objects
+/// it owns (`G15RenderDump::finish` writes the record count).
+pub(crate) fn dump_g15_render(pair: &G15RenderPair, tables: &G15RenderTables) -> Result<G15RenderDump> {
+    use G15RelocTarget as T;
+    let mut d = G15RenderDump::new()?;
+    d.object(
+        G15DumpEngine::Ta,
+        "ta_command",
+        pair.ta.command_fwva,
+        &command_bytes(&pair.ta.cmd)?,
+    )?;
+    d.object(
+        G15DumpEngine::Frag,
+        "fragment_command",
+        pair.frag.command_fwva,
+        &command_bytes(&pair.frag.cmd)?,
+    )?;
+    d.object(G15DumpEngine::Ta, "ta_sku", pair.ta.sku_fwva, &pair.ta.sku)?;
+    d.object(G15DumpEngine::Frag, "fragment_sku", pair.frag.sku_fwva, &pair.frag.sku)?;
+    d.object(
+        G15DumpEngine::Frag,
+        "barrier_command",
+        pair.barrier.gpu_va().get(),
+        &command_bytes(&pair.barrier)?,
+    )?;
+    d.object(
+        G15DumpEngine::Ta,
+        "initbuffer_command",
+        pair.init_buffer.gpu_va().get(),
+        &command_bytes(&pair.init_buffer)?,
+    )?;
+
+    let (ta, fr) = (&tables.ta, &tables.frag);
+    for &t in G15RelocTarget::ALL {
+        if matches!(
+            t,
+            T::TaCommand
+                | T::FragCommand
+                | T::TaSku
+                | T::FragSku
+                | T::BarrierCommand
+                | T::InitBufferCommand
+        ) {
+            continue;
+        }
+        let a = ta.targets.get(t).ok();
+        let b = fr.targets.get(t).ok();
+        if let Some(va) = a.or(b) {
+            d.resource(t.name(), va, 0)?;
+        }
+        if let (Some(a), Some(b)) = (a, b) {
+            if a != b {
+                let mut name = KVec::new();
+                name.extend_from_slice(t.name().as_bytes(), GFP_KERNEL)?;
+                name.extend_from_slice(b"_frag", GFP_KERNEL)?;
+                d.resource(core::str::from_utf8(&name).map_err(|_| EINVAL)?, b, 0)?;
+            }
+        }
+    }
+    for &s in G15ScalarId::ALL {
+        let a = ta.scalars.get(s).ok();
+        let b = fr.scalars.get(s).ok();
+        if let Some(v) = a.or(b) {
+            d.scalar(s.name(), v)?;
+        }
+        if let (Some(a), Some(b)) = (a, b) {
+            if a != b {
+                let mut name = KVec::new();
+                name.extend_from_slice(s.name().as_bytes(), GFP_KERNEL)?;
+                name.extend_from_slice(b"_frag", GFP_KERNEL)?;
+                d.scalar(core::str::from_utf8(&name).map_err(|_| EINVAL)?, b)?;
+            }
+        }
+    }
+    Ok(d)
+}
