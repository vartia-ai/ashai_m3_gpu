+#[allow(dead_code)]
+impl Drop for G15ClientUmaComputeChannelRef {
+    fn drop(&mut self) {
+        if self.released {
+            return;
+        }
+        let retired_pool = {
+            self.container
+                .lock()
+                .release_compute_channel(self.slot_index, self.identity)
+        };
+        crate::debug::g15_trace(format_args!(
+            "uma channel ref drop: slot {} pool {} released; dropping retired owner next",
+            self.slot_index,
+            self.identity.value()
+        ));
+        // Do not run FList/GPU-allocation destructors while holding the
+        // client-container selection mutex.
+        core::mem::drop(retired_pool);
+        crate::debug::g15_trace(format_args!(
+            "uma channel ref drop: slot {} retired owner dropped",
+            self.slot_index
+        ));
+    }
