+                let base = raw as *const fw::initdata::raw::G15Q22Shared as *const u32;
+                let mut nonzero = 0;
+                for off in (START..END).step_by(4) {
+                    // SAFETY: `off` is 4-aligned and below the size of the
+                    // CPU-mapped q22 object (checked above). Firmware may write
+                    // it concurrently, so read it volatile.
+                    let v = unsafe { core::ptr::read_volatile(base.add(off / 4)) };
+                    if v != 0 {
+                        nonzero += 1;
+                        dev_err!(self.dev.as_ref(), "  q22+{:#06x} = {:#010x}\n", off, v);
+                    }
+                }
+                dev_err!(
+                    self.dev.as_ref(),
+                    "G15 recovery snapshot ({}): {} nonzero words\n",
+                    why,
+                    nonzero
+                );
+            });
+        }
+    }
+
+    /// Debugfs `asahi/g15_accounting`: the G15 submission, event and q22
+    /// recovery accounting, one `key=value` per line. Reads host atomics and
+    /// the CPU-mapped q4/q22 words only; writes nothing and never waits on
+    /// firmware. Takes the event allocator lock briefly.
+    #[inline(never)]
+    pub(crate) fn g15_write_accounting(
+        &self,
+        f: &mut core::fmt::Formatter<'_>,
+    ) -> core::fmt::Result {
+        #[ver(G != G15)]
+        let _ = f;
+        #[ver(G == G15)]
+        {
+            let c = &self.g15_counters;
+            let submissions = c.submissions.load(Ordering::Relaxed);
+            let releases = c.releases.load(Ordering::Relaxed);
+            writeln!(f, "crashed={}", u32::from(self.is_crashed()))?;
+            writeln!(f, "submissions={}", submissions)?;
+            writeln!(f, "releases={}", releases)?;
+            writeln!(f, "reservations_armed={}", submissions.wrapping_sub(releases))?;
+            writeln!(f, "completions={}", c.completions.load(Ordering::Relaxed))?;
+            writeln!(
+                f,
+                "completion_errors={}",
+                c.completion_errors.load(Ordering::Relaxed)
+            )?;
+            writeln!(f, "recoveries={}", c.recoveries.load(Ordering::Relaxed))?;
+            let r = &crate::queue::g15_relink::G15_RELINK_TOTALS;
+            writeln!(
+                f,
+                "relink lists={} relinked={} slots={} unsupported={} arena_full={}",
+                r[0].load(Ordering::Relaxed),
+                r[1].load(Ordering::Relaxed),
+                r[2].load(Ordering::Relaxed),
+                r[3].load(Ordering::Relaxed),
+                r[4].load(Ordering::Relaxed)
+            )?;
+
+            let (pending, gate) = self.initdata.g15_globals.with(|raw, _inner| {
+                (
+                    raw.pending_submissions_074.load(Ordering::Acquire),
+                    raw.command_submission_enabled_070.load(Ordering::Acquire),
+                )
+            });
+            // g15_fw_sched_probe=2: a tight cache-invalidating trace (~2M
+            // samples) of the same words, printing every change.
+            #[cfg(CONFIG_DEV_COREDUMP)]
+            if *crate::module_parameters::g15_fw_sched_probe.value() == 2 {
+                let mut changes = KVec::with_capacity(64, GFP_KERNEL).map_err(|_| core::fmt::Error)?;
+                match self.uat.trace_kernel_words(0xfffffc000010e580, 2_000_000, &mut changes) {
+                    Ok(Some((pte, ns))) => {
+                        writeln!(f, "fw_sched_trace samples=2000000 ns={} changes={} pte={:#x}", ns, changes.len(), pte)?;
+                        for (i, w) in changes.iter() {
+                            writeln!(f, "fw_sched_trace_at={} {:#x} {:#x} {:#x}", i, w[0], w[1], w[2])?;
+                        }
+                    }
+                    Ok(None) => writeln!(f, "fw_sched_trace=unmapped")?,
+                    Err(e) => writeln!(f, "fw_sched_trace=err{}", e.to_errno())?,
+                }
+            }
+            // G2 snapshot: firmware staging/pending/master words and the
+            // state-3 filter mask on the scheduler page (FW VA 0xfffffc000010c000).
+            #[cfg(CONFIG_DEV_COREDUMP)]
+            if *crate::module_parameters::g15_fw_sched_probe.value() != 0 {
+                const OFFS: [usize; 6] = [0x2460, 0x2558, 0x2580, 0x2588, 0x2590, 0x39f8];
+                let mut w = [0u64; 6];
+                match self.uat.peek_fw_page(0xfffffc000010c000, &OFFS, &mut w) {
+                    Ok(Some(_)) => writeln!(
+                        f,
+                        "fw_e460={:#x} fw_e558={:#x} fw_e580={:#x} fw_e588={:#x} fw_e590={:#x} fw_f9f8={:#x}",
+                        w[0], w[1], w[2], w[3], w[4], w[5]
+                    )?,
+                    Ok(None) => writeln!(f, "fw_e460=unmapped")?,
+                    Err(e) => writeln!(f, "fw_e460=err{}", e.to_errno())?,
+                }
+            }
+            #[cfg(CONFIG_DEV_COREDUMP)]
+            if *crate::module_parameters::g15_fw_sched_probe.value() != 0 {
+                let mut w = [0u64; 3];
+                match self.uat.probe_kernel_words(0xfffffc000010e580, &mut w) {
+                    Ok(Some(pte)) => writeln!(
+                        f,
+                        "fw_sched_580={:#x} fw_sched_588={:#x} fw_sched_590={:#x} pte={:#x}",
+                        w[0], w[1], w[2], pte
+                    )?,
+                    Ok(None) => writeln!(f, "fw_sched_580=unmapped")?,
+                    Err(e) => writeln!(f, "fw_sched_580=err{}", e.to_errno())?,
+                }
+            }
+            if *crate::module_parameters::g15_job_timing.value() == 2 {
+                for n in 0..crate::debug::G15_STAGE_SLOTS {
+                    let c = crate::debug::G15_STAGE_CNT[n].load(Ordering::Relaxed);
+                    if c != 0 {
+                        let s = crate::debug::G15_STAGE_SUM[n].load(Ordering::Relaxed);
+                        writeln!(f, "stage_ns {} avg={} count={}", n, s / c, c)?;
+                    }
+                }
+            }
+            let w = &crate::queue::g15_render_job::G15_RETIRE_WAITS;
+            writeln!(
+                f,
+                "reseed_age_waits={} reseed_age_wait_total_ns={} reseed_age_wait_max_ns={}",
+                w[0].load(Ordering::Relaxed),
+                w[1].load(Ordering::Relaxed),
+                w[2].load(Ordering::Relaxed)
+            )?;
+            writeln!(f, "q4_pending_submissions={}", pending)?;
+            writeln!(f, "q4_command_gate={}", gate)?;
+            // Firmware-written perf state.
+            let (actual, tgt, cur) = self.initdata.runtime_pointers.hwdata_a.with(|raw, _inner| {
+                // SAFETY: CPU-mapped firmware words, read without a reference held.
+                unsafe {
+                    (
+                        core::ptr::read_volatile(&raw.actual_pstate),
+                        core::ptr::read_volatile(&raw.tgt_pstate),
+                        core::ptr::read_volatile(&raw.cur_pstate),
+                    )
+                }
+            });
+            writeln!(f, "pstate_actual={} pstate_tgt={} pstate_cur={}", actual, tgt, cur)?;
+            for (id, d) in self.g15_uma_descriptors_in_use() {
+                // Packed record: copy the fields out before formatting.
+                let (list, state, pages) = (d.page_pool_list, d.dynamic_state, d.page_count);
+                writeln!(
+                    f,
+                    "uma_descriptor_{}=page_pool_list:{:#x} dynamic_state:{:#x} page_count:{:#x}",
+                    id, { list.0 }, { state.0 }, { pages.0 }
+                )?;
+            }
+
+            let (owned, total) = self.event_manager.owned_slots();
+            writeln!(f, "event_slots_owned={}", owned)?;
+            writeln!(f, "event_slots_total={}", total)?;
+            // G2 (`g15_fw_sched_probe=7`, read-only): the RGX status page,
+            // only while the firmware is parked in the fragment wait (GPU
+            // powered, a fragment job in flight): a baseline from passing
+            // renders for the page dumped at the hang.
+            #[cfg(CONFIG_DEV_COREDUMP)]
+            if *crate::module_parameters::g15_fw_sched_probe.value() == 7 {
+                if self.g15_fragment_parked() {
+                    let mut res = Ok(());
+                    self.g15_rgx_page(&mut |off, v| {
+                        if res.is_ok() {
+                            res = writeln!(f, "rgx+{:#06x}={:#010x}", off, v);
+                        }
+                    });
+                    res?;
+                    writeln!(f, "rgx_parked=1")?;
+                } else {
+                    writeln!(f, "rgx_parked=0")?;
+                }
+            }
+
+            let (halt_count, halted, resume, state_45b0, counter_45c0, stamps) =
+                self.initdata.g15_q22.with(|raw, _inner| {
+                    // SAFETY: both fields are 4-aligned (repr(C), checked
+                    // offsets in an 8-aligned object) and stay mapped while
+                    // `initdata` lives. Firmware writes them, so read volatile.
+                    let (state_45b0, counter_45c0) = unsafe {
+                        (
+                            core::ptr::read_volatile(
+                                core::ptr::addr_of!(raw.state_45b0).cast::<u32>(),
+                            ),
+                            core::ptr::read_volatile(
+                                core::ptr::addr_of!(raw.counter_45c0).cast::<u32>(),
+                            ),
+                        )
+                    };
+                    let stamps = raw
+                        .pending_stamps_40a0
+                        .iter()
+                        .filter(|i| i.info.load(Ordering::Relaxed) & 1 != 0)
+                        .count();
+                    (
+                        raw.halt_count_4580.load(Ordering::Relaxed),
+                        raw.halted_4590.load(Ordering::Relaxed),
+                        raw.resume_45a0.load(Ordering::Relaxed),
+                        state_45b0,
+                        counter_45c0,
+                        stamps,
+                    )
+                });
+            writeln!(f, "q22_halt_count={}", halt_count)?;
+            writeln!(f, "q22_halted={}", halted)?;
+            writeln!(f, "q22_resume={}", resume)?;
+            writeln!(f, "q22_state_45b0={:#x}", state_45b0)?;
+            writeln!(f, "q22_counter_45c0={}", counter_45c0)?;
+            writeln!(f, "q22_pending_stamps={}", stamps)?;
+        }
+        Ok(())
+    }
