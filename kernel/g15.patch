+/// R47: completion record of the last G15 user launch on a queue, written by
+/// the completion callback and read by DRM_IOCTL_ASAHI_G15_READBACK.
+#[derive(Default)]
+pub(crate) struct G15UserStatus {
+    pub(crate) seq: AtomicU64,
+    pub(crate) gpu_start: AtomicU64,
+    pub(crate) gpu_end: AtomicU64,
+    pub(crate) status: AtomicI32,
+    pub(crate) busy: AtomicBool,
+    pub(crate) output_size: AtomicU32,
+}
+
+/// W8f: one G15 user job's claim on its queue's [`G15UserStatus::busy`].
+///
+/// `arm` sets `busy`. The guard then travels with the job's completion
+/// callback payload; the WorkQueue invokes that callback only for a command
+/// that was handed to the firmware-visible queue, and the callback hands the
+/// result over with `complete`, which consumes the guard. Every other way the
+/// payload can go (a `Queue::submit` failure after the job was built, a
+/// `run` failure before publication, a job dropped by the scheduler) drops
+/// the guard uncalled, and `Drop` clears `busy`. Without that, `busy` stayed
+/// set forever and every later readback or submit failed with EBUSY.
+///
+/// The guard is the only writer of `busy == false` for its job, so the two
+/// release paths cannot both run or race. The rollback leaves `seq` and the
+/// timestamps alone (no job completed) and sets `status` to ECANCELED: the
+/// failed submit already replaced the previous job's output (canary fill or
+/// a new render target), so the previous result must not read back as good.
+pub(crate) struct G15UserBusy(Option<Arc<G15UserStatus>>);
+
+impl G15UserBusy {
+    /// Claim `status` for a job whose output is `output_size` bytes. EBUSY
+    /// if a previous job still holds it.
+    pub(crate) fn arm(status: &Arc<G15UserStatus>, output_size: u32) -> Result<Self> {
+        status
+            .busy
+            .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+            .map_err(|_| EBUSY)?;
+        status.output_size.store(output_size, Ordering::Release);
+        Ok(Self(Some(status.clone())))
+    }
+
+    /// Completion callback only: publish the job's result and clear `busy`.
+    pub(crate) fn complete(mut self, gpu_start: u64, gpu_end: u64, result: i32) {
+        if let Some(status) = self.0.take() {
+            status.gpu_start.store(gpu_start, Ordering::Release);
+            status.gpu_end.store(gpu_end, Ordering::Release);
+            status.status.store(result, Ordering::Release);
+            status.seq.fetch_add(1, Ordering::AcqRel);
+            status.busy.store(false, Ordering::Release);
+        }
+    }
+}
+
+impl Drop for G15UserBusy {
+    fn drop(&mut self) {
+        if let Some(status) = self.0.take() {
+            pr_info!("G15 user job dropped before completion; clearing busy\n");
+            status.status.store(ECANCELED.to_errno(), Ordering::Release);
+            status.busy.store(false, Ordering::Release);
+        }
+    }
+}
+
+/// R47: G15 jobs run one at a time across all clients. Firmware expects the
+/// pending-submission count to be 0 at each publication, and the launch heaps
+/// are shared, so two clients publishing together lose a job and wedge the
+/// GPU. A submit takes the device's one `G15JobSlot` before it builds its
+/// command, and the job holds it until its completion callback has run (or
+/// the job is dropped unpublished).
+///
+/// K7: a submit that finds the slot taken sleeps until it is free instead of
+/// failing with EBUSY, so Mesa can pipeline. The wait stays in the ioctl, in
+/// front of the build, rather than in the scheduler: building a G15 command
+/// binds per-channel rotating state and uses the shared heaps, which so far
+/// is only proven with no other G15 job in flight.
+#[pin_data]
+pub(crate) struct G15JobGate {
+    #[pin]
+    busy: Mutex<bool>,
+    #[pin]
+    idle: CondVar,
+    /// Submits sleeping in `G15JobSlot::acquire` (debugfs only).
+    waiters: AtomicU32,
+    /// mmu::Vm id of the job holding the slot (0: none or a teardown).
+    owner: AtomicU64,
+    /// mmu::Vm id of the last job that released the slot.
+    last_owner: AtomicU64,
+}
+
+impl G15JobGate {
+    pub(crate) fn new() -> Result<Arc<Self>> {
+        Arc::pin_init(
+            pin_init!(Self {
+                busy <- new_mutex!(false, "g15_job_gate"),
+                idle <- new_condvar!("g15_job_gate"),
+                waiters: AtomicU32::new(0),
+                owner: AtomicU64::new(0),
+                last_owner: AtomicU64::new(0),
+            }),
+            GFP_KERNEL,
+        )
+    }
+
+    /// Queue teardown: take the slot, uninterruptibly and waiting at most
+    /// `max_ms`, so that no G15 job runs while the queue's firmware resources
+    /// are released. A job keeps the slot until its completion callback has
+    /// run, so once the slot is ours no job (of this queue or another) is on
+    /// the GPU, and none can start before the returned slot drops. The caller
+    /// may be a killed process closing its files: a signal must not cut the
+    /// wait short. None on timeout (`max_ms`) or once the GPU is
+    /// fail-stopped (`gpu_fail_stopped`), which may still run an
+    /// uncancelable job: the caller then retains everything it would free.
+    pub(crate) fn claim_for_teardown(
+        gate: &Arc<Self>,
+        max_ms: u32,
+        gpu_fail_stopped: &dyn Fn() -> bool,
+    ) -> Option<G15JobSlot> {
+        G15_TEARDOWN_CLAIMS.fetch_add(1, Ordering::Relaxed);
+        for waited in 0..=max_ms {
+            // A crashed or fail-stopped GPU may still be running an
+            // uncancelable job that never frees the slot: stop waiting; the
+            // caller retains everything firmware-visible.
+            if gpu_fail_stopped() {
+                G15_TEARDOWN_FAIL_STOPPED.fetch_add(1, Ordering::Relaxed);
+                return None;
+            }
+            {
+                let mut busy = gate.busy.lock();
+                if !*busy {
+                    *busy = true;
+                    if waited > 0 {
+                        G15_TEARDOWN_CONTENDED.fetch_add(1, Ordering::Relaxed);
+                        G15_TEARDOWN_MAX_MS.fetch_max(waited, Ordering::Relaxed);
+                    }
+                    let slot = G15JobSlot(gate.clone());
+                    core::mem::drop(busy);
+                    // Slot held: let the last job's tail finish first.
+                    g15_render_job::g15_wait_teardown_age();
+                    return Some(slot);
+                }
+            }
+            // SAFETY: plain sleep, no locks held.
+            unsafe { kernel::bindings::msleep(1) };
+        }
+        G15_TEARDOWN_TIMEOUTS.fetch_add(1, Ordering::Relaxed);
+        None
+    }
+
+    /// GEM unbind: if the job holding the slot belongs to `vm_id`, wait
+    /// (uninterruptibly, at most `max_ms`) until it completes, so its
+    /// buffers are not unmapped under it (a killed client's handles close
+    /// before any queue teardown). Returns false on timeout.
+    pub(crate) fn wait_vm_job_done(&self, vm_id: u64, max_ms: u32) -> bool {
+        let mut waited = 0;
+        while waited <= max_ms {
+            {
+                let busy = self.busy.lock();
+                if !*busy || self.owner.load(Ordering::Acquire) != vm_id {
+                    if waited > 0 {
+                        G15_UNBIND_WAITS.fetch_add(1, Ordering::Relaxed);
+                        G15_UNBIND_MAX_MS.fetch_max(waited, Ordering::Relaxed);
+                    }
+                    let own_last = self.last_owner.load(Ordering::Acquire) == vm_id;
+                    core::mem::drop(busy);
+                    // This VM's job just finished: let its tail finish too.
+                    if own_last {
+                        g15_render_job::g15_wait_teardown_age();
+                    }
+                    return true;
+                }
+            }
+            // SAFETY: plain sleep, no locks held.
+            unsafe { kernel::bindings::msleep(1) };
+            waited += 1;
+        }
+        G15_UNBIND_TIMEOUTS.fetch_add(1, Ordering::Relaxed);
+        false
+    }
+
+    /// Debugfs `g15_accounting`: (busy, waiters). Takes the gate lock only
+    /// to read the flag; the holder never keeps it across a wait.
+    pub(crate) fn snapshot(&self) -> (bool, u32) {
+        let busy = *self.busy.lock();
+        (busy, self.waiters.load(Ordering::Relaxed))
+    }
+}
+
+/// A field that drops normally unless `retain()` was called, in which case
+/// its value is leaked (G15 teardown that could not take the job slot).
+pub(crate) struct G15Retainable<T> {
+    val: core::mem::ManuallyDrop<T>,
+    retain: bool,
+}
+
+impl<T> G15Retainable<T> {
+    pub(crate) fn new(val: T) -> Self {
+        Self { val: core::mem::ManuallyDrop::new(val), retain: false }
+    }
+
+    /// Leak the value instead of dropping it.
+    pub(crate) fn retain(&mut self) {
+        self.retain = true;
+    }
