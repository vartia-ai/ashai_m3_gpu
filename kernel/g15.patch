+/// G15 PM resources owned as one unit (Apple: AGXParameterManagement, owned
+/// by AGX3DWorkQueue). Replaces the queue's separate `g15_pm_records` (which
+/// lacks the trailing PM state) for the render path.
+pub(crate) struct G15PmPool {
+    // Drop order: the record pool first, then what the records point to.
+    pool: G15Resource,
+    state_offset: usize,
+    state_bytes: usize,
+    scene: G15Resource,
+    scene_geometry: buffer::G15PmSceneGeometry,
+    page_metrics: alloc::G15SharedGpuArray<u8>,
+    scene_stats: alloc::G15SharedGpuArray<u8>,
+}
+
+impl G15PmPool {
+    /// Allocate the PM objects. The page-metrics and scene-statistics
+    /// objects use the same sizes and tags as `Queue::new`, but their native
+    /// bank-1 classes (see `bank1_page_metrics`/`bank1_scene_stats`); the record
+    /// pool's size, alignment and class come from the profile, and the scene
+    /// page sits at the profile's offset from the TVB base, inside a profile
+    /// VA window (capture 5: range-1 0x10_0022_0000).
+    ///
+    /// Checks the profile now and returns an in-place initializer (the pool
+    /// is ~700 bytes) that allocates in order: scene, page metrics, scene
+    /// statistics, record pool. A failure drops what was allocated in
+    /// reverse order, as locals would.
+    fn new<'a>(
+        heaps: &'a G15RenderHeaps<'a>,
+        profile: &'a G15QueueResourceProfile<'a>,
+    ) -> Result<impl Init<Self, Error> + 'a> {
+        let record_bytes = buffer::G15_J615_PM_GPU_RECORD_BYTES;
+        let record_size = core::mem::size_of::<buffer::G15PmRecord>();
+        let state_offset = profile.pm_state_offset.need("pm_state_offset")?;
+        let state_bytes = profile.pm_state_bytes.need("pm_state_bytes")?;
+        let pool_size = profile.pm_pool.size.need("pm_pool")?;
+        if state_offset != record_bytes
+            || state_bytes == 0
+            || state_offset.checked_add(state_bytes).ok_or(EINVAL)? > pool_size
+        {
+            return Err(reject("pm_state_offset/pm_state_bytes"));
+        }
+
+        let geometry = profile.pm_scene.need("pm_scene")?;
+        geometry.validate().map_err(|_| reject("pm_scene"))?;
+        let tvb_base = profile.tvb_blocks.need("tvb_blocks")?.base;
+        let scene_va = tvb_base.checked_add(geometry.offset).ok_or(EINVAL)?;
+        let page = mmu::UAT_PGSZ;
+        if scene_va % page as u64 != 0 {
+            return Err(reject("pm_scene_offset (page alignment)"));
+        }
+        let scene_bytes = geometry.bytes()?.checked_add(page - 1).ok_or(EINVAL)? & !(page - 1);
+        Ok(try_init!(Self {
+            scene: heaps.alloc_in_window(scene_va, scene_bytes, "pm_scene")?,
+            _: {
+                crate::debug::g15_stage(format_args!(
+                    "queue res: PM scene placed at {:#x}",
+                    scene_va
+                ))?;
+            },
+            page_metrics: Self::bank1_page_metrics(heaps)?
+                .array_empty_tagged::<u8>(buffer::G15_J615_PM_PAGE_METRICS_BYTES, b"PMET")?,
+            _: {
+                crate::debug::g15_stage(format_args!(
+                    "queue res: PM page metrics (bank1) at {:#x}",
+                    page_metrics.gpu_va().get()
+                ))?;
+            },
+            scene_stats: Self::bank1_scene_stats(heaps)?
+                .array_empty_tagged::<u8>(buffer::G15_PM_PAGE_LIST_STATS_BYTES, b"PSTS")?,
+            _: {
+                crate::debug::g15_stage(format_args!(
+                    "queue res: PM scene stats (bank1) at {:#x}",
+                    scene_stats.gpu_va().get()
+                ))?;
+            },
+            pool: heaps.alloc(&profile.pm_pool, "pm_pool", b"PMRC", state_offset + state_bytes)?,
+            _: {
+                crate::debug::g15_stage(format_args!(
+                    "queue res: PM record pool at {:#x}",
+                    pool.gpu_va()
+                ))?;
+
+                // Relocation bases of record +0x00/+0x08 (page-metrics array) and
+                // +0x40 (scene-statistics half, +0x40, as in Queue::new).
+                let metrics_base = page_metrics.gpu_va().get();
+                let scene_stats_fwva: u64 = scene_stats.gpu_offset_pointer(0x40).into();
+                let slice = pool.as_mut_slice()?;
+                for i in 0..buffer::G15_J615_PM_RECORD_COUNT {
+                    let rec = buffer::G15PmRecord::new_render(
+                        &geometry,
+                        i as u32,
+                        metrics_base,
+                        scene_stats_fwva,
+                    )?;
+                    let off = buffer::g15_j615_pm_record_offset(i as u32);
+                    if off + record_size > state_offset {
+                        return Err(EINVAL);
+                    }
+                    // SAFETY: `off + size_of::<G15PmRecord>() <= state_offset <= len`
+                    // was checked above, the slice is CPU-mapped kernel memory and
+                    // the write is unaligned-safe.
+                    unsafe {
+                        core::ptr::write_unaligned(
+                            slice.as_mut_ptr().add(off) as *mut buffer::G15PmRecord,
+                            rec,
+                        )
+                    };
+                }
+                crate::debug::g15_stage(format_args!("queue res: PM records written"))?;
+            },
+            state_offset,
+            state_bytes,
+            scene_geometry: geometry,
+        }))
+    }
+
+    /// The bank-1 allocator of the page-metrics object. The GPU's parameter
+    /// manager (gPM_SP) reads it, so it needs the native GPU-readable class:
+    /// leaf 0x00e000000000040b, protection 0x00e0000000000008 (AP0, uncached,
+    /// UXN+PXN), which is `PROT_GPU_FW_SHARED_RW` via the range-7 HWMetrics
+    /// aperture. The FW-only range-7 class faulted (gPM_SP read, NoAccess).
+    /// The native context-1 GPU walk and context-0 FW walk share root and
+    /// leaf, so shared bank 1 is right and no per-VM mapping is needed. The
+    /// allocator keeps no state between allocations.
+    fn bank1_page_metrics(heaps: &G15RenderHeaps<'_>) -> Result<alloc::G15SharedBank1Allocator> {
+        Ok(alloc::G15SharedBank1Allocator::new_range7_hwmetrics(
+            heaps.dev,
+            heaps.bank1.as_ref().ok_or(EINVAL)?.clone(),
+            buffer::PAGE_SIZE,
+            true,
+            heaps.mapping_notifier.clone(),
+        ))
+    }
+
+    /// The bank-1 allocator of the scene-statistics object. Native class:
+    /// leaf 0x00c000000000044b, protection 0x00c0000000000048 (FW-only AP1,
+    /// uncached), which is `PROT_G15_RANGE7_QUEUE_STATE` via the range-7
+    /// queue-state aperture. Shared bank 1, as for the page metrics.
+    fn bank1_scene_stats(heaps: &G15RenderHeaps<'_>) -> Result<alloc::G15SharedBank1Allocator> {
+        Ok(alloc::G15SharedBank1Allocator::new_range7_timestamp_queue(
+            heaps.dev,
+            heaps.bank1.as_ref().ok_or(EINVAL)?.clone(),
+            buffer::PAGE_SIZE,
+            true,
+            heaps.mapping_notifier.clone(),
+        ))
+    }
+
+    /// CPU view of the PM scene statistics object, for diagnostic dumps.
+    pub(crate) fn scene_stats_bytes(&self) -> &[u8] {
+        self.scene_stats.as_slice()
+    }
+
+    /// CPU view of the PM page-metrics array (one u32 slot per record), for
+    /// diagnostic dumps.
+    pub(crate) fn page_metrics_bytes(&self) -> &[u8] {
+        self.page_metrics.as_slice()
+    }
+
+    /// CPU view of the PM record pool (records plus trailing state), for
+    /// diagnostic dumps.
+    pub(crate) fn pool_bytes(&self) -> Result<&[u8]> {
+        self.pool.as_slice()
+    }
+
+    /// PM record pool base (PMPOOL).
+    pub(crate) fn pool_va(&self) -> u64 {
+        self.pool.gpu_va()
+    }
+
+    /// Selected record (TA `+0x2c`, 3D `+0x30`).
+    pub(crate) fn record_va(&self, index: u32) -> u64 {
+        self.pool.gpu_va() + buffer::g15_j615_pm_record_offset(index) as u64
+    }
+
+    /// PM state (TA `+0x34`, 3D `+0x38`).
+    pub(crate) fn state_va(&self) -> u64 {
+        self.pool.gpu_va() + self.state_offset as u64
+    }
+
+    /// GPUVA of the scene slot that record `index` names in `+0x28`.
+    pub(crate) fn scene_slice_va(&self, index: u32) -> Result<u64> {
+        let rel = self.scene_geometry.slice(index)? - self.scene_geometry.offset;
+        self.scene.gpu_va().checked_add(rel).ok_or(EINVAL)
+    }
+
+    /// Add the record pool (records only, without the PM state) and the
+    /// relocation bases of the record words to a dump: `pm_scene` (+0x28 /
+    /// +0x30 offsets resolve against it), `pm_page_metrics_array` (+0x00 /
+    /// +0x08 = base + 4 * i) and `pm_scene_stats` (+0x40 = base + 0x40).
+    pub(crate) fn dump(&self, d: &mut super::g15_render::G15RenderDump) -> Result {
+        use super::g15_render::G15DumpEngine;
+        let records = self.pool.as_slice()?.get(..self.state_offset).ok_or(EINVAL)?;
+        d.object(G15DumpEngine::None, "pm_records", self.pool.gpu_va(), records)?;
+        d.resource("pm_scene", self.scene.gpu_va(), self.scene.len() as u64)?;
+        d.scalar("pm_scene_offset", self.scene_geometry.offset)?;
+        d.resource(
+            "pm_page_metrics_array",
+            self.page_metrics.gpu_va().get(),
+            self.page_metrics.len() as u64,
+        )?;
+        d.resource(
+            "pm_scene_stats",
+            self.scene_stats.gpu_va().get(),
+            self.scene_stats.len() as u64,
+        )
+    }
+
+    /// Selected page-metrics slot (PMR `+0x0`, TA reg 0x1c910 source).
+    pub(crate) fn page_metrics_va(&self, index: u32) -> u64 {
+        self.page_metrics.gpu_va().get()
+            + buffer::g15_j615_pm_page_metrics_slot_offset(index) as u64
+    }
+}
