+    /// (TA +0x900, 3D +0xc48: SKU timing +0x08). Dump only.
+    ta_complete: u64,
+    frag_complete: u64,
+    /// `g15_job_timing` CPU stamps (ns): submit in, slot taken, published,
+    /// TA callback, 3D callback.
+    t: [u64; 5],
+    /// The same as system counter ticks: published, TA callback, 3D callback.
+    c: [u64; 3],
+    /// 3D +0xb64 `tvb_overflow_count` at completion (the kernel zeroes it
+    /// when it builds the command), logged; it stays 0 on G15.
+    frag_tvb_overflow: u32,
+    /// 3D +0xb74: partial renders the firmware ran for the pass (native
+    /// capture), logged.
+    frag_partials: u32,
+    /// This job wrote the current G15RDMP1 dump; its first record is the
+    /// TA command at this FWVA. The completion values are appended to it.
+    dump_ta_command: Option<u64>,
