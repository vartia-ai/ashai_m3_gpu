+/// Per-queue render resources. W8 creates this once per render queue (on
+/// first render submission) and keeps an `Arc` in the queue; every pass
+/// holds another `Arc` until retirement.
+pub(crate) struct G15RenderQueueResources {
+    // Drop order: PB lease, FW page list, PM pool, TVB blocks.
+    pb: G15PbEntry,
+    fw_page_list: G15Resource,
+    pm: G15PmPool,
+    tvb: G15TvbBlocks,
+}
+
+impl G15RenderQueueResources {
+    /// `buffer_info` is the FWVA of the queue's TVB buffer Info object.
+    ///
+    /// Built in place in the `Arc` (allocated first), in allocation order:
+    /// TVB, PM, FW page list, PB entry. A failure drops what was built in
+    /// reverse order, as locals would.
+    #[inline(never)]
+    pub(crate) fn new(
+        heaps: &G15RenderHeaps<'_>,
+        pb_slots: &G15PbSlotAllocator,
+        buffer_info: u64,
+        profile: &G15QueueResourceProfile<'_>,
+    ) -> Result<Arc<Self>> {
+        Arc::try_init(
+            try_init!(Self {
+                tvb: G15TvbBlocks::new(heaps, profile.tvb_blocks, profile.tvb_page_list)?,
+                _: {
+                    crate::debug::g15_stage(format_args!("queue res: TVB done"))?;
+                },
+                pm <- G15PmPool::new(heaps, profile)?,
+                _: {
+                    crate::debug::g15_stage(format_args!("queue res: PM pool done"))?;
+                },
+                fw_page_list: heaps.alloc(&profile.fw_page_list, "fw_page_list", b"FWPL", 0)?,
+                _: {
+                    crate::debug::g15_stage(format_args!(
+                        "queue res: FW page list at {:#x}",
+                        fw_page_list.gpu_va()
+                    ))?;
+                },
+                pb: G15PbEntry::new(
+                    pb_slots,
+                    profile.pb_descriptor,
+                    &G15PbTargets {
+                        buffer_info,
+                        pm_pool: pm.pool_va(),
+                        fw_page_list: fw_page_list.gpu_va(),
+                        tvb_page_list: tvb.page_list().map(|(va, _)| va),
+                    },
+                )?,
+                _: {
+                    crate::debug::g15_stage(format_args!(
+                        "queue res: PB entry slot {}",
+                        pb.slot()
+                    ))?;
+                },
+            }),
+            GFP_KERNEL,
+        )
+    }
+
+    pub(crate) fn pm(&self) -> &G15PmPool {
+        &self.pm
+    }
+
+    pub(crate) fn pb(&self) -> &G15PbEntry {
+        &self.pb
+    }
+
+    pub(crate) fn tvb(&self) -> &G15TvbBlocks {
+        &self.tvb
+    }
+
+    pub(crate) fn fw_page_list_va(&self) -> u64 {
+        self.fw_page_list.gpu_va()
+    }
+}
