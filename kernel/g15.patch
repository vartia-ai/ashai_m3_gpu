+/// Queue-lifetime render state, built by the first user render.
+pub(super) struct G15QueueRenderState {
+    /// `G15KernelProfile::queue_key` of the profile that built it.
+    key: u64,
+    res: Arc<G15RenderQueueResources>,
+    /// Whether `g15_pb_desc_table[slot]` holds this queue's descriptor.
+    pb_published: bool,
+    /// The GPU timing record every pass of this queue shares. The firmware
+    /// may still write it after a pass's completion is signalled; freeing it
+    /// per pass raced that and left q22 unserviced (firmware crash on the
+    /// unmap). One job runs at a time, so passes never overlap on it.
