+pub(crate) fn load_g15_launch_input(
+    dev: &kernel::device::Device,
+) -> Result<Option<crate::queue::launch_input::LaunchInput>> {
+    use crate::queue::launch_input::{LaunchInput, HEADER_CELLS, MAX_CELLS};
+    let node = dev.fwnode().ok_or(EIO)?;
+    let name = c_str!("brian,g15-launch-v1");
+    if !node.property_present(name) {
+        return Ok(None);
+    }
+    let count = node.property_count_elem::<u32>(name)?;
+    if !(HEADER_CELLS..=MAX_CELLS).contains(&count) {
+        return Err(EINVAL);
+    }
+    let cells: KVec<u32> = node.property_read_array_vec(name, count)?.required_by(dev)?;
+    let input = LaunchInput::parse(cells.as_slice()).map_err(|error| {
+        dev_err!(dev, "J613 G15 launch input rejected: {:?}\n", error);
+        EINVAL
+    })?;
+    Ok(Some(input))
+}
