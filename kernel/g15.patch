+/// Linux address per relocation target. Zero means "not supplied".
+#[derive(Clone, Debug)]
+pub(crate) struct G15TargetTable {
+    va: [u64; G15RelocTarget::COUNT],
+}
+
+impl G15TargetTable {
+    pub(crate) const fn new() -> Self {
+        Self {
+            va: [0; G15RelocTarget::COUNT],
+        }
+    }
+
+    /// Supply a target once. A zero address or a conflicting second value is
+    /// rejected.
+    pub(crate) fn set(&mut self, t: G15RelocTarget, va: u64) -> Result {
+        let slot = &mut self.va[t.idx()];
+        if va == 0 || (*slot != 0 && *slot != va) {
+            return Err(EINVAL);
+        }
+        *slot = va;
+        Ok(())
+    }
+
+    pub(crate) fn get(&self, t: G15RelocTarget) -> Result<u64> {
+        match self.va[t.idx()] {
+            0 => Err(EINVAL),
+            va => Ok(va),
+        }
+    }
+}
+
+/// Linux scalar values for D fields.
+#[derive(Clone, Debug)]
+pub(crate) struct G15ScalarTable {
+    val: [Option<u64>; G15ScalarId::COUNT],
+}
+
+impl G15ScalarTable {
+    pub(crate) const fn new() -> Self {
+        Self {
+            val: [None; G15ScalarId::COUNT],
+        }
+    }
+
+    pub(crate) fn set(&mut self, id: G15ScalarId, v: u64) -> Result {
+        let slot = &mut self.val[id.idx()];
+        if matches!(*slot, Some(old) if old != v) {
+            return Err(EINVAL);
+        }
+        *slot = Some(v);
+        Ok(())
+    }
+
+    pub(crate) fn get(&self, id: G15ScalarId) -> Result<u64> {
+        self.val[id.idx()].ok_or(EINVAL)
+    }
+}
+
+fn width_mask(width: u8) -> Result<u64> {
+    match width {
+        1 | 2 | 4 => Ok((1u64 << (width as u32 * 8)) - 1),
+        8 => Ok(!0),
+        _ => Err(EINVAL),
+    }
+}
+
+impl G15Encoding {
+    fn check(&self, width: u8) -> Result {
+        let wmask = width_mask(width)?;
+        if width != 4 && width != 8 {
+            return Err(EINVAL);
+        }
+        if let G15Encoding::Bitfield {
+            address_shift,
+            field_shift,
+            mask,
+            ..
+        } = *self
+        {
+            if address_shift >= 64 || field_shift >= 64 || mask == 0 || mask & !wmask != 0 {
+                return Err(EINVAL);
+            }
+        }
+        Ok(())
+    }
+}
+
+impl G15Reloc {
+    /// Encode this relocation for a `width`-byte word whose native value is
+    /// `native`. Fails on a missing target, lost alignment bits, overflow
+    /// past the mask or width, or a target below the base.
+    pub(crate) fn encode(&self, native: u64, width: u8, t: &G15TargetTable) -> Result<u64> {
+        self.encoding.check(width)?;
+        let wmask = width_mask(width)?;
+        let addr = t
+            .get(self.target)?
+            .checked_add_signed(self.addend)
+            .ok_or(EOVERFLOW)?;
+        let word = match self.encoding {
+            G15Encoding::FullAddress => addr,
+            G15Encoding::Bitfield {
+                base,
+                address_shift,
+                field_shift,
+                mask,
+            } => {
+                let base = match base {
+                    G15AddrBase::Literal(b) => b,
+                    G15AddrBase::Target(bt) => t.get(bt)?,
+                };
+                let off = addr.checked_sub(base).ok_or(EINVAL)?;
+                if off & ((1u64 << address_shift) - 1) != 0 {
+                    return Err(EINVAL);
+                }
+                let v = off >> address_shift;
+                let f = v << field_shift;
+                if f >> field_shift != v || f & !mask != 0 {
+                    return Err(EINVAL);
+                }
+                (native & !mask) | f
+            }
+        };
+        if word & !wmask != 0 {
+            return Err(EINVAL);
+        }
+        Ok(word)
+    }
+}
+
+/// Everything a serializer reads: the profile plus the builder's Linux
+/// addresses and scalars.
+#[derive(Clone, Copy)]
+pub(crate) struct G15Resolver<'a> {
+    pub(crate) profile: &'a G15RenderProfile<'a>,
+    pub(crate) targets: &'a G15TargetTable,
+    pub(crate) scalars: &'a G15ScalarTable,
+}
+
+impl<'a> G15Resolver<'a> {
+    fn list(&self, e: G15Engine) -> &'a G15RegList<'a> {
+        match e {
+            G15Engine::Ta => &self.profile.ta_regs,
+            G15Engine::Frag => &self.profile.frag_regs,
+        }
+    }
+
+    fn find(&self, r: G15RegRef) -> Result<&'a G15RegEntry> {
+        self.list(r.engine)
+            .entries
+            .iter()
+            .find(|e| e.reg == r.reg)
+            .ok_or(EINVAL)
+    }
+
+    /// Value one field or register gets, for a `width`-byte destination.
+    /// `allow_reg_src` is false while resolving the source of a register
+    /// reference, which rejects chains.
+    fn eval(&self, native: u64, prov: &G15Prov, width: u8, allow_reg_src: bool) -> Result<u64> {
+        let wmask = width_mask(width)?;
+        let v = match prov {
+            G15Prov::Native => native,
+            G15Prov::FwOwned => 0,
+            G15Prov::Reloc(r) => r.encode(native, width, self.targets)?,
+            G15Prov::Derived(d) => {
+                let src = match d.src {
+                    G15DerivedSrc::Scalar(id) => self.scalars.get(id)?,
+                    G15DerivedSrc::Reg(r) => {
+                        if !allow_reg_src {
+                            return Err(EINVAL);
+                        }
+                        let e = self.find(r)?;
+                        self.eval(e.native, &e.prov, 8, false)?
+                    }
+                };
+                d.op.apply(src)?
+            }
+            G15Prov::LiveControl | G15Prov::Unresolved => return Err(EINVAL),
+        };
+        if v & !wmask != 0 {
+            return Err(EINVAL);
+        }
+        Ok(v)
+    }
+
+    /// Resolved value of one register. W4 uses this for command fields that
+    /// mirror a register (for example a 3D RTM word equal to a 3D register).
+    pub(crate) fn reg_value(&self, r: G15RegRef) -> Result<u64> {
+        let e = self.find(r)?;
+        self.eval(e.native, &e.prov, 8, true)
+    }
+}
+
+/// Destination of a register list. `RegisterArray` implements it; tests and
+/// the W7 dump can use their own.
+pub(crate) trait G15RegSink {
+    fn len(&self) -> usize;
+    fn push(&mut self, reg: u32, value: u64);
+    fn clear(&mut self);
+}
+
+impl G15RegSink for RegisterArray {
+    fn len(&self) -> usize {
+        self.count as usize
+    }
+
+    fn push(&mut self, reg: u32, value: u64) {
+        self.add(reg, value);
+    }
+
+    fn clear(&mut self) {
+        for i in 0..G15_REG_LIST_MAX {
+            self.registers[i] = Default::default();
+        }
+        self.count = 0;
+        self.length = 0;
+    }
+}
+
+impl G15RegList<'_> {
+    fn validate(&self, engine: G15Engine) -> Result {
+        if self.engine != engine || self.entries.len() > G15_REG_LIST_MAX {
+            return Err(EINVAL);
+        }
+        for (i, e) in self.entries.iter().enumerate() {
+            if self.entries[..i].iter().any(|p| p.reg == e.reg) {
+                return Err(EINVAL);
+            }
+            match e.prov {
+                G15Prov::Native | G15Prov::Derived(_) => {}
+                G15Prov::Reloc(r) => r.encoding.check(8)?,
+                G15Prov::FwOwned | G15Prov::LiveControl | G15Prov::Unresolved => {
+                    return Err(EINVAL)
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// Emit every entry, in profile order, into an empty `out`. On error,
+    /// `out` is cleared.
+    pub(crate) fn emit(&self, r: &G15Resolver<'_>, out: &mut impl G15RegSink) -> Result<usize> {
+        if out.len() != 0 || self.entries.len() > G15_REG_LIST_MAX {
+            return Err(EINVAL);
+        }
+        for e in self.entries {
+            match r.eval(e.native, &e.prov, 8, true) {
+                Ok(v) => out.push(e.reg, v),
+                Err(err) => {
+                    out.clear();
+                    return Err(err);
+                }
+            }
+        }
+        Ok(self.entries.len())
+    }
+
+    /// I09 R3: the overrides for this list's engine, applied after
+    /// [`Self::emit`]. Every override register must be in the list as a
+    /// native (N) entry, else EINVAL. `set(index, reg, profile, user)` gets
+    /// each one's position in the emitted list, the profile value `emit`
+    /// wrote there and the user value to write instead.
+    pub(crate) fn user_overrides(
+        &self,
+        overrides: &[G15RegOverride],
+        mut set: impl FnMut(usize, u32, u64, u64),
+    ) -> Result {
+        for o in overrides.iter().filter(|o| o.reg.engine == self.engine) {
+            let (index, e) = self
+                .entries
+                .iter()
+                .enumerate()
+                .find(|(_, e)| e.reg == o.reg.reg)
+                .ok_or(EINVAL)?;
+            if e.prov != G15Prov::Native {
+                return Err(EINVAL);
+            }
+            set(index, e.reg, e.native, o.apply(e.native));
+        }
+        Ok(())
+    }
+}
+
+/// I09 R3: one register value a HYBRID render takes from its
+/// `drm_asahi_cmd_render` instead of the profile's native (N) value.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15RegOverride {
+    pub(crate) reg: G15RegRef,
+    pub(crate) value: u64,
+    /// Bits `value` replaces (I09 R4: the tile fields of 0x16068); the
+    /// profile's value keeps the others.
+    pub(crate) mask: u64,
+}
+
+impl G15RegOverride {
+    /// The register value with this override applied to `profile`.
+    pub(crate) fn apply(&self, profile: u64) -> u64 {
+        (profile & !self.mask) | (self.value & self.mask)
+    }
+}
+
+/// I09 R4: a `width` x `height` target's 32x32 tiles, `(tx, ty)`; both at
+/// least 1.
+pub(crate) fn g15_tiles(width: u16, height: u16) -> (u64, u64) {
+    let t = |px: u16| u64::from(px.max(1)).div_ceil(32);
+    (t(width), t(height))
+}
+
+/// Number of registers [`g15_user_reg_overrides`] writes.
+pub(crate) const G15_USER_REG_COUNT: usize = 31;
+
+/// I09 R3: `drm_asahi_cmd_render` field to G15 register, with the legacy
+/// G15 arm's formulas (`queue/render.rs`): each field is the register value
+/// unchanged, except 0x15211 = `height_px << 32 | width_px`. Only registers
+/// that are native (N) in the I04 triangle profile and equal Mesa's value
+/// there (research/g15-i09-ordinary-render.md section 2). The scissor and
+/// depth-bias bases, 0x15021, layers, utile and sample registers stay with
+/// the profile.
+///
+/// I09 R4: the size registers, as the native 128x128, 160x160, 256x256 and
+/// 200x120 captures relate them to the target (32x32 tiles, `tx` by `ty`):
+/// TA 0x10129 = `(height - 1) << 16 | (width - 1)`, TA 0x101b9 and 3D
+/// 0x100d9 = `(ty - 1) << 12 | (tx - 1)`, and 3D 0x16068 keeps the profile's
+/// value except `tx - 1` at bit 44 and `ty - 1` at bit 53.
+///
+/// Depth (the native D32F captures): 3D 0x15321 = `isp_zls_pixels` and
+/// 0x15329/0x15331 (Z load/store base) = `depth.base`; all 0 without depth.
+pub(crate) fn g15_user_reg_overrides(
+    f: &crate::render_input::G15UserRegFields,
+) -> [G15RegOverride; G15_USER_REG_COUNT] {
+    let m = |engine, reg, value, mask| G15RegOverride {
+        reg: G15RegRef { engine, reg },
+        value,
+        mask,
+    };
+    let o = |engine, reg, value| m(engine, reg, value, u64::MAX);
+    use G15Engine::{Frag, Ta};
+    let (w, h) = (u64::from(f.width_px), u64::from(f.height_px));
+    let size = (h << 32) | w;
+    let (tx, ty) = g15_tiles(f.width_px, f.height_px);
+    let tiles = ((ty - 1) << 12) | (tx - 1);
+    let tile_fields = ((ty - 1) << 53) | ((tx - 1) << 44);
+    // Tiling geometry, as `get_tiling_params` derives it for one layer and
+    // 32x32 utiles (one utile per tile): 4x4 macrotiles, each a multiple of
+    // 4 tiles per side. The native refs (all <= 256 px) only show the 128x128
+    // values, which these reproduce; larger targets need their own.
+    let tpm_x = tx.div_ceil(4).next_multiple_of(4);
+    let tpm_y = ty.div_ceil(4).next_multiple_of(4);
+    let tiles_per_mtile = tpm_x * tpm_y;
+    let rgn_size = (5 * tiles_per_mtile).next_multiple_of(4) / 4;
+    let mtile = |t: u64| (3 * t) | ((2 * t) << 9) | (t << 18);
+    let isp_mtile = tpm_y | (tpm_x << 16);
+    // Tiler mode selectors (3D 0x10039 0x280, TA 0x10141 0x200, 3D 0x16068
+    // bit 37) off, as both renders of the native 2560x1664 clear+store,
+    // load+store pair have them; and 0x10039's process-empty-tiles bit from
+    // the command flag (set only on that pair's clearing render). The
+    // small-target profile has the selectors on; with them on, large
+    // targets that load a full surface crash the firmware at the next GPU
+    // power-down (the sustained-load SError).
+    let pet = if f.load_pass { 0 } else { 0x1_0000 };
+    let psg_bits = u64::from(*crate::module_parameters::g15_ta_psg_bits.value());
+    let stencil_ta = *crate::module_parameters::g15_render_stencil.value() >= 2;
+    [
+        // G2: Rogue TE_PSG.cs_size candidate bit 21 set in TA 0x1c0b1/0x1c850
+        // leaves the TA's tile lists byte-identical; not a live chunk-size
+        // control on G15 (g2psg21-172138).
+        // G2 (`g15_ta_psg_bits`): extra TE_PSG bits, e.g. 0x4000 = Rogue
+        // cache_bypass (bit 14); native clears it.
+        o(Ta, 0x1c0b1, rgn_size | psg_bits),
+        o(Ta, 0x1c850, rgn_size | psg_bits),
+        o(Frag, 0x16431, rgn_size << 26),
+        o(Ta, 0x1c069, mtile(tpm_x)),
+        o(Ta, 0x1c071, mtile(tpm_y)),
+        o(Ta, 0x1c081, tiles_per_mtile),
+        o(Ta, 0x1c0a9, 8 * tiles_per_mtile / 4),
+        o(Frag, 0x100b1, isp_mtile),
+        o(Frag, 0x16030, isp_mtile),
+        o(Ta, 0x10129, ((h - 1) << 16) | (w - 1)),
+        o(Ta, 0x101b9, tiles),
+        o(Frag, 0x100d9, tiles),
+        m(Frag, 0x16068, tile_fields, (0x1ff << 53) | (0x1ff << 44) | (1 << 37)),
+        o(Frag, 0x10039, pet),
+        o(Ta, 0x10141, 0),
+        o(Frag, 0x15131, f.isp_merge_upper_x.into()),
+        o(Frag, 0x15139, f.isp_merge_upper_y.into()),
+        o(Ta, 0x10121, f.ppp_ctrl.into()),
+        o(Frag, 0x15319, f.zls_ctrl),
+        o(Frag, 0x10019, f.ppp_multisamplectl),
+        o(Ta, 0x10139, f.ppp_multisamplectl),
+        o(Frag, 0x15301, f.isp_bgobjdepth.into()),
+        o(Frag, 0x15309, f.isp_bgobjvals.into()),
+        o(Frag, 0x15211, size),
+        o(Frag, 0x15321, f.isp_zls_pixels.into()),
+        o(Frag, 0x15329, f.depth_base),
+        o(Frag, 0x15331, f.depth_base),
+        // Stencil (`g15_render_stencil`, uncompressed level-0 S8; Apple's
+        // register producers, not yet seen in a native capture): S load and
+        // store base, 0x15229 the base at 128-byte alignment, TA 0x1c1b9 at
+        // 256-byte alignment (mode 2). All 0 without stencil, as natively.
+        o(Frag, 0x15339, f.stencil_base),
+        o(Frag, 0x15341, f.stencil_base),
+        o(Frag, 0x15229, f.stencil_base & !0x7f),
+        m(Ta, 0x1c1b9, f.stencil_base & !0xff, if stencil_ta { u64::MAX } else { 0 }),
+    ]
+}
+
+/// I09 R7: the 3D registers of a background (`eot` false) or end-of-tile
+/// program a command brings (`[usc, rsrc_spec]`, see `G15UserRegFields`).
+/// The USC registers hold full addresses: the fixed 1-TiB USC base plus the
+/// command's 32-bit offset, as the native triangle's 0x100_0062_0240 does.
+pub(crate) fn g15_user_tile_program_overrides(eot: bool, program: [u32; 2]) -> [G15RegOverride; 2] {
+    const USC_BASE: u64 = 1 << 40;
+    let o = |reg, value| G15RegOverride {
+        reg: G15RegRef {
+            engine: G15Engine::Frag,
+            reg,
+        },
+        value,
+        mask: u64::MAX,
+    };
+    let (usc, rsrc) = if eot { (0x15381, 0x15379) } else { (0x15371, 0x15369) };
+    [o(usc, USC_BASE | u64::from(program[0])), o(rsrc, program[1].into())]
+}
+
+impl G15Resolver<'_> {
+    /// [`Self::reg_value`] after the I09 R3 `overrides`: the value
+    /// [`G15RegList::user_overrides`] writes for an overridden register (which
+    /// must be N in the profile), else the profile's.
+    pub(crate) fn reg_value_with(&self, r: G15RegRef, overrides: &[G15RegOverride]) -> Result<u64> {
+        match overrides.iter().find(|o| o.reg == r) {
+            Some(o) => match self.find(r)? {
+                e if e.prov == G15Prov::Native => Ok(o.apply(e.native)),
+                _ => Err(EINVAL),
+            },
+            None => self.reg_value(r),
+        }
+    }
+}
+
+fn read_le(bytes: &[u8], off: usize, width: usize) -> u64 {
+    bytes[off..off + width]
+        .iter()
+        .rev()
+        .fold(0u64, |acc, b| (acc << 8) | *b as u64)
+}
+
+fn write_le(bytes: &mut [u8], off: usize, width: usize, v: u64) {
+    for (i, b) in bytes[off..off + width].iter_mut().enumerate() {
+        *b = (v >> (8 * i)) as u8;
+    }
+}
+
+impl G15ByteTemplate<'_> {
+    fn validate(&self, p: &G15RenderProfile<'_>) -> Result {
+        let len = self.bytes.len();
+        if len == 0 || len > G15_TEMPLATE_MAX_BYTES {
+            return Err(EINVAL);
+        }
+        let mut end = 0usize;
+        for f in self.patches {
+            let off = f.offset as usize;
+            let w = f.width as usize;
+            width_mask(f.width)?;
+            if off < end || off.checked_add(w).ok_or(EINVAL)? > len {
+                return Err(EINVAL);
+            }
+            end = off + w;
+            if read_le(self.bytes, off, w) != f.native {
+                return Err(EINVAL);
+            }
+            match f.prov {
+                G15Prov::Native | G15Prov::FwOwned => {}
+                G15Prov::Reloc(r) => r.encoding.check(f.width)?,
+                G15Prov::Derived(d) => {
+                    if let G15DerivedSrc::Reg(rr) = d.src {
+                        reg_src_ok(p, rr)?;
+                    }
+                }
+                G15Prov::LiveControl | G15Prov::Unresolved => return Err(EINVAL),
+            }
+        }
+        Ok(())
+    }
+
+    /// Copy the template into `out`, zero the rest of `out`, and apply every
+    /// patch. On error `out` is all zero.
+    pub(crate) fn serialize(&self, r: &G15Resolver<'_>, out: &mut [u8]) -> Result<usize> {
+        out.fill(0);
+        let res = self.serialize_inner(r, out);
+        if res.is_err() {
+            out.fill(0);
+        }
+        res
+    }
+
+    fn serialize_inner(&self, r: &G15Resolver<'_>, out: &mut [u8]) -> Result<usize> {
+        let len = self.bytes.len();
+        if len == 0 || len > G15_TEMPLATE_MAX_BYTES || out.len() < len {
+            return Err(EINVAL);
+        }
+        out[..len].copy_from_slice(self.bytes);
+        let mut end = 0usize;
+        for f in self.patches {
+            let off = f.offset as usize;
+            let w = f.width as usize;
+            if off < end || off.checked_add(w).ok_or(EINVAL)? > len {
+                return Err(EINVAL);
+            }
+            end = off + w;
+            let v = r.eval(f.native, &f.prov, f.width, true)?;
+            write_le(out, off, w, v);
+        }
+        Ok(len)
+    }
+}
+
+fn reg_src_ok(p: &G15RenderProfile<'_>, rr: G15RegRef) -> Result {
+    let list = match rr.engine {
+        G15Engine::Ta => &p.ta_regs,
+        G15Engine::Frag => &p.frag_regs,
+    };
+    let e = list.entries.iter().find(|e| e.reg == rr.reg).ok_or(EINVAL)?;
+    match e.prov {
+        G15Prov::Derived(G15Derived {
+            src: G15DerivedSrc::Reg(_),
+            ..
+        }) => Err(EINVAL),
+        _ => Ok(()),
+    }
+}
+
+impl G15RenderProfile<'_> {
+    /// The I03 completeness gate plus structural checks. Builders call this
+    /// once per profile and refuse to build from a profile that fails it.
+    /// An evidence dry-run or TRIAL view skips only the unresolved count:
+    /// its native uncertainties are recorded, not missing. An evidence view
+    /// never publishes; a TRIAL view publishes only under the trial switch.
+    /// `ready` and every structural check still apply.
+    pub(crate) fn validate(&self) -> Result {
+        if !self.ready || (self.unresolved != 0 && self.kind == G15ViewKind::Replay) {
+            return Err(EINVAL);
+        }
+        self.ta_regs.validate(G15Engine::Ta)?;
+        self.frag_regs.validate(G15Engine::Frag)?;
+        for e in Iterator::chain(self.ta_regs.entries.iter(), self.frag_regs.entries) {
+            if let G15Prov::Derived(G15Derived {
+                src: G15DerivedSrc::Reg(rr),
+                ..
+            }) = e.prov
+            {
+                reg_src_ok(self, rr)?;
+            }
+        }
+        for (sku, engine) in [(&self.ta_sku, G15Engine::Ta), (&self.frag_sku, G15Engine::Frag)] {
+            if sku.engine != engine || !sku.slot_align.is_power_of_two() {
+                return Err(EINVAL);
+            }
+            sku.image.validate(self)?;
+        }
+        for cmd in [&self.ta_cmd, &self.frag_cmd].into_iter().flatten() {
+            cmd.validate(self)?;
+        }
+        Ok(())
+    }
+}
+
+/// Serialize one SKU stream into its leased slot.
+///
+/// `slot_fwva` must be aligned to the template's `slot_align` and equal the
+/// address the resolver gives for the stream's own target, so self-pointers
+/// and the published pointer agree. `out` is the CPU view of the whole slot;
+/// bytes past the stream are zeroed. Returns the stream size for the command
+/// (TA +0x778, 3D +0x1c).
+pub(crate) fn g15_serialize_sku(
+    t: &G15SkuTemplate<'_>,
+    r: &G15Resolver<'_>,
+    slot_fwva: u64,
+    out: &mut [u8],
+) -> Result<u32> {
+    let ok = t.slot_align.is_power_of_two()
+        && slot_fwva != 0
+        && slot_fwva & (t.slot_align - 1) == 0
+        && matches!(r.targets.get(t.own_target()), Ok(va) if va == slot_fwva);
+    if !ok {
+        out.fill(0);
+        return Err(EINVAL);
+    }
+    let n = t.image.serialize(r, out)?;
+    u32::try_from(n).map_err(|_| EINVAL)
+}
