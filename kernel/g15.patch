+use crate::render_profile::G15KernelProfile;
+
+// The UAPI fixed-placement windows are the mmu.rs geometry.
+const _: () = assert!(
+    uapi::DRM_ASAHI_G15_RENDER_FIXED_RANGE5_START as u64 == mmu::G15_GART_RANGE5.start
+        && uapi::DRM_ASAHI_G15_RENDER_FIXED_RANGE5_END as u64 == mmu::G15_GART_RANGE5.end
+        && uapi::DRM_ASAHI_G15_RENDER_FIXED_ALIGN as usize == mmu::UAT_PGSZ
+);
+/// I09 R1: the G15 render-context aperture. TA VDM_CTRL_STREAM_BASE holds
+/// the VDM stream's offset from its start; a HYBRID render's user VDM stream
