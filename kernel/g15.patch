+pub(crate) struct G15JobSlot(Arc<G15JobGate>);
+
+impl G15JobSlot {
+    /// K7: take the device-wide slot, sleeping interruptibly while another
+    /// G15 job holds it. The holder needs nothing a waiter holds (its
+    /// dependencies were fences when it was submitted, and its completion
+    /// takes only WorkQueue, channel and leaf locks), so the wait ends when
+    /// that job completes, fails, or is dropped. A signal returns
+    /// ERESTARTSYS, which unwinds the submit like any other error.
+    #[inline(never)]
+    fn acquire(dev: &AsahiDevice, owner_vm: u64) -> Result<Self> {
+        let gate = dev.g15_job_gate.clone();
+        {
+            let mut busy = gate.busy.lock();
+            if *busy {
+                gate.waiters.fetch_add(1, Ordering::Relaxed);
+                let mut interrupted = false;
+                while *busy {
+                    if gate.idle.wait_interruptible(&mut busy) {
+                        interrupted = true;
+                        break;
+                    }
+                }
+                gate.waiters.fetch_sub(1, Ordering::Relaxed);
+                if interrupted {
+                    return Err(ERESTARTSYS);
+                }
+            }
+            *busy = true;
+            gate.owner.store(owner_vm, Ordering::Release);
+        }
+        let slot = Self(gate);
+        // A firmware crash fails every job, which frees the slot for the
+        // waiters; do not let them build on a dead GPU.
+        if dev.gpu.is_crashed() {
+            return Err(ENODEV);
+        }
+        Ok(slot)
+    }
+}
+
+impl Drop for G15JobSlot {
+    fn drop(&mut self) {
+        {
+            let mut busy = self.0.busy.lock();
+            let o = self.0.owner.swap(0, Ordering::AcqRel);
+            if o != 0 {
+                self.0.last_owner.store(o, Ordering::Release);
+            }
+            *busy = false;
+        }
+        // All waiters recheck under the lock. One woken waiter that leaves
+        // on a signal must not swallow the only wakeup.
+        self.0.idle.notify_all();
+    }
+}
