+    /// The firmware is parked in the fragment wait: unit-1 wait bit set,
+    /// ready bit clear (a fragment job in flight, GPU powered).
+    #[cfg(CONFIG_DEV_COREDUMP)]
+    fn g15_fragment_parked(&self) -> bool {
+        let mut wait = [0u64; 1];
+        let mut ready = [0u64; 1];
+        matches!(self.uat.peek_fw_words(0xfffffc00000a8d70, &mut wait), Ok(Some(_)))
+            && matches!(self.uat.peek_fw_words(0xfffffc00000a8c78, &mut ready), Ok(Some(_)))
