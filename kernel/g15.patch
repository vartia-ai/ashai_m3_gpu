+    /// Mark work associated with currently in-progress event slots as failed, after a fault or
+    /// timeout.
+    fn mark_pending_events(&self, culprit_slot: Option<u32>, error: workqueue::WorkError) {
+        dev_err!(self.dev.as_ref(), "  Pending events:\n");
+
+        #[ver(G != G15)]
+        self.initdata.globals.with(|raw, _inner| {
+            for (index, i) in raw.pending_stamps.iter().enumerate() {
+                let info = i.info.load(Ordering::Relaxed);
+                let wait_value = i.wait_value.load(Ordering::Relaxed);
+
+                if info & 1 != 0 {
+                    #[ver(V >= V13_5)]
+                    let slot = (info >> 4) & 0x7f;
+                    #[ver(V < V13_5)]
+                    let slot = (info >> 3) & 0x7f;
+                    #[ver(V >= V13_5)]
+                    let flags = info & 0xf;
+                    #[ver(V < V13_5)]
+                    let flags = info & 0x7;
+                    dev_err!(
+                        self.dev.as_ref(),
+                        "    [{}:{}] flags={} value={:#x}\n",
+                        index,
+                        slot,
+                        flags,
+                        wait_value
+                    );
+                    let error = if culprit_slot.is_some() && culprit_slot != Some(slot) {
+                        workqueue::WorkError::Killed
+                    } else {
+                        error
+                    };
+                    self.event_manager.mark_error(slot, wait_value, error);
+                    i.info.store(0, Ordering::Relaxed);
+                    i.wait_value.store(0, Ordering::Relaxed);
+                }
+            }
+        });
+        #[ver(G == G15)]
+        {
+            self.g15_recovery_snapshot("fault/timeout event");
+            // Partial-render diagnostic: the in-flight render's firmware
+            // state, before recovery changes anything.
+            if let Some(snapshot) = self.g15_watchdog_snapshot.lock().as_ref() {
+                snapshot();
+            }
+            if *module_parameters::g15_recovery.value() != 0 {
+                self.g15_mark_pending_stamps(culprit_slot, error);
+            } else {
+                dev_err!(
+                    self.dev.as_ref(),
+                    "G15 recovery is off (g15_recovery=0); pending work stays in flight\n"
+                );
+            }
+        }
+    }
+
+    /// #16 B1: the legacy pending-stamp walk over the q22 table at +0x40a0.
+    /// Each valid entry marks its event slot's work up to `wait_value` as
+    /// failed; the normal completion (Flag event -> WorkQueue::signal) then
+    /// completes it with that error and releases its resources.
+    #[inline(never)]
+    fn g15_mark_pending_stamps(&self, culprit_slot: Option<u32>, error: workqueue::WorkError) {
+        #[ver(G != G15)]
+        let _ = (culprit_slot, error);
+        #[ver(G == G15)]
+        self.initdata.g15_q22.with(|raw, _inner| {
+            for (index, i) in raw.pending_stamps_40a0.iter().enumerate() {
+                let info = i.info.load(Ordering::Relaxed);
+                let wait_value = i.wait_value.load(Ordering::Relaxed);
+
+                if info & 1 != 0 {
+                    let slot = (info >> 4) & 0x7f;
+                    let flags = info & 0xf;
+                    dev_err!(
+                        self.dev.as_ref(),
+                        "    [{}:{}] flags={} value={:#x}\n",
+                        index,
+                        slot,
+                        flags,
+                        wait_value
+                    );
+                    let error = if culprit_slot.is_some() && culprit_slot != Some(slot) {
+                        workqueue::WorkError::Killed
+                    } else {
+                        error
+                    };
+                    self.event_manager.mark_error(slot, wait_value, error);
+                    i.info.store(0, Ordering::Relaxed);
+                    i.wait_value.store(0, Ordering::Relaxed);
+                }
+            }
+        });
+    }
