+/// How one FList's page pool is populated before its first publication.
+///
+/// `blocks` 4-MiB backing extents are mapped and listed (page list and one
+/// 64-byte backup record each); the first `admitted_blocks` of them are
+/// what the 0x70 Page-Pool State admits (page count and cursors). The
+/// remaining extents are what a DeviceControl 0x1b async-grow request
+/// (not sent by Linux) would admit later.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[allow(dead_code)]
+pub(crate) struct G15UmaPoolPopulation {
+    pub(crate) blocks: u32,
+    pub(crate) admitted_blocks: u32,
+    /// Page-Pool State +0x58: a reusable shared CL/Compute pool.
+    pub(crate) shared_compute: bool,
+    /// Whether the driver writes this pool's UMA descriptor-table entry
+    /// (all `blocks`) itself before the first publication.
+    pub(crate) host_descriptor: bool,
+}
+
+#[allow(dead_code)]
+impl G15UmaPoolPopulation {
+    /// The R30/R47 Compute pool: ten extents, all admitted. The firmware
+    /// fills the descriptor from the state.
+    pub(crate) const J615_COMPUTE: Self = Self {
+        blocks: 10,
+        admitted_blocks: 10,
+        shared_compute: true,
+        host_descriptor: false,
+    };
+
+    /// The native render pool of capture-triangle-1 (one pool shared by TA
+    /// and 3D): 25 extents (100 MiB) mapped and listed, the descriptor
+    /// counting all 25600 pages, the state shadow admitting the first ten
+    /// (10240 pages), backup list 200 qwords.
+    pub(crate) const fn render(blocks: u32, admitted_blocks: u32) -> Self {
+        Self {
+            blocks,
+            admitted_blocks,
+            shared_compute: false,
+            host_descriptor: true,
+        }
+    }
+
+    const PAGES_PER_BLOCK: u32 =
+        (G15FListGeometry::J615_BLOCK_BYTES / G15_UMA_PAGE_BYTES) as u32;
+
+    pub(crate) fn validate(&self) -> Result {
+        let max_blocks = G15FListGeometry::J615_MAX_POOL_BYTES / G15FListGeometry::J615_BLOCK_BYTES;
+        let pages = u64::from(self.blocks) * u64::from(Self::PAGES_PER_BLOCK);
+        if self.admitted_blocks == 0
+            || self.admitted_blocks > self.blocks
+            || u64::from(self.blocks) > max_blocks
+            || pages >= (1 << 22)
+            || pages > u64::from(G15FListGeometry::J615_PAGE_POOL_LIST_ENTRIES)
+        {
+            return Err(EINVAL);
+        }
+        Ok(())
+    }
+}
