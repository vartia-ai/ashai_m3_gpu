+/// I09 R3: the USER_REGS override table, boxed. Not inlined: keeps the
+/// table out of `g15_build_render_pair`'s frame.
+#[inline(never)]
+fn boxed_user_reg_overrides(
+    f: &crate::render_input::G15UserRegFields,
+) -> Result<KVec<fw::g15_render::G15RegOverride>> {
+    let mut overrides =
+        KVec::with_capacity(fw::g15_render::G15_USER_REG_COUNT + 6, GFP_KERNEL)?;
+    overrides.extend_from_slice(&fw::g15_render::g15_user_reg_overrides(f), GFP_KERNEL)?;
+    for (eot, program) in [(false, f.bg), (true, f.eot)] {
+        if let Some(program) = program {
+            let regs = fw::g15_render::g15_user_tile_program_overrides(eot, program);
+            overrides.extend_from_slice(&regs, GFP_KERNEL)?;
+        }
+    }
+    if let Some([scissor, dbias]) = f.isp_arrays {
+        for (reg, value) in [(0x15109, scissor), (0x15101, dbias)] {
+            overrides.push(
+                fw::g15_render::G15RegOverride {
+                    reg: fw::g15_render::G15RegRef {
+                        engine: fw::g15_render::G15Engine::Frag,
+                        reg,
+                    },
+                    value,
+                    mask: u64::MAX,
+                },
+                GFP_KERNEL,
+            )?;
+        }
+    }
+    Ok(overrides)
+}
