+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+#![recursion_limit = "2048"]
+
+//! J613 (M3, T8122) PMP driver: experimental G2 bring-up.
+//!
+//! Based on drivers/soc/apple/pmp.rs (Copyright (C) The Asahi Linux
+//! Contributors). The T8122 PMP firmware (RTKit-2419.140.12) and macOS 14.8.9
+//! speak a different registry protocol than the t6000 driver implements
+//! (research/g15-g2-pmp-protocol-audit.md):
+//! - 0x30 init: the descriptor holds two addresses (+0, +8), reply 0x31;
+//! - 0x32 add: 0x58-byte descriptor, size +0x40, entry ID +0x48 (low 32
+//!   bits kept), flags +0x50; reply 0x33 | size (no index);
+//! - 0x34 remove, reply 0x35;
+//! - 0x36 set: msg low 16 bits are the entry ID; reply 0x37 | size.
+//! Binds only "apple,t8122-pmp-v2", which the built-in driver does not match.
+
+use core::mem;
+
+use kernel::{
+    bindings,
+    device::{
+        self,
+        Core, //
+    },
+    dma::{
+        Coherent,
+        CoherentBox, //
+    },
+    io::{
+        io_project,
+        Io,
+        IoBase,
+        Mmio,
+        Region, //
+    },
+    kvec,
+    module_platform_driver,
+    new_mutex,
+    of,
+    platform,
+    prelude::*,
+    soc::apple::rtkit::{
+        self,
+        ASC_CPU_CONTROL, //
+    },
+    str::CString,
+    sync::{
+        aref::ARef,
+        Arc,
+        Mutex, //
+    },
+    transmute::{
+        AsBytes,
+        FromBytes, //
+    },
+    types::ForeignOwnable, //
+};
+
+const PMP_MMIO_SIZE: usize = 0x80000;
+const ASC_MMIO_SIZE: usize = 0x4000;
+const ASC_CPU_CONTROL_OFFSET: usize = 0x44;
+const BOOTARGS_OFFSET: usize = 0x22c;
+const BOOTARGS_SIZE: usize = 0x230;
+const PMP_ENDPOINT: u8 = 0x20;
+const OPC_GET_IOVA_TABLE: u64 = 0x10;
+const OPC_MALLOC: u64 = 0x12;
+const OPC_FREE: u64 = 0x14;
+const OPC_INIT: u64 = 0x30;
+const OPC_ADD: u64 = 0x32;
+const OPC_REMOVE: u64 = 0x34;
+const OPC_SET: u64 = 0x36;
+const OPC_ACK_MASK: u64 = 0x1;
+const OPC_SHIFT: u32 = 48;
+const MALLOC_SIZE_MASK: u64 = 0xFFFFFF;
+const MSG_IOVA_MASK: u64 = 0xFFFFFFFFFFFF;
+const ENTRY_ID_MASK: u64 = 0xFFFF;
+const ADD_DESC_MIN: usize = 0x51;
+const BOOTARGS_MAX: usize = 0x1000;
+/// J613 preloaded image (`g2pmpargs-215148`): reset-vector branch word and
+/// bootargs block; anything else is refused before patching or waking.
+const J613_RESET_WORD: u32 = 0x1400_0091;
+const J613_BOOTARGS_OFFSET: usize = 0x46800;
+const J613_BOOTARGS_SIZE: usize = 0x29c;
+const J613_BOARD_ID: u32 = 48;
+/// The T8122 firmware reads at most 32 IOVA table entries.
+const IOVA_TABLE_MAX: usize = 32;
+const PIO_VM_BASE: u64 = 0xc0000000;
+const PIO_GRANULARITY: u64 = 0x1000000;
+
+const fn from_fourcc(b: &[u8; 4]) -> u32 {
+    b[3] as u32 | (b[2] as u32) << 8 | (b[1] as u32) << 16 | (b[0] as u32) << 24
+}
+
+struct PmpAllocation {
+    addr: u64,
+    alloc: Coherent<[u8]>,
+}
+
+struct IovaTableEntry {
+    _host_addr: u64,
+    _pio_base: u64,
+    _size: u64,
+}
+
+// SAFETY: TODO:
+unsafe impl AsBytes for IovaTableEntry {}
+// SAFETY: TODO:
+unsafe impl FromBytes for IovaTableEntry {}
+
+struct PmpState {
+    iova_table: Option<Coherent<[IovaTableEntry]>>,
+    allocs: KVec<PmpAllocation>,
+    value_buf: Option<u64>,
+    /// Second init address; its use is not decoded yet (kept for logging).
+    #[allow(dead_code)]
+    companion_buf: Option<u64>,
+    /// (entry ID, size) per added registry entry.
+    ioreg_entries: KVec<(u32, u32)>,
+}
+
+impl PmpState {
+    fn new() -> Result<PmpState> {
+        Ok(PmpState {
+            iova_table: None,
+            allocs: KVec::with_capacity(10, GFP_KERNEL)?,
+            value_buf: None,
+            companion_buf: None,
+            ioreg_entries: KVec::with_capacity(340, GFP_KERNEL)?,
+        })
+    }
+    fn find_alloc(&self, addr: u64) -> Option<usize> {
+        // Due to how pmp manages memory, iterating in reverse will
+        // usually result in us getting the right one on the first try
+        for (i, e) in self.allocs.iter().enumerate().rev() {
+            if e.addr == addr {
+                return Some(i);
+            }
+        }
+        None
+    }
+    fn get_buf(&mut self, addr: u64) -> Option<&mut Coherent<[u8]>> {
+        let idx = self.find_alloc(addr)?;
+        Some(&mut self.allocs[idx].alloc)
+    }
+}
+
+#[pin_data]
+struct PmpData {
+    dev: ARef<device::Device>,
+    #[pin]
+    rtkit: Mutex<Option<rtkit::RtKit<PmpData>>>,
+    #[pin]
+    state: Mutex<PmpState>,
+}
+
+impl PmpData {
+    fn new(dev: &platform::Device<Core<'_>>) -> Result<Arc<PmpData>> {
+        Arc::pin_init(
+            try_pin_init!(
+                PmpData {
+                    dev: dev.as_ref().into(),
+                    rtkit <- new_mutex!(None),
+                    state <- new_mutex!(PmpState::new()?)
+                }
+            ),
+            GFP_KERNEL,
+        )
+    }
+    fn start(&self) -> Result<()> {
+        let mut guard = self.rtkit.lock();
+        let mut rtk = guard.as_mut().as_pin_mut().unwrap();
+        rtk.as_mut().wake()?;
+        rtk.start_endpoint(PMP_ENDPOINT)
+    }
+    fn patch_bootargs(
+        &self,
+        pmp_mmio: &Mmio<'_, Region<PMP_MMIO_SIZE>>,
+        patches: &[(u32, u32)],
+    ) -> Result<()> {
+        let io = pmp_mmio.as_view().relaxed();
+        let offset = io.read32(BOOTARGS_OFFSET) as usize;
+        let size = io.read32(BOOTARGS_SIZE) as usize;
+        // The span must be nonempty, bounded and inside the SRAM.
+        // J613: the preloaded image's bootargs block, clear of the header and
+        // code (research/g15-g2-pmp-bringup-plan.md step 1).
+        if (offset, size) != (J613_BOOTARGS_OFFSET, J613_BOOTARGS_SIZE)
+            || size > BOOTARGS_MAX
+            || offset.checked_add(size).is_none_or(|e| e > PMP_MMIO_SIZE)
+        {
+            dev_err!(self.dev, "PMP bootargs span invalid: off {:#x} size {:#x}\n", offset, size);
+            return Err(EIO);
+        }
+        let mut arg_bytes = kvec![0u8; size]?;
+        let pmp_io_array: Mmio<'_, [u8; PMP_MMIO_SIZE]> = pmp_mmio.try_cast()?;
+        let bootargs = io_project!(pmp_io_array, [try: offset .. offset+size]);
+        bootargs.copy_to_slice(&mut arg_bytes);
+        // First a complete parse (records may be byte-sized and unaligned);
+        // patch only if every record fits, only the requested keys, and only
+        // when the record has the expected width.
+        let mut found = KVec::<(usize, usize, u32, usize)>::new();
+        let mut idx = 0;
+        while idx < size {
+            if size - idx < 8 {
+                dev_err!(self.dev, "PMP bootargs truncated header at +{:#x}\n", idx);
+                return Err(EIO);
+            }
+            let key = u32::from_le_bytes(arg_bytes[idx..idx + 4].try_into().unwrap());
+            let len = u32::from_le_bytes(arg_bytes[idx + 4..idx + 8].try_into().unwrap()) as usize;
+            idx += 8;
+            if len > size - idx {
+                dev_err!(self.dev, "PMP bootargs record at +{:#x} overruns\n", idx - 8);
+                return Err(EIO);
+            }
+            if let Some(pi) = patches.iter().position(|(k, _)| *k == key) {
+                if len != 4 {
+                    dev_err!(self.dev, "PMP bootarg {:#x} has width {}, expected 4\n", key, len);
+                    return Err(EIO);
+                }
+                if found.iter().any(|f| f.3 == pi) {
+                    dev_err!(self.dev, "PMP bootarg {:#x} appears twice\n", key);
+                    return Err(EIO);
+                }
+                found.push((idx, len, patches[pi].1, pi), GFP_KERNEL)?;
+            }
+            idx += len;
+        }
+        if found.len() != patches.len() {
+            dev_err!(self.dev, "PMP bootargs: {} of {} requested fields present\n", found.len(), patches.len());
+            return Err(EIO);
+        }
+        for (at, len, v, _) in found.iter() {
+            arg_bytes[*at..*at + *len].copy_from_slice(&v.to_le_bytes()[..*len]);
+        }
+        bootargs.copy_from_slice(&arg_bytes);
+        dev_info!(self.dev, "PMP bootargs: {} of {} requested fields patched\n", found.len(), patches.len());
+        Ok(())
+    }
+    fn get_iova_table(&self) -> Result<u64> {
+        let mut state = self.state.lock();
+        if state.iova_table.is_some() {
+            dev_err!(self.dev, "Asked for iova table with existing buffer");
+            return Err(EIO);
+        }
+        let node = self.dev.fwnode().ok_or(EIO)?;
+        let mut pio_base = PIO_VM_BASE;
+        let prop_name = c"apple,pio-ranges";
+        if !node.property_present(prop_name) {
+            return Ok((OPC_GET_IOVA_TABLE | OPC_ACK_MASK) << OPC_SHIFT);
+        }
+        let n_entries = node.property_count_elem::<u64>(prop_name)? / 2;
+        if n_entries > IOVA_TABLE_MAX {
+            dev_err!(self.dev, "apple,pio-ranges has {} entries, at most {}\n", n_entries, IOVA_TABLE_MAX);
+            return Err(EINVAL);
+        }
+        let ranges = node
+            .property_read_array_vec::<u64>(prop_name, n_entries * 2)?
+            .required_by(&self.dev)?;
+        // SAFETY: TODO: ensure self.dev is bound
+        let bound_dev = unsafe { self.dev.as_bound() };
+        let mut table = CoherentBox::<[IovaTableEntry]>::zeroed_slice(bound_dev, 170, GFP_KERNEL)?;
+
+        let domain = unsafe { bindings::iommu_get_domain_for_dev(self.dev.as_raw()) };
+        for i in 0..n_entries {
+            let host_addr = ranges[i * 2];
+            let size = ranges[i * 2 + 1];
+            unsafe {
+                let err = bindings::iommu_map(
+                    domain,
+                    pio_base as usize,
+                    host_addr,
+                    size as usize,
+                    (bindings::IOMMU_READ | bindings::IOMMU_WRITE | bindings::IOMMU_MMIO) as i32,
+                    bindings::GFP_KERNEL,
+                );
+                if err != 0 {
+                    return Err(Error::from_errno(err));
+                }
+            }
+            table[i] = IovaTableEntry {
+                _host_addr: host_addr,
+                _pio_base: pio_base,
+                _size: size,
+            };
+            pio_base += PIO_GRANULARITY;
+        }
+        let table: Coherent<[IovaTableEntry]> = table.into();
+        let msg = (OPC_GET_IOVA_TABLE | OPC_ACK_MASK) << OPC_SHIFT | table.dma_handle();
+        state.iova_table = Some(table);
+        Ok(msg)
+    }
+    fn malloc(&self, size: u64) -> Result<u64> {
+        // SAFETY: TODO: ensure self.dev is bound
+        let bound_dev = unsafe { self.dev.as_bound() };
+        let iomem = Coherent::<u8>::zeroed_slice(bound_dev, size as usize, GFP_KERNEL)?;
+        let mut state = self.state.lock();
+        let addr = iomem.dma_handle();
+        let msg = (OPC_MALLOC | OPC_ACK_MASK) << OPC_SHIFT | addr;
+        state.allocs.push(
+            PmpAllocation {
+                addr: addr,
+                alloc: iomem,
+            },
+            GFP_KERNEL,
+        )?;
+        Ok(msg)
+    }
+    fn free(&self, addr: u64) -> Result<u64> {
+        let mut state = self.state.lock();
+        if state.value_buf == Some(addr) || state.companion_buf == Some(addr) {
+            dev_err!(self.dev, "PMP free of a registry buffer {:#x} refused\n", addr);
+            return Err(EIO);
+        }
+        if let Some(idx) = state.find_alloc(addr) {
+            state.allocs.swap_remove(idx);
+        } else {
+            dev_err!(
+                self.dev,
+                "Attempted to free memory that was not allocated {}",
+                addr
+            );
+            return Err(EIO);
+        }
+        let msg = (OPC_FREE | OPC_ACK_MASK) << OPC_SHIFT;
+        Ok(msg)
+    }
+    fn set_buf(&self, addr: u64) -> Result<u64> {
+        let mut state = self.state.lock();
+        if state.value_buf.is_some() {
+            dev_err!(self.dev, "Setting a buffer when one exists");
+            return Err(EIO);
+        }
+        let ptr_buf = if let Some(s) = state.get_buf(addr) {
+            s
+        } else {
+            dev_err!(self.dev, "Unable to find buffer");
+            return Err(EIO);
+        };
+        if ptr_buf.size() < 2 * mem::size_of::<u64>() {
+            dev_err!(self.dev, "Buffer too small");
+            return Err(EIO);
+        }
+        // SAFETY: the buffer holds at least two u64s (checked above).
+        let (ptr, companion) = unsafe {
+            let p = ptr_buf.as_ptr() as *const u64;
+            (core::ptr::read_unaligned(p), core::ptr::read_unaligned(p.add(1)))
+        };
+        if state.find_alloc(ptr).is_none() || state.find_alloc(companion).is_none() {
+            dev_err!(self.dev, "PMP registry init names an unallocated buffer ({:#x}, {:#x})\n", ptr, companion);
+            return Err(EIO);
+        }
+        state.value_buf = Some(ptr);
+        state.companion_buf = Some(companion);
+        dev_info!(self.dev, "PMP registry init: value {:#x} companion {:#x}\n", ptr, companion);
+        let msg = (OPC_INIT | OPC_ACK_MASK) << OPC_SHIFT;
+        Ok(msg)
+    }
+    fn register_ioreg(&self, addr: u64) -> Result<u64> {
+        let mut state = self.state.lock();
+        // Copy the descriptor out so the state is free for the checks below.
+        let mut desc = [0u8; ADD_DESC_MIN];
+        {
+            let msg_buf = if let Some(s) = state.get_buf(addr) {
+                s
+            } else {
+                dev_err!(self.dev, "Unable to find buffer");
+                return Err(EIO);
+            };
+            if msg_buf.size() < ADD_DESC_MIN {
+                dev_err!(self.dev, "Buffer too small");
+                return Err(EIO);
+            }
+            // SAFETY: the descriptor is at least ADD_DESC_MIN bytes (checked above).
+            desc.copy_from_slice(unsafe { &msg_buf.as_ref()[..ADD_DESC_MIN] });
+        }
+        let size64 = u64::from_le_bytes(desc[0x40..0x48].try_into().unwrap());
+        let id64 = u64::from_le_bytes(desc[0x48..0x50].try_into().unwrap());
+        if size64 >> 32 != 0 || id64 >> 32 != 0 {
+            dev_err!(self.dev, "PMP add: size {:#x} or id {:#x} out of range\n", size64, id64);
+            return Err(EIO);
+        }
+        let mut size = size64 as u32;
+        let entry_id = id64 as u32;
+        if state.ioreg_entries.iter().any(|e| e.0 == entry_id) {
+            dev_err!(self.dev, "PMP add: duplicate entry id {:#x}\n", entry_id);
+            return Err(EIO);
+        }
+        if size == 0 {
+            let mut name_vec = KVec::with_capacity(0x31, GFP_KERNEL)?;
+            name_vec
+                .extend_from_slice(&desc[0..0x30], GFP_KERNEL)
+                .unwrap();
+            name_vec.push(0, GFP_KERNEL).unwrap();
+            let name_str = CStr::from_bytes_until_nul(&name_vec).unwrap();
+            let name_str = CString::try_from_fmt(fmt!("apple,tunable-{name_str}"))?;
+            let node = self.dev.fwnode().ok_or(EIO)?;
+            if state.value_buf.is_none() {
+                dev_err!(self.dev, "Value buf not set");
+                return Err(EIO);
+            }
+            let val_buf_addr = state.value_buf.unwrap();
+            let val_buf = if let Some(s) = state.get_buf(val_buf_addr) {
+                s
+            } else {
+                dev_err!(self.dev, "Unable to find value buffer");
+                return Err(EIO);
+            };
+            if node.property_present(&name_str) {
+                let len = node.property_count_elem::<u8>(&name_str)?;
+                let data = node
+                    .property_read_array_vec::<u8>(&name_str, len)?
+                    .required_by(&self.dev)?;
+                if len > val_buf.size() {
+                    dev_err!(self.dev, "tunable {:?} ({} bytes) exceeds the value buffer ({})\n", name_str, len, val_buf.size());
+                    return Err(EIO);
+                }
+                // SAFETY: `len` fits the value buffer (checked above).
+                unsafe {
+                    val_buf.as_mut()[0..len].copy_from_slice(&data);
+                }
+                size = len as u32;
+                if *module_parameters::trace.value() != 0 {
+                    // FNV-1a 64 of the value bytes, for the native comparison.
+                    let h = data.iter().fold(0xcbf2_9ce4_8422_2325u64, |h, b| {
+                        (h ^ u64::from(*b)).wrapping_mul(0x100_0000_01b3)
+                    });
+                    dev_info!(self.dev, "G15 PMP value id={:#x} name={:?} len={} fnv1a64={:#018x}\n", entry_id, name_str, len, h);
+                }
+            } else {
+                dev_info!(self.dev, "unknown property {:?}", name_str);
+                if *module_parameters::trace.value() != 0 {
+                    dev_info!(self.dev, "G15 PMP value id={:#x} name={:?} len=0 (no ADT property)\n", entry_id, name_str);
+                }
+            }
+        }
+        // A size-0 reply is a failed registration: the firmware does not
+        // install the entry and reuses the same free ID for its next Add, so
+        // only successful (size > 0) entries are recorded.
+        if size > 0 {
+            state.ioreg_entries.push((entry_id, size), GFP_KERNEL)?;
+        }
+        let msg = (OPC_ADD | OPC_ACK_MASK) << OPC_SHIFT | size as u64;
+        Ok(msg)
+    }
+    fn remove_ioreg(&self, msg: u64) -> Result<u64> {
+        let id = (msg & ENTRY_ID_MASK) as u32;
+        let mut state = self.state.lock();
+        let mut removed = 0u64;
+        if let Some(i) = state.ioreg_entries.iter().position(|e| e.0 == id) {
+            removed = state.ioreg_entries.swap_remove(i).1 as u64;
+        }
+        // Native replies with the removed entry's size (38/38 in the native
+        // transcript); `remove_size=1` does the same, 0 keeps the old zero.
+        if *module_parameters::remove_size.value() == 0 {
+            removed = 0;
+        }
+        Ok((OPC_REMOVE | OPC_ACK_MASK) << OPC_SHIFT | removed)
+    }
+    fn set_ioreg(&self, id: u64) -> Result<u64> {
+        let id = id as u32;
+        let len = self
+            .state
+            .lock()
+            .ioreg_entries
+            .iter()
+            .find(|e| e.0 == id)
+            .ok_or(EIO)?
+            .1 as u64;
+        let msg = (OPC_SET | OPC_ACK_MASK) << OPC_SHIFT | len;
+        Ok(msg)
+    }
+    fn recv_message(&self, msg: u64) -> Result<()> {
+        g15_pmp_trace(&self.dev, "rx", msg);
+        let opc = (msg >> OPC_SHIFT) & 0xFF;
+        let reply = match opc {
+            OPC_GET_IOVA_TABLE => self.get_iova_table()?,
+            OPC_MALLOC => self.malloc(msg & MALLOC_SIZE_MASK)?,
+            OPC_FREE => self.free(msg & MSG_IOVA_MASK)?,
+            OPC_INIT => self.set_buf(msg & MSG_IOVA_MASK)?,
+            OPC_ADD => self.register_ioreg(msg & MSG_IOVA_MASK)?,
+            OPC_REMOVE => self.remove_ioreg(msg)?,
+            OPC_SET => self.set_ioreg(msg & ENTRY_ID_MASK)?,
+            _ => {
+                dev_err!(self.dev, "Got unknown message {}", msg);
+                return Err(EIO);
+            }
+        };
+        let mut rtk_guard = self.rtkit.lock();
+        let rtk = rtk_guard.as_mut().as_pin_mut().unwrap();
+        g15_pmp_trace(&self.dev, "tx", reply);
+        rtk.send_message(PMP_ENDPOINT, reply)?;
+        Ok(())
+    }
+}
