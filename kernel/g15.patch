+                    #[ver(G == G15)]
+                    g15_phantom: PhantomData,
                 })
             },
         )?;
         Ok(KBox::new(obj, GFP_KERNEL)?)
     }
 }
+
+/// G15 GPU idle power-off delay: the ChinookV9 default 2 ms, or the
+/// `g15_idle_off_delay_ms` experiment (the G15 form of KeepGpuPowered).
+pub(crate) fn g15_idle_off_delay_ms() -> u32 {
+    match *crate::module_parameters::g15_idle_off_delay_ms.value() {
+        0 => 2,
+        v => v,
+    }
+}
