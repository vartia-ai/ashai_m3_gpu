+/// Persistent backing allocations owned by one exact J615/G15 FList.
+///
+/// E086 created the four objects at the AGXUMAFList::init() boundary. E099 adds
+/// only the exact HardwareBuffer-reference and post-populatePagePool firmware-
+/// state population boundary. The object remains compile-only/unreachable and
+/// exposes no Page-Pool-State FWVA to a work command.
+///
+/// The actual Page Pool List / Backup Page List contents and chained backing
+/// mappings remain a separate activation prerequisite; this type must not be
+/// wired into Queue/GpuManager until that producer is represented exactly.
+#[allow(dead_code)]
+pub(crate) struct G15FListResourceOwner {
+    plan: G15FListResourcePlan,
+    // Rust drops struct fields in declaration order. Match exact 23J220
+    // AGXUMAFList::free(): Page-Pool State (+0x1c0), FW-Uncached State
+    // (+0x1b0), Page Pool List (+0x50), then Backup Page List (+0xb0).
+    // Construction still uses the already-created locals below, so this changes
+    // teardown ordering only and does not alter allocation/publication order.
+    page_pool_state: alloc::G15SharedGpuArray<buffer::raw::G15UMAPagePoolState>,
+    fw_uncached_state: alloc::G15SharedGpuArray<buffer::raw::G15UMAFWUncachedState>,
+    page_pool_list: GpuArray<U64>,
+    backup_page_list: GpuArray<U64>,
+    page_pool_backing: KVec<GpuArray<u8>>,
+    firmware_state_initialized: bool,
+    population: G15UmaPoolPopulation,
+    /// HardwareBuffer ID whose descriptor-table entry the driver wrote
+    /// (`host_descriptor` pools only).
+    descriptor_written: Option<u32>,
+}
+
+#[allow(dead_code)]
+impl G15FListResourceOwner {
+    /// Built in place in a box (~570 bytes, so the pool owner stays small on
+    /// the submit path's stack). A failure drops what was allocated in
+    /// reverse order, as locals would.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn new_j615_unprepared(
+        dev: &crate::driver::AsahiDevice,
+        manager: G15HardwareBufferIdManager,
+        owner_cookie: u64,
+        pool_id: u64,
+        range5_list_alloc: &mut alloc::DefaultAllocator,
+        bank1: mmu::G15SharedBank1,
+        notifier: Option<Arc<Mutex<mmu::G15MappingNotifier>>>,
+        population: G15UmaPoolPopulation,
+    ) -> Result<KBox<Self>> {
+        population.validate()?;
+        // Side-effect free, as is the geometry below (a u64 entry count
+        // always fits usize here); the box is allocated next, before any
+        // object.
+        let plan = G15FListResourcePlan::new_j615(manager, owner_cookie)?;
+        let geometry = plan.geometry();
+        let backup_entries: usize = (geometry.backup_page_list_bytes
+            / G15FListGeometry::BACKUP_PAGE_LIST_ENTRY_BYTES)
+            .try_into()
+            .map_err(|_| EOVERFLOW)?;
+
+        KBox::try_init(
+            try_init!(Self {
+                plan,
+                // Exact range-5 persistent list backings. The supplied per-VM
+                // allocator must be the cached/FList class
+                // (PROT_G15_RANGE5_FLIST_LIST); E082 proves that class is
+                // bit-identical to the existing cached range-5 arena while
+                // retaining distinct FList semantics here.
+                _: {
+                    crate::debug::g15_stage(format_args!(
+                        "flist {}: plan made; page pool list (UPPL, range 5 cached) next",
+                        pool_id
+                    ))?;
+                },
+                page_pool_list: range5_list_alloc.array_empty_tagged::<U64>(
+                    geometry.page_pool_list_entries as usize,
+                    b"UPPL",
+                )?,
+                _: {
+                    if crate::debug::g15_verbose() {
+                        pr_info!(
+                            "G15 UMA pool {}: page pool list at {:#x}\n",
+                            pool_id,
+                            page_pool_list.gpu_va().get()
+                        );
+                    }
+                    crate::debug::g15_stage(format_args!(
+                        "flist: UPPL at {:#x} ({} entries); backup list next",
+                        page_pool_list.gpu_va().get(),
+                        page_pool_list.len()
+                    ))?;
+                },
+                backup_page_list: range5_list_alloc
+                    .array_empty_tagged::<U64>(backup_entries, b"UBPL")?,
+                _: {
+                    crate::debug::g15_stage(format_args!(
+                        "flist: UBPL at {:#x} ({} entries); FW uncached state (range 7, q22 map) next",
+                        backup_page_list.gpu_va().get(),
+                        backup_entries
+                    ))?;
+                },
+                // Exact fixed FList objects in accelerator-shared bank 1.
+                // Their constructors hard-wire the independently proven
+                // range-7 FList and range-8 Page-Pool-State protection
+                // classes. E085 makes the shared q22 notifier encode range-8
+                // map/unmap as special-aperture 3/2.
+                fw_uncached_state: {
+                    let mut fw_uncached_alloc = alloc::G15SharedBank1Allocator::new_range7_flist(
+                        dev,
+                        bank1.clone(),
+                        mmu::UAT_PGSZ,
+                        true,
+                        notifier.clone(),
+                    );
+                    fw_uncached_alloc
+                        .array_empty_tagged::<buffer::raw::G15UMAFWUncachedState>(1, b"UFUS")?
+                },
+                _: {
+                    crate::debug::g15_stage(format_args!(
+                        "flist: UFUS (range 7) at {:#x}; page pool state (range 8, q22 map) next",
+                        fw_uncached_state.gpu_va().get()
+                    ))?;
+                },
+                page_pool_state: {
+                    let mut page_pool_state_alloc = alloc::G15SharedBank1Allocator::new_range8(
+                        dev,
+                        bank1,
+                        mmu::UAT_PGSZ,
+                        true,
+                        notifier,
+                    );
+                    page_pool_state_alloc
+                        .array_empty_tagged::<buffer::raw::G15UMAPagePoolState>(1, b"UPPS")?
+                },
+                _: {
+                    crate::debug::g15_stage(format_args!(
+                        "flist: UPPS (range 8) at {:#x}; seed next",
+                        page_pool_state.gpu_va().get()
+                    ))?;
+
+                    // Exact AGXUMAFList::init() seed. The rest remains zero
+                    // until the future prepareBufferResources()/
+                    // populateFirmwareState() boundary.
+                    let state = &mut page_pool_state.as_mut_slice()[0];
+                    state.pool_id = U64(pool_id);
+                    state.hardware_buffer_id = U32(u32::MAX);
+                    crate::debug::g15_stage(format_args!(
+                        "flist: UPPS seeded (pool id {})",
+                        pool_id
+                    ))?;
