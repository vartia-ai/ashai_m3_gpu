+/// Where a channel's UMA (FList) lease comes from.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[allow(dead_code)]
+pub(crate) enum G15PipeUmaSource {
+    /// No UMA lease. The command's UMA and page-pool-state fields stay zero.
+    None,
+    /// A reference on this client's shared Compute UMAPool, selected or
+    /// created exactly as the CL channel does it. Its first use populates
+    /// the pool with the Compute FList inputs.
+    SharedComputePool,
+    /// The client's dedicated render pool, shared by the queue's TA and 3D
+    /// channels (natively TA +0x8d6 == 3D +0xc1e), in client-container slot
+    /// `slot` (0 or 1, equal to `uma_priority_class`). Distinct from the
+    /// Compute pool: its state has +0x58 == 0. `blocks`/`admitted_blocks`
+    /// are the population (`buffer::G15UmaPoolPopulation::render`).
+    RenderPool {
+        slot: u8,
+        blocks: u32,
+        admitted_blocks: u32,
+    },
+}
+
+impl G15PipeUmaSource {
+    /// Population of a render pool.
+    pub(crate) fn render_population(&self) -> Option<buffer::G15UmaPoolPopulation> {
+        match *self {
+            G15PipeUmaSource::RenderPool {
+                blocks,
+                admitted_blocks,
+                ..
+            } => Some(buffer::G15UmaPoolPopulation::render(blocks, admitted_blocks)),
+            _ => None,
+        }
+    }
+}
