index 000000000..c39d91fae
--- /dev/null
+++ b/drivers/gpu/drm/asahi/queue/g15_resources.rs
@@ -0,0 +1,2431 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! G15 (J613/J615, firmware V14_7) render resource owners (I04 work item W6).
+//!
+//! This module allocates and owns the kernel-side objects that one native
+//! clear or one native triangle pass references, as described by the
+//! `resources[]` records of the shared `g15-render-bundle-v1` contract:
+//!
+//! * per queue ([`G15RenderQueueResources`]): the PM record pool together with
+//!   its trailing PM state (3D `+0x38` / TA `+0x34` target), the PM scene,
+//!   page-metrics and scene-statistics objects the records point at, the
+//!   "Firmware Page List Entries" resource, the native TVB blocks with their
+//!   page list (BufferInfo `+0x1c`), and the PB descriptor-table entry;
+//! * per pass ([`G15RenderResources`]): the render context-switch region, the
+//!   optional legacy preemption buffers, the TVB tilemap, heap/layer metadata
+//!   and tail pointer cache, the kernel-owned render target and the validated
+//!   user payload sections (VDM, USC programs, PBE, uniforms).
+//!
+//! Nothing here builds or publishes firmware commands, and nothing here
+//! writes device-global firmware tables. Integration (W8) moves a
+//! [`G15RenderResources`] into the job and publishes the PB descriptor.
+//!
+//! Every size, alignment, address class and initialization rule that is only
+//! known from the native capture comes from a profile field typed
+//! [`G15Profiled`]. An unresolved field fails the constructor with `EINVAL`.
+//! Values recovered from the Apple host driver and already present in the
+//! tree (`buffer::G15_J615_PM_*`) are not re-derived; the profile is checked
+//! against them and a disagreement also fails with `EINVAL`.
+//!
+//! # Placement
+//!
+//! A native resource is described by its Apple eGartRange and the attribute
+//! bits of its leaf PTE ([`G15PteClass`]). Each Linux heap that already
+//! exists for the compute path has exactly one such class (see
+//! [`G15RenderHeaps`]). A resource is placed in the first heap whose class is
+//! equal to the profile's class; if that is a profile window and it is full
+//! (ENOSPC), the next window of the same class is tried. Native classes that
+//! no existing heap realizes (for example the eGartRange-1 user window that
+//! holds the native TVB) need a [`G15RenderVaWindow`], which the integrator
+//! creates once per VM from a profile window and passes in. No heap matches
+//! means `EINVAL`.
+//!
+//! # Lifetime and drop order
+//!
+//! The firmware may touch every object here until both the TA and the 3D
+//! command of a pass have retired. Rules:
+//!
+//! 1. A [`G15RenderResources`] is moved into the job that publishes the pass
+//!    and dropped only from the completion path, after both pipes report
+//!    completion (doneptr == wptr on the TA and on the 3D queue), exactly as
+//!    the compute path keeps its per-launch assets.
+//! 2. It holds an `Arc` to the per-queue [`G15RenderQueueResources`], so the PM
+//!    pool, FW page list and PB entry outlive every pass that references them,
+//!    even if the DRM queue is destroyed first.
+//! 3. The render target is an `Arc` so the integrator may keep it past
+//!    retirement for `G15_READBACK`. An I09 R5 pass has none: its target is
+//!    a user BO that the driver neither allocates nor keeps.
+//! 4. Fields drop in declaration order. Per-pass objects drop user payloads
+//!    first, then the render target reference, TVB objects, preempt buffers,
+//!    the context-switch region, and finally the per-queue reference. The
+//!    per-queue object drops the PB lease first, then the FW page list, the
+//!    record pool, and last the scene/metrics/statistics objects the records
+//!    point to. The PB table entry itself lives in InitData: the integrator
+//!    must zero it before the last reference to [`G15RenderQueueResources`]
+//!    goes away.
+//!
+//! The heaps are `keep_garbage` heaps, so a dropped allocation is not reused
+//! until the allocator's garbage collection runs.
+
+#![allow(dead_code)]
+
+use core::ops::Range;
+use core::sync::atomic::{
+    AtomicU64,
+    Ordering, //
+};
+
+use kernel::prelude::*;
+use kernel::sync::{Arc, Mutex};
+
+use crate::alloc::{self, Allocator};
+use crate::driver::AsahiDevice;
+use crate::fw::types::*;
+use crate::{buffer, fw, mmu};
+
+/// Leaf-PTE attribute bits compared between the native capture and a Linux
+/// heap: AP (bits 6..7), memory attribute (bits 2..4) and the high attribute
+/// field (bits 52..63: PXN, UXN, GPU access and the OS bits). Address, type,
+/// AF and non-global bits are excluded. This is the UAT PTE layout used by
+/// `pgtable.rs` (`UAT_PROT_BITS`), not a capture-derived value.
+pub(crate) const G15_PTE_ATTR_MASK: u64 = (0xfff << 52) | (3 << 6) | (7 << 2);
+
+/// One value from a `g15-render-bundle-v1` profile.
+///
+/// The exporter writes `Unresolved` for every value it could not prove from
+/// the capture, and lists the value under the bundle's `unresolved[]` key.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum G15Profiled<T> {
+    /// Value proven by the capture.
+    Resolved(T),
+    /// Value listed in the bundle's `unresolved[]`.
+    Unresolved,
+}
+
+impl<T: Copy> G15Profiled<T> {
+    /// Return the resolved value, or fail closed with `EINVAL`.
+    fn need(&self, what: &str) -> Result<T> {
+        match self {
+            G15Profiled::Resolved(v) => Ok(*v),
+            G15Profiled::Unresolved => {
+                pr_err!("G15 render resources: profile value {} is unresolved\n", what);
+                Err(EINVAL)
+            }
+        }
+    }
+}
+
+fn reject(what: &str) -> Error {
+    pr_err!("G15 render resources: profile value {} is inconsistent\n", what);
+    EINVAL
+}
+
+/// Native placement class of one resource.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15PteClass {
+    /// Apple eGartRange of the native GPUVA (`AGXGart::returnGartRange()`).
+    /// From g15-render-bundle-v1 `resources[].address_space`.
+    pub(crate) gart_range: u8,
+    /// Native leaf PTE masked with [`G15_PTE_ATTR_MASK`].
+    /// From g15-render-bundle-v1 `resources[].pte_evidence`.
+    pub(crate) pte_attr: u64,
+}
+
+impl G15PteClass {
+    const fn of(gart_range: u8, prot: mmu::Prot) -> Self {
+        Self {
+            gart_range,
+            pte_attr: prot.as_pte() & G15_PTE_ATTR_MASK,
+        }
+    }
+}
+
+/// Initial contents of a resource.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum G15ResourceInit<'a> {
+    /// Zero-filled.
+    Zero,
+    /// Captured bytes copied to offset 0. They must fit in the resource.
+    /// Only for kernel-object roles whose initialization rule the bundle
+    /// proves; live control bytes are never accepted here.
+    Bytes(&'a [u8]),
+}
+
+/// One `resources[]` record of g15-render-bundle-v1.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct G15ResourceReq<'a> {
+    /// From g15-render-bundle-v1 `resources[].size` (bytes).
+    pub(crate) size: G15Profiled<usize>,
+    /// From g15-render-bundle-v1 `resources[].alignment` (bytes, power of two).
+    pub(crate) alignment: G15Profiled<usize>,
+    /// From g15-render-bundle-v1 `resources[].address_space` and
+    /// `resources[].pte_evidence`.
+    pub(crate) class: G15Profiled<G15PteClass>,
+    /// From g15-render-bundle-v1 `resources[].initialization`.
+    pub(crate) init: G15Profiled<G15ResourceInit<'a>>,
+}
+
+/// A native VA window that no existing Linux heap covers.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct G15VaWindowProfile {
+    /// First GPUVA of the window. From g15-render-bundle-v1
+    /// `resources[].address_space` (the native window of the resources that
+    /// use this class).
+    pub(crate) start: u64,
+    /// End GPUVA (exclusive). Same source.
+    pub(crate) end: u64,
+    /// Class of every mapping in the window.
+    pub(crate) class: G15PteClass,
+}
+
+/// Relocation encodings from g15-render-bundle-v1 `relocations[].encoding`.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum G15RelocEncoding {
+    /// Write target GPUVA plus addend, little endian.
+    FullAddress,
+    /// `((target + addend - address_base) >> address_shift) << field_shift`,
+    /// inserted under `mask` into the native word.
+    Bitfield {
+        address_base: u64,
+        address_shift: u8,
+        field_shift: u8,
+        mask: u64,
+    },
+}
+
+/// Targets a PB descriptor relocation may name.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum G15PbRelocTarget {
+    /// The queue's TVB buffer Info object (TA `+0x24` / 3D `+0x28`).
+    BufferInfo,
+    /// The PM record pool base.
+    PmPool,
+    /// The FW page list resource.
+    FwPageList,
+    /// The queue's TVB page list (BufferInfo `+0x1c`, RESOURCE 12). Capture
+    /// 5: word 0 = `(VA - 0x10_0000_0000) >> 4` (0x22800 for the native list
+    /// at 0x10_0022_8000), a bitfield relocation against the eGartRange-1
+    /// window base.
+    TvbPageList,
+}
+
+/// One relocation inside the 16-byte PB descriptor.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct G15PbReloc {
+    /// Byte offset inside the descriptor. From `relocations[].offset`.
+    pub(crate) offset: usize,
+    /// 4 or 8. From `relocations[].width`.
+    pub(crate) width: usize,
+    /// From `relocations[].target_resource`.
+    pub(crate) target: G15PbRelocTarget,
+    /// From `relocations[].addend`.
+    pub(crate) addend: i64,
+    /// From `relocations[].encoding`.
+    pub(crate) encoding: G15RelocEncoding,
+}
+
+/// Captured PB descriptor-table record for the render buffer.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct G15PbDescriptorProfile {
+    /// Native record words, before relocation. From the captured
+    /// PB descriptor-table section (`sections[]`, role pb_descriptor).
+    pub(crate) words: [u32; 4],
+    /// Relocations applied to `words`, in order.
+    pub(crate) relocs: [Option<G15PbReloc>; 4],
+}
+
+impl G15PbDescriptorProfile {
+    /// Whether word 0 (natively the TVB page list) comes from a TVB page
+    /// list relocation that keeps none of the native word's bits. A replay
+    /// profile needs this: the literal native word names Apple's page list,
+    /// which this driver does not own. Evidence-only dumps may carry the
+    /// literal word.
+    pub(crate) fn word0_relocated(&self) -> bool {
+        self.relocs.iter().flatten().any(|r| {
+            r.target == G15PbRelocTarget::TvbPageList
+                && r.offset == 0
+                && (r.width == 4 || r.width == 8)
+                && match r.encoding {
+                    G15RelocEncoding::FullAddress => true,
+                    G15RelocEncoding::Bitfield { mask, .. } => {
+                        u64::from(self.words[0]) & !mask == 0
+                    }
+                }
+        })
+    }
+}
+
+/// Per-queue resource profile.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct G15QueueResourceProfile<'a> {
+    /// PM record pool, records plus trailing PM state, as one extent.
+    /// From g15-render-bundle-v1 `resources[]` role `pm_record_pool`.
+    pub(crate) pm_pool: G15ResourceReq<'a>,
+    /// Offset of the PM state inside the pool: `FR.u64@0x38 - PMPOOL`
+    /// (checklist F07). From g15-render-bundle-v1 `fields[]`/`relocations[]`
+    /// for 3D `+0x38`. Must equal the tree's 80 x 0x80 record bytes.
+    pub(crate) pm_state_offset: G15Profiled<usize>,
+    /// PM state size. From g15-render-bundle-v1 `resources[]` role
+    /// `pm_state` (the declared extent, not a mapped run).
+    pub(crate) pm_state_bytes: G15Profiled<usize>,
+    /// "Firmware Page List Entries". From g15-render-bundle-v1 `resources[]`
+    /// role `pm_fw_page_list`.
+    pub(crate) fw_page_list: G15ResourceReq<'a>,
+    /// PB descriptor record. From g15-render-bundle-v1 `sections[]` and
+    /// `relocations[]` of the PB descriptor table (initial resource
+    /// registration under `publication`).
+    pub(crate) pb_descriptor: G15Profiled<G15PbDescriptorProfile>,
+    /// Native TVB blocks. From g15-render-bundle-v1 BufferInfo block list
+    /// (`+0x38`) and page list (`+0x1c`).
+    pub(crate) tvb_blocks: G15Profiled<G15TvbBlockProfile<'a>>,
+    /// TVB page list (BufferInfo `+0x1c`): the page IDs of `tvb_blocks`, u32
+    /// each, in a separate object with its own class (capture 5: eGartRange
+    /// 1, attr 0xe0000000000000, at 0x10_0022_8000). From RESOURCE 12;
+    /// `None` when the profile has no such record (evidence-only dumps only:
+    /// the Info then keeps its own list, and no PB relocation may target it).
+    pub(crate) tvb_page_list: Option<G15ResourceReq<'a>>,
+    /// PM record scene words (`+0x28`/`+0x30`) and the scene page placement
+    /// (TVB base + offset). From the PM records' `+0x28`/`+0x30` (capture
+    /// 5: offset 0x220000, stride 0x40, 36 slots).
+    pub(crate) pm_scene: G15Profiled<buffer::G15PmSceneGeometry>,
+}
+
+/// Native TVB blocks addressed by hardware page ID (32-KiB pages,
+/// `buffer::PAGES_PER_BLOCK` pages per block): block `id` covers
+/// `base + (id << buffer::PAGE_SHIFT)` for one block size.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct G15TvbBlockProfile<'a> {
+    /// GPUVA of page ID 0 (capture-triangle-1: the eGartRange-1 window
+    /// base 0x10_0000_0000).
+    pub(crate) base: u64,
+    /// First page ID of every block, strictly increasing, non-overlapping
+    /// (capture-triangle-1: 13, 18, ..., 63).
+    pub(crate) ids: &'a [u32],
+}
+
+/// TVB blocks mapped at their native block-ID addresses, each a fixed
+/// placement in the profile VA window that covers it, with that window's
+/// class. Owned per queue with the PM pool (Apple: the parameter buffer).
+pub(crate) struct G15TvbBlocks {
+    blocks: KVec<(u32, G15Resource)>,
+    relink_arena: KVec<G15Resource>,
+    /// The page list BufferInfo `+0x1c` points at, when the profile has one.
+    page_list: Option<G15Resource>,
+}
+
+/// TVB block IDs to install: the profile's (the small native captures'
+/// 11) plus, by default, the 29 more of the native 2560x1664 render
+/// (95, 100, ..., 235), 40 in all: native installs
+/// `max(11, align(ceil(tiles / 128), 8))` blocks up front and does not
+/// grow them. With only 11, a render with ~8 full-panel layers overflows
+/// the TVB and needs a partial render. `g15_tvb_blocks_native40=0`: the
+/// profile's 11 only.
+/// G2 relinker arena: one placement of just under 2 MiB in profile VA window 5, reserved for it
+/// (same PTE class as the TVB blocks).
+const G15_RELINK_ARENA_VA: u64 = 0x10_0080_0000;
+/// 2 MiB, half of window 5 (a heap guard may follow the placement).
+const G15_RELINK_ARENA_BYTES: usize = 0x10_0000 * 2 - 0x4000;
+
+pub(crate) fn g15_tvb_block_ids(profile_ids: &[u32]) -> Result<KVec<u32>> {
+    let mut ids = KVec::with_capacity(40, GFP_KERNEL)?;
+    // G2: the native hotspot's layout (TVB block IDs 15 + 5n, PM scene at
+    // +0x230000, native tilemap/heapmeta/TPC VAs) reproduced exactly left the
+    // per-tile cliff unchanged (g2natlayout-115852, g2tvbid-114849, g2areaCE2-095212).
+    for &id in profile_ids {
+        ids.push(id, GFP_KERNEL)?;
+    }
+    if *crate::module_parameters::g15_tvb_blocks_native40.value() != 0 {
+        for id in (95..=235u32).step_by(5) {
+            if !ids.contains(&id) {
+                ids.push(id, GFP_KERNEL)?;
+            }
+        }
+    }
+    Ok(ids)
+}
+
+impl G15TvbBlocks {
+    // Not inlined: keeps its temporaries out of the queue-resources frame.
+    #[inline(never)]
+    fn new(
+        heaps: &G15RenderHeaps<'_>,
+        profile: G15Profiled<G15TvbBlockProfile<'_>>,
+        page_list: Option<G15ResourceReq<'_>>,
+    ) -> Result<Self> {
+        let page_list_req = page_list;
+        let p = profile.need("tvb_blocks")?;
+        let all_ids = g15_tvb_block_ids(p.ids)?;
+        let mut blocks = KVec::with_capacity(all_ids.len(), GFP_KERNEL)?;
+        for &id in all_ids.iter() {
+            let va = p
+                .base
+                .checked_add(u64::from(id) << buffer::PAGE_SHIFT)
+                .ok_or(EINVAL)?;
+            let res = heaps.alloc_in_window(va, buffer::BLOCK_SIZE, "tvb_block")?;
+            blocks.push((id, res), GFP_KERNEL)?;
+            crate::debug::g15_stage(format_args!("queue res: TVB block {} placed at {:#x}", id, va))?;
+        }
+        let page_list = match page_list {
+            None => None,
+            Some(req) => {
+                // The kernel writes the whole list; captured bytes would be
+                // Apple's page IDs.
+                if !matches!(req.init, G15Profiled::Resolved(G15ResourceInit::Zero)) {
+                    return Err(reject("tvb_page_list.init"));
+                }
+                let entries = all_ids.len().checked_mul(buffer::PAGES_PER_BLOCK).ok_or(EINVAL)?;
+                let mut list = heaps.alloc(&req, "tvb_page_list", b"TVPL", entries * 4)?;
+                let dst = list.as_mut_slice()?;
+                for (i, &id) in all_ids.iter().enumerate() {
+                    for j in 0..buffer::PAGES_PER_BLOCK {
+                        let page = id.checked_add(j as u32).ok_or(EINVAL)?;
+                        let off = (i * buffer::PAGES_PER_BLOCK + j) * 4;
+                        dst[off..off + 4].copy_from_slice(&page.to_le_bytes());
+                    }
+                }
+                crate::debug::g15_stage(format_args!(
+                    "queue res: TVB page list at {:#x} filled",
+                    list.gpu_va()
+                ))?;
+                Some(list)
+            }
+        };
+        let _ = page_list_req;
+        // G2 workaround: the relinker's continuation chunks, inside the TVB
+        // window (links carry only the low 32 bits) and outside the page
+        // list, so the PM never hands them out.
+        let mut relink_arena = KVec::new();
+        // One placement: adjacent fixed placements in a window heap collide
+        // (EBUSY on the second).
+        if *crate::module_parameters::g15_relink.value() != 0 {
+            relink_arena.push(
+                heaps.alloc_in_window(G15_RELINK_ARENA_VA, G15_RELINK_ARENA_BYTES, "relink_arena")?,
+                GFP_KERNEL,
+            )?;
+        }
+        Ok(Self {
+            blocks,
+            page_list,
+            relink_arena,
+        })
+    }
+
+    /// CPU view of the TVB page list, for diagnostic dumps.
+    /// G2 diagnostic: block `i`'s first page ID and CPU bytes, invalidated
+    /// first (the GPU writes the TVB uncached).
+    pub(crate) fn block_bytes(&self, i: usize) -> Option<(u32, &[u8])> {
+        let (id, r) = self.blocks.get(i)?;
+        let b = r.as_slice().ok()?;
+        g15_invalidate_from_poc(b.as_ptr() as usize, b.len());
+        Some((*id, b))
+    }
+
+
+    pub(crate) fn page_list_bytes(&self) -> Option<&[u8]> {
+        self.page_list.as_ref().and_then(|r| r.as_slice().ok())
+    }
+
+    /// `(GPUVA, bytes)` of the TVB page list object, if the profile has one.
+    pub(crate) fn page_list(&self) -> Option<(u64, usize)> {
+        self.page_list.as_ref().map(|r| (r.gpu_va(), r.len()))
+    }
+
+    /// G2 relinker: `(GPU VA, CPU address, length)` of every TVB block, no
+    /// cache maintenance.
+    pub(crate) fn views(&self) -> KVec<super::g15_relink::G15RelinkView> {
+        Self::views_of(self.blocks.iter().map(|(_, r)| r))
+    }
+
+    /// G2 relinker: the arena blocks, as [`Self::views`].
+    pub(crate) fn arena_views(&self) -> KVec<super::g15_relink::G15RelinkView> {
+        Self::views_of(self.relink_arena.iter())
+    }
+
+    fn views_of<'b>(rs: impl Iterator<Item = &'b G15Resource>) -> KVec<super::g15_relink::G15RelinkView> {
+        let mut v = KVec::new();
+        for r in rs {
+            if let Ok(b) = r.as_slice() {
+                let _ = v.push(
+                    super::g15_relink::G15RelinkView { gpu: r.gpu_va(), cpu: b.as_ptr() as usize, len: b.len() },
+                    GFP_KERNEL,
+                );
+            }
+        }
+        v
+    }
+
+    /// First page ID of every block, in profile order.
+    pub(crate) fn ids(&self) -> impl Iterator<Item = u32> + '_ {
+        self.blocks.iter().map(|(id, _)| *id)
+    }
+
+    /// `(first page ID, GPUVA)` of every block.
+    pub(crate) fn blocks(&self) -> impl Iterator<Item = (u32, u64)> + '_ {
+        self.blocks.iter().map(|(id, r)| (*id, r.gpu_va()))
+    }
+}
