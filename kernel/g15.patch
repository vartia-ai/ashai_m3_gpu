+    /// +0xc + 24 * unit). Empty on other generations.
+    pub(crate) fn g15_stats_vtx_bytes(&self, len: usize) -> KVec<u8> {
+        #[allow(unused_mut)]
+        let mut out = KVec::new();
+        #[ver(G == G15)]
+        {
+            let obj = &self.initdata.runtime_pointers.g15_stats_vtx;
+            obj.with(|raw, _inner| {
+                let base = raw as *const _ as *const u8;
+                let n = len.min(core::mem::size_of_val(raw));
+                for i in 0..n {
+                    // SAFETY: inside the live, CPU-mapped firmware object.
+                    let b = unsafe { core::ptr::read_volatile(base.add(i)) };
+                    if out.push(b, GFP_KERNEL).is_err() {
+                        break;
+                    }
+                }
+            });
+        }
+        #[ver(G != G15)]
+        let _ = len;
+        out
+    }
