+#[versions(AGX)]
+#[allow(dead_code)]
+impl G15RenderChannel::ver {
+    /// Empty per-subqueue lifetime slot, filled by `ensure`.
+    pub(super) fn new_slot() -> Result<Arc<Mutex<Option<Self>>>> {
+        Arc::pin_init(
+            new_mutex!(None, "g15_render_channel_lifetime"),
+            GFP_KERNEL,
+        )
+    }
+
+    /// Return the channel slot for `profile.pipe` (Vertex or Fragment),
+    /// assembling the channel on first use. The slot lock is held across
+    /// assembly, so concurrent first uses cannot select resources twice. A
+    /// later call with a different profile fails with EBUSY.
+    pub(super) fn ensure(
+        queue: &super::Queue::ver,
+        gpu: &gpu::GpuManager::ver,
+        profile: &G15PipeProfile,
+    ) -> Result<Arc<Mutex<Option<Self>>>> {
+        #[ver(G != G15)]
+        {
+            let _ = (queue, gpu, profile);
+            return Err(EINVAL);
+        }
+
+        #[ver(G == G15)]
+        {
+            profile.validate()?;
+            let subqueue = match profile.pipe {
+                PipeType::Vertex => queue.q_vtx.as_ref(),
+                PipeType::Fragment => queue.q_frag.as_ref(),
+                PipeType::Compute => return Err(EINVAL),
+            }
+            .ok_or(EINVAL)?;
+            let slot = subqueue._g15_render_channel.as_ref().ok_or(EINVAL)?.clone();
+            {
+                let mut channel = slot.lock();
+                if let Some(existing) = channel.as_ref() {
+                    if existing.owners.profile() != profile {
+                        return Err(EBUSY);
+                    }
+                }
+                if channel.is_none() {
+                    crate::debug::g15_stage(format_args!(
+                        "ensure {:?}: slot empty, assembling (uma {:?} class {})",
+                        profile.pipe, profile.uma, profile.uma_priority_class
+                    ))?;
+                    let render_uma_backing = match profile.uma {
+                        G15PipeUmaSource::RenderPool { .. } => Some(
+                            queue
+                                .inner
+                                .g15_render_windows
+                                .as_ref()
+                                .ok_or(EINVAL)?
+                                .lock()
+                                .render_uma_heap(&queue.dev, &queue.vm)?,
+                        ),
+                        _ => None,
+                    };
+                    crate::debug::g15_stage(format_args!(
+                        "ensure {:?}: render UMA backing heap ready ({})",
+                        profile.pipe,
+                        render_uma_backing.is_some()
+                    ))?;
+                    let parts = queue.inner.g15_assemble_pipe_channel(
+                        gpu,
+                        profile,
+                        render_uma_backing.as_ref(),
+                    )?;
+                    let uma = match parts.pool {
+                        Some(pool) => G15RenderUma::Shared(G15RenderPoolRef {
+                            pool: core::mem::ManuallyDrop::new(pool),
+                            dev: queue.dev.clone(),
+                            clear: Self::clear_uma_descriptor,
+                        }),
+                        None => G15RenderUma::None(
+                            queue
+                                .inner
+                                ._g15_uma_shared_pools
+                                .as_ref()
+                                .ok_or(EINVAL)?
+                                .clone(),
+                        ),
+                    };
+                    *channel = Some(Self {
+                        owners: parts.owners,
+                        guards: parts.guards,
+                        fw_channel_resources: parts.fw_channel_resources,
+                        scheduler_publication: queue.inner._g15_scheduler_publication.clone(),
+                        commands_submitted: false,
+                        owns_scheduler_publication: false,
+                        uma,
+                    });
+                    crate::debug::g15_stage(format_args!(
+                        "ensure {:?}: channel stored in slot",
+                        profile.pipe
+                    ))?;
+                }
+            }
+            Ok(slot)
+        }
+    }
+
+    pub(super) fn pipe(&self) -> PipeType {
+        self.owners.profile().pipe
+    }
+
+    /// Zero UMA descriptor-table record `id` ([`G15RenderPoolRef`]).
+    fn clear_uma_descriptor(dev: &AsahiDevRef, id: u32) -> Result {
+        (**dev)
+            .gpu
+            .as_any()
+            .downcast_ref::<gpu::GpuManager::ver>()
+            .ok_or(EIO)?
+            .g15_set_uma_descriptor(id, Default::default())
+    }
+
+    /// Write this channel's render UMA pool descriptor-table entry if the
+    /// pool still needs it (`G15FListResourceOwner::pending_uma_descriptor`).
+    /// Call at the pass's first firmware-visible write, while the pass's
+    /// leases hold a pool reference. No-op for other UMA sources and once
+    /// written; the TA and 3D channels of a queue share the pool, so the
+    /// second call does nothing.
+    pub(super) fn publish_uma_descriptor(&self, gpu: &gpu::GpuManager::ver) -> Result {
+        let G15RenderUma::Shared(pool) = &self.uma else {
+            return Ok(());
+        };
+        if self.owners.profile().uma.render_population().is_none() {
+            return Ok(());
+        }
+        pool.with_pool(|uma_pool| {
+            if let Some((id, descriptor)) = uma_pool.pending_uma_descriptor()? {
+                crate::debug::g15_stage(format_args!(
+                    "uma descriptor: HW ID {} record {:x?} write next",
+                    id, descriptor
+                ))?;
+                gpu.g15_set_uma_descriptor(id, descriptor)?;
+                crate::debug::g15_stage(format_args!("uma descriptor: HW ID {} written", id))?;
+                uma_pool.mark_uma_descriptor_written(id);
+            }
+            Ok(())
+        })
+    }
+
+    /// Phase 1 for one command: take the next state sequence, bind the next
+    /// event-control state and a retired SKU slot to `fence`, seed the state,
+    /// reserve the SKU slot, take the UMA reference (if any) and a HWMetrics
+    /// record. Same order as the Compute channel.
+    pub(super) fn lease(
+        &mut self,
+        fence: &UserFence<super::JobFence::ver>,
+    ) -> Result<G15ArmedRenderLeases::ver> {
+        let profile = *self.owners.profile();
+        let owners = &mut self.owners;
+        let guards = &mut self.guards;
+        match &self.uma {
+            G15RenderUma::Shared(pool) => {
+                let state_sequence = pool.next_stock_empty_state_sequence()?;
+                pool.with_pool(|uma_pool| {
+                    let (arm, event_index, sku_index) = guards.bind_phase1(owners, fence)?;
+                    let leased = Self::lease_bound(
+                        owners,
+                        Some(uma_pool),
+                        &profile,
+                        event_index,
+                        state_sequence,
+                        sku_index,
+                    );
+                    match leased {
+                        Ok((leases, sku, hardware_buffer_id)) => Ok(G15ArmedRenderLeases::ver {
+                            arm,
+                            leases,
+                            event_index,
+                            sku,
+                            hardware_buffer_id,
+                            sku_size: None,
+                            uma_epoch: None,
+                        }),
+                        Err(err) => {
+                            guards.rollback(event_index, sku_index);
+                            Err(err)
+                        }
+                    }
+                })
+            }
+            G15RenderUma::None(container) => {
+                let state_sequence =
+                    buffer::G15ClientUmaPoolContainerState::next_command_buffer_state_sequence(
+                        container,
+                    );
+                let (arm, event_index, sku_index) = guards.bind_phase1(owners, fence)?;
+                match Self::lease_bound(
+                    owners,
+                    None,
+                    &profile,
+                    event_index,
+                    state_sequence,
+                    sku_index,
+                ) {
+                    Ok((leases, sku, hardware_buffer_id)) => Ok(G15ArmedRenderLeases::ver {
+                        arm,
+                        leases,
+                        event_index,
+                        sku,
+                        hardware_buffer_id,
+                        sku_size: None,
+                        uma_epoch: None,
+                    }),
+                    Err(err) => {
+                        guards.rollback(event_index, sku_index);
+                        Err(err)
+                    }
+                }
+            }
+        }
+    }
+
+    fn lease_bound(
+        owners: &mut G15PipeChannelOwners,
+        uma_pool: Option<&mut buffer::G15SharedComputeUmaPoolOwner>,
+        profile: &G15PipeProfile,
+        event_index: usize,
+        state_sequence: u32,
+        sku_index: usize,
+    ) -> Result<(G15RenderLeases, G15PipeSkuSlot, Option<u32>)> {
+        let (channel_state_fwva, evctl_fwva, sku) =
+            owners.select_event_and_sku(event_index, state_sequence, sku_index)?;
+        // Read everything that can fail before the UMA reference is taken, so
+        // no error below this point has a reference to release.
+        let evctl_stamp_fwva = owners.evctl_stamp_fwva(event_index)?;
+        let command_region_fwva = match profile.command_resource {
+            Some(_) => owners.command_resource_fwva()?,
+            None => 0,
+        };
+        let (uma, hwmetrics_fwva, hardware_buffer_id) = match uma_pool {
+            Some(uma_pool) => {
+                let (page_pool_state_fwva, hwmetrics_fwva, id) =
+                    // W8f: the coherency epoch is written at publication
+                    // (`publish_uma_epoch`), not here: the pair's two
+                    // references are both taken before either publishes.
+                    owners.lease_uma_and_hwmetrics(
+                        uma_pool,
+                        profile.uma_priority_class,
+                        buffer::G15UmaEpochTiming::AtPublication,
+                    )?;
+                (
+                    G15UmaSnapshot {
+                        page_pool_state_fwva,
+                        prepared: true,
+                        min_pool_size: profile.uma_pool_sizes.0,
+                        ideal_pool_size: profile.uma_pool_sizes.1,
+                    },
+                    hwmetrics_fwva,
+                    Some(id),
+                )
+            }
+            None => (G15UmaSnapshot::default(), owners.take_hwmetrics_fwva()?, None),
+        };
+        Ok((
+            G15RenderLeases {
+                pipe: profile.pipe,
+                evctl_fwva,
+                evctl_slot: event_index as u32,
+                evctl_stamp_fwva,
+                evctl_index: profile.evctl_index,
+                state_sequence,
+                sku_slot_fwva: sku.fwva(),
+                sku_slot_bytes: profile.sku_slot_stride,
+                channel_state_fwva,
+                firmware_state_fwva: owners.firmware_state_fwva(),
+                command_region_fwva,
+                uma,
+                hwmetrics_fwva,
+            },
+            sku,
+            hardware_buffer_id,
+        ))
+    }
+
+    /// Phase 2: write the serialized SKU stream (which embeds the command
+    /// FWVA) into the slot reserved in phase 1.
+    pub(super) fn write_sku(
+        &mut self,
+        armed: &mut G15ArmedRenderLeases::ver,
+        stream: &[u8],
+    ) -> Result<u32> {
+        if armed.sku_size.is_some() {
+            return Err(EBUSY);
+        }
+        let written = self.owners.write_sku(armed.sku, stream)?;
+        if written.fwva() != armed.leases.sku_slot_fwva {
+            return Err(EIO);
+        }
+        armed.sku_size = Some(written.size());
+        Ok(written.size())
+    }
+
+    fn release_uma(&self, hardware_buffer_id: Option<u32>) -> Result<bool> {
+        match (&self.uma, hardware_buffer_id) {
+            (G15RenderUma::Shared(pool), Some(id)) => {
+                pool.with_pool(|uma_pool| uma_pool.complete_reference(id))
+            }
+            (_, None) => Ok(false),
+            (G15RenderUma::None(_), Some(_)) => Err(EIO),
+        }
+    }
+
+    /// W8f: write the UMA coherency epoch for `armed`'s command. Call
+    /// immediately before that command's publication, in publication order;
+    /// the TA and 3D channels share the pool, so the pair writes 1 then 2
+    /// from a zero mirror, as native does. Returns the value written, or
+    /// `None` for a command without a UMA reference.
+    pub(super) fn publish_uma_epoch(
+        &mut self,
+        armed: &mut G15ArmedRenderLeases::ver,
+    ) -> Result<Option<u64>> {
+        let Some(_) = armed.hardware_buffer_id else {
+            return Ok(None);
+        };
+        if armed.uma_epoch.is_some() {
+            return Err(EBUSY);
+        }
+        let G15RenderUma::Shared(pool) = &self.uma else {
+            return Err(EIO);
+        };
+        let (previous, written) = pool.with_pool(|uma_pool| uma_pool.publish_coherency_epoch())?;
+        armed.uma_epoch = Some((previous, written));
+        Ok(Some(written))
+    }
+
+    /// Release a command that never reached firmware: undo its UMA epoch
+    /// write (if any), unbind both rotating slots, release the UMA
+    /// reference, then drop the fence reference.
+    pub(super) fn abort(&mut self, armed: G15ArmedRenderLeases::ver) -> Result<bool> {
+        let G15ArmedRenderLeases::ver {
+            arm,
+            event_index,
+            sku,
+            hardware_buffer_id,
+            uma_epoch,
+            ..
+        } = armed;
+        if let (Some((previous, written)), G15RenderUma::Shared(pool)) = (uma_epoch, &self.uma) {
+            if let Err(err) = pool.with_pool(|uma_pool| {
+                uma_pool.rollback_coherency_epoch(previous, written);
+                Ok(())
+            }) {
+                pr_err!("G15 render UMA epoch rollback failed: {:?}\n", err);
+            }
+        }
+        self.guards.rollback(event_index, sku.index());
+        let result = self.release_uma(hardware_buffer_id);
+        core::mem::drop(arm);
+        result
+    }
+
+    /// Completion of a published command: release the UMA reference, then
+    /// drop the fence reference. The slots stay bound to the fence until it
+    /// signals, then `scrub` frees them.
+    pub(super) fn complete(&mut self, armed: G15ArmedRenderLeases::ver) -> Result<bool> {
+        let G15ArmedRenderLeases::ver {
+            arm,
+            hardware_buffer_id,
+            ..
+        } = armed;
+        let result = self.release_uma(hardware_buffer_id);
+        core::mem::drop(arm);
+        self.guards.scrub_completed();
+        result
+    }
+
+    fn transport_queue_info_fwva(&self) -> Result<u64> {
+        self.fw_channel_resources.transport_queue_info_fwva()
+    }
+
+    pub(super) fn transport_state(&self) -> Result<buffer::G15ChannelTransportState> {
+        self.fw_channel_resources.transport_state()
+    }
+
+    pub(super) fn execution_state(&self) -> Result<buffer::G15ChannelExecutionState> {
+        self.fw_channel_resources.execution_state()
+    }
+
+    fn transport_write_command(&self, command_fwva: u64) -> Result<u32> {
+        self.fw_channel_resources.transport_write_command(command_fwva)
+    }
+
+    /// The returned flag is the RunWorkQueue "new" bit: true exactly for
+    /// this channel's first submission, as natively for both the TA and the
+    /// 3D channel. The scheduler resource is per command queue, so only the
+    /// queue's first published channel moves it to Published; a later
+    /// channel joins it (`G15SchedulerPublication::begin_channel`).
+    fn begin_transport_submission(&mut self) -> Result<bool> {
+        if self.commands_submitted {
+            if self.scheduler_publication.state() != super::G15SchedulerPublicationState::Published {
+                return Err(EIO);
+            }
+            return Ok(false);
+        }
+        self.owns_scheduler_publication = self.scheduler_publication.begin_channel()?;
+        Ok(true)
+    }
+
+    fn finish_transport_submission(&mut self, first_submission: bool) -> Result {
+        if first_submission {
+            if self.commands_submitted {
+                return Err(EIO);
+            }
+            self.scheduler_publication
+                .finish_channel(self.owns_scheduler_publication)?;
+            self.commands_submitted = true;
+            return Ok(());
+        }
+        if self.scheduler_publication.state() != super::G15SchedulerPublicationState::Published {
+            return Err(EIO);
+        }
+        self.commands_submitted = true;
+        Ok(())
+    }
+
+    fn fail_transport_submission(&mut self, first_submission: bool) {
+        if first_submission {
+            self.scheduler_publication
+                .fail_channel(self.owns_scheduler_publication);
+        }
+    }
+}
