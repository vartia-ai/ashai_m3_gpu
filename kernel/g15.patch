+/// Per-job owner of one render command's leases. Dropping it returns the
+/// leases: `abort` if the command was never marked published, `complete`
+/// otherwise. Holds the channel slot, so it does not depend on the Queue
+/// outliving the job.
+#[versions(AGX)]
+#[allow(dead_code)]
+pub(super) struct G15RenderJobLeases {
+    channel: Arc<Mutex<Option<G15RenderChannel::ver>>>,
+    armed: Option<G15ArmedRenderLeases::ver>,
+    published: bool,
+}
+
+#[versions(AGX)]
+#[allow(dead_code)]
+impl G15RenderJobLeases::ver {
+    // Not inlined: keeps the lease temporaries out of the submit frame.
+    #[inline(never)]
+    pub(super) fn new(
+        channel: Arc<Mutex<Option<G15RenderChannel::ver>>>,
+        fence: &UserFence<super::JobFence::ver>,
+    ) -> Result<Self> {
+        let armed = {
+            let mut slot = channel.lock();
+            (&mut *slot).as_mut().ok_or(EINVAL)?.lease(fence)?
+        };
+        Ok(Self {
+            channel,
+            armed: Some(armed),
+            published: false,
+        })
+    }
+
+    pub(super) fn leases(&self) -> Result<G15RenderLeases> {
+        Ok(*self.armed.as_ref().ok_or(EINVAL)?.leases())
+    }
+
+    pub(super) fn write_sku(&mut self, stream: &[u8]) -> Result<u32> {
+        let armed = self.armed.as_mut().ok_or(EINVAL)?;
+        let mut slot = self.channel.lock();
+        (&mut *slot).as_mut().ok_or(EINVAL)?.write_sku(armed, stream)
+    }
+
+    /// W8f: write this command's UMA coherency epoch
+    /// (`G15RenderChannel::publish_uma_epoch`). Call immediately before the
+    /// command's publication; if it is never published, dropping the leases
+    /// restores the previous value.
+    pub(super) fn publish_uma_epoch(&mut self) -> Result<Option<u64>> {
+        let armed = self.armed.as_mut().ok_or(EINVAL)?;
+        if self.published {
+            return Err(EINVAL);
+        }
+        let mut slot = self.channel.lock();
+        (&mut *slot).as_mut().ok_or(EINVAL)?.publish_uma_epoch(armed)
+    }
+
+    /// Call once the command FWVA has been written to the channel ring.
+    pub(super) fn mark_published(&mut self) {
+        self.published = true;
+    }
+}
+
+#[versions(AGX)]
+#[allow(dead_code)]
+impl Drop for G15RenderJobLeases::ver {
+    fn drop(&mut self) {
+        let Some(armed) = self.armed.take() else {
+            return;
+        };
+        let mut slot = self.channel.lock();
+        let Some(channel) = (&mut *slot).as_mut() else {
+            core::mem::forget(armed);
+            pr_err!("G15 render job lost its channel; retaining leases fail-closed\n");
+            return;
+        };
+        crate::debug::g15_trace(format_args!(
+            "lease drop {:?}: {}",
+            channel.pipe(),
+            if self.published { "complete" } else { "abort" }
+        ));
+        let result = if self.published {
+            channel.complete(armed)
+        } else {
+            channel.abort(armed)
+        };
+        if let Err(err) = result {
+            pr_err!("G15 render lease release failed: {:?}\n", err);
+        }
+        crate::debug::g15_trace(format_args!("lease drop: released"));
+    }
+}
diff --git a/drivers/gpu/drm/asahi/queue/g15_relink.rs b/drivers/gpu/drm/asahi/queue/g15_relink.rs
new file mode 100644
index 000000000..1a5e21106
--- /dev/null
+++ b/drivers/gpu/drm/asahi/queue/g15_relink.rs
@@ -0,0 +1,771 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! G15 tile-list relinker (`g15_relink`): the G2 workaround.
+//!
+//! G15 tile lists are chains of 128-byte chunks. The TA fills a chunk to
+//! +0x77 and links at +0x78; on Linux the fragment pass cannot consume a
+//! chunk's second 64-byte half and hangs on any list with content past +0x40
+//! (docs/g15-spec/30-render.md section 9). With the 3D command published only
+//! after the TA completes (`g15_render_serial`), this module rewrites every
+//! such list into chunks that end by +0x40 before the 3D publication:
+//!
+//! - Tilemap: one 5-byte entry per tile, `root offset | 0x02` or with low
+//!   bits 0 (root offset from the TVB base, 0x80-aligned). Tilemap order is
+//!   not TPC order.
+//! - TPC (tail-pointer cache) entry: the tile's CURRENT (final) chunk as
+//!   `(page << 8) | slot` (32 KiB pages, 128-byte slots), then
+//!   `0xb0000000 | tail`, tail = 2 x the 0xa8 terminator's offset in that
+//!   chunk. The head word is kept bit for bit.
+//! - A link is LE32 `(target & 0xffffffff) | 0x69`, target 0x80-aligned,
+//!   then zeros to the slot end.
+//! - Long lists start with a 12-byte prefix, then entries of 8 bytes
+//!   (`entry[1] & 7 == 0`) or 6 bytes (`== 2`), then a 1..8-byte terminal
+//!   ending in 0xa8 (Codex `research/g15-g2-tile-list-tokenizer.md`).
+//! - Multi-draw lists: whole 9-byte records (one per draw, header low nibble
+//!   2, high nibble nonzero), then 0xa8.
+//!
+//! The root chunk is repacked in place; continuation chunks come from a
+//! per-queue arena in the TVB window, reused every render. A non-final chunk
+//! keeps at most `g15_relink_cap` bytes, then the link: cut at that offset
+//! (`g15_relink_raw`, the default; the consumer reads one-draw lists as a
+//! byte stream) or at token boundaries, except that multi-draw lists are cut
+//! only between records. Lists ending at or before +0x3f are left alone;
+//! anything that cannot be bounded is left alone and counted.
+
+use core::sync::atomic::{AtomicU64, Ordering};
+use kernel::prelude::*;
+
+use super::g15_resources::{g15_clean_to_poc, g15_invalidate_from_poc};
+
+/// GPU VA of TVB page ID 0; links carry only the low 32 bits.
+pub(crate) const G15_TVB_BASE: u64 = 0x10_0000_0000;
+const CHUNK: usize = 0x80;
+const LINK_AT: usize = 0x78;
+const LINK_TAG: u32 = 0x69;
+/// Largest payload ahead of a link in a rewritten chunk
+/// (`g15_relink_cap`, 0x30..=0x3c; default 0x38).
+fn payload_cap() -> usize {
+    let c = *crate::module_parameters::g15_relink_cap.value() as usize;
+    if (0x30..=0x3c).contains(&c) { c } else { 0x38 }
+}
+/// Rejected lists logged so far (the first eight are logged).
+static G15_RELINK_REJECTS: AtomicU64 = AtomicU64::new(0);
+/// Relinked lists logged so far (the first eight are logged).
+static G15_RELINK_LOGGED: AtomicU64 = AtomicU64::new(0);
+/// Longest final chunk content: the terminator at +0x3f at most.
+const FINAL_MAX: usize = 0x40;
+const PREFIX: usize = 12;
+const MAX_CHUNKS: usize = 256;
+
+/// Totals since load: lists seen, relinked, arena slots used, left alone
+/// because unsupported, renders whose arena ran out.
+pub(crate) static G15_RELINK_TOTALS: [AtomicU64; 5] = [
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+    AtomicU64::new(0),
+];
+
+/// A CPU view of GPU memory: GPU VA, CPU address, length.
+#[derive(Clone, Copy)]
+pub(crate) struct G15RelinkView {
+    pub(crate) gpu: u64,
+    pub(crate) cpu: usize,
+    pub(crate) len: usize,
+}
+
+impl G15RelinkView {
+    fn contains(&self, va: u64, len: usize) -> bool {
+        va >= self.gpu && va + len as u64 <= self.gpu + self.len as u64
+    }
+}
+
+/// One render pass's relink inputs. The views stay valid while the pass's
+/// resources are alive, which the pair's completion state guarantees until
+/// both commands retire.
+pub(crate) struct G15RelinkPlan {
+    pub(crate) tilemap: G15RelinkView,
+    pub(crate) tpc: G15RelinkView,
+    pub(crate) blocks: KVec<G15RelinkView>,
+    pub(crate) arena: KVec<G15RelinkView>,
+}
+
+#[derive(Default, Debug, Clone, Copy)]
+pub(crate) struct G15RelinkStats {
+    pub(crate) lists: u32,
+    pub(crate) relinked: u32,
+    pub(crate) slots: u32,
+    pub(crate) unsupported: u32,
+    pub(crate) arena_full: bool,
+}
+
+fn rd8(a: usize) -> u8 {
+    // SAFETY: callers pass addresses inside a live `G15RelinkView`.
+    unsafe { core::ptr::read_volatile(a as *const u8) }
+}
+
+fn rd32(a: usize) -> u32 {
+    // SAFETY: as for `rd8`; 4-byte aligned.
+    unsafe { core::ptr::read_volatile(a as *const u32) }
+}
+
+fn wr8(a: usize, v: u8) {
+    // SAFETY: as for `rd8`; the 3D command is not yet published.
+    unsafe { core::ptr::write_volatile(a as *mut u8, v) }
+}
+
+fn wr32(a: usize, v: u32) {
+    // SAFETY: as for `wr8`; 4-byte aligned.
+    unsafe { core::ptr::write_volatile(a as *mut u32, v) }
+}
+
+/// Record boundaries of the multi-draw list form: whole 9-byte records,
+/// each starting with a header byte whose low nibble is 2 and high nibble
+/// (valid tiles) nonzero, then the 0xa8 terminator (Codex,
+/// `tools/g15-g2-relink-dump.py`). None if the list is not in that form.
+fn g15_multidraw_cuts(b: &[u8]) -> Result<Option<KVec<usize>>> {
+    const REC: usize = 9;
+    let n = b.len();
+    if n < 1 + REC || (n - 1) % REC != 0 || b[n - 1] != 0xa8 {
+        return Ok(None);
+    }
+    if !(0..n - 1).step_by(REC).all(|i| b[i] & 0xf == 2 && b[i] >> 4 != 0) {
+        return Ok(None);
+    }
+    let mut cuts = KVec::with_capacity((n - 1) / REC, GFP_KERNEL)?;
+    for i in (REC..n).step_by(REC) {
+        cuts.push(i, GFP_KERNEL)?;
+    }
+    Ok(Some(cuts))
+}
+
+/// The link ending `chunk`, if it holds one, as (target VA, offset). The TA
+/// writes it right after the last record that fits, at any byte offset
+/// (+0x78 in the hotspot lists, +0x70 in overdraw x200, +0x75 in a 16-draw
+/// list): LE32 `target | 0x69` (0x80-aligned target, high byte 0) followed
+/// only by zeros. Its target bytes can look like a tag too (`69 e9 13 00`,
+/// g2q16-233827), so the link is the lowest such word with a target of at
+/// least 64 KiB (TVB pages start at 0x68000), whose third byte is the last
+/// nonzero one. A final chunk ends
+/// in the 0xa8 terminator; a false match must also name a chunk in the TVB,
+/// which the caller checks.
+fn link_target(chunk: usize) -> Option<(u64, usize)> {
+    let last = (0..CHUNK).rev().find(|&p| rd8(chunk + p) != 0)?;
+    (last.saturating_sub(3)..=last.min(CHUNK - 4)).find_map(|at| {
+        let w = u32::from_le_bytes(core::array::from_fn(|k| rd8(chunk + at + k)));
+        (w & 0x7f == LINK_TAG && w >> 24 == 0 && w >= 0x1_0000 && at + 3 >= last)
+            .then(|| (G15_TVB_BASE | u64::from(w & !0x7f), at))
+    })
+}
+
+/// One list's relink, planned before any write.
+struct G15ListPlan {
+    root_va: u64,
+    root: usize,
+    tail_addr: usize,
+    tw: u32,
+    /// The chain's payload, flattened (links removed).
+    bytes: KVec<u8>,
+    /// Payload range of each output chunk: the root, then arena slots.
+    chunks: KVec<(usize, usize)>,
+    /// Destination of each output chunk after the root: (GPU VA, CPU).
+    dests: KVec<(u64, usize)>,
+    /// First arena slot.
+    first: usize,
+    /// The TA's first link offset in the root chunk (0: none), for the log.
+    link_at: usize,
+}
+
+/// Token boundaries of a flattened long list (Codex
+/// `research/g15-g2-tile-list-tokenizer.md`): a 12-byte prefix, entries of 8
+/// (`entry[1] & 7 == 0`) or 6 (`== 2`) bytes with `entry[0]` even, then a
+/// 1..8-byte terminal ending in 0xa8. Anything else is unsupported.
+fn g15_tokenize(buf: &[u8]) -> Result<KVec<usize>> {
+    let len = buf.len();
+    if len < PREFIX + 1 || buf[len - 1] != 0xa8 {
+        return Err(EINVAL);
+    }
+    let mut cuts = KVec::new();
+    let mut pos = PREFIX;
+    cuts.push(pos, GFP_KERNEL)?;
+    while len - pos > 8 {
+        if buf[pos] & 1 != 0 {
+            return Err(EINVAL);
+        }
+        pos += match buf[pos + 1] & 7 {
+            0 => 8,
+            2 => 6,
+            _ => return Err(EINVAL),
+        };
+        // An entry may not consume the terminal.
+        if pos >= len {
+            return Err(EINVAL);
+        }
+        cuts.push(pos, GFP_KERNEL)?;
+    }
+    Ok(cuts)
+}
+
+impl G15RelinkPlan {
+    fn cpu_of(&self, va: u64) -> Option<usize> {
+        self.blocks
+            .iter()
+            .find(|b| b.contains(va, CHUNK))
+            .map(|b| b.cpu + (va - b.gpu) as usize)
+    }
+
+    /// Arena slot `n` as (GPU VA, CPU address).
+    fn arena_slot(&self, n: usize) -> Option<(u64, usize)> {
+        let mut n = n;
+        for a in self.arena.iter() {
+            let slots = a.len / CHUNK;
+            if n < slots {
+                return Some((a.gpu + (n * CHUNK) as u64, a.cpu + n * CHUNK));
+            }
+            n -= slots;
+        }
+        None
+    }
+
+    /// Rewrite every list with content past +0x40 of a chunk. Call after
+    /// the TA completed and before the 3D publication.
+    pub(crate) fn run(&self) -> G15RelinkStats {
+        let mut st = G15RelinkStats::default();
+        let mut heads = match KVec::<(u32, usize)>::with_capacity(self.tpc.len / 8, GFP_KERNEL) {
+            Ok(h) => h,
+            Err(_) => {
+                st.arena_full = true;
+                return st;
+            }
+        };
+        g15_invalidate_from_poc(self.tpc.cpu, self.tpc.len);
+        g15_invalidate_from_poc(self.tilemap.cpu, self.tilemap.len);
+        for e in 0..self.tpc.len / 8 {
+            let entry = self.tpc.cpu + 8 * e;
+            let head = rd32(entry);
+            if head != 0 && rd32(entry + 4) >> 28 == 0xb {
+                let _ = heads.push((head, entry + 4), GFP_KERNEL);
+            }
+        }
+        heads.sort_unstable_by_key(|&(h, _)| h);
+        // One snapshot of the tilemap: both passes must see the same lists.
+        let mut roots: KVec<(usize, u64)> = KVec::new();
+        for t in 0..self.tilemap.len / 5 {
+            let base = self.tilemap.cpu + 5 * t;
+            let mut v = 0u64;
+            for k in 0..5 {
+                v |= u64::from(rd8(base + k)) << (8 * k);
+            }
+            if v != 0 && roots.push((t, v), GFP_KERNEL).is_err() {
+                st.arena_full = true;
+                return st;
+            }
+        }
+        if *crate::module_parameters::g15_relink_log.value() != 0 {
+            pr_info!("G15 relink: snapshot roots {} TPC heads {}\n", roots.len(), heads.len());
+        }
+        // Pass 1 validates every list and plans it (bytes, chunk cuts,
+        // arena slots); the commit only writes and cleans. Lists are
+        // independent: an unsupported list is left unchanged and the others
+        // are still relinked (with several draws per render, one odd list
+        // used to leave every long list in the render unrelinked).
+        let capacity: usize = self.arena.iter().map(|a| a.len / CHUNK).sum();
+        let mut plans: KVec<G15ListPlan> = KVec::new();
+        let mut next_slot = 0usize;
+        for &(t, v) in roots.iter() {
+            st.lists += 1;
+            // Low bits 0x02 (hotspot/overdraw) and 0x00 (glmark, rendered
+            // correctly unchanged) both name a live root at v & !0x7f.
+            let planned = if v & 0x7f != 0x02 && v & 0x7f != 0 {
+                Err(EPROTO)
+            } else {
+                self.plan_one(G15_TVB_BASE + (v & !0x7f), &heads, next_slot)
+            };
+            match planned {
+                Ok(None) => {}
+                Ok(Some(plan)) => {
+                    next_slot += plan.chunks.len() - 1;
+                    if plans.push(plan, GFP_KERNEL).is_err() {
+                        st.arena_full = true;
+                    }
+                }
+                Err(e) if e == ENOSPC => st.arena_full = true,
+                Err(e) => {
+                    st.unsupported += 1;
+                    let n = G15_RELINK_REJECTS.fetch_add(1, Ordering::Relaxed);
+                    if n == 0 && *crate::module_parameters::g15_relink_log.value() != 0 {
+                        self.dump_list(G15_TVB_BASE + (v & !0x7f), &heads);
+                    }
+                    if n < 8 {
+                        pr_info!(
+                            "G15 relink: tilemap entry {} value {:#x} rejected: errno {}; TPC heads {}\n",
+                            t,
+                            v,
+                            e.to_errno(),
+                            heads.len()
+                        );
+                    }
+                }
+            }
+        }
+        if next_slot > capacity {
+            st.arena_full = true;
+        }
+        if !st.arena_full {
+            for plan in plans.iter() {
+                self.commit(plan);
+            }
+            st.relinked = plans.len() as u32;
+            st.slots = next_slot as u32;
+        }
+        for (t, v) in G15_RELINK_TOTALS.iter().zip([
+            st.lists.into(),
+            st.relinked.into(),
+            st.slots.into(),
+            st.unsupported.into(),
+            u64::from(st.arena_full),
+        ]) {
+            t.fetch_add(v, Ordering::Relaxed);
+        }
+        st
+    }
+
+    /// G2 discriminator (`g15_relink_clone=1`, instead of relinking): copy
+    /// every single-chunk list whose terminator is past +0x3f, byte for byte,
+    /// to a fresh arena chunk, and repoint only its tilemap root and TPC head
+    /// (tail and bytes unchanged). Returns (cloned, skipped).
+    pub(crate) fn clone_run(&self) -> (u32, u32) {
+        let (mut cloned, mut skipped) = (0u32, 0u32);
+        let mut heads = match KVec::<(u32, usize)>::with_capacity(self.tpc.len / 8, GFP_KERNEL) {
+            Ok(h) => h,
+            Err(_) => return (0, 0),
+        };
+        g15_invalidate_from_poc(self.tpc.cpu, self.tpc.len);
+        g15_invalidate_from_poc(self.tilemap.cpu, self.tilemap.len);
+        for e in 0..self.tpc.len / 8 {
+            let entry = self.tpc.cpu + 8 * e;
+            let head = rd32(entry);
+            if head != 0 && rd32(entry + 4) >> 28 == 0xb {
+                let _ = heads.push((head, entry), GFP_KERNEL);
+            }
+        }
+        heads.sort_unstable_by_key(|&(h, _)| h);
+        let mut slot = 0usize;
+        for t in 0..self.tilemap.len / 5 {
+            let base = self.tilemap.cpu + 5 * t;
+            let mut v = 0u64;
+            for k in 0..5 {
+                v |= u64::from(rd8(base + k)) << (8 * k);
+            }
+            if v == 0 {
+                continue;
+            }
+            let root_va = G15_TVB_BASE + (v & !0x7f);
+            let Some(root) = self.cpu_of(root_va) else {
+                skipped += 1;
+                continue;
+            };
+            g15_invalidate_from_poc(root, CHUNK);
+            let code = ((root_va - G15_TVB_BASE) >> 7) as u32;
+            let i = match heads.binary_search_by_key(&code, |&(h, _)| h) {
+                Ok(i) if !((i > 0 && heads[i - 1].0 == code) || (i + 1 < heads.len() && heads[i + 1].0 == code)) => i,
+                _ => {
+                    skipped += 1;
+                    continue;
+                }
+            };
+            let entry = heads[i].1;
+            let term = ((rd32(entry + 4) & 0xfff) / 2) as usize;
+            if link_target(root).is_some() || term < 0x40 {
+                skipped += 1;
+                continue;
+            }
+            let Some((dst_va, dst)) = self.arena_slot(slot) else {
+                skipped += 1;
+                continue;
+            };
+            slot += 1;
+            for k in 0..CHUNK {
+                wr8(dst + k, rd8(root + k));
+            }
+            g15_clean_to_poc(dst, CHUNK);
+            let nv = (dst_va - G15_TVB_BASE) | (v & 0x7f);
+            for k in 0..5 {
+                wr8(base + k, (nv >> (8 * k)) as u8);
+            }
+            g15_clean_to_poc(base, 5);
+            wr32(entry, ((dst_va - G15_TVB_BASE) >> 7) as u32);
+            g15_clean_to_poc(entry, 4);
+            cloned += 1;
+            if cloned <= 4 {
+                pr_info!("G15 relink clone: root {:#x} -> {:#x} terminator +{:#x}\n", root_va, dst_va, term);
+            }
+        }
+        (cloned, skipped)
+    }
+
+    /// G2 discriminator (`g15_tvb_fill`): before the TA is published, fill
+    /// every TVB block with `byte` and clean it to PoC, so anything the
+    /// consumer reads that the TA did not write is a recognizable pattern.
+    pub(crate) fn fill_blocks(&self, byte: u8) -> usize {
+        let mut n = 0;
+        for b in self.blocks.iter() {
+            for k in 0..b.len {
+                wr8(b.cpu + k, byte);
+            }
+            g15_clean_to_poc(b.cpu, b.len);
+            n += b.len;
+        }
+        n
+    }
+
+    /// G2 discriminator (`g15_relink_pad=K`, instead of relinking): in every
+    /// single-chunk list with a unique TPC tail whose last entry is a 6-byte
+    /// record, insert K copies of that record with its mask byte cleared (a
+    /// valid primitive covering no pixel; Codex: header 0x26 = one tile, 4-byte
+    /// base, 1-byte mask) in front of the terminal token, and move the TPC tail
+    /// with it: the same records, ending 6K bytes later. Lists whose new
+    /// terminator would reach the link slot (+0x78) are left alone. Returns
+    /// (padded, skipped).
+    pub(crate) fn pad_run(&self, n: usize) -> (u32, u32) {
+        let (mut padded, mut skipped) = (0u32, 0u32);
+        let mut heads = match KVec::<(u32, usize)>::with_capacity(self.tpc.len / 8, GFP_KERNEL) {
+            Ok(h) => h,
+            Err(_) => return (0, 0),
+        };
+        g15_invalidate_from_poc(self.tpc.cpu, self.tpc.len);
+        g15_invalidate_from_poc(self.tilemap.cpu, self.tilemap.len);
+        for e in 0..self.tpc.len / 8 {
+            let entry = self.tpc.cpu + 8 * e;
+            let head = rd32(entry);
+            if head != 0 && rd32(entry + 4) >> 28 == 0xb {
+                let _ = heads.push((head, entry + 4), GFP_KERNEL);
+            }
+        }
+        heads.sort_unstable_by_key(|&(h, _)| h);
+        for t in 0..self.tilemap.len / 5 {
+            let base = self.tilemap.cpu + 5 * t;
+            let mut v = 0u64;
+            for k in 0..5 {
+                v |= u64::from(rd8(base + k)) << (8 * k);
+            }
+            if v == 0 {
+                continue;
+            }
+            match self.pad_one(G15_TVB_BASE + (v & !0x7f), &heads, n) {
+                Some((old, new)) => {
+                    padded += 1;
+                    if padded <= 8 {
+                        pr_info!("G15 relink pad: root {:#x} terminator +{:#x} -> +{:#x}\n", v & !0x7f, old, new);
+                        // The padded chunk's first 0x50 bytes, for token placement.
+                        if let Some(c) = self.cpu_of(G15_TVB_BASE + (v & !0x7f)) {
+                            let b: [u8; 0x50] = core::array::from_fn(|k| rd8(c + k));
+                            pr_info!("G15 relink pad bytes: {:02x?}\n", &b[..]);
+                        }
+                    }
+                }
+                None => skipped += 1,
+            }
+        }
+        (padded, skipped)
+    }
+
+    /// One list for `pad_run`: (old, new) terminator offsets, or None if
+    /// left alone.
+    fn pad_one(&self, root_va: u64, heads: &[(u32, usize)], n: usize) -> Option<(usize, usize)> {
+        let root = self.cpu_of(root_va)?;
+        g15_invalidate_from_poc(root, CHUNK);
+        if link_target(root).is_some() {
+            return None;
+        }
+        let code = ((root_va - G15_TVB_BASE) >> 7) as u32;
+        let i = heads.binary_search_by_key(&code, |&(h, _)| h).ok()?;
+        if (i > 0 && heads[i - 1].0 == code) || (i + 1 < heads.len() && heads[i + 1].0 == code) {
+            return None;
+        }
+        let (tail_addr, tw) = (heads[i].1, rd32(heads[i].1));
+        if tw & 1 != 0 || tw & 0x0fff_f000 != 0 {
+            return None;
+        }
+        const REC: usize = 6;
+        let term = ((tw & 0xfff) / 2) as usize;
+        let pad = n.checked_mul(REC)?;
+        if term + pad >= LINK_AT || rd8(root + term) != 0xa8 {
+            return None;
+        }
+        let mut buf = KVec::with_capacity(term + 1, GFP_KERNEL).ok()?;
+        for k in 0..=term {
+            buf.push(rd8(root + k), GFP_KERNEL).ok()?;
+        }
+        let cuts = g15_tokenize(&buf).ok()?;
+        // The terminal starts at the last cut; the record before it is the
+        // template and must be a 6-byte entry.
+        let start = *cuts.last()?;
+        let prev = *cuts.get(cuts.len().checked_sub(2)?)?;
+        if start - prev != REC {
+            return None;
+        }
+        let mut rec = [0u8; REC];
+        rec.copy_from_slice(&buf[prev..start]);
+        // Only a header-0x16 descriptor is 6 bytes (SIPF2: 0x12 = 5,
+        // 0x1a = 7, 0x1e = 8); copying any other would be malformed.
+        if rec[0] != 0x16 {
+            return None;
+        }
+        rec[REC - 1] = 0;
+        // `g15_relink_pad_b1`: replace the copies' encoded base byte 1
+        // (e.g. 0x1a -> 0x12 moves the primitive base down by 0x40).
+        let b1 = *crate::module_parameters::g15_relink_pad_b1.value();
+        if b1 != 0 {
+            rec[1] = b1 as u8;
+        }
+        for k in (start..=term).rev() {
+            wr8(root + k + pad, buf[k]);
+        }
+        for c in 0..n {
+            for (j, b) in rec.iter().enumerate() {
+                wr8(root + start + c * REC + j, *b);
+            }
+        }
+        g15_clean_to_poc(root, CHUNK);
+        wr32(tail_addr, (tw & !0xfff) | (2 * (term + pad)) as u32);
+        g15_clean_to_poc(tail_addr, 4);
+        Some((term, term + pad))
+    }
+
+    /// Plan one list, or None if it is left unchanged. Reads only. Error
+    /// codes name the failed check (logged for the first few).
+    /// `g15_relink_log`: the first rejected list's chunks (at most 8) and the
+    /// final chunk's TPC entries, for offline grammar work.
+    fn dump_list(&self, root_va: u64, heads: &[(u32, usize)]) {
+        let mut va = root_va;
+        for i in 0..8 {
+            let Some(c) = self.cpu_of(va) else {
+                pr_info!("G15 relink dump: chunk {} va {:#x} unmapped\n", i, va);
+                return;
+            };
+            g15_invalidate_from_poc(c, CHUNK);
+            for off in (0..CHUNK).step_by(16) {
+                let b: [u8; 16] = core::array::from_fn(|k| rd8(c + off + k));
+                pr_info!(
+                    "G15 relink dump: chunk {} va {:#x} +{:02x}: {:02x}{:02x}{:02x}{:02x} {:02x}{:02x}{:02x}{:02x} {:02x}{:02x}{:02x}{:02x} {:02x}{:02x}{:02x}{:02x}\n",
+                    i, va, off, b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7], b[8], b[9], b[10],
+                    b[11], b[12], b[13], b[14], b[15]
+                );
+            }
+            let code = ((va - G15_TVB_BASE) >> 7) as u32;
+            for &(h, a) in heads.iter().filter(|&&(h, _)| h == code) {
+                pr_info!("G15 relink dump: chunk {} TPC code {:#x} tail word {:#x}\n", i, h, rd32(a));
+            }
+            match link_target(c) {
+                Some((t, _)) => va = t,
+                None => return,
+            }
+        }
+    }
+
+    fn plan_one(&self, root_va: u64, heads: &[(u32, usize)], first: usize) -> Result<Option<G15ListPlan>> {
+        let root = self.cpu_of(root_va).ok_or(EFAULT)?;
+        g15_invalidate_from_poc(root, CHUNK);
+
+        // Walk to the final chunk; its TPC entry gives the tail.
+        let mut final_va = root_va;
+        let mut chunk = root;
+        let mut links = 0usize;
+        let mut link_at = 0;
+        while let Some((target, at)) = link_target(chunk) {
+            if links == 0 {
+                link_at = at;
+            }
+            links += 1;
+            if links >= MAX_CHUNKS {
+                return Err(ELOOP);
+            }
+            final_va = target;
+            chunk = self.cpu_of(target).ok_or(EFAULT)?;
+            g15_invalidate_from_poc(chunk, CHUNK);
+        }
+        // The end: a unique TPC entry for the final chunk gives the tail
+        // (2 x the 0xa8 terminator's offset). Without one (the TPC does not
+        // name every live list, g2capladder), the terminator is the only
+        // 0xa8 followed by zeros to the end of its 64-byte half; reused TVB
+        // memory keeps stale bytes past a live terminator otherwise
+        // (g2capnotpc-214107). The fragment pass reads no TPC.
+        let code = ((final_va - G15_TVB_BASE) >> 7) as u32;
+        let (tail_addr, tw) = match heads.binary_search_by_key(&code, |&(h, _)| h) {
+            Ok(i)
+                if !((i > 0 && heads[i - 1].0 == code)
+                    || (i + 1 < heads.len() && heads[i + 1].0 == code)) =>
+            {
+                (heads[i].1, rd32(heads[i].1))
+            }
+            _ => (0, 0),
+        };
+        let inferred = tail_addr == 0;
+        // Without a TPC tail, a single chunk whose first half holds exactly
+        // one 0xa8 followed by zeros to +0x40 is a short list the consumer
+        // handles: leave it without looking at the (possibly stale) second
+        // half (Codex's 165-root audit). A unique TPC tail stays authoritative.
+        if inferred && links == 0 {
+            let mut ends = (0..0x40usize)
+                .filter(|&p| rd8(chunk + p) == 0xa8 && (p + 1..0x40).all(|k| rd8(chunk + k) == 0));
+            if let (Some(_), None) = (ends.next(), ends.next()) {
+                return Ok(None);
+            }
+        }
+        let term = if tail_addr != 0 {
+            // Tail: even, in the low 12 bits; bits 12..27 reserved zero.
+            if tw & 1 != 0 || tw & 0x0fff_f000 != 0 {
+                return Err(ERANGE);
+            }
+            ((tw & 0xfff) / 2) as usize
+        } else {
+            let mut found = None;
+            for p in 0..CHUNK {
+                let half_end = if p < 0x40 { 0x40 } else { CHUNK };
+                if rd8(chunk + p) == 0xa8 && (p + 1..half_end).all(|k| rd8(chunk + k) == 0) {
+                    if found.is_some() {
+                        return Err(EBADMSG);
+                    }
+                    found = Some(p);
+                }
+            }
+            found.ok_or(EBADMSG)?
+        };
+        if term >= CHUNK || rd8(chunk + term) != 0xa8 {
+            return Err(EBADMSG);
+        }
+
+        // Single-chunk lists ending by +0x3f (including the 10-byte form
+        // without the long-list prefix) are what the consumer handles.
+        if links == 0 && term < FINAL_MAX {
+            return Ok(None);
+        }
+
+        // Flatten the chain's payload.
+        let mut bytes = KVec::with_capacity((links + 1) * LINK_AT, GFP_KERNEL)?;
+        let mut chunk = root;
+        while let Some((target, at)) = link_target(chunk) {
+            for k in 0..at {
+                bytes.push(rd8(chunk + k), GFP_KERNEL)?;
+            }
+            chunk = self.cpu_of(target).ok_or(EFAULT)?;
+        }
+        for k in 0..=term {
+            bytes.push(rd8(chunk + k), GFP_KERNEL)?;
+        }
+
+        // Chunk payloads: non-final ones end at a token boundary within the
+        // cap (or exactly at the cap in raw mode, `g15_relink_raw`: the
+        // consumer reads the list as a byte stream across links, as the
+        // mid-entry +0x38 splice showed); the final one holds at most 0x40.
+        let raw = *crate::module_parameters::g15_relink_raw.value() != 0;
+        // An inferred end on a long list must be confirmed by the grammar:
+        // a payload 0xa8 before stale zeros could otherwise cut a live list.
+        if inferred {
+            g15_tokenize(&bytes)?;
+        }
+        // The multi-draw form (one 9-byte record per draw) is split only at
+        // record boundaries, in either mode; a raw cut inside a record hangs
+        // (g2quadsdump-224508).
+        let records = if inferred { None } else { g15_multidraw_cuts(&bytes)? };
+        let cuts = match records {
+            Some(c) => c,
+            None if raw => KVec::new(),
+            None => g15_tokenize(&bytes)?,
+        };
+        let raw = raw && cuts.is_empty();
+        let len = bytes.len();
+        let mut chunks: KVec<(usize, usize)> = KVec::new();
+        let mut start = 0usize;
+        while len - start > FINAL_MAX {
+            let end = if raw {
+                start + payload_cap()
+            } else {
+                cuts.iter()
+                    .copied()
+                    .filter(|&c| c > start && c - start <= payload_cap())
+                    .max()
+                    .ok_or(EMSGSIZE)?
+            };
+            chunks.push((start, end), GFP_KERNEL)?;
+            start = end;
+        }
+        chunks.push((start, len), GFP_KERNEL)?;
+        // Resolve every destination now; the commit cannot fail.
+        let mut dests = KVec::with_capacity(chunks.len() - 1, GFP_KERNEL)?;
+        for i in 0..chunks.len() - 1 {
+            dests.push(self.arena_slot(first + i).ok_or(ENOSPC)?, GFP_KERNEL)?;
+        }
+        Ok(Some(G15ListPlan {
+            root_va,
+            root,
+            tail_addr,
+            tw,
+            bytes,
+            chunks,
+            dests,
+            first,
+            link_at,
+        }))
+    }
+
+    /// Write one planned list: the root in place, then its arena slots, then
+    /// the TPC tail. No allocation; slots were sized in planning.
+    fn commit(&self, p: &G15ListPlan) {
+        let mut dest = p.root;
+        for (i, &(s, e)) in p.chunks.iter().enumerate() {
+            let n = e - s;
+            for k in 0..n {
+                wr8(dest + k, p.bytes[s + k]);
+            }
+            let mut fill = n;
+            let next = match p.dests.get(i) {
+                Some(&(gva, cpu)) => {
+                    let l = ((gva & 0xffff_ffff) as u32 & !0x7f) | LINK_TAG;
+                    for (k, b) in l.to_le_bytes().iter().enumerate() {
+                        wr8(dest + n + k, *b);
+                    }
+                    fill = n + 4;
+                    Some(cpu)
+                }
+                None => None,
+            };
+            for k in fill..CHUNK {
+                wr8(dest + k, 0);
+            }
+            g15_clean_to_poc(dest, CHUNK);
+            match next {
+                Some(cpu) => dest = cpu,
+                None => {
+                    if p.tail_addr != 0 {
+                        let t = (p.tw & !0xfff) | (2 * (n - 1)) as u32;
+                        wr32(p.tail_addr, t);
+                        g15_clean_to_poc(p.tail_addr, 4);
+                    }
+                    break;
+                }
+            }
+        }
+        if G15_RELINK_LOGGED.fetch_add(1, Ordering::Relaxed) < 8 {
+            let tail_now = if p.tail_addr != 0 { rd32(p.tail_addr) & 0xfff } else { 0 };
+            let mut sizes = [0usize; 8];
+            for (l, &(s, e)) in sizes.iter_mut().zip(p.chunks.iter()) {
+                *l = e - s;
+            }
+            pr_info!(
+                "G15 relink: root {:#x} TA link +{:#x} len {:#x} chunks {} payloads {:x?} arena slot {} tail {:#x} -> {:#x}\n",
+                p.root_va,
+                p.link_at,
+                p.bytes.len(),
+                p.chunks.len(),
+                &sizes[..p.chunks.len().min(8)],
+                p.first,
+                p.tw & 0xfff,
+                tail_now
+            );
+        }
+    }
+
+}
