+/// One selected installed allocation and its preallocated dump payload.
+struct G15PayloadSelection {
+    index: usize,
+    gpuva: u64,
+    len: usize,
+    heap: G15Heap,
+    class: G15PteClass,
+    offset: usize,
+    output: Range<usize>,
