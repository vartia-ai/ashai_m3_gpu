+    /// Raise the G15 pending-submission count at the same lifecycle boundary
+    /// observed in the successful native write1337 transaction: after all
+    /// prerequisites are published and immediately before the work producer.
+    /// On success `reservation` is armed and owns the raise. On EIO this
+    /// function undoes its own increment before returning, so a count that
+    /// was already nonzero is not pushed higher by every refused submit.
+    fn g15_begin_submission(&self, reservation: &G15SubmissionReservation) -> Result {
+        #[ver(G != G15)]
+        {
+            let _ = reservation;
+            return Err(EINVAL);
+        }
+        #[ver(G == G15)]
+        {
+            if reservation.armed.load(Ordering::Acquire) {
+                return Err(EINVAL);
+            }
+            let before = self.initdata.g15_globals.with(|raw, _inner| {
+                raw.pending_submissions_074.fetch_add(1, Ordering::AcqRel)
+            });
+            mem::sync();
+            let after = self.initdata.g15_globals.with(|raw, _inner| {
+                raw.pending_submissions_074.load(Ordering::Acquire)
+            });
+            if crate::debug::g15_verbose() {
+                dev_info!(
+                self.dev.as_ref(),
+                "T8122 G15 R43 q4 pending submissions {} -> {}\n",
+                before,
+                after
+            );
+                }
+            if before != 0 || after != 1 {
+                // Undo only our own increment; never go below zero.
+                let rolled_back = self.initdata.g15_globals.with(|raw, _inner| {
+                    raw.pending_submissions_074
+                        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |v| v.checked_sub(1))
+                        .unwrap_or(0)
+                });
+                mem::sync();
+                dev_err!(
+                    self.dev.as_ref(),
+                    "T8122 G15 R48 q4 pending submissions refused ({} -> {}); rolled back {} -> {}\n",
+                    before,
+                    after,
+                    rolled_back,
+                    rolled_back.saturating_sub(1)
+                );
+                return Err(EIO);
+            }
+            reservation.armed.store(true, Ordering::Release);
+            self.g15_counters.submissions.fetch_add(1, Ordering::Relaxed);
+            Ok(())
+        }
+    }
+
+    /// R48: lower the pending-submission count raised for `reservation`,
+    /// at most once. Called by the completion callback and by the submit
+    /// error path; only the first caller while armed reaches
