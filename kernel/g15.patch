+/// Prepared only for the native triangle entry family while render dumps are
+/// enabled. All storage is allocated during submit, before state publication.
+struct G15PreparedPayloadSnapshot {
+    selections: [G15PayloadSelection; 5],
+    meta: Range<usize>,
+    bytes: KVec<u8>,
+    ta: u64,
+}
+
+impl G15PreparedPayloadSnapshot {
+    #[inline(never)]
+    fn new(
+        res: &G15RenderResources, user: &G15UserRender, indices: &[usize],
+        id: u64, vm_slot: u32, ta: u64, frag: u64,
+    ) -> Result<Self> {
+        use super::g15_render::{G15DumpEngine as E, G15RenderDump};
+        let aux = user.sections().iter().position(|s|
+            s.role == Role::AuxCode && s.native_va == mmu::G15_GART_RANGE5.start
+                && s.len() == 0x4000).ok_or(EINVAL)?;
+        let si = [aux, user.find(Role::VsUsc).ok_or(EINVAL)?,
+            user.find(Role::FsUsc).ok_or(EINVAL)?, user.find(Role::Vdm).ok_or(EINVAL)?,
+            user.find(Role::Ppp).ok_or(EINVAL)?];
+        let mut dump = G15RenderDump::new()?;
+        let meta = dump.object_storage(E::None, "publish.payload_meta", 0, 512)?;
+        let prepare = |dump: &mut G15RenderDump, n: usize, name: &str, e: E,
+                       offset: usize, size: usize| -> Result<G15PayloadSelection> {
+            let index = *indices.get(si[n]).ok_or(EINVAL)?;
+            let r = res.selected_user_payload(index)?;
+            let section = &user.sections()[si[n]];
+            if r.len() != section.len() || size == 0
+                || offset.checked_add(size).ok_or(EINVAL)? > r.len() {
+                return Err(EINVAL);
+            }
+            // Contiguous CPU ownership is required by this narrow diagnostic;
+            // do not silently substitute input bytes or a split staging copy.
+            let _ = r.as_slice()?;
+            let output = dump.object_storage(e, name,
+                r.gpu_va().checked_add(offset as u64).ok_or(EINVAL)?, size)?;
+            Ok(G15PayloadSelection { index, gpuva: r.gpu_va(), len: r.len(),
+                heap: r.heap(), class: r.class(), offset, output })
+        };
+        // The full two USC allocations cover the opaque entry tails as well.
+        if user.sections()[si[1]].len() != 0x8000
+            || user.sections()[si[2]].len() != 0x8000 { return Err(EINVAL); }
+        let selections = [
+            prepare(&mut dump, 0, "publish.aux_code", E::None, 0, 0x4000)?,
+            prepare(&mut dump, 1, "publish.vs_usc", E::Ta, 0, 0x8000)?,
+            prepare(&mut dump, 2, "publish.fs_usc", E::Frag, 0, 0x8000)?,
+            prepare(&mut dump, 3, "publish.vdm_link", E::Ta, 0x0c, 4)?,
+            prepare(&mut dump, 4, "publish.ppp_link", E::Frag, 0x914, 4)?,
+        ];
+        let mut bytes = dump.finish();
+        let m = &mut bytes[meta.clone()];
+        m[..8].copy_from_slice(b"G15PAYL1");
+        let put = |m: &mut [u8], off: usize, v: u64| m[off..off + 8].copy_from_slice(&v.to_le_bytes());
+        for (off, value) in [(8, 1), (24, id), (32, u64::from(vm_slot)), (40, ta),
+                             (48, frag), (56, 2), (112, 5)] { put(m, off, value); }
+        for (n, s) in selections.iter().enumerate() {
+            let heap = match s.heap {
+                G15Heap::Range5Code => 0, G15Heap::Range5Ppl308 => 1,
+                G15Heap::Range5Uncached => 2, G15Heap::Range5Cached => 3,
+                G15Heap::Range5PrimeCode => 4, G15Heap::Range5PrimePpl308 => 5,
+                G15Heap::Bank1Range7 => 6, G15Heap::Bank1Range7Uncached => 7,
+                G15Heap::Bank1Range8 => 8, G15Heap::Window(i) => 0x100 + i as u64,
+            };
+            for (field, value) in [si[n] as u64, s.index as u64, s.gpuva, s.len as u64,
+                s.offset as u64, s.output.len() as u64, heap,
+                u64::from(s.class.gart_range), s.class.pte_attr].iter().enumerate() {
+                put(m, 128 + n * 72 + field * 8, *value);
+            }
+        }
+        Ok(Self { selections, meta, bytes, ta })
+    }
+
+    #[inline(never)]
+    fn read(&mut self, res: &G15RenderResources) -> Result {
+        for s in &self.selections {
+            let r = res.selected_user_payload(s.index)?;
+            if r.gpu_va() != s.gpuva || r.len() != s.len || r.heap() != s.heap
+                || r.class() != s.class { return Err(EIO); }
+            r.read_selected(s.offset, &mut self.bytes[s.output.clone()])?;
+        }
+        let word = |n: usize| -> Result<u32> {
+            Ok(u32::from_le_bytes(self.bytes[self.selections[n].output.clone()]
+                .try_into().map_err(|_| EINVAL)?))
+        };
+        // Fixture-scoped observed entry selectors, not a general graphics ABI.
+        let base = mmu::G15_GART_RANGE5.start;
+        let vs_entry = base.checked_add(u64::from(word(3)?) << 6).ok_or(EINVAL)?;
+        let fs_entry = base.checked_add(u64::from(word(4)?) << 6).ok_or(EINVAL)?;
+        let body = |n: usize, entry: u64, relative: usize| -> Result<u64> {
+            let s = &self.selections[n];
+            let off = usize::try_from(entry.checked_sub(s.gpuva).ok_or(EINVAL)?)
+                .map_err(|_| EINVAL)?.checked_add(relative).ok_or(EINVAL)?;
+            let b = self.bytes[s.output.clone()].get(off..off.checked_add(10).ok_or(EINVAL)?)
+                .ok_or(EINVAL)?;
+            if b[..2] != [0x77, 0x01] { return Err(EINVAL); }
+            let raw = u64::from_le_bytes(b[2..].try_into().map_err(|_| EINVAL)?);
+            let target = base.checked_add(((raw & 0x1_ffff_ff80) >> 7) << 6).ok_or(EINVAL)?;
+            let aux = &self.selections[0];
+            if target < aux.gpuva || target >= aux.gpuva + aux.len as u64 {
+                return Err(EINVAL);
+            }
+            Ok(target)
+        };
+        for (n, entry, selected_len) in [(1, vs_entry, 96), (2, fs_entry, 48)] {
+            let off = usize::try_from(entry.checked_sub(self.selections[n].gpuva)
+                .ok_or(EINVAL)?).map_err(|_| EINVAL)?;
+            if off.checked_add(selected_len).ok_or(EINVAL)? > self.selections[n].output.len() {
+                return Err(EINVAL);
+            }
+        }
+        let vs_body = body(1, vs_entry, 0x26)?;
+        let fs_body = body(2, fs_entry, 8)?;
+        let m = &mut self.bytes[self.meta.clone()];
+        for (off, value) in [(64, vs_entry), (72, fs_entry), (80, vs_body), (88, fs_body),
+            (96, vs_entry.checked_add(0x26).ok_or(EINVAL)?),
+            (104, fs_entry.checked_add(8).ok_or(EINVAL)?), (16, 1)] {
+            m[off..off + 8].copy_from_slice(&value.to_le_bytes());
+        }
+        Ok(())
+    }
+}
