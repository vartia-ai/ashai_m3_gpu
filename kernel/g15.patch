+#[versions(AGX)]
+#[allow(dead_code)]
+impl G15SelectedPayloadSnapshot::ver {
+    #[inline(never)]
+    pub(super) fn capture(mut self, dev: &AsahiDevice, pipe: PipeType) -> Result {
+        if !matches!(pipe, PipeType::Fragment) { return Err(EINVAL); }
+        {
+            let done = self.done.lock();
+            let final_state = (&*done).as_ref().ok_or(EIO)?;
+            if final_state.dump_ta_command != Some(self.prepared.ta) { return Err(EIO); }
+            self.prepared.read(&final_state._resources)?;
+        }
+        // Never nest the final-state, lease, and debugfs locks.
+        let mut last = dev.g15_render_last.lock();
+        super::g15_render::G15RenderDump::append_selected(
+            &mut *last, self.prepared.ta, &self.prepared.bytes)
+    }
+}
