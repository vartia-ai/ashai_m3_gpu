+    #[test]
+    fn bitfield_encoding() {
+        let mut t = G15TargetTable::new();
+        t.set(G15RelocTarget::Tpc, 0x12_3456_7000).unwrap();
+        t.set(G15RelocTarget::RenderTarget, 0x12_0000_0000).unwrap();
+        let enc = |base, ashift, fshift, mask| G15Reloc {
+            target: G15RelocTarget::Tpc,
+            addend: 0,
+            encoding: G15Encoding::Bitfield {
+                base,
+                address_shift: ashift,
+                field_shift: fshift,
+                mask,
+            },
+        };
+        // Offset from a literal base, keeping native tag bit 63.
+        let rl = enc(G15AddrBase::Literal(HI as u64), 0, 0, (1 << 48) - 1);
+        assert_eq!(rl.encode(BIT63 | 0xdead, 8, &t), Ok(BIT63 | 0x2_3456_7000));
+        // Offset from a resource base, shifted into a 32-bit field.
+        let rt = enc(G15AddrBase::Target(G15RelocTarget::RenderTarget), 12, 4, 0xffff_fff0);
+        assert_eq!(rt.encode(0xf, 4, &t), Ok((0x3456_7 << 4) | 0xf));
+        // Lost alignment bits.
+        let ra = enc(G15AddrBase::Literal(0), 16, 0, !0);
+        assert_eq!(ra.encode(0, 8, &t), Err(EINVAL));
+        // Overflow past the mask.
+        let ro = enc(G15AddrBase::Literal(0), 0, 0, 0xffff_ffff);
+        assert_eq!(ro.encode(0, 4, &t), Err(EINVAL));
+        // Target below the base.
+        let rb = enc(G15AddrBase::Literal(u64::MAX), 0, 0, !0);
+        assert_eq!(rb.encode(0, 8, &t), Err(EINVAL));
+        // Full address does not fit in 4 bytes.
+        let rf = G15Reloc {
+            target: G15RelocTarget::Tpc,
+            addend: 0,
+            encoding: G15Encoding::FullAddress,
+        };
+        assert_eq!(rf.encode(0, 4, &t), Err(EINVAL));
+    }
