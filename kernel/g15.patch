+/// Hex-dump the RTKit crashlog sections the RTKit parser does not decode
+/// (anything but CLHE/Cstr/Cver/Cmbx/Ctim/Crg8), up to 1 KiB each, so
+/// firmware crash details reach the persistent kernel log.
+fn g15_dump_crashlog_sections(dev: &kernel::device::Device, log: &[u8]) {
+    let u32_at = |off: usize| -> Option<u32> {
+        log.get(off..off + 4).map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+    };
+    let Some(total) = u32_at(8) else { return };
+    let end = (total as usize).min(log.len());
+    let mut off = 0x20usize;
+    let known = [*b"CLHE", *b"Cstr", *b"Cver", *b"Cmbx", *b"Ctim", *b"Crg8"];
+    while off + 16 <= end {
+        let (Some(fourcc), Some(size)) = (u32_at(off), u32_at(off + 12)) else { break };
+        let size = size as usize;
+        if size < 16 || off + size > end {
+            break;
+        }
+        let tag = fourcc.to_be_bytes();
+        if tag == *b"CLHE" {
+            break;
+        }
+        if !known.contains(&tag) {
+            let body = &log[off + 16..off + size];
+            dev_err!(
+                dev,
+                "G15 crashlog section {:?} ({:#x} bytes):\n",
+                core::str::from_utf8(&tag).unwrap_or("????"),
+                body.len()
+            );
+            for (i, chunk) in body.chunks(32).take(32).enumerate() {
+                let mut line = [0u8; 32 * 3];
+                let mut n = 0;
+                for b in chunk {
+                    let hex = b"0123456789abcdef";
+                    line[n] = hex[(b >> 4) as usize];
+                    line[n + 1] = hex[(b & 0xf) as usize];
+                    line[n + 2] = b' ';
+                    n += 3;
+                }
+                dev_err!(
+                    dev,
+                    "  +{:#05x}: {}\n",
+                    i * 32,
+                    core::str::from_utf8(&line[..n]).unwrap_or("")
+                );
+            }
+        }
+        off += size;
     }
 }
