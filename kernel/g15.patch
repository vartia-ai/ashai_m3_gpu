+/// I05: an ordinary G15 compute command, `flags == 0` with a real CDM stream
+/// in a user-bound BO. The submit gate admits it only with the
+/// `g15_ordinary_compute` module parameter; `base == 0` stays stock-empty.
+pub(crate) fn g15_is_ordinary(compute: &uapi::drm_asahi_cmd_compute) -> bool {
+    compute.flags == 0 && compute.cdm_ctrl_stream_base != 0
+}
+
+/// I05: largest ordinary CDM stream, terminator excluded.
+const G15_ORDINARY_MAX_CDM: u64 = 0x10000;
+
+/// I05 (K6): most input and most output syncs of one Mesa-shaped submit, each
+/// way. It also keeps `in + out` in `SyncItem::parse_array` far from u32
+/// overflow.
+pub(crate) const G15_MESA_MAX_SYNCS: u32 = 256;
+
+/// I05 (K6): whether `cmdbuf_raw` is a Mesa submit shape G15 admits: Mesa's
+/// compute shape (`g15_mesa_compute_shape`) or, I09 R8, its render shape
+/// (`g15_mesa_render_split`). Such a submit may also carry input syncs,
+/// several output syncs (timelines included) and barriers of NONE or 0.
+/// Every other G15 shape keeps the stricter rules.
+pub(crate) fn g15_mesa_shape(cmdbuf_raw: &[u8]) -> bool {
+    g15_mesa_compute_shape(cmdbuf_raw) || g15_mesa_render_split(cmdbuf_raw).is_some()
+}
+
+/// I09 R8: most fragment attachments in one Mesa render submit (Mesa sends
+/// up to 8 colour buffers, depth and separate stencil).
+pub(crate) const G15_MESA_MAX_ATTACHMENTS: usize = 16;
+
+/// I09 R8: largest Mesa render command buffer: the attachment prefix plus
+/// the longest HYBRID render.
+pub(crate) const G15_MESA_RENDER_MAX_BYTES: usize = 2
+    * core::mem::size_of::<uapi::drm_asahi_cmd_header>()
+    + G15_MESA_MAX_ATTACHMENTS * core::mem::size_of::<uapi::drm_asahi_attachment>()
+    + core::mem::size_of::<uapi::drm_asahi_g15_cmd_render_hybrid_rt>();
+
+/// I09 R8: Mesa's render submit shape, admitted only with
+/// `g15_render_mesa_shape` and `g15_render_user_vdm` set: an optional
+/// SET_FRAGMENT_ATTACHMENTS (1..=16 attachments, barriers NONE) followed by
+/// exactly one HYBRID render command. Returns the attachment bytes and the
+/// offset of the render header. The render itself is checked by the gate.
+#[inline(never)]
+pub(crate) fn g15_mesa_render_split(
+    cmdbuf_raw: &[u8],
+) -> Option<(core::ops::Range<usize>, usize)> {
+    if *module_parameters::g15_render_mesa_shape.value() == 0
+        || *module_parameters::g15_render_user_vdm.value() == 0
+        || cmdbuf_raw.len() > G15_MESA_RENDER_MAX_BYTES
+    {
+        return None;
+    }
+    let hdr = core::mem::size_of::<uapi::drm_asahi_cmd_header>();
+    let att = core::mem::size_of::<uapi::drm_asahi_attachment>();
+    let none = uapi::DRM_ASAHI_BARRIER_NONE as u16;
+    let mut shape = Reader::new(cmdbuf_raw);
+    let mut header: uapi::drm_asahi_cmd_header = shape.read().ok()?;
+    let mut attachments = 0..0;
+    let mut render_at = 0;
+    if header.cmd_type as u32 == uapi::drm_asahi_cmd_type_DRM_ASAHI_SET_FRAGMENT_ATTACHMENTS {
+        let size = header.size as usize;
+        if size == 0
+            || size % att != 0
+            || size / att > G15_MESA_MAX_ATTACHMENTS
+            || header.vdm_barrier != none
+            || header.cdm_barrier != none
+        {
+            return None;
+        }
+        attachments = hdr..hdr + size;
+        render_at = hdr + size;
+        shape.skip(size);
+        header = shape.read().ok()?;
+    }
+    let flags = cmdbuf_raw.get(render_at + hdr..render_at + hdr + 4)?;
+    let flags = u32::from_le_bytes(flags.try_into().ok()?);
+    let hybrid = uapi::DRM_ASAHI_RENDER_G15_USER | uapi::DRM_ASAHI_RENDER_G15_HYBRID;
+    (header.cmd_type as u32 == uapi::drm_asahi_cmd_type_DRM_ASAHI_CMD_RENDER
+        && cmdbuf_raw.len() == render_at + hdr + header.size as usize
+        && (flags & hybrid == hybrid || (g15_plain_render(flags) && !attachments.is_empty())))
+        .then_some((attachments, render_at))
+}
+
+/// I09 R8b: whether render `flags` are a plain (Mesa) render's, which runs on
+/// the bridge bundle: no `DRM_ASAHI_RENDER_G15_*` bit, and only with
+/// `g15_render_bridge` set (the other R8b parameters are checked by the gate).
+pub(crate) fn g15_plain_render(flags: u32) -> bool {
+    let private = uapi::DRM_ASAHI_RENDER_G15_USER
+        | uapi::DRM_ASAHI_RENDER_G15_HYBRID
+        | uapi::DRM_ASAHI_RENDER_G15_USER_RT
+        | uapi::DRM_ASAHI_RENDER_G15_USER_REGS;
+    *module_parameters::g15_render_bridge.value() != 0 && flags & private == 0
+}
+
+/// I05 (K6): Mesa's compute submit shape, admitted only for an ordinary
+/// compute with `g15_ordinary_compute` set: one header plus one full-size
+/// compute command with flags 0 and a CDM base. Not inlined: keeps the
+/// copies out of the callers' frames.
+#[inline(never)]
+fn g15_mesa_compute_shape(cmdbuf_raw: &[u8]) -> bool {
+    if *module_parameters::g15_ordinary_compute.value() == 0 {
+        return false;
+    }
+    let hdr = core::mem::size_of::<uapi::drm_asahi_cmd_header>();
+    let size = core::mem::size_of::<uapi::drm_asahi_cmd_compute>();
+    if cmdbuf_raw.len() != hdr + size {
+        return false;
+    }
+    let mut shape = Reader::new(cmdbuf_raw);
+    let Ok(header) = shape.read::<uapi::drm_asahi_cmd_header>() else {
+        return false;
+    };
+    let Ok(compute) = shape.read::<uapi::drm_asahi_cmd_compute>() else {
+        return false;
+    };
+    header.cmd_type as u32 == uapi::drm_asahi_cmd_type_DRM_ASAHI_CMD_COMPUTE
+        && header.size as usize == size
+        && g15_is_ordinary(&compute)
+}
