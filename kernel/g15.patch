+kernel::of_device_table!(
+    OF_TABLE,
+    MODULE_OF_TABLE,
+    (),
+    [(of::DeviceId::new(c"apple,t8122-pmp-v2"), ())]
+);
+
+impl platform::Driver for PmpDriver {
+    type IdInfo = ();
+    type Data<'bound> = PmpDriver;
+
+    const OF_ID_TABLE: Option<of::IdTable<Self::IdInfo>> = Some(&OF_TABLE);
+
+    fn probe<'bound>(
+        pdev: &'bound platform::Device<Core<'_>>,
+        _info: Option<&'bound Self::IdInfo>,
+    ) -> impl PinInit<Self::Data<'bound>, Error> + 'bound {
+        let dev: ARef<device::Device> = pdev.as_ref().into();
+        let pmp_req = pdev.io_request_by_name(c"pmp").ok_or(EINVAL)?;
+        let pmp_mmio = pmp_req.iomap_sized::<PMP_MMIO_SIZE>()?;
+        let pmp_mmio = pmp_mmio.as_view();
+        let asc_req = pdev.io_request_by_name(c"asc").ok_or(EINVAL)?;
+        let asc_mmio = asc_req.iomap_sized::<ASC_MMIO_SIZE>()?;
+        let asc_mmio = asc_mmio.as_view().relaxed();
+        let data = PmpData::new(pdev)?;
+        let node = dev.fwnode().ok_or(EIO)?;
+        let dvid = node
+            .property_read(c"apple,dram-vendor-id")
+            .required_by(&dev)?;
+        let bdid = node.property_read(c"apple,board-id").required_by(&dev)?;
+        // Both PMP power domains must actually be on (held by g15_dt_overlay's
+        // keep-power nodes) before the ASC is touched.
+        for (name, pa) in [("PMP", 0x2_d070_0450u64), ("PMS_SRAM", 0x2_d070_0458)] {
+            // SAFETY: maps one page of PMGR MMIO for one read; unmapped below.
+            let v = unsafe { bindings::ioremap_np((pa & !0xfff) as _, 0x1000) } as *mut u8;
+            if v.is_null() {
+                return Err(ENOMEM);
+            }
+            // SAFETY: inside the mapped page.
+            let ps = unsafe { bindings::readl(v.add((pa & 0xfff) as usize) as *const _) };
+            // SAFETY: `v` came from ioremap above.
+            unsafe { bindings::iounmap(v as *mut _) };
+            if (ps >> 4) & 0xf != 0xf {
+                dev_err!(dev, "PMP: {} power state {:#x} not on\n", name, ps);
+                return Err(EIO);
+            }
+        }
+        // Preconditions before any SRAM write or RUN: the PMP is stopped,
+        // this is the J613 board, and the SRAM holds the expected image.
+        let cpu_control = asc_mmio.read32(ASC_CPU_CONTROL_OFFSET);
+        let reset_word = pmp_mmio.relaxed().read32(0);
+        if cpu_control != 0 || bdid != J613_BOARD_ID || reset_word != J613_RESET_WORD {
+            dev_err!(dev, "PMP preconditions not met: CPU_CONTROL {:#x}, board-id {}, reset word {:#x}\n",
+                cpu_control, bdid, reset_word);
+            return Err(EIO);
+        }
+        match node.property_read(c"apple,dram-capacity").optional() {
+            Some(dcap) => data.patch_bootargs(
+                &pmp_mmio,
+                &[
+                    (from_fourcc(b"BDID"), bdid),
+                    (from_fourcc(b"DCAP"), dcap),
+                    (from_fourcc(b"DVID"), dvid),
+                ],
+            )?,
+            None => data.patch_bootargs(
+                &pmp_mmio,
+                &[(from_fourcc(b"BDID"), bdid), (from_fourcc(b"DVID"), dvid)],
+            )?,
+        };
+        let rtkit = rtkit::RtKit::<PmpData>::new(&dev, None, 0, data.clone())?;
+        data.rtkit.lock().as_mut().set(Some(rtkit));
+        asc_mmio.update(ASC_CPU_CONTROL, |r| r.with_const_cpu_run::<1>());
+        if let Err(e) = data.start() {
+            // The processor may be running and using our DMA buffers: never
+            // free them. Leak the state; only a reboot resets the PMP.
+            core::mem::forget(data.clone());
+            dev_err!(dev, "PMP start failed ({:?}); state leaked, reboot to recover\n", e);
+            return Err(e);
+        }
+        // READY is published by the PMP firmware itself at dashboard +0x10
+        // (PA 0x2_d03c_0010, read-only u64) after its init; wait at most 2 s.
+        // SAFETY: maps one page of the dashboard for reads; unmapped below.
+        let dash = unsafe { bindings::ioremap_np(0x2_d03c_0000, 0x1000) } as *mut u8;
+        let mut ready = 0u64;
+        if !dash.is_null() {
+            for _ in 0..200 {
+                // SAFETY: +0x10 is inside the mapped page, 8-aligned.
+                ready = unsafe { bindings::readq(dash.add(0x10) as *const _) };
+                if ready & 1 != 0 {
+                    break;
+                }
+                // SAFETY: plain sleep.
+                unsafe { bindings::msleep(10) };
+            }
+            // SAFETY: `dash` came from ioremap above.
+            unsafe { bindings::iounmap(dash as *mut _) };
+        }
+        if ready & 1 == 0 {
+            core::mem::forget(data.clone());
+            dev_err!(dev, "PMP READY not published (dashboard +0x10 = {:#x}); state leaked, reboot\n", ready);
+            return Err(ETIMEDOUT);
+        }
+        dev_info!(dev, "PMP READY (dashboard +0x10 = {:#x})\n", ready);
+        Ok(PmpDriver(data))
+    }
+}
+
+module_platform_driver! {
+    type: PmpDriver,
+    name: "g15_pmp",
+    description: "J613 PMP (experimental, G2)",
+    license: "Dual MIT/GPL",
+    params: {
+        remove_size: u32 {
+            default: 0,
+            description: "1 replies to a registry Remove (0x35) with the removed entry's size, as macOS does; 0 replies 0 (G2 A/B)",
+        },
+        trace: u32 {
+            default: 0,
+            description: "1 logs every PMP endpoint 0x20 message received and every reply sent (G2 transcript vs native)",
+        },
+    },
+}
+
+/// `trace=1`: message ordinal across both directions.
+static G15_PMP_TRACE_ORD: core::sync::atomic::AtomicU64 = core::sync::atomic::AtomicU64::new(0);
+
+fn g15_pmp_trace(dev: &device::Device, dir: &str, msg: u64) {
+    if *module_parameters::trace.value() != 0 {
+        let n = G15_PMP_TRACE_ORD.fetch_add(1, core::sync::atomic::Ordering::Relaxed);
+        dev_info!(dev, "G15 PMP trace {} {} opc={:#x} msg={:#018x}\n", n, dir, (msg >> OPC_SHIFT) & 0xff, msg);
+    }
+}
