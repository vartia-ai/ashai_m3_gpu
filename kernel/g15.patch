+    /// Container-level form of `G15ClientUmaComputeChannelRef::
+    /// next_stock_empty_state_sequence`, for a channel that holds no Compute
+    /// pool reference. Advances the same AGXShared +0x160 sequence.
+    pub(crate) fn next_command_buffer_state_sequence(container: &Arc<Mutex<Self>>) -> u32 {
+        container.lock().next_stock_empty_state_sequence()
+    }
+
+    fn next_stock_empty_state_sequence(&mut self) -> u32 {
+        loop {
+            let sequence = self.command_buffer_state_sequence;
+            self.command_buffer_state_sequence = sequence.wrapping_add(1);
+            if sequence & (G15_J615_SHARED_STATE_EVENT_COUNT - 1)
+                != G15_J615_SHARED_STATE_RESERVED_INDEX
+            {
+                return sequence;
+            }
+        }
+    }
+
+    fn compute_slot_index(priority_class: u32) -> Result<usize> {
+        if priority_class > 1 {
+            return Err(EINVAL);
+        }
+        Ok(2 + priority_class as usize)
+    }
