+#[versions(AGX)]
+// G15-only; the other generations compile it without a caller.
+#[allow(dead_code)]
+impl G15RenderPairFinal::ver {
+/// Completion callback for one pipe of the pair. `timing` is the CPU
+/// address of the pipe's command SKU timing state.
+fn callback(
+    done: Arc<Mutex<Option<G15RenderPairFinal::ver>>>,
+    leases: G15RenderLeaseSlot::ver,
+    timing: G15CommandTiming,
+) -> impl FnOnce(Option<WorkError>) + Send + Sync + 'static {
+    move |error| {
+        let stamp = timing.read();
+        let last = {
+            let mut guard = done.lock();
+            match (&mut *guard).as_mut() {
+                Some(state) => {
+                    if state.error.is_none() {
+                        state.error = error;
+                    }
+                    match timing.pipe {
+                        PipeType::Vertex => {
+                            state.ta_complete = stamp;
+                            gpu::G15_SERIAL_TA_FAILED.store(error.is_some(), Ordering::Release);
+                            gpu::G15_SERIAL_TA_RETIRED.store(true, Ordering::Release);
+                            state.t[3] = g15_now_ns();
+                            state.c[1] = g15_cntvct();
+                            // C9: the page list at TA retirement, the same
+                            // phase in passing and failing renders.
+                            if *module_parameters::g15_fw_sched_probe.value() == 2 {
+                                let frag_done = state.remaining < 2;
+                                pr_info!("G15 pagelist job={} phase=ta-callback frag_already_done={} bufinfo={:x?}\n",
+                                    state.job_id, u32::from(frag_done), state.snapshot_buffer.g15_info_words());
+                                if let Some(list) = state._resources.queue().tvb().page_list_bytes() {
+                                    g15_page_list_rows("ta", list);
+                                }
+                            }
+                        }
+                        _ => {
+                            state.frag_complete = stamp;
+                            state.t[4] = g15_now_ns();
+                            state.c[2] = g15_cntvct();
+                            state.frag_tvb_overflow = timing.read_overflow();
+                            state.frag_partials = timing.read_partials();
+                        }
+                    }
+                    state.remaining -= 1;
+                    if state.remaining == 0 {
+                        guard.take()
+                    } else {
+                        None
+                    }
+                }
+                None => None,
+            }
+        };
+        let job_slot = last.and_then(|state| state.finish());
+        // This pipe's command retired: return its leases. This drops the
+        // command's fence reference; for the last pipe it signals the fence.
+        let leases = leases.lock().take();
+        core::mem::drop(leases);
+        // K7: free the device slot last, once both pipes returned their
+        // leases, so a waiting submit finds the channels released.
+        core::mem::drop(job_slot);
+    }
+}
