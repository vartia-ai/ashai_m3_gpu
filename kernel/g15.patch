+    /// Fetch the GPU MMU fault information from the hardware registers.
+    fn get_fault_info(&self) -> Option<regs::FaultInfo> {
+        let res = &(*self.dev).resources;
+
+        let info = res.get_fault_info(self.cfg);
+        if info.is_some() {
+            dev_err!(
+                self.dev.as_ref(),
+                "  Fault info: {:#x?}\n",
+                info.as_ref().unwrap()
+            );
+        }
+        // Multi-process diagnostic (`g15_fault_walk=1`, read-only): the
+        // faulting slot's page-table entries for the fault address now, as
+        // the CPU sees them (cached) and as memory holds them (uncached).
+        if let (Some(i), true) = (info.as_ref(), *crate::module_parameters::g15_fault_walk.value() != 0) {
+            let w = self.uat.g15_fault_walk(i.vm_slot, i.address);
+            dev_err!(self.dev.as_ref(), "G15 fault walk: slot {} va {:#x}: (level, cached, uncached) {:#x?}\n", i.vm_slot, i.address, &w[..]);
+        }
+        info
+    }
+
+    /// Resume the GPU firmware after it halts (due to a timeout, fault, or request).
+    fn recover(&self) {
+        #[ver(G == G15)]
+        {
+            // G15 keeps the legacy FwStatus halt/resume words in q22
+            // (+0x4580/+0x4590/+0x45a0). Off by default: fail closed.
+            if *module_parameters::g15_recovery.value() == 0 {
+                dev_err!(
+                    self.dev.as_ref(),
+                    "G15 recovery is off (g15_recovery=0); refusing recovery\n"
+                );
+                return;
+            }
+            self.g15_recover();
+            return;
+        }
+        #[ver(G != G15)]
+        self.initdata.fw_status.with(|raw, _inner| {
+            let halt_count = raw.flags.halt_count.load(Ordering::Relaxed);
+            let mut halted = raw.flags.halted.load(Ordering::Relaxed);
+            dev_err!(self.dev.as_ref(), "  Halt count: {}\n", halt_count);
+            dev_err!(self.dev.as_ref(), "  Halted: {}\n", halted);
+
+            if halted == 0 {
+                let start = Instant::<Monotonic>::now();
+                while start.elapsed() < HALT_ENTER_TIMEOUT {
+                    halted = raw.flags.halted.load(Ordering::Relaxed);
+                    if halted != 0 {
+                        break;
+                    }
+                    mem::sync();
+                }
+                halted = raw.flags.halted.load(Ordering::Relaxed);
+            }
+
+            if debug_enabled(DebugFlags::NoGpuRecovery) {
+                dev_crit!(
+                    self.dev.as_ref(),
+                    "  GPU recovery is disabled, wedging forever!\n"
+                );
+            } else if halted != 0 {
+                dev_err!(self.dev.as_ref(), "  Attempting recovery...\n");
+                raw.flags.halted.store(0, Ordering::SeqCst);
+                raw.flags.resume.store(1, Ordering::SeqCst);
+            } else {
+                dev_err!(self.dev.as_ref(), "  Cannot recover.\n");
+            }
+        });
+    }
+
+    /// #16 B2: the legacy halt/resume handshake on the q22 words, as Apple
+    /// does it on G15 (halted = 0, then resume = 1). Logs the words before
+    /// and after, then snapshots the q22 recovery window.
+    #[inline(never)]
+    fn g15_recover(&self) {
+        #[ver(G == G15)]
+        {
+            let resumed = self.initdata.g15_q22.with(|raw, _inner| {
+                let halt_count = raw.halt_count_4580.load(Ordering::Relaxed);
+                let mut halted = raw.halted_4590.load(Ordering::Relaxed);
+                dev_err!(
+                    self.dev.as_ref(),
+                    "  G15 halt count: {}, halted: {}, resume: {}\n",
+                    halt_count,
+                    halted,
+                    raw.resume_45a0.load(Ordering::Relaxed)
+                );
+
+                if halted == 0 {
+                    let start = Instant::<Monotonic>::now();
+                    while start.elapsed() < HALT_ENTER_TIMEOUT {
+                        halted = raw.halted_4590.load(Ordering::Relaxed);
+                        if halted != 0 {
+                            break;
+                        }
+                        mem::sync();
+                    }
+                    halted = raw.halted_4590.load(Ordering::Relaxed);
+                }
+
+                if debug_enabled(DebugFlags::NoGpuRecovery) {
+                    dev_crit!(
+                        self.dev.as_ref(),
+                        "  GPU recovery is disabled, wedging forever!\n"
+                    );
+                    false
+                } else if halted != 0 {
+                    dev_err!(self.dev.as_ref(), "  Attempting G15 recovery...\n");
+                    raw.halted_4590.store(0, Ordering::SeqCst);
+                    raw.resume_45a0.store(1, Ordering::SeqCst);
+                    dev_err!(
+                        self.dev.as_ref(),
+                        "  G15 after resume: halt count: {}, halted: {}, resume: {}\n",
+                        raw.halt_count_4580.load(Ordering::Relaxed),
+                        raw.halted_4590.load(Ordering::Relaxed),
+                        raw.resume_45a0.load(Ordering::Relaxed)
+                    );
+                    true
+                } else {
+                    dev_err!(self.dev.as_ref(), "  Cannot recover.\n");
+                    false
+                }
+            });
+            if resumed {
+                self.g15_counters.recoveries.fetch_add(1, Ordering::Relaxed);
+                self.g15_recovery_snapshot("after resume");
+            }
+        }
+    }
