+                range5_code: &self.inner._g15_range5_code,
+                range5_ppl308: &self.inner._g15_range5_ppl308,
+                range5_uncached: &self.inner._g15_range5_uncached,
+                range5_cached: &self.inner._g15_range5_cached,
+                range5_prime_code: &self.inner._g15_range5_prime_code,
+                range5_prime_ppl308: &self.inner._g15_range5_prime_ppl308,
+                bank1: &self.inner._g15_shared_bank1,
+                mapping_notifier: &self.inner._g15_mapping_notifier,
