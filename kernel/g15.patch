+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! G15 (J613/J615, firmware V14_7) TA/3D render command builders (I04 W4).
+//!
+//! `build_ta` and `build_frag` turn typed Linux inputs plus a
+//! `fw::g15_render::G15RenderProfile` into one `RunVertexG15V14_7` and one
+//! `RunFragmentG15V14_7` command, each with its serialized SKU stream. Nothing
+//! here publishes, takes queue locks or owns channel state: the integrator
+//! (W8) allocates the leases (W5) and resources (W6), calls these builders,
+//! writes each SKU stream into its leased slot and publishes the commands.
+//!
+//! # How a command is built
+//!
+//! 1. The profile's command image (`ta_cmd` / `frag_cmd`) is serialized with
+//!    this pass's relocation targets and scalars. It supplies every native
+//!    (N) byte plus the profile's own D/R/F patches. A profile without a
+//!    command image, or one that is not `ready`, is rejected.
+//! 2. The builder's typed field map is applied on top. Every field it lists is
+//!    a derived (D) or relocated (R) value taken from the typed inputs below,
+//!    a firmware-owned (F) field written as zero, or a structural constant
+//!    (the command tag). Offsets come from the raw structs in `fw/vertex.rs`
+//!    and `fw/fragment.rs`, so the compile-time layout locks cover them.
+//!    Where the profile also patches a field, both values must agree;
+//!    otherwise the build fails with `EINVAL`.
+//! 3. The register list is emitted from the profile (`ta_regs` / `frag_regs`)
+//!    into the command's RegisterArray.
+//!
+//! Field classes, TA (`RunVertexG15V14_7`):
+//! - D: `+0x04` counter (n + 1), `+0x0c` context ID, RegisterArray count and
+//!   length, `+0x768` TPC size, `+0x778` SKU size, `+0x77c/+0x780` 3D stamp
+//!   slot/value, `+0x840` submission tag, meta stamp value/slot/evctl
+//!   index/uuid/event_seq, `+0x8de` UMA prepared, `+0x8f7` context generation.
+//! - R: `+0x14` event control, `+0x24` Info, `+0x2c` PM record, `+0x34` PM
+//!   state, `+0x740` RegisterArray self-pointer, `+0x760` TPC, `+0x770` SKU,
+//!   `+0x7a8` context-switch secondary, meta stamp/fw_stamp, `+0x8b0` timing
+//!   record, `+0x8d6` UMA page-pool state, `+0x8ef` UMA metrics.
+//! - N (profile, read from the lease where W5 carries it): `+0x8df/+0x8e7`
+//!   UMA pool sizes, and every byte not listed here, among them `+0x10`,
+//!   `+0x1c`, `+0x20`, `+0x3c`, `+0x784..+0x7a0`, `+0x7b0..+0x83f`,
+//!   `+0x848..+0x85f`, meta engine_state/flush_stamps, `+0x88c..+0x8cf`.
+//! - F: `+0x8f8..+0x91f` (SKU timing and the opaque tail).
+//!
+//! Field classes, 3D (`RunFragmentG15V14_7`):
+//! - D: `+0x04` counter (n), `+0x0c` context ID, `+0x1c` SKU size,
+//!   RegisterArray count and length, `+0xb88` submission tag, `+0xb9c`
+//!   context ID - 1, meta as for TA, `+0xc26` UMA prepared, `+0xc3f` context
+//!   generation, and nine JobParameters3 words that mirror 3D registers
+//!   (`G15_FRAG_PARAMS3_MIRRORS`).
+//! - R: `+0x14` SKU, `+0x20` event control, `+0x28/+0x30/+0x38` Info, PM
+//!   record and PM state, `+0x40` TVB tilemap, `+0x780` RegisterArray
+//!   self-pointer, meta stamp/fw_stamp, `+0xbf8` timing record start and
+//!   `+0xc00` its end qword (+8), `+0xc1e` UMA page-pool state, `+0xc37` UMA
+//!   metrics.
+//! - N: `+0xc27/+0xc2f` UMA pool sizes (via the lease) and every byte not
+//!   listed, among them the RTM block `+0x48..+0x7f`, the rest of
+//!   JobParameters3, `+0xa50`, the encoder state other than `+0xb88`,
+//!   `+0xb94..+0xba4` other than `+0xb9c`, `+0xbd4..+0xbf7`, `+0xc08..+0xc1d`.
+//!   Of these, the
+//!   per-pass user addresses in JobParameters3 (`+0x928`, `+0x930`,
+//!   `+0xa1c`) must be R patches in the profile; the builder has no typed
+//!   source for them.
+//! - F: `+0xa58..+0xb6b` (zeroed region, busy, overflow, `+0xb68`) and the
+//!   SKU timing `+0xc40..+0xc5f`.
+//!
+//! Evidence for each relation is in `fw/vertex.rs`, `fw/fragment.rs` and
+//! `research/reuse/i04-render-diff-format.md` section 3.
+
+#![allow(dead_code)]
+
+use core::mem::{offset_of, size_of};
+
+use kernel::prelude::*;
+
+use crate::alloc::{self, Allocator};
+use crate::fw::g15_render::{
+    G15ByteTemplate, G15Engine, G15Prov, G15RegOverride, G15RegRef, G15RegSink, G15RelocTarget,
+    G15RenderProfile, G15Resolver, G15ScalarId, G15ScalarTable, G15SkuTemplate,
+    G15TargetTable,
+};
+use crate::fw::types::*;
+use crate::{fw, gpu};
+
+use crate::fw::channels::PipeType;
+use crate::fw::fragment::raw::{G15EncoderState, G15JobParameters3, RunFragmentG15V14_7};
+use crate::fw::job::raw::{G15JobMeta, Register, RegisterArray};
+use crate::fw::vertex::raw::RunVertexG15V14_7;
+
+type TaRaw = RunVertexG15V14_7<'static>;
+type FragRaw = RunFragmentG15V14_7<'static>;
+
+/// RegisterArray entry stride (`Register` is 12 bytes, see `fw/job.rs`).
+const REG_STRIDE: usize = size_of::<Register>();
+/// Capacity of the register slots, before the RegisterArray pad.
+const REG_SLOTS_BYTES: usize = offset_of!(RegisterArray, pad);
+
+/// 3D JobParameters3 words that copy a 3D register value. Native evidence:
+/// every one of these equals its register in the triangle capture and in
+/// 231/231 desktop 3D commands (W7 section 3).
+const G15_FRAG_PARAMS3_MIRRORS: [(usize, u32); 13] = [
+    (offset_of!(G15JobParameters3, desc_380_7a0), 0x15101),
+    (offset_of!(G15JobParameters3, desc_388_7b0), 0x15109),
+    // desc_4b8_527_8d8[4] (+0x8f8) and [5] (+0x900).
+    (offset_of!(G15JobParameters3, desc_4b8_527_8d8) + 4 * 8, 0x15369),
+    (offset_of!(G15JobParameters3, desc_4b8_527_8d8) + 5 * 8, 0x15371),
+    // Depth: desc_4b8_527_8d8[12] (+0x938) is ZLS control, +0x948 and
+    // desc_540_548_960 the Z load/store bases (native D32F captures).
+    (offset_of!(G15JobParameters3, desc_4b8_527_8d8) + 12 * 8, 0x15319),
+    (offset_of!(G15JobParameters3, desc_538_948), 0x15329),
+    (offset_of!(G15JobParameters3, desc_540_548_960), 0x15329),
+    (offset_of!(G15JobParameters3, desc_540_548_960) + 8, 0x15331),
+    (offset_of!(G15JobParameters3, desc_610_9b8), 0x10051),
+    // desc_618_620_9c0[0] (+0x9c0) and [1] (+0x9c8).
+    (offset_of!(G15JobParameters3, desc_618_620_9c0), 0x15021),
+    (offset_of!(G15JobParameters3, desc_618_620_9c0) + 8, 0x15211),
+    (offset_of!(G15JobParameters3, reg_10039_9d8), 0x10039),
+    // desc_630_638_9f4[1] (+0x9fc).
+    (offset_of!(G15JobParameters3, desc_630_638_9f4) + 8, 0x15381),
+];
+
+/// UMA command fields of one pipe (W5 `G15UmaSnapshot`).
+#[derive(Clone, Copy, Debug, Default)]
