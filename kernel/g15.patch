+/// `Arc::pin_init(new_mutex!(t, name), GFP_KERNEL)` with the caller's lock
+/// name and class. Not inlined: `t` (leases, the pair state) is moved in
+/// once instead of through several inlined initializer copies.
+#[inline(never)]
+fn arc_mutex<T>(
+    t: T,
+    name: &'static kernel::str::CStr,
+    key: core::pin::Pin<&'static kernel::sync::LockClassKey>,
+) -> Result<Arc<Mutex<T>>> {
+    Arc::pin_init(Mutex::new(t, name, key), GFP_KERNEL)
+}
