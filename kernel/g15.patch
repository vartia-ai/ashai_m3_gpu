+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u8)]
+enum G15SchedulerPublicationState {
+    Unpublished = 0,
+    Publishing = 1,
+    Published = 2,
+    Released = 3,
+    Uncertain = 4,
+}
+
+/// Command-queue-lifetime ownership state for the selected G15 scheduler
+/// resource. E191 makes teardown fail-closed before any selected submit caller
+/// is enabled; later transport work may only advance this state monotonically.
+struct G15SchedulerPublication {
+    state: AtomicU8,
+}
+
+impl G15SchedulerPublication {
+    fn new() -> Self {
+        Self {
+            state: AtomicU8::new(G15SchedulerPublicationState::Unpublished as u8),
+        }
+    }
+
+    fn state(&self) -> G15SchedulerPublicationState {
+        match self.state.load(Ordering::Acquire) {
+            0 => G15SchedulerPublicationState::Unpublished,
+            1 => G15SchedulerPublicationState::Publishing,
+            2 => G15SchedulerPublicationState::Published,
+            3 => G15SchedulerPublicationState::Released,
+            _ => G15SchedulerPublicationState::Uncertain,
+        }
+    }
+
+    #[allow(dead_code)]
+    fn begin_publication(&self) -> Result {
+        self.state
+            .compare_exchange(
+                G15SchedulerPublicationState::Unpublished as u8,
+                G15SchedulerPublicationState::Publishing as u8,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            )
+            .map(|_| ())
+            .map_err(|_| EBUSY)
+    }
+
+    #[allow(dead_code)]
+    fn mark_published(&self) -> Result {
+        self.state
+            .compare_exchange(
+                G15SchedulerPublicationState::Publishing as u8,
+                G15SchedulerPublicationState::Published as u8,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            )
+            .map(|_| ())
+            .map_err(|_| EIO)
+    }
+
+    #[allow(dead_code)]
+    fn mark_uncertain(&self) {
+        self.state
+            .store(G15SchedulerPublicationState::Uncertain as u8, Ordering::Release);
+    }
+
+    /// First submission of one channel of this command queue. Every
+    /// channel's first RunWorkQueue is "new" (native capture-triangle-1:
+    /// both the 3D and the TA channel's first message carry new_queue = 1),
+    /// but only the queue's first channel starts the scheduler publication.
+    /// Returns whether this channel owns that transaction; a later channel
+    /// joins an already Published resource.
+    fn begin_channel(&self) -> Result<bool> {
+        match self.begin_publication() {
+            Ok(()) => Ok(true),
+            Err(_) if self.state() == G15SchedulerPublicationState::Published => Ok(false),
+            Err(err) => Err(err),
+        }
+    }
+
+    /// Completion of a channel's first submission (see `begin_channel`).
+    fn finish_channel(&self, owns_publication: bool) -> Result {
+        if owns_publication {
+            self.mark_published()
+        } else if self.state() == G15SchedulerPublicationState::Published {
+            Ok(())
+        } else {
+            Err(EIO)
+        }
+    }
+
+    /// Failure of a channel's first submission (see `begin_channel`).
+    fn fail_channel(&self, owns_publication: bool) {
+        if owns_publication {
+            self.mark_uncertain();
+        }
+    }
+
+    fn mark_released(&self) -> Result {
+        self.state
+            .compare_exchange(
+                G15SchedulerPublicationState::Published as u8,
+                G15SchedulerPublicationState::Released as u8,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            )
+            .map(|_| ())
+            .map_err(|_| EIO)
+    }
+}
