+    reservation: Arc<gpu::G15SubmissionReservation>,
+    fence: UserFence<super::JobFence::ver>,
+    channels: [Arc<Mutex<Option<super::g15_channel::G15RenderChannel::ver>>>; 2],
+    // Dropped last, after both pipes retired.
+    /// GPU start (+0) and end (+8), written by the firmware.
+    timing: Arc<G15RenderTimingRecord>,
+    /// The queue's TVB buffer, for the watchdog snapshot.
+    snapshot_buffer: crate::buffer::Buffer::ver,
