+/// GPUVAs a builder (W4) needs from one pass's resources.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct G15RenderResourceRefs {
+    pub(crate) pm_pool: u64,
+    pub(crate) pm_state: u64,
+    pub(crate) fw_page_list: u64,
+    pub(crate) pb_slot: u8,
+    pub(crate) ctxswitch: u64,
+    pub(crate) ctxswitch_secondary: u64,
+    pub(crate) preempt: [Option<u64>; 3],
+    pub(crate) tilemap: u64,
+    pub(crate) heapmeta: u64,
+    pub(crate) tpc: (u64, usize),
+    pub(crate) render_target: u64,
+}
+
+/// The render target of one pass.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum G15PassTarget {
+    /// Driver-owned, at the profile's native VA (RESOURCE 10, VALUE 14),
+    /// filled with `canary` if set, and kept for `G15_READBACK`.
+    Driver { canary: Option<u32> },
+    /// I09 R5: a user BO at this GPU VA, already checked by the submit; the
+    /// driver allocates and fills nothing.
+    User(u64),
+}
+
+/// Per-pass render resources. Moved into the job; dropped after both TA and
+/// 3D retire.
+pub(crate) struct G15RenderResources {
+    // Drop order is declaration order; see the module documentation.
+    payloads: KVec<G15Resource>,
+    /// F2: keeps the VM's persistent R9 fixed sections alive for this job.
+    persistent_fixed: Option<Arc<super::g15_render_job::G15PersistentFixed>>,
+    /// None for a user render target (I09 R5).
+    render_target: Option<Arc<G15RenderTargetBo>>,
+    /// GPU VA of the render target, either kind.
+    render_target_va: u64,
+    tpc: G15Resource,
+    tilemap: G15Resource,
+    heapmeta: G15Resource,
+    preempt: [Option<G15Resource>; 3],
+    ctxswitch: G15Resource,
+    ctxswitch_secondary_offset: usize,
+    queue: Arc<G15RenderQueueResources>,
+}
+
+impl G15RenderResources {
+    /// The queue-lifetime objects this pass uses.
+    pub(crate) fn queue(&self) -> &G15RenderQueueResources {
+        &self.queue
+    }
+
+    /// G2 relinker: the tilemap and TPC as views, no cache maintenance.
+    pub(crate) fn relink_views(&self) -> Option<[super::g15_relink::G15RelinkView; 2]> {
+        let v = |r: &G15Resource| -> Option<super::g15_relink::G15RelinkView> {
+            let b = r.as_slice().ok()?;
+            Some(super::g15_relink::G15RelinkView { gpu: r.gpu_va(), cpu: b.as_ptr() as usize, len: b.len() })
+        };
+        Some([v(&self.tilemap)?, v(&self.tpc)?])
+    }
+
+    /// G2 diagnostic: the CPU view of this pass's TVB tilemap, heapmeta and
+    /// TPC. Invalidates the CPU lines first: the GPU writes them uncached.
+    pub(crate) fn tile_state(&self) -> [(&'static str, Result<&[u8]>); 3] {
+        let r = [
+            ("tilemap", self.tilemap.as_slice()),
+            ("heapmeta", self.heapmeta.as_slice()),
+            ("tpc", self.tpc.as_slice()),
+        ];
+        for (_, b) in r.iter() {
+            if let Ok(b) = b {
+                g15_invalidate_from_poc(b.as_ptr() as usize, b.len());
+            }
+        }
+        r
+    }
+
+    /// Allocate one pass. `tile_info` is only a consistency check: the tree's
+    /// tiling formulas are not verified for G15, so the profile sizes are
+    /// allocated, and a TileInfo that needs more than the profile provides
+    /// means the pass shape differs from the captured one.
+    ///
+    /// Built in place in a box (~1.3 KiB, kept by the job) allocated before
+    /// any resource, in allocation order: ctxswitch, preempt, heapmeta,
+    /// tilemap, TPC, render target (a driver-owned `target` only). A failure
+    /// drops what was placed in reverse order, as locals would.
+    #[inline(never)]
+    pub(crate) fn new(
+        heaps: &G15RenderHeaps<'_>,
+        queue: Arc<G15RenderQueueResources>,
+        tile_info: &buffer::TileInfo,
+        profile: &G15PassResourceProfile<'_>,
+        target: G15PassTarget,
+    ) -> Result<KBox<Self>> {
+        let secondary = profile
+            .ctxswitch_secondary_offset
+            .need("ctxswitch_secondary_offset")?;
+        const PREEMPT: [(&str, &[u8; 4]); 3] = [("preempt1", b"PRM1"), ("preempt2", b"PRM2"), ("preempt3", b"PRM3")];
+        KBox::try_init(
+            try_init!(Self {
+                ctxswitch: heaps.alloc(
+                    &profile.ctxswitch,
+                    "ctxswitch",
+                    b"CTSW",
+                    buffer::G15_RENDER_CTXSWITCH_BYTES,
+                )?,
+                _: {
+                    if secondary >= ctxswitch.len() {
+                        return Err(reject("ctxswitch_secondary_offset"));
+                    }
+                    crate::debug::g15_stage(format_args!(
+                        "pass res: ctxswitch at {:#x}",
+                        ctxswitch.gpu_va()
+                    ))?;
+                },
+                preempt: [None, None, None],
+                _: {
+                    for (i, slot) in preempt.iter_mut().enumerate() {
+                        let req = &profile.preempt[i];
+                        if req.size.need(PREEMPT[i].0)? == 0 {
+                            continue;
+                        }
+                        let r = heaps.alloc(req, PREEMPT[i].0, PREEMPT[i].1, 0)?;
+                        let va = r.gpu_va();
+                        *slot = Some(r);
+                        crate::debug::g15_stage(format_args!(
+                            "pass res: {} at {:#x}",
+                            PREEMPT[i].0, va
+                        ))?;
+                    }
+                },
+                heapmeta: heaps.alloc(
+                    &profile.tvb_heapmeta,
+                    "tvb_heapmeta",
+                    b"HMTA",
+                    tile_info.layermeta_size,
+                )?,
+                _: {
+                    crate::debug::g15_stage(format_args!(
+                        "pass res: heapmeta at {:#x}",
+                        heapmeta.gpu_va()
+                    ))?;
+                },
+                // The TA writes only the tiles it touches and the fragment
+                // pass reads every nonzero entry: a reused allocation must be
+                // zeroed with plain stores and cleaned before the TA, or the
+                // fragment pass walks lists left from earlier passes (G2,
+                // g2capglmark2-205644; memset's DC ZVA is invisible, F2).
+                tilemap: {
+                    let mut t = heaps.alloc(
+                        &profile.tvb_tilemap,
+                        "tvb_tilemap",
+                        b"TMAP",
+                        tile_info.tilemap_size,
+                    )?;
+                    if *crate::module_parameters::g15_tilemap_zero.value() != 0 {
+                        t.zero_with_stores()?;
+                        if let Ok(b) = t.as_slice() {
+                            g15_clean_to_poc(b.as_ptr() as usize, b.len());
+                        }
+                    }
+                    t
+                },
+                _: {
+                    crate::debug::g15_stage(format_args!(
+                        "pass res: tilemap at {:#x}",
+                        tilemap.gpu_va()
+                    ))?;
+                },
+                tpc: heaps.alloc(&profile.tvb_tpc, "tvb_tpc", b"TPC ", tile_info.tpc_size)?,
+                _: {
+                    crate::debug::g15_stage(format_args!("pass res: TPC at {:#x}", tpc.gpu_va()))?;
+                },
+                render_target: match target {
+                    G15PassTarget::Driver { canary } => {
+                        Some(Self::new_render_target(heaps, profile, canary)?)
+                    }
+                    G15PassTarget::User(_) => None,
+                },
+                render_target_va: match target {
+                    G15PassTarget::User(va) => va,
+                    G15PassTarget::Driver { .. } => render_target.as_ref().ok_or(EINVAL)?.gpu_va(),
+                },
+                _: {
+                    if let G15PassTarget::User(va) = target {
+                        crate::debug::g15_stage(format_args!(
+                            "pass res: user render target at {:#x}, none allocated",
+                            va
+                        ))?;
+                    }
+                },
+                payloads: KVec::new(),
+            persistent_fixed: None,
+                ctxswitch_secondary_offset: secondary,
+                queue,
+            }),
+            GFP_KERNEL,
+        )
+    }
+
+    /// The pass's render target, at its native VA (the last allocation of
+    /// [`Self::new`]).
+    fn new_render_target(
+        heaps: &G15RenderHeaps<'_>,
+        profile: &G15PassResourceProfile<'_>,
+        rt_canary: Option<u32>,
+    ) -> Result<Arc<G15RenderTargetBo>> {
+        let bytes_per_row = profile.rt_bytes_per_row.need("pass.bytes_per_row")?;
+        let height = profile.rt_height.need("pass.height")?;
+        let rt_min = (bytes_per_row as usize)
+            .checked_mul(height as usize)
+            .ok_or(EINVAL)?;
+        // The first replay places the target at its native VA only: shader
+        // and PBE words were captured against it. A collision is EBUSY (the
+        // client retries on a fresh VM); there is no relocated fallback.
+        let rt_va = profile.rt_native_va.need("render_target.native_va")?;
+        let rt_req = &profile.render_target;
+        let rt_size = rt_req.size.need("render_target")?;
+        let rt_align = rt_req.alignment.need("render_target")?;
+        // Checked for completeness; the canary fill below replaces any init.
+        rt_req.init.need("render_target")?;
+        let page = mmu::UAT_PGSZ;
+        let rt_bytes = rt_size.checked_add(page - 1).ok_or(EINVAL)? & !(page - 1);
+        if rt_size < rt_min || !rt_align.is_power_of_two() || rt_va % rt_align as u64 != 0 {
+            return Err(reject("render_target"));
+        }
+        let mut rt = heaps.alloc_fixed(
+            rt_req.class,
+            rt_va,
+            rt_bytes,
+            G15FixedUse::RenderTarget,
+            "render_target",
+        )?;
+        pr_info!(
+            "G15 render resources: render target at native {:#x} ({:#x} bytes)\n",
+            rt_va,
+            rt_bytes
+        );
+        crate::debug::g15_stage(format_args!("pass res: render target placed at {:#x}", rt_va))?;
+        if let Some(canary) = rt_canary {
+            rt.write_with(|dst| {
+                for word in dst.chunks_exact_mut(4) {
+                    word.copy_from_slice(&canary.to_le_bytes());
+                }
+                Ok(())
+            })?;
+            crate::debug::g15_stage(format_args!("pass res: render target canary filled"))?;
+        }
+        Ok(Arc::new(
+            G15RenderTargetBo {
+                res: rt,
+                bytes_per_row,
+                height,
+            },
+            GFP_KERNEL,
+        )?)
+    }
+
+    /// Place one validated user payload section (VDM, PPP, VS/FS USC and
+    /// code, BG/EOT USC and code, PBE, uniforms) at its native class and
+    /// return its GPUVA. The caller (W9 input validation) has already checked
+    /// the bytes; the profile record decides size, alignment and class.
+    pub(crate) fn add_user_payload(
+        &mut self,
+        heaps: &G15RenderHeaps<'_>,
+        req: &G15ResourceReq<'_>,
+        bytes: &[u8],
+    ) -> Result<u64> {
+        let req = G15ResourceReq {
+            size: req.size,
+            alignment: req.alignment,
+            class: req.class,
+            init: G15Profiled::Resolved(G15ResourceInit::Bytes(bytes)),
+        };
+        let res = heaps.alloc(&req, "user_payload", b"UPAY", bytes.len())?;
+        let va = res.gpu_va();
+        self.payloads.push(res, GFP_KERNEL)?;
+        Ok(va)
+    }
+
+    /// Place one user payload section, zero-filled, at the class `req`
+    /// names. Returns its index for [`Self::write_user_payload`] and its GPUVA.
+    /// The integrator copies and relocates the bytes once every section has
+    /// an address (sections may point at each other).
+    pub(crate) fn add_user_payload_zeroed(
+        &mut self,
+        heaps: &G15RenderHeaps<'_>,
+        req: &G15ResourceReq<'_>,
+        min_size: usize,
+    ) -> Result<(usize, u64)> {
+        let req = G15ResourceReq {
+            size: req.size,
+            alignment: req.alignment,
+            class: req.class,
+            init: G15Profiled::Resolved(G15ResourceInit::Zero),
+        };
+        let res = heaps.alloc(&req, "user_payload", b"UPAY", min_size)?;
+        let va = res.gpu_va();
+        self.payloads.push(res, GFP_KERNEL)?;
+        Ok((self.payloads.len() - 1, va))
+    }
+
+    /// F2 audit (`g15_persist_audit`): the persistent fixed sections.
+    pub(crate) fn persistent_fixed(&self) -> Option<&super::g15_render_job::G15PersistentFixed> {
+        self.persistent_fixed.as_deref()
+    }
+
+    /// F2: hold the VM's persistent fixed sections until this job retires.
+    pub(crate) fn hold_persistent_fixed(&mut self, p: Arc<super::g15_render_job::G15PersistentFixed>) {
+        self.persistent_fixed = Some(p);
+    }
+
+    /// Take ownership of a user payload placed earlier (a fixed section,
+    /// mapped before any kernel-owned render object). Returns its index.
+    pub(crate) fn adopt_user_payload(&mut self, res: G15Resource) -> Result<usize> {
+        self.payloads.push(res, GFP_KERNEL)?;
+        Ok(self.payloads.len() - 1)
+    }
+
+    /// Run `f` on a mutable view of user payload `index`, also a fixed
+    /// section over several arenas ([`G15Resource::write_with`]). Before
+    /// publication only.
+    pub(crate) fn write_user_payload(
+        &mut self,
+        index: usize,
+        f: impl FnOnce(&mut [u8]) -> Result,
+    ) -> Result {
+        self.payloads.get_mut(index).ok_or(EINVAL)?.write_with(f)
+    }
+
+    /// Zero user payload `index` in place (no staging for split placements).
+    pub(crate) fn zero_user_payload(&mut self, index: usize) -> Result {
+        self.payloads.get_mut(index).ok_or(EINVAL)?.zero()
+    }
+
+    /// Borrow an installed user payload, retaining this pass's actual allocation.
+    pub(crate) fn selected_user_payload(&self, index: usize) -> Result<&G15Resource> {
+        self.payloads.get(index).ok_or(EINVAL)
+    }
+
+    /// GPUVA and size of every user payload, in placement order.
+    pub(crate) fn user_payloads(&self) -> impl Iterator<Item = (u64, usize)> + '_ {
+        self.payloads.iter().map(|r| (r.gpu_va(), r.len()))
+    }
+
+    /// GPU VA of the render target, driver-owned or (I09 R5) user.
+    pub(crate) fn render_target_va(&self) -> u64 {
+        self.render_target_va
+    }
+
+    /// The driver-owned render target; None for a user one (I09 R5).
+    pub(crate) fn render_target(&self) -> Option<Arc<G15RenderTargetBo>> {
+        self.render_target.clone()
+    }
+
+    pub(crate) fn queue_resources(&self) -> &Arc<G15RenderQueueResources> {
+        &self.queue
+    }
+
+    pub(crate) fn refs(&self) -> G15RenderResourceRefs {
+        let ctxswitch = self.ctxswitch.gpu_va();
+        G15RenderResourceRefs {
+            pm_pool: self.queue.pm.pool_va(),
+            pm_state: self.queue.pm.state_va(),
+            fw_page_list: self.queue.fw_page_list_va(),
+            pb_slot: self.queue.pb.slot(),
+            ctxswitch,
+            ctxswitch_secondary: ctxswitch + self.ctxswitch_secondary_offset as u64,
+            preempt: [
+                self.preempt[0].as_ref().map(|r| r.gpu_va()),
+                self.preempt[1].as_ref().map(|r| r.gpu_va()),
+                self.preempt[2].as_ref().map(|r| r.gpu_va()),
+            ],
+            tilemap: self.tilemap.gpu_va(),
+            heapmeta: self.heapmeta.gpu_va(),
+            tpc: (self.tpc.gpu_va(), self.tpc.len()),
+            render_target: self.render_target_va,
+        }
+    }
+}
diff --git a/drivers/gpu/drm/asahi/queue/launch_input.rs b/drivers/gpu/drm/asahi/queue/launch_input.rs
new file mode 100644
index 000000000..e33e40e44
--- /dev/null
+++ b/drivers/gpu/drm/asahi/queue/launch_input.rs
@@ -0,0 +1,514 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! Launch inputs for the private J613 G15 experiment: the immutable DT launch
+//! and per-submission user launches.
+
+use kernel::{prelude::*, uapi};
+
+pub(crate) const MAGIC: u32 = 0x4731_354c;
+pub(crate) const HEADER_CELLS: usize = 12;
+pub(crate) const MAX_CDM: usize = 0x100;
+pub(crate) const MAX_ENTRY: usize = 0x100;
+pub(crate) const MAX_BODY: usize = 0x200;
+const MAX_RELOCS: usize = 7;
+pub(crate) const MAX_CELLS: usize =
+    HEADER_CELLS + (MAX_CDM + MAX_ENTRY + MAX_BODY) / 4 + MAX_RELOCS * 2;
+const STOP: [u8; 4] = [0x0e, 0, 0, 0];
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) enum InvalidLaunch {
+    Header,
+    Length,
+    Padding,
+    Verdict,
+    Relocation,
+    Address,
+    Buffer,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Fixup {
+    kind: u32,
+    offset: usize,
+}
+
+#[derive(Debug)]
+pub(crate) struct LaunchInput {
+    cdm: [u8; MAX_CDM],
+    entry: [u8; MAX_ENTRY],
+    body: [u8; MAX_BODY],
+    end_offset: u64,
+    shader_required: bool,
+    expected_result: u32,
+    relocs: [Fixup; MAX_RELOCS],
+    reloc_count: usize,
+}
+
+#[derive(Clone, Copy)]
+pub(crate) struct Addresses {
+    pub(crate) result: u64,
+    pub(crate) body: u64,
+    pub(crate) entry: u64,
+    pub(crate) args: u64,
+    pub(crate) statics: u64,
+    pub(crate) profile_helper: u64,
+}
+
+impl LaunchInput {
+    pub(crate) fn parse(cells: &[u32]) -> Result<Self, InvalidLaunch> {
+        use InvalidLaunch::*;
+        if cells.len() < HEADER_CELLS || cells.len() > MAX_CELLS {
+            return Err(Length);
+        }
+        if cells[0] != MAGIC
+            || cells[1] != 1
+            || cells[2] as usize != cells.len()
+            || cells[10] != 0
+            || cells[11] != 0
+        {
+            return Err(Header);
+        }
+        let (cdm_len, entry_len, body_len) =
+            (cells[3] as usize, cells[4] as usize, cells[5] as usize);
+        let reloc_count = cells[9] as usize;
+        if !(4..=MAX_CDM).contains(&cdm_len)
+            || cdm_len % 4 != 0
+            || !(4..=MAX_ENTRY).contains(&entry_len)
+            || entry_len % 2 != 0
+            || !(4..=MAX_BODY).contains(&body_len)
+            || body_len % 2 != 0
+            || reloc_count > MAX_RELOCS
+        {
+            return Err(Length);
+        }
+        let expected_cells =
+            HEADER_CELLS + cdm_len / 4 + (entry_len + 3) / 4 + (body_len + 3) / 4 + reloc_count * 2;
+        if expected_cells != cells.len() {
+            return Err(Length);
+        }
+        let end_offset = cells[6] as usize;
+        if end_offset != if cdm_len == 4 { 4 } else { cdm_len - 4 } {
+            return Err(Length);
+        }
+        let shader_required = match cells[7] {
+            0 if cells[8] == u32::MAX => false,
+            1 if cells[8] != u32::MAX => true,
+            _ => return Err(Verdict),
+        };
+        let mut input = Self {
+            cdm: [0; MAX_CDM],
+            entry: [0; MAX_ENTRY],
+            body: [0; MAX_BODY],
+            end_offset: end_offset as u64,
+            shader_required,
+            expected_result: cells[8],
+            relocs: [Fixup { kind: 0, offset: 0 }; MAX_RELOCS],
+            reloc_count,
+        };
+        let mut pos = HEADER_CELLS;
+        copy_words(cells, &mut pos, &mut input.cdm[..cdm_len])?;
+        copy_words(cells, &mut pos, &mut input.entry[..entry_len])?;
+        copy_words(cells, &mut pos, &mut input.body[..body_len])?;
+        if input.cdm[cdm_len - 4..cdm_len] != 0x4000_0000u32.to_le_bytes() {
+            return Err(Length);
+        }
+        if shader_required {
+            if cdm_len == 4 || input.body[body_len - 4..body_len] != STOP {
+                return Err(Verdict);
+            }
+        } else if input.body[..4] != STOP || input.body[4..body_len].iter().any(|&b| b != 0) {
+            return Err(Verdict);
+        }
+        let mut seen = 0u32;
+        for index in 0..reloc_count {
+            let reloc = Fixup {
+                kind: cells[pos],
+                offset: cells[pos + 1] as usize,
+            };
+            pos += 2;
+            let (section, width) = relocation_shape(reloc.kind).ok_or(Relocation)?;
+            let bit = 1 << (reloc.kind - 1);
+            if seen & bit != 0 {
+                return Err(Relocation);
+            }
+            seen |= bit;
+            let target = match section {
+                0 => &input.body[..body_len],
+                1 => &input.entry[..entry_len],
+                _ => &input.cdm[..cdm_len],
+            };
+            let end = reloc.offset.checked_add(width).ok_or(Relocation)?;
+            let bytes = target.get(reloc.offset..end).ok_or(Relocation)?;
+            match reloc.kind {
+                1 | 2 | 5 | 6 => {
+                    let reg = if reloc.kind % 4 == 1 { 0 } else { 1 };
+                    if bytes != imm_inst(reg, 0) {
+                        return Err(Relocation);
+                    }
+                }
+                7..=10 => {
+                    let reg = match reloc.kind {
+                        7 => 2,
+                        8 => 3,
+                        9 => 18,
+                        _ => 19,
+                    };
+                    if reloc.offset % 2 != 0 || bytes != imm_inst(reg, 0) {
+                        return Err(Relocation);
+                    }
+                }
+                11 => {
+                    if reloc.offset % 2 != 0 || bytes != call_inst(0) {
+                        return Err(Relocation);
+                    }
+                }
+                3 => {
+                    if reloc.offset < 3
+                        || target[reloc.offset - 3..reloc.offset] != [0x77, 1, 0x2a]
+                        || bytes.iter().any(|&b| b != 0)
+                    {
+                        return Err(Relocation);
+                    }
+                }
+                4 => {
+                    if reloc.offset < 4
+                        || reloc.offset % 4 != 0
+                        || target[reloc.offset - 4..reloc.offset] != 0x0008_0000u32.to_le_bytes()
+                        || bytes.iter().any(|&b| b != 0)
+                    {
+                        return Err(Relocation);
+                    }
+                }
+                _ => return Err(Relocation),
+            }
+            for old in &input.relocs[..index] {
+                let (old_section, old_width) = relocation_shape(old.kind).ok_or(Relocation)?;
+                if old_section == section
+                    && reloc.offset < old.offset + old_width
+                    && old.offset < end
+                {
+                    return Err(Relocation);
+                }
+            }
+            input.relocs[index] = reloc;
+        }
+        // Shaders use one complete address convention: body r0/r1, entry
+        // r0/r1, or native args/statics loads plus the owned profile helper.
+        let valid = if shader_required {
+            seen == 0xf || seen == 0x3c || seen == 0x7cc
+        } else if cdm_len == 4 {
+            seen == 0x4
+        } else {
+            seen == 0xc
+        };
+        if !valid {
+            return Err(Relocation);
+        }
+        Ok(input)
+    }
+
+    pub(crate) fn apply(
+        &self,
+        addresses: Addresses,
+        cdm: &mut [u8],
+        entry: &mut [u8],
+        body: &mut [u8],
+    ) -> Result<(), InvalidLaunch> {
+        if cdm.len() != MAX_CDM || entry.len() != MAX_ENTRY || body.len() != MAX_BODY {
+            return Err(InvalidLaunch::Buffer);
+        }
+        if [addresses.result, addresses.body, addresses.entry]
+            .iter()
+            .any(|&addr| addr == 0 || addr >= (1u64 << 42))
+            || addresses.result & 3 != 0
+            || addresses.body & 0x7f != 0
+            || addresses.entry & 0x3f != 0
+        {
+            return Err(InvalidLaunch::Address);
+        }
+        let native = self.relocs[..self.reloc_count].iter().any(|reloc| reloc.kind == 11);
+        if native
+            && ([addresses.args, addresses.statics, addresses.profile_helper]
+                .iter()
+                .any(|&addr| addr == 0 || addr >= (1u64 << 42))
+                || addresses.args & 7 != 0
+                || addresses.statics & 7 != 0
+                || addresses.profile_helper & 1 != 0)
+        {
+            return Err(InvalidLaunch::Address);
+        }
+        cdm.copy_from_slice(&self.cdm);
+        entry.copy_from_slice(&self.entry);
+        body.copy_from_slice(&self.body);
+        for reloc in &self.relocs[..self.reloc_count] {
+            let off = reloc.offset;
+            match reloc.kind {
+                1 => body[off..off + 8].copy_from_slice(&imm_inst(0, addresses.result as u32)),
+                2 => body[off..off + 8]
+                    .copy_from_slice(&imm_inst(1, (addresses.result >> 32) as u32)),
+                5 => entry[off..off + 8].copy_from_slice(&imm_inst(0, addresses.result as u32)),
+                6 => entry[off..off + 8]
+                    .copy_from_slice(&imm_inst(1, (addresses.result >> 32) as u32)),
+                7 => entry[off..off + 8].copy_from_slice(&imm_inst(2, addresses.args as u32)),
+                8 => entry[off..off + 8]
+                    .copy_from_slice(&imm_inst(3, (addresses.args >> 32) as u32)),
+                9 => entry[off..off + 8].copy_from_slice(&imm_inst(18, addresses.statics as u32)),
+                10 => entry[off..off + 8]
+                    .copy_from_slice(&imm_inst(19, (addresses.statics >> 32) as u32)),
+                11 => entry[off..off + 10].copy_from_slice(&call_inst(addresses.profile_helper)),
+                3 => entry[off..off + 5].copy_from_slice(&(addresses.body >> 7).to_le_bytes()[..5]),
+                4 => {
+                    let packed =
+                        ((addresses.entry & 0xffff_ffff) << 26) | ((addresses.entry >> 32) << 16);
+                    cdm[off..off + 8].copy_from_slice(&packed.to_le_bytes());
+                }
+                _ => return Err(InvalidLaunch::Relocation),
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn end_offset(&self) -> u64 {
+        self.end_offset
+    }
+    pub(crate) fn shader_required(&self) -> bool {
+        self.shader_required
+    }
+    pub(crate) fn expected_result(&self) -> u32 {
+        self.expected_result
+    }
+}
+
+fn relocation_shape(kind: u32) -> Option<(u8, usize)> {
+    match kind {
+        1 | 2 => Some((0, 8)),
+        3 => Some((1, 5)),
+        5..=10 => Some((1, 8)),
+        11 => Some((1, 10)),
+        4 => Some((2, 8)),
+        _ => None,
+    }
+}
+
+fn copy_words(cells: &[u32], pos: &mut usize, bytes: &mut [u8]) -> Result<(), InvalidLaunch> {
+    for offset in (0..bytes.len()).step_by(4) {
+        let word = cells[*pos].to_le_bytes();
+        *pos += 1;
+        let count = core::cmp::min(4, bytes.len() - offset);
+        if word[count..].iter().any(|&byte| byte != 0) {
+            return Err(InvalidLaunch::Padding);
+        }
+        bytes[offset..offset + count].copy_from_slice(&word[..count]);
+    }
+    Ok(())
+}
+
+fn imm_inst(reg: u8, value: u32) -> [u8; 8] {
+    let v = value as u64;
+    let swizzled = ((v & 0x7f) << 8)
+        | (((v >> 7) & 0xf) << 33)
+        | (((v >> 11) & 3) << 42)
+        | (((v >> 13) & 0xfff) << 48)
+        | (((v >> 25) & 0x7f) << 25);
+    let destination = ((reg as u64 & 0xf) << 4)
+        | (((reg as u64 >> 4) & 3) << 22)
+        | (((reg as u64 >> 6) & 1) << 60);
+    (0x0002_800cu64 | destination | swizzled).to_le_bytes()
+}
+
+fn call_inst(address: u64) -> [u8; 10] {
+    let encoded = 0x0154_008fu128 | ((address as u128 >> 1) << 25);
+    let mut bytes = [0; 10];
+    bytes.copy_from_slice(&encoded.to_le_bytes()[..10]);
+    bytes
+}
+
+/// A G15 compute launch supplied by userspace for one submission (R47).
+///
+/// Unlike the DT launch above, the program is relocated against any of the
+/// per-job driver allocations plus a per-queue output buffer, the statics and
+/// parameter bytes are copied into driver objects, and the binding table may
+/// hold several buffer addresses.
+pub(crate) struct UserLaunch {
+    raw: KBox<uapi::drm_asahi_g15_launch>,
+}
+
+/// Driver addresses a user launch may refer to.
+#[derive(Clone, Copy)]
+pub(crate) struct UserAddresses {
+    pub(crate) output: u64,
+    pub(crate) params: u64,
+    pub(crate) bindings: u64,
+    pub(crate) statics: u64,
+    pub(crate) body: u64,
+    pub(crate) entry: u64,
+    pub(crate) profile_helper: u64,
+}
+
+impl UserAddresses {
+    fn base(&self, base: u8) -> Option<u64> {
+        Some(match base as u32 {
+            uapi::DRM_ASAHI_G15_BASE_OUTPUT => self.output,
+            uapi::DRM_ASAHI_G15_BASE_PARAMS => self.params,
+            uapi::DRM_ASAHI_G15_BASE_BINDINGS => self.bindings,
+            uapi::DRM_ASAHI_G15_BASE_STATICS => self.statics,
+            uapi::DRM_ASAHI_G15_BASE_BODY => self.body,
+            uapi::DRM_ASAHI_G15_BASE_ENTRY => self.entry,
+            uapi::DRM_ASAHI_G15_BASE_PROFILE_HELPER => self.profile_helper,
+            _ => return None,
+        })
+    }
+}
+
+impl UserLaunch {
+    /// Copy and validate a launch from userspace.
+    pub(crate) fn read(pointer: u64) -> Result<Self> {
+        use kernel::uaccess::{UserPtr, UserSlice};
+        let size = core::mem::size_of::<uapi::drm_asahi_g15_launch>();
+        let mut boxed = KBox::<uapi::drm_asahi_g15_launch>::new_uninit(GFP_KERNEL)?;
+        // SAFETY: the box holds `size` writable bytes; every bit pattern is a
+        // valid value of this plain-integer UAPI struct.
+        let bytes =
+            unsafe { core::slice::from_raw_parts_mut(boxed.as_mut_ptr() as *mut u8, size) };
+        UserSlice::new(UserPtr::from_addr(pointer as _), size)
+            .reader()
+            .read_slice(bytes)?;
+        // SAFETY: fully initialized by read_slice above.
+        let launch = Self { raw: unsafe { boxed.assume_init() } };
+        launch.validate()?;
+        Ok(launch)
+    }
+
+    fn validate(&self) -> Result {
+        let r = &*self.raw;
+        let ok = r.version == uapi::DRM_ASAHI_G15_LAUNCH_VERSION
+            && (8..=MAX_CDM as u32).contains(&r.cdm_len)
+            && r.cdm_len % 4 == 0
+            && (4..=uapi::DRM_ASAHI_G15_MAX_ENTRY).contains(&r.entry_len)
+            && (4..=uapi::DRM_ASAHI_G15_MAX_BODY).contains(&r.body_len)
+            && r.statics_len <= uapi::DRM_ASAHI_G15_MAX_STATICS
+            && r.params_len <= uapi::DRM_ASAHI_G15_MAX_PARAMS
+            && r.reloc_count <= uapi::DRM_ASAHI_G15_MAX_RELOCS
+            && r.binding_count <= uapi::DRM_ASAHI_G15_MAX_BINDINGS
+            && (4..=uapi::DRM_ASAHI_G15_MAX_OUTPUT).contains(&r.output_size)
+            && r.output_size % 4 == 0
+            && r.cdm[r.cdm_len as usize - 4..r.cdm_len as usize] == 0x4000_0000u32.to_le_bytes()
+            && r.body[r.body_len as usize - 4..r.body_len as usize] == STOP;
+        if !ok {
+            return Err(EINVAL);
+        }
+        for reloc in &r.relocs[..r.reloc_count as usize] {
+            let width = match reloc.kind as u32 {
+                uapi::DRM_ASAHI_G15_RELOC_MOVIMM_LO | uapi::DRM_ASAHI_G15_RELOC_MOVIMM_HI => 8,
+                uapi::DRM_ASAHI_G15_RELOC_SHADER => 5,
+                uapi::DRM_ASAHI_G15_RELOC_CDM_ENTRY => 8,
+                uapi::DRM_ASAHI_G15_RELOC_CALL => 10,
+                uapi::DRM_ASAHI_G15_RELOC_PREAMBLE => 11,
+                _ => return Err(EINVAL),
+            };
+            let len = match reloc.section as u32 {
+                uapi::DRM_ASAHI_G15_SECTION_CDM => r.cdm_len,
+                uapi::DRM_ASAHI_G15_SECTION_ENTRY => r.entry_len,
+                uapi::DRM_ASAHI_G15_SECTION_BODY => r.body_len,
+                _ => return Err(EINVAL),
+            } as usize;
+            if reloc.offset as usize + width > len || reloc.base > 6 || reloc.reg > 127 {
+                return Err(EINVAL);
+            }
+        }
+        if r.bindings[..r.binding_count as usize].iter().any(|&b| b > 6) {
+            return Err(EINVAL);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn cdm_len(&self) -> usize {
+        self.raw.cdm_len as usize
+    }
+    pub(crate) fn output_size(&self) -> usize {
+        self.raw.output_size as usize
+    }
+    pub(crate) fn canary(&self) -> u32 {
+        self.raw.canary
+    }
+
+    /// Copy the program into the driver buffers and apply relocations and
+    /// bindings. `cdm`, `entry` and `body` are the full driver allocations.
+    pub(crate) fn apply(
+        &self,
+        a: &UserAddresses,
+        cdm: &mut [u8],
+        entry: &mut [u8],
+        body: &mut [u8],
+        statics: &mut [u8],
+        params: &mut [u8],
+        bindings: &mut [u8],
+    ) -> Result {
+        let r = &*self.raw;
+        let (cl, el, bl) = (r.cdm_len as usize, r.entry_len as usize, r.body_len as usize);
+        let (sl, pl, nb) = (r.statics_len as usize, r.params_len as usize, r.binding_count as usize);
+        if cdm.len() < cl || entry.len() < el || body.len() < bl || statics.len() < sl
+            || params.len() < pl || bindings.len() < nb * 8
+        {
+            return Err(EINVAL);
+        }
+        if a.body & 0x7f != 0 || a.entry & 0x3f != 0 || a.output & 3 != 0 {
+            return Err(EINVAL);
+        }
+        cdm.fill(0);
+        entry.fill(0);
+        body.fill(0);
+        cdm[..cl].copy_from_slice(&r.cdm[..cl]);
+        entry[..el].copy_from_slice(&r.entry[..el]);
+        body[..bl].copy_from_slice(&r.body[..bl]);
+        statics[..sl].copy_from_slice(&r.statics[..sl]);
+        params[..pl].copy_from_slice(&r.params[..pl]);
+        for (i, &base) in r.bindings[..nb].iter().enumerate() {
+            let value = a.base(base).ok_or(EINVAL)?;
+            bindings[i * 8..i * 8 + 8].copy_from_slice(&value.to_le_bytes());
+        }
+        for reloc in &r.relocs[..r.reloc_count as usize] {
+            let value = (a.base(reloc.base).ok_or(EINVAL)? as i64).wrapping_add(reloc.addend) as u64;
+            let section: &mut [u8] = match reloc.section as u32 {
+                uapi::DRM_ASAHI_G15_SECTION_CDM => &mut cdm[..cl],
+                uapi::DRM_ASAHI_G15_SECTION_ENTRY => &mut entry[..el],
+                _ => &mut body[..bl],
+            };
+            let off = reloc.offset as usize;
+            match reloc.kind as u32 {
+                uapi::DRM_ASAHI_G15_RELOC_MOVIMM_LO => {
+                    section[off..off + 8].copy_from_slice(&imm_inst(reloc.reg, value as u32))
+                }
+                uapi::DRM_ASAHI_G15_RELOC_MOVIMM_HI => {
+                    section[off..off + 8].copy_from_slice(&imm_inst(reloc.reg, (value >> 32) as u32))
+                }
+                uapi::DRM_ASAHI_G15_RELOC_SHADER => {
+                    if value & 0x7f != 0 {
+                        return Err(EINVAL);
+                    }
+                    section[off..off + 5].copy_from_slice(&(value >> 7).to_le_bytes()[..5])
+                }
+                uapi::DRM_ASAHI_G15_RELOC_CDM_ENTRY => {
+                    let mut q = u64::from_le_bytes(section[off..off + 8].try_into().map_err(|_| EINVAL)?);
+                    q = (q & 0xffff) | ((value & 0xffff_ffff) << 26) | ((value >> 32) << 16);
+                    section[off..off + 8].copy_from_slice(&q.to_le_bytes())
+                }
+                uapi::DRM_ASAHI_G15_RELOC_CALL => {
+                    section[off..off + 10].copy_from_slice(&call_inst(value))
+                }
+                uapi::DRM_ASAHI_G15_RELOC_PREAMBLE => {
+                    if value & 0x3f != 0 || value >> 48 != 0 {
+                        return Err(EINVAL);
+                    }
+                    let mut field = [0u8; 8];
+                    field[..6].copy_from_slice(&section[off + 5..off + 11]);
+                    let old = u64::from_le_bytes(field);
+                    let new = (old & 0x3f) | value;
+                    section[off + 5..off + 11].copy_from_slice(&new.to_le_bytes()[..6]);
+                }
+                _ => return Err(EINVAL),
+            }
+        }
+        Ok(())
+    }
+}
