+/// One assembled channel before it is wrapped as a Compute or render channel.
+#[versions(AGX)]
+#[allow(dead_code)]
+pub(super) struct G15PipeChannelParts {
+    pub(super) owners: KBox<G15PipeChannelOwners>,
+    pub(super) guards: G15PipeGuards::ver,
+    pub(super) fw_channel_resources: buffer::G15FirmwareChannelResourceLeases,
+    pub(super) pool: Option<buffer::G15ClientUmaComputeChannelRef>,
