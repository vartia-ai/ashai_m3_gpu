+    /// G2 read-only: every nonzero 32-bit word of the RGX status page
+    /// (sgx +0xc000..+0xd000), except +0xc100 (never read) and +0xc128 (may
+    /// clear on read; probe 6 reads it).
+    pub(crate) fn g15_rgx_page(&self, emit: &mut dyn FnMut(usize, u32)) {
+        for off in (0xc000..0xd000).step_by(4) {
+            if off == 0xc100 || off == 0xc128 {
+                continue;
+            }
+            let v = self.dev.resources.g15_sgx_peek32(off);
+            if v != 0 {
+                emit(off, v);
+            }
+        }
+    }
