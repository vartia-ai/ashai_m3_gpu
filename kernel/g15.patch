+    pub(crate) fn g15_install_native_blocks(
+        &self,
+        ids: impl Iterator<Item = u32>,
+        max_blocks: u32,
+        page_list_size: u32,
+        page_list: Option<(u64, usize)>,
+    ) -> Result {
+        #[ver(G != G15)]
+        if page_list.is_some() {
+            return Err(EINVAL);
+        }
+        let mut inner = self.inner.lock();
+        if !inner.blocks.is_empty() || inner.active_scenes != 0 {
+            return Err(EBUSY);
+        }
+        let max = max_blocks as usize;
+        let list_bytes = page_list_size as usize;
+        let list_capacity = match page_list {
+            Some((_, bytes)) => bytes / 4,
+            None => inner.info.page_list.len(),
+        };
+        if max == 0
+            || max.checked_mul(2).ok_or(EINVAL)? > inner.info.block_list.len()
+            || list_bytes % 4 != 0
+            || list_bytes / 4 > list_capacity
+            || page_list.is_some_and(|(va, _)| va == 0 || va % 4 != 0)
+        {
+            pr_err!(
+                "Buffer: G15 Info max_blocks {:#x} / page_list_size {:#x} exceed the lists ({} blocks, {} pages)\n",
+                max_blocks,
+                page_list_size,
+                inner.info.block_list.len() / 2,
+                list_capacity
+            );
+            return Err(EINVAL);
+        }
+        let mut count = 0usize;
+        for id in ids {
+            if count >= max || (count + 1) * PAGES_PER_BLOCK * 4 > list_bytes {
+                return Err(ENOMEM);
+            }
+            inner.info.block_list[2 * count] = id;
+            inner.info.block_list[2 * count + 1] = 0;
+            if page_list.is_none() {
+                for j in 0..PAGES_PER_BLOCK {
+                    inner.info.page_list[count * PAGES_PER_BLOCK + j] =
+                        id.checked_add(j as u32).ok_or(EINVAL)?;
+                }
+            }
+            count += 1;
+        }
+        if count == 0 {
+            return Err(EINVAL);
+        }
+        inner.info.block_ctl.with(|raw, _inner| {
+            raw.total.store(count as u32, Ordering::SeqCst);
+            raw.wptr.store(count as u32, Ordering::SeqCst);
+        });
+        let page_count = (count * PAGES_PER_BLOCK) as u32;
+        inner.info.with_mut(|raw, _inner| {
+            #[ver(G == G15)]
+            if let Some((va, _)) = page_list {
+                raw.page_list = U64(va);
+            }
+            raw.page_list_size = page_list_size;
+            raw.max_blocks = max_blocks;
+            // The page limits follow max_blocks as natively (0x9b34 and
+            // 0x33bc for max_blocks 0x26cd).
+            #[ver(G == G15)]
+            {
+                raw.max_pages_70 = raw.max_blocks * PAGES_PER_BLOCK as u32;
+                raw.max_pages_nomemless_74 = raw.max_blocks / 3 * PAGES_PER_BLOCK as u32;
+            }
+            raw.page_count.store(page_count, Ordering::Relaxed);
+            raw.block_count.store(count as u32, Ordering::Relaxed);
+            raw.last_page.store(page_count - 1, Ordering::Relaxed);
+        });
+        Ok(())
+    }
+
+    /// Diagnostic: the first 32 words of the Info object as the GPU sees
+    /// it (G15 BufferInfo is 0x80 bytes).
+    pub(crate) fn g15_info_words(&self) -> [u32; 32] {
+        let inner = self.inner.lock();
+        let mut out = [0u32; 32];
+        inner.info.with(|raw, _inner| {
+            let p = raw as *const _ as *const u32;
+            let n = (core::mem::size_of_val(raw) / 4).min(32);
+            for (i, w) in out.iter_mut().enumerate().take(n) {
+                // SAFETY: `raw` is a live, readable firmware object of at
+                // least `n` words.
+                *w = unsafe { core::ptr::read_volatile(p.add(i)) };
+            }
+        });
+        out
+    }
