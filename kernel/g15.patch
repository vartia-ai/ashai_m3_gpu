+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! Kernel part of a `g15-render-bundle-v1` profile, as passed at submit time.
+//!
+//! A G15 user render (`drm_asahi_g15_render`) carries a pointer to a
+//! "G15KPRF1" blob. The blob holds every native value the driver needs to
+//! build its own objects for one captured pass: the TA/3D register lists, SKU
+//! and command templates (`fw::g15_render`), resource sizes and placement
+//! classes (`queue::g15_resources`) and the TA/3D channel constructor values
+//! (`queue::g15_channel`). Apple data is never packaged with the kernel, so it
+//! arrives here, through the private diagnostic UAPI, and is validated like
+//! any other user input. The parser decodes into the real W3/W5/W6 types;
+//! their own `validate()` functions run when the driver uses them.
+//!
+//! # Layout (all integers little endian, every record 8-byte aligned)
+//!
+//! Header, 24 bytes: `magic[8] = "G15KPRF1"`, `version: u32 = 2`,
+//! `record_count: u32`, `flags: u32`, `reserved: u32 = 0`. Version 1 blobs
+//! (16-byte header without `flags`/`reserved`) are still accepted, with
+//! flags 0. Unknown flag bits are rejected. Flags:
+//!
+//! * [`G15KPRF_FLAG_EVIDENCE_ONLY`] (bit 0): the blob reproduces a capture
+//!   for inspection and is not a ready replay profile. The driver accepts it
+//!   only while the `g15_render_dry_run` module parameter is set: it builds
+//!   and dumps the pass and returns ECANCELED, and never publishes. The flag
+//!   only lifts the W3 `ready` gate; every other check still applies.
+//! * [`G15KPRF_FLAG_TRIAL`] (bit 1): a TRIAL profile for a bounded hardware
+//!   experiment. It keeps the capture's native uncertainties (STATUS stays
+//!   `ready = 0` with its `unresolved` count) and carries exactly one
+//!   TRIAL_BINDING record naming the reviewed policy ledger that pins their
+//!   Linux choices. Otherwise it is held to every replay rule. The driver
+//!   accepts it in a dry run, and publishes it only while the
+//!   `g15_render_trial` module parameter (default 0) is set. Its view reports
+//!   `ready = true`, meaning constructible under that reviewed policy, not
+//!   native readiness, and `validate()` skips only the unresolved count.
+//!   Setting both flags is rejected.
+//!
+//! Then `record_count` records, each `type: u16`,
+//! `reserved: u16 = 0`, `length: u32` (payload bytes), the payload, and zero
+//! padding to a multiple of 8. No trailing bytes.
+//!
+//! | type | record | payload |
+//! |---|---|---|
+//! | 1 | NAMES | `n` x 32-byte NUL-padded ASCII names. Must come before any PROV. One. |
+//! | 2 | STATUS | `ready: u32` (0/1), `unresolved: u32`. One, required. |
+//! | 3 | REGS | `engine: u32` (1 TA, 2 3D), `count: u32`, `count` x REG. One per engine, required. |
+//! | 4 | TEMPLATE | `kind: u32` (1 TA SKU, 2 3D SKU, 3 TA command, 4 3D command), `byte_len: u32`, `patch_count: u32`, `slot_align: u32` (SKU only, else 0), bytes padded to 8, `patch_count` x PATCH. SKUs required. |
+//! | 5 | RESOURCE | `id: u32`, `resolved: u32` (bit 0 size, 1 alignment, 2 class, 3 init), `size: u64`, `alignment: u64`, `gart_range: u32`, `init_kind: u32` (0 zero, 1 bytes), `pte_attr: u64`, `init_len: u32`, `pad: u32`, init bytes padded to 8. |
+//! | 6 | VALUE | `id: u32`, `resolved: u32` (0/1), `value: u64`. |
+//! | 7 | PB_DESCRIPTOR | `words: [u32; 4]`, 4 x PBRELOC. |
+//! | 8 | VA_WINDOW | `start: u64`, `end: u64`, `gart_range: u32`, `pad: u32`, `pte_attr: u64`. Up to 5. |
+//! | 9 | PIPE | see [`PIPE_BYTES`]; one per TA and 3D, required. |
+//! | 10 | TVB_BLOCKS | `base: u64`, `page_shift: u32 = 15`, `pages_per_block: u32 = 4`, `count: u32`, `pad: u32`, `count` x `first_page_id: u32` padded to 8. At most one. |
+//! | 11 | TRIAL_BINDING | `policy_version: u32 = 1`, `native_gap_count: u32` (= STATUS `unresolved`), `policy_sha256: [u8; 32]` (SHA-256 of the reviewed policy JSON; the kernel only logs it). Exactly one in a TRIAL blob, none otherwise. |
+//!
+//! TVB_BLOCKS lists the native TVB blocks by hardware page ID: block `i`
+//! covers pages `id_i .. id_i + pages_per_block` at GPUVA
+//! `base + (id << page_shift)` (capture-triangle-1: base 0x10_0000_0000,
+//! ids 13, 18, ..., 63). IDs strictly increase and blocks do not overlap.
+//!
+//! REG (56 bytes): `reg: u32`, `pad: u32`, `native: u64`, PROV.
+//! PATCH (56 bytes): `offset: u32`, `width: u8`, `pad: [u8; 3]`, `native: u64`, PROV.
+//!
+//! PROV (40 bytes), the W3 `G15Prov`:
+//! `kind: u8` (0 N, 1 D, 2 R, 3 F), `sub: u8` (D: 0 scalar, 1 register;
+//! R: 0 full_address, 1 bitfield with literal base, 2 bitfield with target
+//! base), `address_shift: u8`, `field_shift: u8`, `engine: u8` (D register
+//! source: 1 TA, 2 3D), `pad: [u8; 3]`, `name: u16` (NAMES index of the R
+//! target or the D scalar), `base_name: u16` (NAMES index of an R base
+//! target), `reg: u32` (D register source), `a: u64` (R addend / D add, both
+//! signed), `b: u64` (R mask / D and), `c: u64` (R literal base / D or).
+//! Fields a kind does not use must be zero. Names are W3 `G15RelocTarget` /
+//! `G15ScalarId` producer names.
+//!
+//! RESOURCE ids: 1 pm_pool, 2 fw_page_list, 3 ctxswitch, 4..6 preempt1..3,
+//! 7 tvb_tilemap, 8 tvb_heapmeta, 9 tvb_tpc, 10 render_target,
+//! 11 segment_resource_list, the per-pass GPU timing record (TA `+0x8b0` /
+//! 3D `+0xbf8` = base, 3D `+0xc00` = base + 8; firmware writes GPU start at
+//! +0 and GPU end at +8). At least 16 bytes; the integrator owns it per pass
+//! and zeroes it, so a nonzero init is rejected. 12 tvb_page_list: the TVB
+//! page list that BufferInfo `+0x1c` points at (capture 5: 0x10_0022_8000,
+//! eGartRange 1, attr 0xe0000000000000), its own object, never the
+//! fw_page_list (2). The kernel fills it with the TVB_BLOCKS page IDs (u32
+//! each), so `init` must be zero; `size` must hold them and VALUE 19 bytes.
+//! It is placed by class like every non-fixed resource, so the profile needs
+//! a VA_WINDOW with exactly this class (Linux has no other heap with it).
+//! Queue-scoped. Required for replay; an evidence-only blob may omit it, and
+//! then BufferInfo keeps the kernel's own list and no PBRELOC may name it.
+//! And `0x100 + role - 1` for the placement of user sections with W9 role `role`
+//! (`size` is then a minimum; the section length wins if larger).
+//! VALUE ids: 1 pm_state_offset, 2 pm_state_bytes, 3 ctxswitch_secondary_offset,
+//! 4 rt_bytes_per_row, 5 rt_height, 6 barrier_external,
+//! 7 barrier_internal_type, 8 init_buffer_slot, 9 init_buffer_unk_c,
+//! 10 init_buffer_block_count (the W4 `G15PreludeProfile` words), and
+//! 11 submission_tag (TA `+0x840` / 3D `+0xb88`; its Linux producer is not
+//! known, so this diagnostic stage replays the native value),
+//! 12 uma_render_pool_blocks and 13 uma_render_pool_admitted_blocks (the
+//! render pool population: 4-MiB extents mapped and listed, and how many of
+//! them the Page-Pool State admits; native 25 and 10; required, both or
+//! neither, when a PIPE uses uma 2), 14 rt_native_va (the render target's
+//! native GPUVA; the kernel-owned target is placed exactly there with the
+//! RESOURCE 10 class, or the submit fails),
+//! 15 pm_scene_stride (bytes per PM scene slot; capture 5: 0x40),
+//! 16 pm_scene_slots (modulo-selected scene slots; capture 5: 36),
+//! 17 pm_scene_offset (PM record `+0x28` of slot 0, an offset from the
+//! TVB_BLOCKS base; capture 5: 0x220000). Record `i` gets
+//! `+0x28 = offset + stride * (i % slots)` and `+0x30 = offset + stride *
+//! slots`; the kernel maps the scene page (`stride * (slots + 1)` bytes,
+//! page rounded) at TVB_BLOCKS base + offset, which must be page aligned,
+//! inside a VA_WINDOW and with that window's class. 15..17 are all
+//! required.
+//! 18 buffer_info_max_blocks (BufferInfo `+0x2c`; capture 5: 0x26cd),
+//! 19 buffer_info_page_list_size (BufferInfo `+0x24`, bytes, a multiple of
+//! 4), both required and written verbatim when the native TVB blocks are
+//! installed. They must fit the kernel's BufferInfo list allocation
+//! (`buffer::G15_INFO_LIST_CAPACITY_BLOCKS` blocks). A missing
+//! RESOURCE or VALUE is
+//! unresolved; W6 fails closed on any unresolved value it needs.
+//!
+//! PBRELOC (40 bytes): `present: u8`, `width: u8`, `target: u8` (1 buffer
+//! info, 2 PM pool, 3 FW page list, 4 TVB page list = RESOURCE 12),
+//! `encoding: u8` (0 full, 1 bitfield), `address_shift: u8`,
+//! `field_shift: u8`, `pad: [u8; 2]`, `offset: u32`, `pad: u32`,
+//! `addend: i64`, `address_base: u64`, `mask: u64`. A bitfield writes
+//! `((target + addend - address_base) >> address_shift) << field_shift`
+//! under `mask`; low bits lost to the shift or bits outside the mask fail.
+//!
+//! Capture 5's PB descriptor is `[0x22800, 0x2c, 0, 0]`: word 0 is the TVB
+//! page list, `(0x10_0022_8000 - 0x10_0000_0000) >> 4`; word 1 is decimal
+//! 44 (11 blocks x 4 pages), the same in all four samples. Its PBRELOC is
+//! `present 1, width 4, target 4, encoding 1, address_shift 4,
+//! field_shift 0, offset 0, addend 0, address_base 0x10_0000_0000` (the
+//! eGartRange-1 window base, the TVB_BLOCKS base), `mask 0xffff_ffff`. A
+//! replay or TRIAL blob (not [`G15KPRF_FLAG_EVIDENCE_ONLY`]) must relocate
+//! word 0 this way: a target-4 relocation at offset 0 whose mask covers every set
+//! bit of the native word 0. The literal native word names Apple's page
+//! list, which the kernel does not own; only an evidence-only blob may
+//! carry it unrelocated.
+
+use kernel::prelude::*;
+
+use crate::buffer::{G15ChannelPriorityWords, G15PipeChannelStateImage};
+use crate::channel::PipeType;
+use crate::fw::g15_render::*;
+use crate::queue::g15_channel::{
+    G15FirmwareStateSlice, G15PipeChannelInit, G15PipeProfile, G15PipeUmaSource,
+};
+use crate::queue::g15_resources::*;
+use crate::render_input::Role;
+
+const MAGIC: &[u8; 8] = b"G15KPRF1";
+const VERSION_V1: u32 = 1;
+const VERSION: u32 = 2;
+const HEADER_BYTES_V1: usize = 16;
+const HEADER_BYTES: usize = 24;
+/// Header flag: evidence-only blob; see the module documentation.
+pub(crate) const G15KPRF_FLAG_EVIDENCE_ONLY: u32 = 1 << 0;
+/// Header flag: TRIAL blob; see the module documentation.
+pub(crate) const G15KPRF_FLAG_TRIAL: u32 = 1 << 1;
+const KNOWN_FLAGS: u32 = G15KPRF_FLAG_EVIDENCE_ONLY | G15KPRF_FLAG_TRIAL;
+const TRIAL_BINDING_BYTES: usize = 40;
+const TRIAL_POLICY_VERSION: u32 = 1;
+const NAME_BYTES: usize = 32;
+const PROV_BYTES: usize = 40;
+const REG_BYTES: usize = 56;
+const PATCH_BYTES: usize = 56;
+const _: () = assert!(REG_BYTES == 16 + PROV_BYTES && PATCH_BYTES == 16 + PROV_BYTES);
+const RESOURCE_HEAD_BYTES: usize = 48;
+const PBRELOC_BYTES: usize = 40;
+const WINDOW_BYTES: usize = 32;
+/// PIPE payload: pipe u32 (0 TA, 1 3D) @0, owner_pid u32 @4 (the native
+/// client's pid, evidence only: the channel state gets this client's own
+/// pid), byte_ac u32 @8,
+/// ring_size u32 @12, word_30 u32 @16, word_34 u32 @20, mask_38 u64 @24,
+/// word_40 u32 @32, word_44 u32 @36, word_48 u32 @40, evctl_index u32 @44,
+/// evctl_effective_record_count u32 @48, sku_slot_count u32 @52,
+/// sku_slot_stride u32 @56, command_resource_bytes u32 @60 (0: none),
+/// command_resource_tag [u8; 4] @64, uma u32 @68 (0 none, 1 shared Compute
+/// pool, 2 dedicated render pool shared by TA and 3D, in client-container
+/// slot `uma_priority_class` with the population of VALUEs 12/13),
+/// uma_priority_class u32 @72, firmware_state u32 @76 (0 vertex,
+/// 1 fragment), uma_min u64 @80, uma_ideal u64 @88.
+pub(crate) const PIPE_BYTES: usize = 96;
+
+const MAX_NAMES: usize = 256;
+const MAX_PATCHES: usize = 2048;
+const MAX_WINDOWS: usize = 5;
+const MAX_TVB_BLOCKS: usize = 256;
+const MAX_INIT_BYTES: usize = 0x10000;
+
+const RES_PASS_COUNT: usize = 12;
+const RES_TVB_PAGE_LIST: usize = 12;
+const VALUE_COUNT: usize = 19;
+const VALUE_UMA_RENDER_POOL_BLOCKS: usize = 12;
+const VALUE_UMA_RENDER_POOL_ADMITTED: usize = 13;
+const VALUE_PM_SCENE_STRIDE: usize = 15;
+const VALUE_PM_SCENE_SLOTS: usize = 16;
+const VALUE_PM_SCENE_OFFSET: usize = 17;
+const VALUE_BUFFER_INFO_MAX_BLOCKS: usize = 18;
+const VALUE_BUFFER_INFO_PAGE_LIST_SIZE: usize = 19;
+const RES_USER_BASE: u32 = 0x100;
+
+fn le(b: &[u8]) -> u64 {
+    b.iter().rev().fold(0, |acc, &x| (acc << 8) | u64::from(x))
+}
+
+/// Bounds-checked little-endian reader over one payload.
+struct Rd<'a>(&'a [u8]);
+
+impl<'a> Rd<'a> {
+    fn get(&self, off: usize, width: usize) -> Result<u64> {
+        let end = off.checked_add(width).ok_or(EINVAL)?;
+        Ok(le(self.0.get(off..end).ok_or(EINVAL)?))
+    }
+    fn u8(&self, off: usize) -> Result<u8> {
+        Ok(self.get(off, 1)? as u8)
+    }
+    fn u16(&self, off: usize) -> Result<u16> {
+        Ok(self.get(off, 2)? as u16)
+    }
+    fn u32(&self, off: usize) -> Result<u32> {
+        Ok(self.get(off, 4)? as u32)
+    }
+    fn u64(&self, off: usize) -> Result<u64> {
+        self.get(off, 8)
+    }
+    fn bytes(&self, off: usize, len: usize) -> Result<&'a [u8]> {
+        let end = off.checked_add(len).ok_or(EINVAL)?;
+        self.0.get(off..end).ok_or(EINVAL)
+    }
+    fn zero(&self, off: usize, len: usize) -> Result {
+        if self.bytes(off, len)?.iter().any(|&b| b != 0) {
+            return Err(EINVAL);
+        }
+        Ok(())
+    }
+}
+
+fn pad8(n: usize) -> Result<usize> {
+    n.checked_add(7).map(|v| v & !7).ok_or(EINVAL)
+}
+
+/// Owned byte template (SKU stream or command image).
+struct Template {
+    bytes: KVVec<u8>,
+    patches: KVec<G15Patch>,
+    slot_align: u64,
+}
+
+impl Template {
+    fn view(&self) -> G15ByteTemplate<'_> {
+        G15ByteTemplate {
+            bytes: &self.bytes,
+            patches: &self.patches,
+        }
+    }
+}
+
+/// One RESOURCE record.
+struct ResourceRec {
+    resolved: u32,
+    size: usize,
+    alignment: usize,
+    class: G15PteClass,
+    init: Option<KVVec<u8>>,
+}
+
+impl ResourceRec {
+    fn req(&self) -> G15ResourceReq<'_> {
+        let pick = |bit: u32| self.resolved & (1 << bit) != 0;
+        G15ResourceReq {
+            size: if pick(0) {
+                G15Profiled::Resolved(self.size)
+            } else {
+                G15Profiled::Unresolved
+            },
+            alignment: if pick(1) {
+                G15Profiled::Resolved(self.alignment)
+            } else {
+                G15Profiled::Unresolved
+            },
+            class: if pick(2) {
+                G15Profiled::Resolved(self.class)
+            } else {
+                G15Profiled::Unresolved
+            },
+            init: if pick(3) {
+                G15Profiled::Resolved(match &self.init {
+                    Some(b) => G15ResourceInit::Bytes(b),
+                    None => G15ResourceInit::Zero,
+                })
+            } else {
+                G15Profiled::Unresolved
+            },
+        }
+    }
+}
+
+fn unresolved_req() -> G15ResourceReq<'static> {
+    G15ResourceReq {
+        size: G15Profiled::Unresolved,
+        alignment: G15Profiled::Unresolved,
+        class: G15Profiled::Unresolved,
+        init: G15Profiled::Unresolved,
+    }
+}
+
+/// TRIAL_BINDING (record 11): the reviewed policy ledger a TRIAL blob is
+/// bound to. Displays as `policy v<version> gaps <count> sha <64 hex>`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15TrialBinding {
+    pub(crate) policy_version: u32,
+    /// Native uncertainties the policy pins; equals STATUS `unresolved`.
+    pub(crate) native_gap_count: u32,
+    /// SHA-256 of the reviewed policy JSON. Opaque to the kernel.
+    pub(crate) policy_sha256: [u8; 32],
+}
+
+impl core::fmt::Display for G15TrialBinding {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(
+            f,
+            "policy v{} gaps {} sha ",
+            self.policy_version, self.native_gap_count
+        )?;
+        for b in self.policy_sha256 {
+            write!(f, "{:02x}", b)?;
+        }
+        Ok(())
+    }
+}
+
+/// A validated kernel profile, owned.
+pub(crate) struct G15KernelProfile {
+    /// Header flag [`G15KPRF_FLAG_EVIDENCE_ONLY`].
+    evidence_only: bool,
+    /// Header flag [`G15KPRF_FLAG_TRIAL`].
+    trial: bool,
+    /// TRIAL_BINDING; present exactly when `trial` once parsed.
+    trial_binding: Option<G15TrialBinding>,
+    ready: bool,
+    unresolved: usize,
+    ta_regs: Option<KVec<G15RegEntry>>,
+    frag_regs: Option<KVec<G15RegEntry>>,
+    templates: [Option<Template>; 4],
+    resources: [Option<ResourceRec>; RES_PASS_COUNT],
+    placements: [Option<ResourceRec>; Role::COUNT],
+    values: [Option<u64>; VALUE_COUNT],
+    pb: Option<G15PbDescriptorProfile>,
+    windows: KVec<G15VaWindowProfile>,
+    pipes: [Option<G15PipeProfile>; 2],
+    /// TVB_BLOCKS: (base, first page IDs).
+    tvb_blocks: Option<(u64, KVec<u32>)>,
+    /// FNV-1a over the queue-scoped records, in blob order. Two submits on
+    /// one queue must agree on it, because the queue-lifetime objects they
+    /// describe are built only once.
+    queue_key: u64,
+}
+
+fn fnv(mut h: u64, bytes: &[u8]) -> u64 {
+    for &b in bytes {
+        h ^= u64::from(b);
+        h = h.wrapping_mul(0x100_0000_01b3);
+    }
+    h
+}
+
+impl G15KernelProfile {
+    /// Parse and structurally validate a G15KPRF1 blob.
+    // The kernel parses in place (`parse_into`); the host tests use this.
+    #[allow(dead_code)]
+    pub(crate) fn parse(blob: &[u8]) -> Result<Self> {
+        let mut p = Self::blank();
+        p.parse_into(blob)?;
+        Ok(p)
+    }
+
+    /// The profile `parse_into` starts from.
+    pub(crate) fn blank() -> Self {
+        Self {
+            evidence_only: false,
+            trial: false,
+            trial_binding: None,
+            ready: false,
+            unresolved: 0,
+            ta_regs: None,
+            frag_regs: None,
+            templates: [None, None, None, None],
+            resources: Default::default(),
+            placements: Default::default(),
+            values: [None; VALUE_COUNT],
+            pb: None,
+            windows: KVec::new(),
+            pipes: [None, None],
+            tvb_blocks: None,
+            queue_key: 0xcbf2_9ce4_8422_2325,
+        }
+    }
+
+    /// [`Self::parse`] into a [`Self::blank`] profile, which can then live
+    /// on the heap from the start: the profile is ~3 KiB, too big for the
+    /// submit path's stack. On error `self` holds a partial parse.
+    pub(crate) fn parse_into(&mut self, blob: &[u8]) -> Result {
+        let head = Rd(blob);
+        if blob.len() < HEADER_BYTES_V1 || head.bytes(0, 8)? != MAGIC {
+            return Err(EINVAL);
+        }
+        let (header_bytes, flags) = match head.u32(8)? {
+            VERSION_V1 => (HEADER_BYTES_V1, 0),
+            VERSION => {
+                if head.u32(20)? != 0 {
+                    return Err(EINVAL);
+                }
+                (HEADER_BYTES, head.u32(16)?)
+            }
+            _ => return Err(EINVAL),
+        };
+        const BOTH: u32 = G15KPRF_FLAG_EVIDENCE_ONLY | G15KPRF_FLAG_TRIAL;
+        if flags & !KNOWN_FLAGS != 0 || flags & BOTH == BOTH {
+            return Err(EINVAL);
+        }
+        let count = head.u32(12)? as usize;
+        let p = self;
+        p.evidence_only = flags & G15KPRF_FLAG_EVIDENCE_ONLY != 0;
+        p.trial = flags & G15KPRF_FLAG_TRIAL != 0;
+        let mut names: KVec<[u8; NAME_BYTES]> = KVec::new();
+        let (mut have_names, mut have_status) = (false, false);
+        let mut off = header_bytes;
+        for _ in 0..count {
+            let rh = Rd(blob.get(off..).ok_or(EINVAL)?);
+            let (ty, reserved, len) = (rh.u16(0)?, rh.u16(2)?, rh.u32(4)? as usize);
+            let body = rh.bytes(8, len)?;
+            let padded = pad8(len)?;
+            rh.zero(8 + len, padded - len)?;
+            if reserved != 0 {
+                return Err(EINVAL);
+            }
+            let r = Rd(body);
+            let mut queue_scoped = false;
+            match ty {
+                1 => {
+                    if have_names || len % NAME_BYTES != 0 || len / NAME_BYTES > MAX_NAMES {
+                        return Err(EINVAL);
+                    }
+                    for chunk in body.chunks_exact(NAME_BYTES) {
+                        let n = chunk.iter().position(|&b| b == 0).unwrap_or(NAME_BYTES);
+                        if n == 0
+                            || chunk[n..].iter().any(|&b| b != 0)
+                            || !chunk[..n].iter().all(|b| b.is_ascii_graphic())
+                        {
+                            return Err(EINVAL);
+                        }
+                        let mut name = [0u8; NAME_BYTES];
+                        name.copy_from_slice(chunk);
+                        names.push(name, GFP_KERNEL)?;
+                    }
+                    have_names = true;
+                }
+                2 => {
+                    let ready = r.u32(0)?;
+                    if have_status || len != 8 || ready > 1 {
+                        return Err(EINVAL);
+                    }
+                    p.ready = ready == 1;
+                    p.unresolved = r.u32(4)? as usize;
+                    have_status = true;
+                }
+                3 => p.parse_regs(&r, len, &names)?,
+                4 => p.parse_template(&r, len, &names)?,
+                5 => queue_scoped = p.parse_resource(&r, len)?,
+                6 => {
+                    let (id, resolved) = (r.u32(0)? as usize, r.u32(4)?);
+                    if len != 16 || !(1..=VALUE_COUNT).contains(&id) || resolved > 1 {
+                        return Err(EINVAL);
+                    }
+                    let slot = &mut p.values[id - 1];
+                    if slot.is_some() {
+                        return Err(EINVAL);
+                    }
+                    if resolved == 1 {
+                        *slot = Some(r.u64(8)?);
+                    }
+                    queue_scoped = id <= 2
+                        || id == VALUE_UMA_RENDER_POOL_BLOCKS
+                        || id == VALUE_UMA_RENDER_POOL_ADMITTED
+                        || (VALUE_PM_SCENE_STRIDE..=VALUE_BUFFER_INFO_PAGE_LIST_SIZE)
+                            .contains(&id);
+                }
+                7 => {
+                    p.parse_pb(&r, len)?;
+                    queue_scoped = true;
+                }
+                8 => {
+                    if len != WINDOW_BYTES || p.windows.len() >= MAX_WINDOWS || r.u32(20)? != 0 {
+                        return Err(EINVAL);
+                    }
+                    let w = G15VaWindowProfile {
+                        start: r.u64(0)?,
+                        end: r.u64(8)?,
+                        class: G15PteClass {
+                            gart_range: u8::try_from(r.u32(16)?)?,
+                            pte_attr: r.u64(24)?,
+                        },
+                    };
+                    if w.start >= w.end
+                        || p.windows.iter().any(|o| w.start < o.end && o.start < w.end)
+                    {
+                        return Err(EINVAL);
+                    }
+                    p.windows.push(w, GFP_KERNEL)?;
+                    queue_scoped = true;
+                }
+                9 => {
+                    p.parse_pipe(&r, len)?;
+                    queue_scoped = true;
+                }
+                10 => {
+                    p.parse_tvb_blocks(&r, len)?;
+                    queue_scoped = true;
+                }
+                11 => {
+                    if !p.trial
+                        || p.trial_binding.is_some()
+                        || len != TRIAL_BINDING_BYTES
+                        || r.u32(0)? != TRIAL_POLICY_VERSION
+                    {
+                        return Err(EINVAL);
+                    }
+                    let mut policy_sha256 = [0u8; 32];
+                    policy_sha256.copy_from_slice(r.bytes(8, 32)?);
+                    p.trial_binding = Some(G15TrialBinding {
+                        policy_version: TRIAL_POLICY_VERSION,
+                        native_gap_count: r.u32(4)?,
+                        policy_sha256,
+                    });
+                }
+                _ => return Err(EINVAL),
+            }
+            if queue_scoped {
+                p.queue_key = fnv(p.queue_key, rh.bytes(0, 8 + len)?);
+            }
+            off = off.checked_add(8 + padded).ok_or(EINVAL)?;
+        }
+        p.resolve_render_pool()?;
+        if off != blob.len() || !have_status {
+            return Err(EINVAL);
+        }
+        if p.trial {
+            // The binding must account for exactly the STATUS gaps.
+            let b = p.trial_binding.ok_or(EINVAL)?;
+            if b.native_gap_count as usize != p.unresolved {
+                return Err(EINVAL);
+            }
+        }
+        // A replay or TRIAL blob must carry everything the submit path needs;
+        // an evidence-only blob may leave items unknown (a dry run then dumps
+        // the list instead of building, see `missing_required`).
+        if !p.evidence_only {
+            let missing = p.missing_required()?;
+            if let Some(first) = missing.first() {
+                pr_err!(
+                    "G15 render profile: {} required item(s) unresolved, first {}\n",
+                    missing.len(),
+                    first
+                );
+                return Err(EINVAL);
+            }
+            if !p.pb.is_some_and(|pb| pb.word0_relocated()) {
+                pr_err!(
+                    "G15 render profile: replay PB descriptor word 0 is not a TVB page list relocation\n"
+                );
+                return Err(EINVAL);
+            }
+        }
+        Ok(())
+    }
+
+    /// Every item the submit path needs that this blob leaves unknown, by
+    /// sidecar name. Per-section placements are checked at submit, against
+    /// the sections the input actually has.
+    pub(crate) fn missing_required(&self) -> Result<KVec<&'static str>> {
+        const RES: [&str; RES_PASS_COUNT] = [
+            "pm_pool",
+            "fw_page_list",
+            "ctxswitch",
+            "preempt1",
+            "preempt2",
+            "preempt3",
+            "tvb_tilemap",
+            "tvb_heapmeta",
+            "tvb_tpc",
+            "render_target",
+            "segment_resource_list",
+            "tvb_page_list",
+        ];
+        const VALUES: [&str; VALUE_COUNT] = [
+            "pm_state_offset",
+            "pm_state_bytes",
+            "ctxswitch_secondary_offset",
+            "rt_bytes_per_row",
+            "rt_height",
+            "barrier_external",
+            "barrier_internal_type",
+            "init_buffer_slot",
+            "init_buffer_unk_c",
+            "init_buffer_block_count",
+            "submission_tag",
+            "uma_render_pool_blocks",
+            "uma_render_pool_admitted",
+            "rt_native_va",
+            "pm_scene_stride",
+            "pm_scene_slots",
+            "pm_scene_offset",
+            "buffer_info_max_blocks",
+            "buffer_info_page_list_size",
+        ];
+        let mut m = KVec::new();
+        let mut need = |cond: bool, name: &'static str| -> Result {
+            if cond {
+                m.push(name, GFP_KERNEL)?;
+            }
+            Ok(())
+        };
+        need(self.ta_regs.is_none(), "regs.ta")?;
+        need(self.frag_regs.is_none(), "regs.fragment")?;
+        for (i, name) in [
+            "template.ta_sku",
+            "template.fragment_sku",
+            "template.ta_command",
+            "template.fragment_command",
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            need(self.templates[i].is_none(), name)?;
+        }
+        need(self.pipes[0].is_none(), "pipe.ta")?;
+        need(self.pipes[1].is_none(), "pipe.fragment")?;
+        need(self.pb.is_none(), "pb_descriptor")?;
+        need(self.tvb_blocks.is_none(), "tvb_blocks")?;
+        for (i, name) in RES.iter().enumerate() {
+            let complete = match self.resources[i].as_ref() {
+                // Evidence-only blobs may dump the literal PB word 0 without
+                // a kernel TVB page list.
+                None => self.evidence_only && i + 1 == RES_TVB_PAGE_LIST,
+                // A preempt buffer with a known size of 0 is absent; nothing
+                // else about it is needed.
+                Some(r) if (3..=5).contains(&i) && r.resolved & 1 != 0 && r.size == 0 => true,
+                Some(r) => r.resolved == 0xf,
+            };
+            need(!complete, name)?;
+        }
+        let render_pool = self
+            .pipes
+            .iter()
+            .flatten()
+            .any(|p| matches!(p.uma, G15PipeUmaSource::RenderPool { .. }));
+        for (i, name) in VALUES.iter().enumerate() {
+            let id = i + 1;
+            let wanted = match id {
+                VALUE_UMA_RENDER_POOL_BLOCKS | VALUE_UMA_RENDER_POOL_ADMITTED => render_pool,
+                _ => true,
+            };
+            need(wanted && self.values[i].is_none(), name)?;
+        }
+        Ok(m)
+    }
+
+    /// Fill the render pool population (VALUEs 12/13) into every PIPE that
+    /// uses uma 2, then validate those pipes. Both pipes name the same pool.
+    fn resolve_render_pool(&mut self) -> Result {
+        let blocks = self.values[VALUE_UMA_RENDER_POOL_BLOCKS - 1];
+        let admitted = self.values[VALUE_UMA_RENDER_POOL_ADMITTED - 1];
+        if self.evidence_only && (blocks.is_none() || admitted.is_none()) {
+            // Left unset (and listed by `missing_required`): a dry run
+            // stops before any pool exists.
+            return Ok(());
+        }
+        let mut slots = KVec::<u8>::new();
+        for pipe in self.pipes.iter_mut().flatten() {
+            if let G15PipeUmaSource::RenderPool {
+                slot,
+                blocks: b,
+                admitted_blocks: a,
+            } = &mut pipe.uma
+            {
+                *b = u32::try_from(blocks.ok_or(EINVAL)?)?;
+                *a = u32::try_from(admitted.ok_or(EINVAL)?)?;
+                slots.push(*slot, GFP_KERNEL)?;
+                pipe.validate()?;
+            }
+        }
+        if slots.windows(2).any(|w| w[0] != w[1]) {
+            return Err(EINVAL);
+        }
+        Ok(())
+    }
+
+    fn name<'n>(names: &'n [[u8; NAME_BYTES]], index: u16) -> Result<&'n str> {
+        let n = names.get(usize::from(index)).ok_or(EINVAL)?;
+        let len = n.iter().position(|&b| b == 0).unwrap_or(NAME_BYTES);
+        core::str::from_utf8(&n[..len]).map_err(|_| EINVAL)
+    }
+
+    fn engine(raw: u8) -> Result<G15Engine> {
+        match raw {
+            1 => Ok(G15Engine::Ta),
+            2 => Ok(G15Engine::Frag),
+            _ => Err(EINVAL),
+        }
+    }
+
+    /// Decode one PROV into the W3 `G15Prov`.
+    fn prov(r: &Rd<'_>, off: usize, names: &[[u8; NAME_BYTES]]) -> Result<G15Prov> {
+        let (kind, sub) = (r.u8(off)?, r.u8(off + 1)?);
+        let (ashift, fshift, engine) = (r.u8(off + 2)?, r.u8(off + 3)?, r.u8(off + 4)?);
+        r.zero(off + 5, 3)?;
+        let (name, base_name, reg) = (r.u16(off + 8)?, r.u16(off + 10)?, r.u32(off + 12)?);
+        let (a, b, c) = (r.u64(off + 16)?, r.u64(off + 24)?, r.u64(off + 32)?);
+        let unused = |v: &[u64]| v.iter().any(|&x| x != 0);
+        Ok(match kind {
+            0 | 3 => {
+                if sub != 0
+                    || unused(&[
+                        ashift.into(),
+                        fshift.into(),
+                        engine.into(),
+                        name.into(),
+                        base_name.into(),
+                        reg.into(),
+                        a,
+                        b,
+                        c,
+                    ])
+                {
+                    return Err(EINVAL);
+                }
+                if kind == 0 {
+                    G15Prov::Native
+                } else {
+                    G15Prov::FwOwned
+                }
+            }
+            1 => {
+                if unused(&[ashift.into(), fshift.into(), base_name.into()]) {
+                    return Err(EINVAL);
+                }
+                let src = match sub {
+                    0 => {
+                        if unused(&[engine.into(), reg.into()]) {
+                            return Err(EINVAL);
+                        }
+                        G15DerivedSrc::Scalar(G15ScalarId::from_name(Self::name(names, name)?)?)
+                    }
+                    1 => {
+                        if name != 0 {
+                            return Err(EINVAL);
+                        }
+                        G15DerivedSrc::Reg(G15RegRef {
+                            engine: Self::engine(engine)?,
+                            reg,
+                        })
+                    }
+                    _ => return Err(EINVAL),
+                };
+                G15Prov::Derived(G15Derived {
+                    src,
+                    op: G15ValueOp {
+                        add: a as i64,
+                        and: b,
+                        or: c,
+                    },
+                })
+            }
+            2 => {
+                if unused(&[engine.into(), reg.into()]) {
+                    return Err(EINVAL);
+                }
+                let target = G15RelocTarget::from_name(Self::name(names, name)?)?;
+                let encoding = match sub {
+                    0 => {
+                        if unused(&[ashift.into(), fshift.into(), base_name.into(), b, c]) {
+                            return Err(EINVAL);
+                        }
+                        G15Encoding::FullAddress
+                    }
+                    1 | 2 => {
+                        let base = if sub == 1 {
+                            if base_name != 0 {
+                                return Err(EINVAL);
+                            }
+                            G15AddrBase::Literal(c)
+                        } else {
+                            if c != 0 {
+                                return Err(EINVAL);
+                            }
+                            G15AddrBase::Target(G15RelocTarget::from_name(Self::name(
+                                names, base_name,
+                            )?)?)
+                        };
+                        G15Encoding::Bitfield {
+                            base,
+                            address_shift: ashift,
+                            field_shift: fshift,
+                            mask: b,
+                        }
+                    }
+                    _ => return Err(EINVAL),
+                };
+                G15Prov::Reloc(G15Reloc {
+                    target,
+                    addend: a as i64,
+                    encoding,
+                })
+            }
+            _ => return Err(EINVAL),
+        })
+    }
+
+    fn parse_regs(&mut self, r: &Rd<'_>, len: usize, names: &[[u8; NAME_BYTES]]) -> Result {
+        let (engine, count) = (r.u32(0)?, r.u32(4)? as usize);
+        if count > G15_REG_LIST_MAX || len != 8 + count * REG_BYTES {
+            return Err(EINVAL);
+        }
+        let mut entries = KVec::with_capacity(count, GFP_KERNEL)?;
+        for i in 0..count {
+            let o = 8 + i * REG_BYTES;
+            r.zero(o + 4, 4)?;
+            entries.push(
+                G15RegEntry {
+                    reg: r.u32(o)?,
+                    native: r.u64(o + 8)?,
+                    prov: Self::prov(r, o + 16, names)?,
+                },
+                GFP_KERNEL,
+            )?;
+        }
+        let slot = match engine {
+            1 => &mut self.ta_regs,
+            2 => &mut self.frag_regs,
+            _ => return Err(EINVAL),
+        };
+        if slot.is_some() {
+            return Err(EINVAL);
+        }
+        *slot = Some(entries);
+        Ok(())
+    }
+
+    fn parse_template(&mut self, r: &Rd<'_>, len: usize, names: &[[u8; NAME_BYTES]]) -> Result {
+        let (kind, byte_len) = (r.u32(0)? as usize, r.u32(4)? as usize);
+        let (patch_count, slot_align) = (r.u32(8)? as usize, r.u32(12)?);
+        let sku = matches!(kind, 1 | 2);
+        let padded = pad8(byte_len)?;
+        if !(1..=4).contains(&kind)
+            || byte_len == 0
+            || byte_len > G15_TEMPLATE_MAX_BYTES
+            || patch_count > MAX_PATCHES
+            || len != 16 + padded + patch_count * PATCH_BYTES
+            || (sku && !slot_align.is_power_of_two())
+            || (!sku && slot_align != 0)
+            || self.templates[kind - 1].is_some()
+        {
+            return Err(EINVAL);
+        }
+        r.zero(16 + byte_len, padded - byte_len)?;
+        let mut bytes = KVVec::with_capacity(byte_len, GFP_KERNEL)?;
+        bytes.extend_from_slice(r.bytes(16, byte_len)?, GFP_KERNEL)?;
+        let mut patches = KVec::with_capacity(patch_count, GFP_KERNEL)?;
+        for i in 0..patch_count {
+            let o = 16 + padded + i * PATCH_BYTES;
+            r.zero(o + 5, 3)?;
+            patches.push(
+                G15Patch {
+                    offset: r.u32(o)?,
+                    width: r.u8(o + 4)?,
+                    native: r.u64(o + 8)?,
+                    prov: Self::prov(r, o + 16, names)?,
+                },
+                GFP_KERNEL,
+            )?;
+        }
+        self.templates[kind - 1] = Some(Template {
+            bytes,
+            patches,
+            slot_align: u64::from(slot_align),
+        });
+        Ok(())
+    }
+
+    /// Returns whether the record is queue-scoped.
+    fn parse_resource(&mut self, r: &Rd<'_>, len: usize) -> Result<bool> {
+        let (id, resolved) = (r.u32(0)?, r.u32(4)?);
+        let init_kind = r.u32(28)?;
+        let init_len = r.u32(40)? as usize;
+        if resolved & !0xf != 0
+            || init_kind > 1
+            || r.u32(44)? != 0
+            || init_len > MAX_INIT_BYTES
+            || (init_kind == 0 && init_len != 0)
+            || len != RESOURCE_HEAD_BYTES + pad8(init_len)?
+        {
+            return Err(EINVAL);
+        }
+        r.zero(RESOURCE_HEAD_BYTES + init_len, pad8(init_len)? - init_len)?;
+        let init = if init_kind == 1 {
+            let mut b = KVVec::with_capacity(init_len, GFP_KERNEL)?;
+            b.extend_from_slice(r.bytes(RESOURCE_HEAD_BYTES, init_len)?, GFP_KERNEL)?;
+            Some(b)
+        } else {
+            None
+        };
+        let rec = ResourceRec {
+            resolved,
+            size: usize::try_from(r.u64(8)?)?,
+            alignment: usize::try_from(r.u64(16)?)?,
+            class: G15PteClass {
+                gart_range: u8::try_from(r.u32(24)?)?,
+                pte_attr: r.u64(32)?,
+            },
+            init,
+        };
+        let id = id as usize;
+        let slot = if (1..=RES_PASS_COUNT).contains(&id) {
+            &mut self.resources[id - 1]
+        } else {
+            let role = id.checked_sub(RES_USER_BASE as usize).ok_or(EINVAL)?;
+            self.placements.get_mut(role).ok_or(EINVAL)?
+        };
+        if slot.is_some() {
+            return Err(EINVAL);
+        }
+        *slot = Some(rec);
+        Ok(id <= 2 || id == RES_TVB_PAGE_LIST)
+    }
+
+    fn parse_tvb_blocks(&mut self, r: &Rd<'_>, len: usize) -> Result {
+        let count = r.u32(16)? as usize;
+        if self.tvb_blocks.is_some()
+            || count == 0
+            || count > MAX_TVB_BLOCKS
+            || r.u32(8)? as usize != crate::buffer::PAGE_SHIFT
+            || r.u32(12)? as usize != crate::buffer::PAGES_PER_BLOCK
+            || r.u32(20)? != 0
+            || len != 24 + pad8(4 * count)?
+        {
+            return Err(EINVAL);
+        }
+        r.zero(24 + 4 * count, pad8(4 * count)? - 4 * count)?;
+        let base = r.u64(0)?;
+        let mut ids = KVec::with_capacity(count, GFP_KERNEL)?;
+        let ppb = crate::buffer::PAGES_PER_BLOCK as u32;
+        for i in 0..count {
+            let id = r.u32(24 + 4 * i)?;
+            if let Some(&prev) = ids.last() {
+                if id < prev + ppb {
+                    return Err(EINVAL);
+                }
+            }
+            let end_page = u64::from(id) + u64::from(ppb);
+            base.checked_add(end_page << crate::buffer::PAGE_SHIFT).ok_or(EINVAL)?;
+            ids.push(id, GFP_KERNEL)?;
+        }
+        self.tvb_blocks = Some((base, ids));
+        Ok(())
+    }
+
+    fn parse_pb(&mut self, r: &Rd<'_>, len: usize) -> Result {
+        if self.pb.is_some() || len != 16 + 4 * PBRELOC_BYTES {
+            return Err(EINVAL);
+        }
+        let mut words = [0u32; 4];
+        for (i, w) in words.iter_mut().enumerate() {
+            *w = r.u32(4 * i)?;
+        }
+        let mut relocs: [Option<G15PbReloc>; 4] = [None; 4];
+        for (i, slot) in relocs.iter_mut().enumerate() {
+            let o = 16 + i * PBRELOC_BYTES;
+            r.zero(o + 6, 2)?;
+            r.zero(o + 12, 4)?;
+            if r.u8(o)? == 0 {
+                r.zero(o, PBRELOC_BYTES)?;
+                continue;
+            }
+            if r.u8(o)? != 1 {
+                return Err(EINVAL);
+            }
+            let target = match r.u8(o + 2)? {
+                1 => G15PbRelocTarget::BufferInfo,
+                2 => G15PbRelocTarget::PmPool,
+                3 => G15PbRelocTarget::FwPageList,
+                4 => G15PbRelocTarget::TvbPageList,
+                _ => return Err(EINVAL),
+            };
+            let encoding = match r.u8(o + 3)? {
+                0 => G15RelocEncoding::FullAddress,
+                1 => G15RelocEncoding::Bitfield {
+                    address_base: r.u64(o + 24)?,
+                    address_shift: r.u8(o + 4)?,
+                    field_shift: r.u8(o + 5)?,
+                    mask: r.u64(o + 32)?,
+                },
+                _ => return Err(EINVAL),
+            };
+            *slot = Some(G15PbReloc {
+                offset: r.u32(o + 8)? as usize,
+                width: usize::from(r.u8(o + 1)?),
+                target,
+                addend: r.u64(o + 16)? as i64,
+                encoding,
+            });
+        }
+        self.pb = Some(G15PbDescriptorProfile { words, relocs });
+        Ok(())
+    }
+
+    fn parse_pipe(&mut self, r: &Rd<'_>, len: usize) -> Result {
+        let pipe = r.u32(0)?;
+        if len != PIPE_BYTES || pipe > 1 || self.pipes[pipe as usize].is_some() {
+            return Err(EINVAL);
+        }
+        let cmd_bytes = r.u32(60)? as usize;
+        let mut tag = [0u8; 4];
+        tag.copy_from_slice(r.bytes(64, 4)?);
+        if cmd_bytes == 0 && tag != [0; 4] {
+            return Err(EINVAL);
+        }
+        let uma = match r.u32(68)? {
+            0 => G15PipeUmaSource::None,
+            1 => G15PipeUmaSource::SharedComputePool,
+            // Population filled from VALUEs 12/13 once all records are read.
+            2 => G15PipeUmaSource::RenderPool {
+                slot: u8::try_from(r.u32(72)?)?,
+                blocks: 0,
+                admitted_blocks: 0,
+            },
+            _ => return Err(EINVAL),
+        };
+        let firmware_state = match r.u32(76)? {
+            0 => G15FirmwareStateSlice::Vertex,
+            1 => G15FirmwareStateSlice::Fragment,
+            _ => return Err(EINVAL),
+        };
+        let profile = G15PipeProfile {
+            pipe: if pipe == 0 {
+                PipeType::Vertex
+            } else {
+                PipeType::Fragment
+            },
+            channel: G15PipeChannelInit::Explicit(G15PipeChannelStateImage {
+                owner_pid_50: r.u32(4)?,
+                byte_ac: u8::try_from(r.u32(8)?)?,
+                priority: G15ChannelPriorityWords {
+                    word_30: r.u32(16)?,
+                    word_34: r.u32(20)?,
+                    mask_38: r.u64(24)?,
+                    word_40: r.u32(32)?,
+                    word_44: r.u32(36)?,
+                    word_48: r.u32(40)?,
+                },
+                ring_size_50: r.u32(12)?,
+            }),
+            evctl_index: r.u32(44)?,
+            evctl_effective_record_count: r.u32(48)?,
+            sku_slot_count: r.u32(52)? as usize,
+            sku_slot_stride: r.u32(56)? as usize,
+            command_resource: if cmd_bytes == 0 {
+                None
+            } else {
+                Some((cmd_bytes, tag))
+            },
+            uma,
+            uma_priority_class: r.u32(72)?,
+            uma_pool_sizes: (r.u64(80)?, r.u64(88)?),
+            firmware_state,
+        };
+        if profile.uma.render_population().is_none() {
+            profile.validate()?;
+        }
+        self.pipes[pipe as usize] = Some(profile);
+        Ok(())
+    }
+
+    /// Whether the blob carries [`G15KPRF_FLAG_EVIDENCE_ONLY`].
+    pub(crate) fn evidence_only(&self) -> bool {
+        self.evidence_only
+    }
+
+    /// Whether the blob carries [`G15KPRF_FLAG_TRIAL`].
+    pub(crate) fn trial(&self) -> bool {
+        self.trial
+    }
+
+    /// The TRIAL_BINDING record of a TRIAL blob, for the submit log.
+    pub(crate) fn trial_binding(&self) -> Option<G15TrialBinding> {
+        self.trial_binding
+    }
+
+    /// Publication decision for a pass built from this profile. `dry_run`
+    /// and `trial_enabled` are the submit's single reads of
+    /// `g15_render_dry_run` and `g15_render_trial`, the same values it
+    /// passed to [`Self::render`]. A dry run and an evidence-only blob
+    /// never publish; a TRIAL blob publishes only with `trial_enabled`; a
+    /// replay blob always may.
+    pub(crate) fn may_publish(&self, dry_run: bool, trial_enabled: bool) -> bool {
+        !dry_run && !self.evidence_only && (!self.trial || trial_enabled)
+    }
+
+    /// The W3 render profile view. Its `validate()` is the I03 completeness
+    /// gate (`ready`, no unresolved items).
+    ///
+    /// `dry_run` and `trial_enabled` are the caller's single reads of
+    /// `g15_render_dry_run` and `g15_render_trial` for this submit.
+    ///
+    /// * Evidence-only blob: refused (EINVAL) unless `dry_run`. Then the
+    ///   view is [`G15ViewKind::EvidenceDryRun`]: the dry-run-only bypass of
+    ///   the W3 gate, and the caller must return before anything is
+    ///   published.
+    /// * TRIAL blob: refused (EINVAL) unless `dry_run` or `trial_enabled`.
+    ///   Then the view is [`G15ViewKind::Trial`] in either mode.
+    ///
+    /// Both bypassing views report `ready = true` and `validate()` skips
+    /// only their unresolved count. For a TRIAL view `ready` means
+    /// constructible under the reviewed trial policy its TRIAL_BINDING
+    /// names, not native readiness. Every structural check still applies.
+    pub(crate) fn render(
+        &self,
+        dry_run: bool,
+        trial_enabled: bool,
+    ) -> Result<G15RenderProfile<'_>> {
+        let kind = if self.evidence_only {
+            if !dry_run {
+                return Err(EINVAL);
+            }
+            G15ViewKind::EvidenceDryRun
+        } else if self.trial {
+            if !dry_run && !trial_enabled {
+                return Err(EINVAL);
+            }
+            G15ViewKind::Trial
+        } else {
+            G15ViewKind::Replay
+        };
+        let ready = self.ready || kind != G15ViewKind::Replay;
+        let sku = |i: usize, engine| -> Result<G15SkuTemplate<'_>> {
+            let t = self.templates[i].as_ref().ok_or(EINVAL)?;
+            Ok(G15SkuTemplate {
+                engine,
+                image: t.view(),
+                slot_align: t.slot_align,
+            })
+        };
+        Ok(G15RenderProfile {
+            ready,
+            unresolved: self.unresolved,
+            kind,
+            ta_regs: G15RegList {
+                engine: G15Engine::Ta,
+                entries: self.ta_regs.as_deref().ok_or(EINVAL)?,
+            },
+            frag_regs: G15RegList {
+                engine: G15Engine::Frag,
+                entries: self.frag_regs.as_deref().ok_or(EINVAL)?,
+            },
+            ta_sku: sku(0, G15Engine::Ta)?,
+            frag_sku: sku(1, G15Engine::Frag)?,
+            ta_cmd: self.templates[2].as_ref().map(Template::view),
+            frag_cmd: self.templates[3].as_ref().map(Template::view),
+        })
+    }
+
+    fn res(&self, id: usize) -> G15ResourceReq<'_> {
+        match self.resources[id - 1].as_ref() {
+            Some(rec) => rec.req(),
+            None => unresolved_req(),
+        }
+    }
+
+    fn value<T: TryFrom<u64>>(&self, id: usize) -> G15Profiled<T> {
+        match self.values[id - 1].map(T::try_from) {
+            Some(Ok(v)) => G15Profiled::Resolved(v),
+            _ => G15Profiled::Unresolved,
+        }
+    }
+
+    /// W6 per-queue resource profile.
+    pub(crate) fn queue_resources(&self) -> G15QueueResourceProfile<'_> {
+        G15QueueResourceProfile {
+            pm_pool: self.res(1),
+            pm_state_offset: self.value(1),
+            pm_state_bytes: self.value(2),
+            fw_page_list: self.res(2),
+            tvb_page_list: self.resources[RES_TVB_PAGE_LIST - 1].as_ref().map(ResourceRec::req),
+            pb_descriptor: match self.pb {
+                Some(pb) => G15Profiled::Resolved(pb),
+                None => G15Profiled::Unresolved,
+            },
+            tvb_blocks: match self.tvb_blocks.as_ref() {
+                Some((base, ids)) => G15Profiled::Resolved(G15TvbBlockProfile { base: *base, ids }),
+                None => G15Profiled::Unresolved,
+            },
+            pm_scene: match (
+                self.value::<u64>(VALUE_PM_SCENE_OFFSET),
+                self.value::<u64>(VALUE_PM_SCENE_STRIDE),
+                self.value::<u32>(VALUE_PM_SCENE_SLOTS),
+            ) {
+                (
+                    G15Profiled::Resolved(offset),
+                    G15Profiled::Resolved(stride),
+                    G15Profiled::Resolved(slots),
+                ) => G15Profiled::Resolved(crate::buffer::G15PmSceneGeometry {
+                    offset,
+                    stride,
+                    slots,
+                }),
+                _ => G15Profiled::Unresolved,
+            },
+        }
+    }
+
+    /// BufferInfo `+0x2c` max_blocks and `+0x24` page_list_size (VALUEs
+    /// 18/19), written when the native TVB blocks are installed.
+    pub(crate) fn buffer_info_limits(&self) -> Result<(u32, u32)> {
+        let v = |id: usize| -> Result<u32> {
+            u32::try_from(self.values[id - 1].ok_or(EINVAL)?).map_err(|_| EINVAL)
+        };
+        Ok((
+            v(VALUE_BUFFER_INFO_MAX_BLOCKS)?,
+            v(VALUE_BUFFER_INFO_PAGE_LIST_SIZE)?,
+        ))
+    }
+
+    /// W6 per-pass resource profile.
+    pub(crate) fn pass_resources(&self) -> G15PassResourceProfile<'_> {
+        G15PassResourceProfile {
+            ctxswitch: self.res(3),
+            ctxswitch_secondary_offset: self.value(3),
+            preempt: [self.res(4), self.res(5), self.res(6)],
+            tvb_tilemap: self.res(7),
+            tvb_heapmeta: self.res(8),
+            tvb_tpc: self.res(9),
+            render_target: self.res(10),
+            rt_bytes_per_row: self.value(4),
+            rt_height: self.value(5),
+            rt_native_va: self.value(14),
+        }
+    }
+
+    /// Integrator-owned GPU timing record (RESOURCE 11, sidecar name
+    /// `segment_resource_list`).
+    pub(crate) fn timing_record(&self) -> G15ResourceReq<'_> {
+        self.res(11)
+    }
+
+    /// W4 Barrier/InitBuffer native words (VALUE 6..10).
+    pub(crate) fn prelude(&self) -> Result<crate::queue::g15_render::G15PreludeProfile> {
+        let v = |id: usize| -> Result<u32> {
+            u32::try_from(self.values[id - 1].ok_or(EINVAL)?).map_err(|_| EINVAL)
+        };
+        Ok(crate::queue::g15_render::G15PreludeProfile {
+            barrier_external: v(6)?,
+            barrier_internal_type: v(7)?,
+            init_buffer_slot: v(8)?,
+            init_buffer_unk_c: v(9)?,
+            init_buffer_block_count: v(10)?,
+        })
+    }
+
+    /// Native submission tag (VALUE 11).
+    pub(crate) fn submission_tag(&self) -> Result<u64> {
+        self.values[10].ok_or(EINVAL)
+    }
+
+    /// Placement of a user section of `role` holding `len` bytes: the
+    /// profile's class, at least `align` aligned, at least `len` long.
+    pub(crate) fn placement(&self, role: Role, len: usize, align: u64) -> G15ResourceReq<'_> {
+        let Some(rec) = self.placements[role.index()].as_ref() else {
+            return unresolved_req();
+        };
+        let mut req = rec.req();
+        if let G15Profiled::Resolved(size) = req.size {
+            req.size = G15Profiled::Resolved(size.max(len));
+        }
+        if let G15Profiled::Resolved(a) = req.alignment {
+            req.alignment = G15Profiled::Resolved(a.max(align as usize));
+        }
+        // User bytes are copied by the caller after relocation.
+        req.init = G15Profiled::Resolved(G15ResourceInit::Zero);
+        req
+    }
+
+    /// Native VA windows (for example the eGartRange-1 window at
+    /// 0x10_0000_0000 that holds the VDM stream, TVB, TPC and ctxswitch).
+    pub(crate) fn windows(&self) -> &[G15VaWindowProfile] {
+        &self.windows
+    }
+
+    /// W5 constructor values for the TA (`Vertex`) or 3D (`Fragment`) pipe.
+    pub(crate) fn pipe(&self, pipe: PipeType) -> Result<G15PipeProfile> {
+        match pipe {
+            PipeType::Vertex => self.pipes[0].ok_or(EINVAL),
+            PipeType::Fragment => self.pipes[1].ok_or(EINVAL),
+            PipeType::Compute => Err(EINVAL),
+        }
+    }
+
+    /// Hash of the queue-scoped records.
+    pub(crate) fn queue_key(&self) -> u64 {
+        self.queue_key
+    }
+
+    /// I09 R3 (USER_REGS render): EINVAL unless every register
+    /// `g15_user_reg_overrides(fields)` writes is a native (N) entry of its
+    /// list, the condition the builder checks again when it applies them.
+    /// Lets the submit fail before anything is allocated. Not inlined: keeps
+    /// the override table out of the caller's frame.
+    #[inline(never)]
+    pub(crate) fn check_user_regs(&self, fields: &crate::render_input::G15UserRegFields) -> Result {
+        let base = g15_user_reg_overrides(fields);
+        let bg = fields.bg.map(|p| g15_user_tile_program_overrides(false, p));
+        let eot = fields.eot.map(|p| g15_user_tile_program_overrides(true, p));
+        let none: &[G15RegOverride] = &[];
+        for overrides in [&base[..], bg.as_ref().map_or(none, |o| &o[..]), eot.as_ref().map_or(none, |o| &o[..])] {
+        for (engine, entries) in [
+            (G15Engine::Ta, &self.ta_regs),
+            (G15Engine::Frag, &self.frag_regs),
+        ] {
+            let list = G15RegList {
+                engine,
+                entries: entries.as_deref().ok_or(EINVAL)?,
+            };
+            list.user_overrides(overrides, |_, _, _, _| {})?;
+        }
+        }
+        Ok(())
+    }
+
+    /// I09 R1 (HYBRID render): make TA register 0x1c880
+    /// (VDM_CTRL_STREAM_BASE) the `vdm_stream` relocation, written as the
+    /// stream's offset from `context_base` under a 32-bit mask, which is
+    /// what the native N value is (0x18000 from 0x10_0000_0000 in the
+    /// triangle). Only an N entry that holds such an offset is converted;
+    /// anything else is EINVAL. `queue_key` was hashed from the blob at
+    /// parse time and does not change.
+    pub(crate) fn relocate_ta_vdm_base(&mut self, context_base: u64) -> Result {
+        const VDM_CTRL_STREAM_BASE: u32 = 0x1c880;
+        let regs = self.ta_regs.as_mut().ok_or(EINVAL)?;
+        let entry = regs
+            .iter_mut()
+            .find(|e| e.reg == VDM_CTRL_STREAM_BASE)
+            .ok_or(EINVAL)?;
+        if entry.prov != G15Prov::Native || entry.native > u64::from(u32::MAX) {
+            return Err(EINVAL);
+        }
+        entry.prov = G15Prov::Reloc(G15Reloc {
+            target: G15RelocTarget::VdmStream,
+            addend: 0,
+            encoding: G15Encoding::Bitfield {
+                base: G15AddrBase::Literal(context_base),
+                address_shift: 0,
+                field_shift: 0,
+                mask: 0xffff_ffff,
+            },
+        });
+        Ok(())
+    }
+}
