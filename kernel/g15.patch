+    /// First half of phase 1, after both retirement guards are bound: check
+    /// the channel state, seed the selected event-control state and reserve
+    /// (but do not write) the SKU slot. Returns
+    /// `(channel_state_fwva, event_control_fwva, sku)`.
+    pub(super) fn select_event_and_sku(
+        &mut self,
+        event_index: usize,
+        state_sequence: u32,
+        sku_index: usize,
+    ) -> Result<(u64, u64, G15PipeSkuSlot)> {
+        let channel_state_fwva = self.channel_resources.channel_state_fwva();
+        if channel_state_fwva == 0 {
+            return Err(EIO);
+        }
+
+        self.event_control
+            .seed_selected_after_event_finish(event_index, state_sequence)?;
+        let event_control_fwva = self.event_control.control_fwva(event_index)?;
+        let sku = self.sku.reserve_retired_slot(sku_index)?;
+        if event_control_fwva == 0 || sku.fwva() == 0 {
+            return Err(EIO);
+        }
+        Ok((channel_state_fwva, event_control_fwva, sku))
+    }
+
+    /// Second half of phase 1: take a UMA reference (activating the FList
+    /// epoch, or leaving it to the publication: `epoch`) and reserve the
+    /// HWMetrics record. Releases the UMA reference on every error. Returns
+    /// `(page_pool_state_fwva, hwmetrics_fwva, hardware_buffer_id)`.
+    /// `container_slot` is the client-container slot of `uma_pool`, not the
+    /// pool-state priority (`buffer::G15_J615_UMA_POOL_STATE_PRIORITY`).
+    pub(super) fn lease_uma_and_hwmetrics(
+        &mut self,
+        uma_pool: &mut buffer::G15SharedComputeUmaPoolOwner,
+        container_slot: u32,
+        epoch: buffer::G15UmaEpochTiming,
+    ) -> Result<(u64, u64, u32)> {
+        crate::debug::g15_stage(format_args!(
+            "lease {:?}: UMA reference (slot {}, first-epoch population) next",
+            self.profile.pipe, container_slot
+        ))?;
+        let lease = uma_pool.prepare_native_write1337_reference(container_slot, epoch)?;
+        if let Err(err) = crate::debug::g15_stage(format_args!(
+            "lease {:?}: UMA reference taken (HW ID {}); pool state populated",
+            self.profile.pipe, lease.hardware_buffer_id
+        )) {
+            let _ = uma_pool.complete_reference(lease.hardware_buffer_id);
+            return Err(err);
+        }
+        let page_pool_state_fwva = match uma_pool.initialized_page_pool_state_fwva() {
+            Ok(fwva) => fwva,
+            Err(err) => {
+                let _ = uma_pool.complete_reference(lease.hardware_buffer_id);
+                return Err(err);
+            }
+        };
+        let hwmetrics_fwva = match self.hwmetrics.take_record_fwva() {
+            Ok(fwva) => fwva,
+            Err(err) => {
+                let _ = uma_pool.complete_reference(lease.hardware_buffer_id);
+                return Err(err);
+            }
+        };
+        if page_pool_state_fwva == 0 || hwmetrics_fwva == 0 {
+            let _ = uma_pool.complete_reference(lease.hardware_buffer_id);
+            return Err(EIO);
+        }
+        Ok((page_pool_state_fwva, hwmetrics_fwva, lease.hardware_buffer_id))
+    }
+
+    /// Phase-1 HWMetrics reservation for a channel without a UMA lease.
+    fn take_hwmetrics_fwva(&mut self) -> Result<u64> {
+        let fwva = self.hwmetrics.take_record_fwva()?;
+        if fwva == 0 {
+            return Err(EIO);
+        }
+        Ok(fwva)
+    }
+
+    fn evctl_stamp_fwva(&self, event_index: usize) -> Result<u64> {
+        self.event_control.stamp_fwva(event_index)
+    }
+
+    /// Phase 2: write a serialized stream into the reserved slot.
+    pub(super) fn write_sku(
+        &mut self,
+        reserved: G15PipeSkuSlot,
+        stream: &[u8],
+    ) -> Result<G15PipeSkuWritten> {
+        self.sku.write_reserved_slot(reserved, stream)
+    }
+}
