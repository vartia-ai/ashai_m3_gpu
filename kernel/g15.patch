+/// Per-pass GPU timing record (TA `+0x8b0`, 3D `+0xbf8`; W8 first called
+/// it the segment resource list, and the relocation target keeps that
+/// name). Capture 5 (native 0xfffffc2000024908): zero before publication;
+/// the firmware writes qword 0 = GPU start (Metal start x 24 MHz + 1) and
+/// qword 1 (`+0x08`, also 3D `+0xc00`) = GPU end. Size, alignment and
+/// class come from profile RESOURCE 11; at least 16 bytes, always zeroed.
+/// Owned by the pass until both commands retired.
+pub(crate) struct G15RenderTimingRecord {
+    res: G15Resource,
+}
+
+impl G15RenderTimingRecord {
+    /// Bytes the firmware writes: start and end qwords.
+    pub(crate) const BYTES: usize = 16;
+    /// Offset of the end qword (3D `+0xc00` points here).
+    pub(crate) const END_OFFSET: u64 = 8;
+
+    /// Allocate from profile RESOURCE 11. A profile that initializes the
+    /// record to anything but zero is rejected.
+    pub(crate) fn new(heaps: &G15RenderHeaps<'_>, req: &G15ResourceReq<'_>) -> Result<Self> {
+        if let G15ResourceInit::Bytes(b) = req.init.need("timing_record")? {
+            if b.iter().any(|&x| x != 0) {
+                return Err(reject("timing_record.init (not zero)"));
+            }
+        }
+        let req = G15ResourceReq {
+            init: G15Profiled::Resolved(G15ResourceInit::Zero),
+            ..*req
+        };
+        Ok(Self {
+            res: heaps.alloc(&req, "timing_record", b"TIME", Self::BYTES)?,
+        })
+    }
+
+    /// GPUVA of the start qword (TA `+0x8b0`, 3D `+0xbf8`).
+    pub(crate) fn gpu_va(&self) -> u64 {
+        self.res.gpu_va()
+    }
+
+    /// GPUVA of the end qword (3D `+0xc00`).
+    pub(crate) fn end_va(&self) -> u64 {
+        self.res.gpu_va() + Self::END_OFFSET
+    }
+
+    /// `(GPU start, GPU end)` as the firmware left them; 0 means not written.
+    /// Call only after both commands retired.
+    pub(crate) fn read(&self) -> (u64, u64) {
+        // A heap allocation (`G15RenderHeaps::alloc`): always contiguous.
+        let Ok(b) = self.res.as_slice() else {
+            return (0, 0);
+        };
+        let qword = |off: usize| -> u64 {
+            let mut v = 0u64;
+            for i in (0..8).rev() {
+                // SAFETY: `off + 8 <= BYTES <= len` (checked at allocation);
+                // a volatile byte read of CPU-mapped memory the firmware
+                // wrote, after the commands retired.
+                v = (v << 8) | u64::from(unsafe { core::ptr::read_volatile(b.as_ptr().add(off + i)) });
+            }
+            v
+        };
+        (qword(0), qword(Self::END_OFFSET as usize))
+    }
+}
