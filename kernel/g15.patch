+impl<T> core::ops::Deref for G15Retainable<T> {
+    type Target = T;
+    fn deref(&self) -> &T {
+        &self.val
+    }
+}
+
+impl<T> core::ops::DerefMut for G15Retainable<T> {
+    fn deref_mut(&mut self) -> &mut T {
+        &mut self.val
+    }
+}
