+        // anything is allocated. The submit re-checks with its own read.
+        if profile.evidence_only() && *module_parameters::g15_render_dry_run.value() == 0 {
+            return Err(EINVAL);
+        }
+        // Likewise a TRIAL blob outside a dry run without the trial switch.
+        if profile.trial()
+            && *module_parameters::g15_render_dry_run.value() == 0
+            && *module_parameters::g15_render_trial.value() == 0
