+// I04 W8h: G15 render submit stage breadcrumbs.
+//
+// One running stage counter per render submit, reset when
+// `g15_prepare_user_render` starts and closed when the submit ioctl returns
+// (`G15StageScope`). Every checkpoint takes the next number; with
+// `g15_render_trace` it prints "g15 stage N: <name>" at KERN_EMERG so the
+// console gets it synchronously. The first checkpoint whose number is at
+// least `g15_render_stop_stage` returns ECANCELED, which the caller propagates
+// through its normal error path, so the rollback runs too. Teardown
+// breadcrumbs (`g15_trace`, `G15StageMark`) share the counter but never stop.
+
+static G15_STAGE: AtomicU32 = AtomicU32::new(0);
+static G15_STAGE_ACTIVE: AtomicBool = AtomicBool::new(false);
+// W8j: the running sequence belongs to a Compute submit and stops at
+// `g15_compute_stop_stage` instead of `g15_render_stop_stage`.
+static G15_STAGE_COMPUTE: AtomicBool = AtomicBool::new(false);
+
+/// `g15_job_timing>=2`: CLOCK_MONOTONIC ns of the previous stage breadcrumb
+/// (reset at each sequence start).
+static G15_STAGE_T: AtomicU64 = AtomicU64::new(0);
+/// `g15_job_timing=2`: per stage ordinal, the summed ns since the previous
+/// breadcrumb and the count (no logging; `g15_accounting` prints them).
+pub(crate) const G15_STAGE_SLOTS: usize = 320;
+pub(crate) static G15_STAGE_SUM: [AtomicU64; G15_STAGE_SLOTS] =
+    [const { AtomicU64::new(0) }; G15_STAGE_SLOTS];
+pub(crate) static G15_STAGE_CNT: [AtomicU64; G15_STAGE_SLOTS] =
+    [const { AtomicU64::new(0) }; G15_STAGE_SLOTS];
+
+fn g15_stage_emit(name: fmt::Arguments<'_>, can_stop: bool) -> Result {
+    if !G15_STAGE_ACTIVE.load(Ordering::Acquire) {
+        return Ok(());
+    }
+    let n = G15_STAGE.fetch_add(1, Ordering::AcqRel) + 1;
+    let timing = *module_parameters::g15_job_timing.value();
+    if timing >= 2 {
+        // SAFETY: plain time read.
+        let now = unsafe { kernel::bindings::ktime_get() } as u64;
+        let d = now.wrapping_sub(G15_STAGE_T.swap(now, Ordering::Relaxed));
+        if timing == 3 {
+            pr_info!("G15S {} +{}ns {}\n", n, d, name);
+        } else if (n as usize) < G15_STAGE_SLOTS {
+            G15_STAGE_SUM[n as usize].fetch_add(d, Ordering::Relaxed);
+            G15_STAGE_CNT[n as usize].fetch_add(1, Ordering::Relaxed);
+        }
+    }
+    // W8i: stop at the first stop-capable checkpoint numbered N or later. A
+    // trace-only breadcrumb (q22 publish, teardown) can take number N; with
+    // an exact match the submit then ran on to the end.
+    let stop_at = if G15_STAGE_COMPUTE.load(Ordering::Acquire) {
+        *module_parameters::g15_compute_stop_stage.value()
+    } else {
+        *module_parameters::g15_render_stop_stage.value()
+    };
+    let stop = can_stop && stop_at != 0 && n >= stop_at;
+    if stop || *module_parameters::g15_render_trace.value() != 0 {
+        // W8n: kernel stack left below this breadcrumb (16 KiB stacks).
+        let marker = 0u8;
+        let sp = core::ptr::addr_of!(marker) as usize;
+        // SAFETY: `current` is valid for the running task, and `stack` is the
+        // lowest address of its kernel stack.
+        let base = unsafe { (*kernel::task::Task::current_raw()).stack } as usize;
+        pr_emerg!(
+            "g15 stage {}{}: {}{} [stack left {}]\n",
+            n,
+            if can_stop { "" } else { " [trace]" },
+            name,
+            if stop { " -> STOP (ECANCELED)" } else { "" },
+            sp.wrapping_sub(base)
+        );
+        // W8k: the breadcrumb is only useful if it leaves the machine before
+        // a hard reset; busy-wait (callers may hold spinlocks) in 1 ms steps.
+        for _ in 0..*module_parameters::g15_stage_delay_ms.value() {
+            kernel::time::delay::udelay(kernel::time::Delta::from_millis(1));
+        }
+    }
+    if stop {
+        return Err(ECANCELED);
+    }
+    Ok(())
+}
+
+/// Start a render submit's stage sequence at 1.
+pub(crate) fn g15_stage_begin() {
+    // SAFETY: plain time read.
+    G15_STAGE_T.store(unsafe { kernel::bindings::ktime_get() } as u64, Ordering::Relaxed);
+    G15_STAGE.store(0, Ordering::Release);
+    G15_STAGE_COMPUTE.store(false, Ordering::Release);
+    G15_STAGE_ACTIVE.store(true, Ordering::Release);
+}
+
+/// W8j control experiment: with `g15_compute_stop_stage` set, start a stage
+/// sequence at 1 for a Compute submit, so the shared channel/pool constructor
+/// checkpoints become stop-capable against that parameter. Returns whether a
+/// sequence was started; with the parameter 0 nothing changes.
+pub(crate) fn g15_compute_stage_begin() -> bool {
+    let stop_at = *module_parameters::g15_compute_stop_stage.value();
+    if stop_at == 0 {
+        return false;
+    }
+    G15_STAGE.store(0, Ordering::Release);
+    G15_STAGE_COMPUTE.store(true, Ordering::Release);
+    G15_STAGE_ACTIVE.store(true, Ordering::Release);
+    pr_emerg!("g15 compute stage sequence begins (stop at {})\n", stop_at);
+    true
+}
+
+/// W8j: close the sequence early (a Compute submit past its channel
+/// construction), so later shared checkpoints neither print nor stop.
+pub(crate) fn g15_stage_end() {
+    G15_STAGE_ACTIVE.store(false, Ordering::Release);
+}
+
+/// Checkpoint: breadcrumb, and ECANCELED if this is the stop stage.
+pub(crate) fn g15_stage(name: fmt::Arguments<'_>) -> Result {
+    g15_stage_emit(name, true)
+}
+
+/// Whether the per-render G15 diagnostics (completion, UMA, pipe and q22
+/// lines) are printed: only with `g15_render_trace`, so a normal render
+/// logs nothing.
+pub(crate) fn g15_verbose() -> bool {
+    *module_parameters::g15_render_trace.value() != 0
+}
+
+/// Teardown/diagnostic breadcrumb: numbered like a checkpoint, never stops.
+pub(crate) fn g15_trace(name: fmt::Arguments<'_>) {
+    let _ = g15_stage_emit(name, false);
+}
+
+/// Prints `g15_trace` when dropped. Declare it right before a local so the
+/// breadcrumb follows that local's drop on the error path.
+pub(crate) struct G15StageMark(pub(crate) &'static str);
+
+impl Drop for G15StageMark {
+    // Not inlined: the submit path drops many marks; one copy of the
+    // breadcrumb's formatting state instead of one per mark.
+    #[inline(never)]
+    fn drop(&mut self) {
+        g15_trace(format_args!("teardown: {}", self.0));
+    }
+}
+
+/// Closes the stage sequence when the submit ioctl's locals are gone.
+pub(crate) struct G15StageScope;
+
+impl Drop for G15StageScope {
+    fn drop(&mut self) {
+        g15_trace(format_args!("submit ioctl locals dropped; sequence closed"));
+        G15_STAGE_ACTIVE.store(false, Ordering::Release);
+    }
+}
