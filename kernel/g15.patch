+/// A render channel's pool reference. Dropping the last reference to a
+/// pool retires it; before the retired pool's memory goes, the pool's UMA
+/// descriptor-table entry (written by `publish_uma_descriptor`) is zeroed.
+///
+/// This follows the PB descriptor rule: a channel only drops once its
+/// commands retired and its queue was torn down with certain firmware
+/// state; with uncertain state the queue forgets the channels, so the pool
+/// and its entry stay. A failed clear keeps the pool (leaked) as well.
+struct G15RenderPoolRef {
+    pool: core::mem::ManuallyDrop<buffer::G15ClientUmaComputeChannelRef>,
+    dev: AsahiDevRef,
+    /// Writes a zero UMA descriptor-table record for an ID
+    /// (`GpuManager::g15_set_uma_descriptor`).
+    clear: fn(&AsahiDevRef, u32) -> Result,
+}
+
+impl core::ops::Deref for G15RenderPoolRef {
+    type Target = buffer::G15ClientUmaComputeChannelRef;
+
+    fn deref(&self) -> &Self::Target {
+        &self.pool
+    }
+}
+
+impl Drop for G15RenderPoolRef {
+    fn drop(&mut self) {
+        // SAFETY: `pool` is taken exactly once, here, and never used again.
+        let pool = unsafe { core::mem::ManuallyDrop::take(&mut self.pool) };
+        let Some(mut retired) = pool.release() else {
+            return;
+        };
+        let (dev, clear) = (&self.dev, self.clear);
+        match retired.clear_uma_descriptor(|id| clear(dev, id)) {
+            Ok(_) => core::mem::drop(retired),
+            Err(err) => {
+                pr_err!(
+                    "G15 render UMA pool {}: descriptor clear failed: {:?}; retaining the pool\n",
+                    retired.pool_id(),
+                    err
+                );
+                core::mem::forget(retired);
+            }
+        }
+    }
+}
