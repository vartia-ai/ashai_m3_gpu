+/// How the selected channel-state element is initialized.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[allow(dead_code)]
+pub(crate) enum G15PipeChannelInit {
+    /// The exact CL constructor, `initialize_j615_cl`, with process identity
+    /// 0x120, the non-foreground priority/QoS pair and the queue's transport
+    /// priority. Valid only for Compute.
+    J615Cl,
+    /// Every channel-state constant given explicitly (TA/3D).
+    Explicit(buffer::G15PipeChannelStateImage),
+}
+
+/// Per-pipe constructor values for one G15 channel.
+///
+/// For TA/3D every field below marked `TODO(I03 capture)` must come from the
+/// native render capture. Do not fill them from the Compute values.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15PipeProfile {
+    pub(crate) pipe: PipeType,
+    /// Channel-state image: process identity (+0x50), priority words
+    /// (+0x30..+0x4b), byte +0xac and ring size (uncached +0x50).
+    // TODO(I03 capture): TA/3D values for all four.
+    pub(crate) channel: G15PipeChannelInit,
+    /// AGXChannel +0x38, written to JobMeta `evctl_index`.
+    // TODO(I03 capture): TA/3D value.
+    pub(crate) evctl_index: u32,
+    /// Event-control `+0x10` written when a state is reseeded.
+    // TODO(I03 capture): TA/3D value.
+    pub(crate) evctl_effective_record_count: u32,
+    /// SKU encoder slot count.
+    // TODO(I03 capture): TA/3D value.
+    pub(crate) sku_slot_count: usize,
+    /// SKU slot stride; the largest stream the slot can hold. G16 uses 0x300
+    /// for TA and 0x380 for 3D.
+    // TODO(I03 capture): TA/3D value.
+    pub(crate) sku_slot_stride: usize,
+    /// Channel-command resource in range-5 uncached memory: size in bytes and
+    /// allocation tag. `None` if the channel has none.
+    // TODO(I03 capture): whether TA/3D have one, and its size.
+    pub(crate) command_resource: Option<(usize, [u8; 4])>,
+    // TODO(I03 capture): whether TA and 3D take a UMA lease, and whether it
+    // is the Compute pool, one shared render pool or one pool each.
+    pub(crate) uma: G15PipeUmaSource,
+    /// Priority class passed to the UMA pool. Must be the normal Compute
+    /// class when `uma` is `SharedComputePool`.
+    pub(crate) uma_priority_class: u32,
+    /// Command UMA min/ideal pool sizes (Compute `+0x847/+0x84f`).
+    // TODO(I03 capture): TA `+0x8d6..` and 3D `+0xc1e..` values.
+    pub(crate) uma_pool_sizes: (u64, u64),
+    // TODO(I03 capture): confirm TA -> Vertex and 3D -> Fragment.
+    pub(crate) firmware_state: G15FirmwareStateSlice,
+}
+
+impl G15PipeProfile {
+    /// The exact constructor values of the R47 Compute channel.
+    pub(crate) const J615_COMPUTE: Self = Self {
+        pipe: PipeType::Compute,
+        channel: G15PipeChannelInit::J615Cl,
+        evctl_index: fw::workqueue::G15_J615_FIRST_CL_EVCTL_INDEX,
+        evctl_effective_record_count: fw::event::G15_EVENT_CONTROL_J615_EFFECTIVE_RECORD_COUNT,
+        sku_slot_count: fw::compute::G15_SKU_SLOT_COUNT,
+        sku_slot_stride: fw::compute::G15_SKU_SLOT_STRIDE,
+        command_resource: Some((fw::compute::G15_J615_CL_COMMAND_RESOURCE_BYTES, *b"CLCR")),
+        uma: G15PipeUmaSource::SharedComputePool,
+        uma_priority_class: buffer::G15_J615_NORMAL_COMPUTE_POOL_PRIORITY_CLASS,
+        uma_pool_sizes: (
+            super::G15_NATIVE_UMA_MIN_POOL_SIZE,
+            super::G15_NATIVE_UMA_IDEAL_POOL_SIZE,
+        ),
+        firmware_state: G15FirmwareStateSlice::Compute,
+    };
+
+    /// Reject inconsistent or unimplemented profiles before any allocation.
+    pub(crate) fn validate(&self) -> Result {
+        let render = match self.pipe {
+            PipeType::Compute => false,
+            PipeType::Vertex | PipeType::Fragment => true,
+        };
+        match self.channel {
+            G15PipeChannelInit::J615Cl if render => return Err(EINVAL),
+            G15PipeChannelInit::Explicit(_) if !render => return Err(EINVAL),
+            _ => {}
+        }
+        if self.sku_slot_count == 0
+            || self.sku_slot_count > u16::MAX as usize
+            || self.sku_slot_stride == 0
+            || self.sku_slot_stride % 0x40 != 0
+        {
+            return Err(EINVAL);
+        }
+        self.sku_slot_count
+            .checked_mul(self.sku_slot_stride)
+            .ok_or(EOVERFLOW)?;
+        if let Some((bytes, _tag)) = self.command_resource {
+            if bytes == 0 {
+                return Err(EINVAL);
+            }
+        }
+        match self.uma {
+            G15PipeUmaSource::None => {}
+            G15PipeUmaSource::SharedComputePool => {
+                if self.uma_priority_class != buffer::G15_J615_NORMAL_COMPUTE_POOL_PRIORITY_CLASS {
+                    return Err(EINVAL);
+                }
+            }
+            G15PipeUmaSource::RenderPool { slot, .. } => {
+                if !render || self.uma_priority_class > 1 || u32::from(slot) != self.uma_priority_class {
+                    return Err(EINVAL);
+                }
+                self.uma.render_population().ok_or(EINVAL)?.validate()?;
+            }
+        }
+        Ok(())
+    }
+}
