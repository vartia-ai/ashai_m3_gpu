+        && G15_RENDER_CONTEXT.end <= mmu::IOVA_USER_USABLE_RANGE.end
+        && G15_RENDER_CONTEXT.end - G15_RENDER_CONTEXT.start <= 1 << 32
+);
+use crate::gpu::GpuManager as _;
+use crate::workqueue::WorkError;
+use crate::{fw, gpu, mmu, module_parameters};
+use crate::debug::{g15_stage, g15_stage_begin, G15StageMark};
+
+static G15_TVB_PA_PROBE_JOBS: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) struct G15TvbPaProbe {
+    tpc: super::g15_relink::G15RelinkView,
+    pages: KVec<(u64, u64, u64)>,
+}
+
+impl G15TvbPaProbe {
+    fn log(&self, dev: &AsahiDevRef, job_id: u64) {
+        super::g15_resources::g15_invalidate_from_poc(self.tpc.cpu, self.tpc.len);
+        let mut active = 0usize;
+        let mut logged = 0usize;
+        for entry_index in 0..self.tpc.len / 8 {
+            let entry = self.tpc.cpu + entry_index * 8;
+            // SAFETY: `tpc` is retained by the render resources, and each
+            // entry is two naturally aligned u32 words.
+            let head = unsafe { (entry as *const u32).read_volatile() };
+            // SAFETY: the second word is within the same retained entry.
+            let tail = unsafe { ((entry + 4) as *const u32).read_volatile() };
+            if head == 0 || tail >> 28 != 0xb {
+                continue;
+            }
+            active += 1;
+            if logged == 16 {
+                continue;
+            }
+            logged += 1;
+            let gpuva = super::g15_relink::G15_TVB_BASE + u64::from(head) * 0x80;
+            let page = gpuva & !(mmu::UAT_PGMSK as u64);
+            match self.pages.iter().find(|&&(p, _, _)| p == page) {
+                Some(&(_, pte, phys)) => dev_info!(
+                    dev.as_ref(),
+                    "G15 TVB PA probe job={} phase=finish entry={} head={:#x} tail={:#x} gpuva={:#x} page={:#x} pte={:#018x} phys={:#x} color={:#x}\n",
+                    job_id,
+                    entry_index,
+                    head,
+                    tail,
+                    gpuva,
+                    page,
+                    pte,
+                    phys,
+                    (phys >> mmu::UAT_PGBIT) & 0xfff,
+                ),
+                None => dev_info!(
+                    dev.as_ref(),
+                    "G15 TVB PA probe job={} phase=finish entry={} head={:#x} tail={:#x} gpuva={:#x} page={:#x} prewalk-miss\n",
+                    job_id,
+                    entry_index,
+                    head,
+                    tail,
+                    gpuva,
+                    page,
+                ),
+            }
+        }
+        dev_info!(
+            dev.as_ref(),
+            "G15 TVB PA probe job={} phase=finish active={} logged={} cap=16\n",
+            job_id,
+            active,
+            logged,
+        );
+    }
+}
+
+/// THE publication-order decision point for one TA/3D pair.
+///
+/// Both orders put the same commands in the same rings: [Barrier, Fragment]
+/// on the 3D channel and [InitBuffer, Vertex] on the TA channel. The Barrier
+/// waits for the TA stamp, so it carries the TA->3D dependency either way;
+/// the order only decides which channel firmware sees first. The submit
+/// takes the per-pipe leases (fence and UMA references) and writes the UMA
+/// descriptor in the same order.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[allow(dead_code)]
+pub(super) enum G15RenderPublishOrder {
+    /// Native (capture-triangle-1): 3D channel first (Barrier index 0,
+    /// Fragment index 1), then the TA channel (InitBuffer index 2, Vertex
+    /// index 3).
+    FragmentFirst,
+    /// TA channel first, then the 3D channel.
+    TaFirst,
+}
+
+/// The order `QueueJob::run` publishes in. See [`G15RenderPublishOrder`].
+pub(super) const G15_RENDER_PUBLISH_ORDER: G15RenderPublishOrder =
+    G15RenderPublishOrder::FragmentFirst;
+
+/// Most commands one render WorkQueue job holds (prelude + command).
+pub(super) const G15_RENDER_COMMANDS_PER_PIPE: usize = 2;
+
+/// Per-VM native VA windows (W6 `G15RenderVaWindow`), for example the
+/// eGartRange-1 window at 0x10_0000_0000 that natively holds the VDM stream,
+/// TVB, TPC, ctxswitch and PM scene, or a range-5 window for the PM backing.
+///
+/// One instance per client VM, shared by all of its queues, so a window is
+/// created at most once per VM. A window must not overlap the VM's kernel
+/// range, any other window, or the fixed range-5 heaps. G15 VM_BIND is still
+/// refused (`gem_bind_object` returns ENODEV), so no user mapping can enter a
+/// window; lifting that gate must also check these windows.
+/// F2 (`g15_persist_fixed`): the R9 built-in fixed sections of one VM,
+/// reserved and cleared once, then kept for every later render. macOS never
+/// changes these bytes across renders (native capture), and Linux renders
+/// leave them zero; re-reserving and clearing ~7 MiB per render cost most of
+/// the kernel build time. Jobs hold an `Arc` so the ranges outlive any job.
+pub(crate) struct G15PersistentFixed {
+    /// (section index, GPU VA, length), in section order.
+    pub(crate) vas: KVec<(usize, u64, usize)>,
+    /// Locked only to clear them (`g15_persist_fixed=2`) or audit them.
+    _res: Pin<KBox<Mutex<KVec<G15Resource>>>>,
+}
+
+impl G15PersistentFixed {
+    /// F2 (`g15_persist_fixed=2`): clear every section with ordinary stores.
+    /// Under the device slot only (no job reads them meanwhile).
+    pub(crate) fn clear(&self) -> Result {
+        let mask = *module_parameters::g15_persist_clear_mask.value();
+        for (&(i, _, _), r) in self.vas.iter().zip(self._res.lock().iter_mut()) {
+            if i >= 32 || mask & (1 << i) != 0 {
+                r.zero_with_stores()?;
+            }
+        }
+        Ok(())
+    }
+
+    /// F2 audit: (section index, first nonzero offset, nonzero bytes) of
+    /// every section that is no longer all zero.
+    pub(crate) fn dirty(&self) -> KVec<(usize, usize, usize, usize)> {
+        let mut out = KVec::new();
+        let res = self._res.lock();
+        for (&(i, _, _), r) in self.vas.iter().zip(res.iter()) {
+            if let (Some((first, last)), count) = r.nonzero() {
+                let _ = out.push((i, first, last, count), GFP_KERNEL);
+            }
+        }
+        out
+    }
+
+    /// Whether `user`'s fixed sections are exactly these (index, native VA,
+    /// length); a different zeroed layout must not reuse them.
+    fn matches(&self, user: &G15UserRender) -> bool {
+        let mut fixed = user.sections().iter().enumerate().filter_map(|(i, s)| s.fixed_va().map(|va| (i, va, s.len())));
+        self.vas.iter().all(|&(i, va, len)| fixed.next() == Some((i, va, len))) && fixed.next().is_none()
+    }
+}
+
+pub(crate) struct G15VmRenderWindows {
+    /// F2: this VM's persistent R9 fixed sections (`g15_persist_fixed`).
+    persistent_fixed: Option<Arc<G15PersistentFixed>>,
+    kernel_range: Range<u64>,
+    windows: KVec<G15RenderVaWindow>,
+    profiles: KVec<G15VaWindowProfile>,
+    /// Backing heap of this VM's render UMA pool
+    /// (`mmu::G15_GART_RANGE5_RENDER_UMA`), created on first use.
+    render_uma: Option<Arc<Mutex<crate::alloc::DefaultAllocator>>>,
+}
+
+impl G15VmRenderWindows {
+    pub(crate) fn new(kernel_range: Range<u64>) -> Self {
+        Self {
+            persistent_fixed: None,
+            kernel_range,
+            windows: KVec::new(),
+            profiles: KVec::new(),
+            render_uma: None,
+        }
+    }
+
+    /// Release what the VM's earlier renders freed in its windows and render
+    /// UMA heap. Without this, a VM's first render keeps its windows full and
+    /// the next one fails with ENOSPC. Call with the device's job slot held.
+    pub(crate) fn collect_garbage(&self) {
+        for w in self.windows.iter() {
+            w.collect_garbage();
+        }
+        if let Some(heap) = self.render_uma.as_ref() {
+            super::g15_resources::g15_collect_garbage(heap);
+        }
+    }
+
+    /// I05: whether `range` stays clear of every kernel-owned VA of this VM
+    /// that lies in the user range (the kernel range and the render windows),
+    /// so a PTE found there was made by VM_BIND.
+    pub(crate) fn outside_kernel_vas(&self, range: &Range<u64>) -> bool {
+        let overlaps = |r: &Range<u64>| range.start < r.end && r.start < range.end;
+        !overlaps(&self.kernel_range) && !self.profiles.iter().any(|p| overlaps(&(p.start..p.end)))
+    }
+
+    /// The VM's render UMA pool backing heap, created on first use with the
+    /// Compute pool backing's class (PROT_GPU_SHARED_RW, like the "prime
+    /// PPL308" arena; native backing PTEs are AP=2 uncached, 0xc8b).
+    pub(crate) fn render_uma_heap(
+        &mut self,
+        dev: &AsahiDevice,
+        vm: &mmu::Vm,
+    ) -> Result<Arc<Mutex<crate::alloc::DefaultAllocator>>> {
+        if let Some(heap) = self.render_uma.as_ref() {
+            return Ok(heap.clone());
+        }
+        let heap = Arc::pin_init(
+            new_mutex!(crate::alloc::DefaultAllocator::new(
+                dev,
+                vm,
+                mmu::G15_GART_RANGE5_RENDER_UMA,
+                crate::buffer::PAGE_SIZE,
+                mmu::PROT_GPU_SHARED_RW,
+                64 * 1024,
+                true,
+                fmt!("G15 render UMA pool"),
+                false,
+            )?),
+            GFP_KERNEL,
+        )?;
+        self.render_uma = Some(heap.clone());
+        Ok(heap)
+    }
+
+    fn ensure(&mut self, dev: &AsahiDevice, vm: &mmu::Vm, want: &[G15VaWindowProfile]) -> Result {
+        for w in want {
+            let same = |p: &G15VaWindowProfile| {
+                p.start == w.start && p.end == w.end && p.class == w.class
+            };
+            if self.profiles.iter().any(same) {
+                continue;
+            }
+            let overlaps = |r: &Range<u64>| w.start < r.end && r.start < w.end;
+            if self.profiles.iter().any(|p| overlaps(&(p.start..p.end))) {
+                return Err(EBUSY);
+            }
+            let fixed_range5 =
+                mmu::G15_GART_RANGE5_CODE.start..mmu::G15_GART_RANGE5_RENDER_UMA.end;
+            let in_user = w.start >= mmu::IOVA_USER_BASE && w.end <= mmu::IOVA_UNK_PAGE;
+            let in_range5 =
+                w.start >= mmu::G15_GART_RANGE5.start && w.end <= mmu::G15_GART_RANGE5.end;
+            if !(in_user || in_range5) || overlaps(&self.kernel_range) || overlaps(&fixed_range5) {
+                pr_err!(
+                    "G15 render: VA window {:#x}..{:#x} collides with a fixed VM range\n",
+                    w.start,
+                    w.end
+                );
+                return Err(EINVAL);
+            }
+            let window = G15RenderVaWindow::new(dev, vm, G15Profiled::Resolved(*w))?;
+            self.windows.reserve(1, GFP_KERNEL)?;
+            self.profiles.push(*w, GFP_KERNEL)?;
+            self.windows.push(window, GFP_KERNEL)?;
+        }
+        Ok(())
+    }
+}
