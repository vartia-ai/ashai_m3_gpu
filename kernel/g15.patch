+/// DC CVAC (clean only) over [start, start + len), then DSB SY.
+pub(crate) fn g15_clean_only_to_poc(start: usize, len: usize) {
+    let ctr: u64;
+    // SAFETY: CTR_EL0 is readable at EL1.
+    unsafe { core::arch::asm!("mrs {0}, ctr_el0", out(reg) ctr) };
+    let line = 4usize << ((ctr >> 16) & 0xf);
+    let mut a = start & !(line - 1);
+    let end = start + len;
+    while a < end {
+        // SAFETY: cache maintenance on a mapped kernel address.
+        unsafe { core::arch::asm!("dc cvac, {0}", in(reg) a, options(nostack, preserves_flags)) };
+        a += line;
+    }
+    // SAFETY: barrier only.
+    unsafe { core::arch::asm!("dsb sy", options(nostack, preserves_flags)) };
+}
+
+pub(crate) fn g15_clean_to_poc(start: usize, len: usize) {
+    let ctr: u64;
+    // SAFETY: CTR_EL0 is readable at EL1.
+    unsafe { core::arch::asm!("mrs {0}, ctr_el0", out(reg) ctr) };
+    let line = 4usize << ((ctr >> 16) & 0xf);
+    let mut a = start & !(line - 1);
+    let end = start + len;
+    while a < end {
+        // SAFETY: cache maintenance on a mapped kernel address.
+        unsafe { core::arch::asm!("dc civac, {0}", in(reg) a, options(nostack, preserves_flags)) };
+        a += line;
+    }
+    // SAFETY: barrier only.
+    unsafe { core::arch::asm!("dsb sy", options(nostack, preserves_flags)) };
+}
+
+/// Invalidate (without clean) every line of `[start, start+len)` so the next
+/// CPU reads come from memory the GPU wrote through uncached PTEs. Any dirty
+/// CPU line in the range is discarded.
+pub(crate) fn g15_invalidate_from_poc(start: usize, len: usize) {
+    let ctr: u64;
+    // SAFETY: CTR_EL0 is readable at EL1.
+    unsafe { core::arch::asm!("mrs {0}, ctr_el0", out(reg) ctr) };
+    let line = 4usize << ((ctr >> 16) & 0xf);
+    let mut a = start & !(line - 1);
+    let end = start + len;
+    while a < end {
+        // SAFETY: cache maintenance on a mapped kernel address.
+        unsafe { core::arch::asm!("dc ivac, {0}", in(reg) a, options(nostack, preserves_flags)) };
+        a += line;
+    }
+    // SAFETY: barrier only.
+    unsafe { core::arch::asm!("dsb sy", options(nostack, preserves_flags)) };
+}
+
+/// F2 experiment (`g15_zero_mode`): 0 clears with `fill` (memset, which uses
+/// DC ZVA for large ranges), 1 with volatile u64 stores (ordinary stores, as
+/// the staged write-back's memcpy did).
+#[inline(never)]
+fn g15_zero_bytes(dst: &mut [u8], stores: bool) {
+    let mode = *crate::module_parameters::g15_zero_mode.value();
+    if mode == 2 {
+        // memset (DC ZVA), then clean+invalidate every line to the point of
+        // coherency: the CPU view is write-back cached while the GPU reads
+        // these pages uncached (F2).
+        dst.fill(0);
+        g15_clean_to_poc(dst.as_ptr() as usize, dst.len());
+        return;
+    }
+    if !stores && mode == 0 {
+        dst.fill(0);
+        return;
+    }
+    let (head, words, tail) = {
+        // SAFETY: u64 has no invalid bit patterns; align_to splits exactly.
+        unsafe { dst.align_to_mut::<u64>() }
+    };
+    for b in head.iter_mut() {
+        // SAFETY: a valid exclusive reference.
+        unsafe { core::ptr::write_volatile(b, 0) };
+    }
+    for b in tail.iter_mut() {
+        // SAFETY: a valid exclusive reference.
+        unsafe { core::ptr::write_volatile(b, 0) };
+    }
+    // 64 bytes per iteration with STP pairs (ordinary stores, never DC ZVA),
+    // then the remaining words one by one.
+    let (blocks, rest) = words.split_at_mut(words.len() & !7);
+    let mut p = blocks.as_mut_ptr();
+    // SAFETY: `blocks` is u64-aligned with a multiple of 8 words.
+    let end = unsafe { p.add(blocks.len()) };
+    while p < end {
+        // SAFETY: writes 64 bytes inside `blocks`.
+        unsafe {
+            core::arch::asm!(
+                "stp xzr, xzr, [{p}]",
+                "stp xzr, xzr, [{p}, #16]",
+                "stp xzr, xzr, [{p}, #32]",
+                "stp xzr, xzr, [{p}, #48]",
+                p = in(reg) p,
+                options(nostack, preserves_flags),
+            );
+            p = p.add(8);
+        }
+    }
+    for w in rest.iter_mut() {
+        // SAFETY: a valid exclusive reference.
+        unsafe { core::ptr::write_volatile(w, 0) };
+    }
+}
+
+/// What a fixed placement holds (see [`G15RenderHeaps::alloc_fixed`]).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum G15FixedUse {
+    /// A user section or TVB block: exactly the profile's native class.
+    /// Capture-triangle-1 mixes classes within one role family (USC
+    /// launcher pages RW 0xc0000000000088, shader body/library pages RO
+    /// executable 0x80000000000088), so the role implies nothing.
+    Native,
+    /// The kernel-owned render target: the profile's class, which must
+    /// also be GPU-writable.
+    RenderTarget,
+}
+
+/// Classes a fixed placement may use: existing protection constants only,
+/// none of them writable and executable at once (`g15_attr_write_exec`).
+/// Cached non-coherent classes are listed for completeness but the in-place
+/// reprotection refuses them.
+const G15_FIXED_PROTS: [mmu::Prot; 7] = [
+    // AP=2 uxn=0 pxn=0: GPU read-only, executable (code arena, shader
+    // bodies), attr 0x80000000000088.
+    mmu::PROT_GPU_SHARED_RO,
+    // AP=2 uxn=1 pxn=0: GPU read-write, not executable (USC launchers,
+    // render target), attr 0xc0000000000088.
+    mmu::PROT_GPU_SHARED_RW,
+    mmu::PROT_G15_RANGE5_CODE,
+    mmu::PROT_G15_RANGE5_UNCACHED,
+    mmu::PROT_G15_RANGE5_CACHED,
+    mmu::PROT_GPU_FW_SHARED_RW,
+    mmu::PROT_GPU_FW_PRIV_RW,
+];
+
+/// Whether a masked leaf attribute is GPU-writable and executable under
+/// the driver's `pgtable.rs` encoding. For AP=2 (GPU-only) the two
+/// permission bits are (UXN, PXN): (0,0) read-only, (0,1) write-only,
+/// (1,0) read-write, (1,1) none, and UXN clear means executable, so only
+/// the write-only encoding (`PROT_GPU_SHARED_WO`) is writable and
+/// executable. For AP=0/1 the OS permission table (`PROT_TO_PERMS_OS`)
+/// grants no execute.
+const fn g15_attr_write_exec(attr: u64) -> bool {
+    let ap = (attr >> 6) & 3;
+    let high = attr >> 52;
+    let (uxn, pxn) = (high & 0x4 != 0, high & 0x2 != 0);
+    ap == 2 && !uxn && pxn
+}
+
+const fn g15_attr_gpu_writable(attr: u64) -> bool {
+    let ap = (attr >> 6) & 3;
+    let high = attr >> 52;
+    let (uxn, pxn) = (high & 0x4 != 0, high & 0x2 != 0);
+    match ap {
+        2 => pxn != uxn,
+        0 => uxn,
+        _ => false,
+    }
+}
+
+const _: () = {
+    let mut i = 0;
+    while i < G15_FIXED_PROTS.len() {
+        assert!(!g15_attr_write_exec(G15_FIXED_PROTS[i].as_pte() & G15_PTE_ATTR_MASK));
+        i += 1;
+    }
+    // The capture's two range-5 USC/code classes and their meaning.
+    assert!(mmu::PROT_GPU_SHARED_RO.as_pte() & G15_PTE_ATTR_MASK == 0x0080_0000_0000_0088);
+    assert!(mmu::PROT_GPU_SHARED_RW.as_pte() & G15_PTE_ATTR_MASK == 0x00c0_0000_0000_0088);
+    assert!(!g15_attr_gpu_writable(0x0080_0000_0000_0088));
+    assert!(g15_attr_gpu_writable(0x00c0_0000_0000_0088));
+    assert!(g15_attr_write_exec(mmu::PROT_GPU_SHARED_WO.as_pte() & G15_PTE_ATTR_MASK));
+};
+
+/// Existing Linux heaps that can realize a native class.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum G15Heap {
+    /// `file.rs` "G15 Range 5 Code": `G15_GART_RANGE5_CODE`, `PROT_GPU_SHARED_RO`.
+    Range5Code,
+    /// `file.rs` "G15 Range 5 PPL308": `G15_GART_RANGE5_PPL308`, `PROT_GPU_SHARED_RW`.
+    Range5Ppl308,
+    /// `file.rs` "G15 Range 5 Uncached": `G15_GART_RANGE5_UNCACHED`, `PROT_GPU_SHARED_RW`.
+    Range5Uncached,
+    /// `file.rs` "G15 Range 5 Cached": `G15_GART_RANGE5_CACHED`, `PROT_G15_RANGE5_CODE`.
+    Range5Cached,
+    /// `file.rs` "G15 Range 5 Prime Code": `G15_GART_RANGE5_PRIME_CODE`,
+    /// `PROT_GPU_SHARED_RO`. Fixed placements only.
+    Range5PrimeCode,
+    /// `file.rs` "G15 Range 5 Prime PPL308": `G15_GART_RANGE5_PRIME_PPL308`,
+    /// `PROT_GPU_SHARED_RW`. Fixed placements only.
+    Range5PrimePpl308,
+    /// `G15SharedBank1Allocator::new_range7_event`: eGartRange 7, `PROT_G15_RANGE7_FW`.
+    Bank1Range7,
+    /// `G15SharedBank1Allocator::new_range7_timestamp_queue`: eGartRange 7,
+    /// `PROT_G15_RANGE7_QUEUE_STATE` (uncached normal memory). Capture 5 maps
+    /// the per-pass timing record with this class, not the device-memory one
+    /// of [`G15Heap::Bank1Range7`].
+    Bank1Range7Uncached,
+    /// `G15SharedBank1Allocator::new_range8`: eGartRange 8, `PROT_G15_RANGE8_FW`.
+    Bank1Range8,
+    /// A [`G15RenderVaWindow`] passed by the integrator (index into the slice).
+    Window(usize),
+}
+
+/// Heap search order and the class each existing heap maps with. The range-5
+/// rows must stay equal to the `DefaultAllocator::new` calls in `file.rs`
+/// (Vm creation); every allocation is also checked against the VA range.
+const G15_FIXED_HEAPS: [(G15Heap, G15PteClass, Range<u64>); 7] = [
+    (
+        G15Heap::Range5Code,
+        G15PteClass::of(5, mmu::PROT_GPU_SHARED_RO),
+        mmu::G15_GART_RANGE5_CODE,
+    ),
+    (
+        G15Heap::Range5Ppl308,
+        G15PteClass::of(5, mmu::PROT_GPU_SHARED_RW),
+        mmu::G15_GART_RANGE5_PPL308,
+    ),
+    (
+        G15Heap::Range5Uncached,
+        G15PteClass::of(5, mmu::PROT_GPU_SHARED_RW),
+        mmu::G15_GART_RANGE5_UNCACHED,
+    ),
+    (
+        G15Heap::Range5Cached,
+        G15PteClass::of(5, mmu::PROT_G15_RANGE5_CODE),
+        mmu::G15_GART_RANGE5_CACHED,
+    ),
+    (
+        G15Heap::Bank1Range7,
+        G15PteClass::of(7, mmu::PROT_G15_RANGE7_FW),
+        mmu::G15_GART_RANGE7,
+    ),
+    (
+        G15Heap::Bank1Range7Uncached,
+        G15PteClass::of(7, mmu::PROT_G15_RANGE7_QUEUE_STATE),
+        mmu::G15_GART_RANGE7,
+    ),
+    (
+        G15Heap::Bank1Range8,
+        G15PteClass::of(8, mmu::PROT_G15_RANGE8_FW),
+        mmu::G15_GART_RANGE8,
+    ),
+];
+
+/// Existing protection constants a native VA window may use. A window whose
+/// class is none of these is rejected; adding a protection class is a
+/// separate, evidence-backed change to `pgtable.rs`.
+const G15_WINDOW_PROTS: [mmu::Prot; 7] = [
+    mmu::PROT_G15_RANGE5_UNCACHED,
+    mmu::PROT_G15_RANGE5_CACHED,
+    mmu::PROT_G15_RANGE5_CODE,
+    mmu::PROT_GPU_SHARED_RW,
+    mmu::PROT_GPU_SHARED_RO,
+    mmu::PROT_GPU_FW_SHARED_RW,
+    mmu::PROT_GPU_FW_PRIV_RW,
+];
+
+/// A per-VM heap over a native VA window that no existing heap covers, e.g.
+/// the eGartRange-1 window holding the native TVB, TPC and context-switch
+/// region. Create at most one per VM and window: two heaps over the same
+/// VA range in one VM would map the same addresses twice. The integrator
+/// must also keep the window out of the userspace VM_BIND range.
+pub(crate) struct G15RenderVaWindow {
+    heap: Arc<Mutex<alloc::DefaultAllocator>>,
+    range: Range<u64>,
+    class: G15PteClass,
+}
+
+/// Live `G15RenderVaWindow`s across all VMs (debugfs `g15_accounting`).
+static G15_RENDER_WINDOWS_LIVE: AtomicU64 = AtomicU64::new(0);
+
+/// Number of live per-VM render VA windows.
+pub(crate) fn g15_render_windows_live() -> u64 {
+    G15_RENDER_WINDOWS_LIVE.load(Ordering::Relaxed)
+}
+
+impl Drop for G15RenderVaWindow {
+    fn drop(&mut self) {
+        G15_RENDER_WINDOWS_LIVE.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+impl G15RenderVaWindow {
+    /// Create the window heap from a resolved profile window.
+    pub(crate) fn new(
+        dev: &AsahiDevice,
+        vm: &mmu::Vm,
+        window: G15Profiled<G15VaWindowProfile>,
+    ) -> Result<Self> {
+        let w = window.need("va_window")?;
+        let page = buffer::PAGE_SIZE as u64;
+        if w.start >= w.end || w.start % page != 0 || w.end % page != 0 {
+            return Err(reject("va_window"));
+        }
+        let prot = G15_WINDOW_PROTS
+            .iter()
+            .copied()
+            .find(|p| (p.as_pte() & G15_PTE_ATTR_MASK) == w.class.pte_attr)
+            .ok_or_else(|| reject("va_window.class"))?;
+        let heap = Arc::pin_init(
+            kernel::new_mutex!(alloc::DefaultAllocator::new(
+                dev,
+                vm,
+                w.start..w.end,
+                buffer::PAGE_SIZE,
+                prot,
+                64 * 1024,
+                true,
+                fmt!("G15 render window {:#x}", w.start),
+                true,
+            )?),
+            GFP_KERNEL,
+        )?;
+        G15_RENDER_WINDOWS_LIVE.fetch_add(1, Ordering::Relaxed);
+        Ok(Self {
+            heap,
+            range: w.start..w.end,
+            class: w.class,
+        })
+    }
+
+    /// Window GPUVA range.
+    pub(crate) fn range(&self) -> Range<u64> {
+        self.range.clone()
+    }
+
+    /// Release the allocations freed since the last render. Their objects
+    /// were dropped after their job retired (see `HeapAllocation::drop`), so
+    /// the caller only needs to hold the device's job slot.
+    pub(crate) fn collect_garbage(&self) {
+        g15_collect_garbage(&self.heap);
+    }
+}
+
+/// [`G15RenderVaWindow::collect_garbage`] for any keep-garbage heap.
+pub(crate) fn g15_collect_garbage(heap: &Arc<Mutex<alloc::DefaultAllocator>>) {
+    let mut heap = heap.lock();
+    let (count, _) = heap.garbage();
+    if count > 0 {
+        heap.collect_garbage(count);
+    }
+}
+
+/// Split the fixed range `[va, end)` at owner boundaries: one
+/// `(owner index, piece)` per owner it crosses, in VA order. `owners` lists
+/// the Linux range-5 arenas and the profile VA windows; the first owner that
+/// contains a piece's start owns it, up to its own end. The pieces cover the
+/// range exactly. EINVAL if the range is empty or any byte of it lies in no
+/// owner. Pure; the host tests (tools/g15-render-input-test) run it.
+pub(crate) fn g15_fixed_pieces(
+    owners: &[Range<u64>],
+    va: u64,
+    end: u64,
+) -> Result<KVec<(usize, Range<u64>)>> {
+    if va >= end {
+        return Err(EINVAL);
+    }
+    let mut pieces = KVec::new();
+    let mut cur = va;
+    while cur < end {
+        let i = owners
+            .iter()
+            .position(|r| r.start <= cur && cur < r.end)
+            .ok_or(EINVAL)?;
+        let stop = owners[i].end.min(end);
+        pieces.push((i, cur..stop), GFP_KERNEL)?;
+        cur = stop;
+    }
+    Ok(pieces)
+}
+
+/// The allocators one render resource set may use. W8 builds this from the
+/// queue's existing fields (`_g15_range5_*`, `_g15_shared_bank1`,
+/// `_g15_mapping_notifier`) and the VM's windows.
+pub(crate) struct G15RenderHeaps<'a> {
+    pub(crate) dev: &'a AsahiDevice,
+    pub(crate) range5_code: &'a Option<Arc<Mutex<alloc::DefaultAllocator>>>,
+    pub(crate) range5_ppl308: &'a Option<Arc<Mutex<alloc::DefaultAllocator>>>,
+    pub(crate) range5_uncached: &'a Option<Arc<Mutex<alloc::DefaultAllocator>>>,
+    pub(crate) range5_cached: &'a Option<Arc<Mutex<alloc::DefaultAllocator>>>,
+    /// Only for fixed placements inside these arenas; never selected by
+    /// class.
+    pub(crate) range5_prime_code: &'a Option<Arc<Mutex<alloc::DefaultAllocator>>>,
+    pub(crate) range5_prime_ppl308: &'a Option<Arc<Mutex<alloc::DefaultAllocator>>>,
+    pub(crate) bank1: &'a Option<mmu::G15SharedBank1>,
+    pub(crate) mapping_notifier: &'a Option<Arc<Mutex<mmu::G15MappingNotifier>>>,
+    pub(crate) windows: &'a [G15RenderVaWindow],
+    /// The queue's VM, for the dedicated block-list mapping.
+    pub(crate) vm: Option<&'a crate::mmu::Vm>,
+}
+
+impl G15RenderHeaps<'_> {
+    fn heap_alloc(
+        heap: &Option<Arc<Mutex<alloc::DefaultAllocator>>>,
+        size: usize,
+        align: usize,
+        tag: &[u8; 4],
+    ) -> Result<G15Backing> {
+        let raw = heap
+            .as_ref()
+            .ok_or(EINVAL)?
+            .lock()
+            .alloc_generic::<u8>(size, align, Some(u32::from_le_bytes(*tag)))?;
+        Ok(G15Backing::Heap(GpuArray::<u8>::empty(raw, size)?))
+    }
+
+    fn bank1_alloc(&self, heap: G15Heap, size: usize, align: usize, tag: &[u8; 4]) -> Result<G15Backing> {
+        let bank1 = self.bank1.as_ref().ok_or(EINVAL)?.clone();
+        let notifier = self.mapping_notifier.clone();
+        let new = match heap {
+            G15Heap::Bank1Range7 => alloc::G15SharedBank1Allocator::new_range7_event,
+            G15Heap::Bank1Range7Uncached => alloc::G15SharedBank1Allocator::new_range7_timestamp_queue,
+            G15Heap::Bank1Range8 => alloc::G15SharedBank1Allocator::new_range8,
+            _ => return Err(EINVAL),
+        };
+        let mut a = new(self.dev, bank1, buffer::PAGE_SIZE, true, notifier);
+        let raw = a.alloc_generic::<u8>(size, align, Some(u32::from_le_bytes(*tag)))?;
+        Ok(G15Backing::Bank1(alloc::G15SharedGpuArray::<u8>::empty(raw, size)?))
+    }
+
+    fn alloc_on(&self, heap: G15Heap, size: usize, align: usize, tag: &[u8; 4]) -> Result<G15Backing> {
+        match heap {
+            G15Heap::Range5Code => Self::heap_alloc(self.range5_code, size, align, tag),
+            G15Heap::Range5Ppl308 => Self::heap_alloc(self.range5_ppl308, size, align, tag),
+            G15Heap::Range5Uncached => Self::heap_alloc(self.range5_uncached, size, align, tag),
+            G15Heap::Range5Cached => Self::heap_alloc(self.range5_cached, size, align, tag),
+            G15Heap::Range5PrimeCode | G15Heap::Range5PrimePpl308 => Err(EINVAL),
+            G15Heap::Bank1Range7 | G15Heap::Bank1Range7Uncached | G15Heap::Bank1Range8 => {
+                self.bank1_alloc(heap, size, align, tag)
+            }
+            G15Heap::Window(i) => {
+                let w = self.windows.get(i).ok_or(EINVAL)?;
+                let raw = w
+                    .heap
+                    .lock()
+                    .alloc_generic::<u8>(size, align, Some(u32::from_le_bytes(*tag)))?;
+                Ok(G15Backing::Heap(GpuArray::<u8>::empty(raw, size)?))
+            }
+        }
+    }
+
+    fn heap_range(&self, heap: G15Heap) -> Result<Range<u64>> {
+        match heap {
+            G15Heap::Window(i) => Ok(self.windows.get(i).ok_or(EINVAL)?.range()),
+            h => G15_FIXED_HEAPS
+                .iter()
+                .find(|(fh, _, _)| *fh == h)
+                .map(|(_, _, r)| r.clone())
+                .ok_or(EINVAL),
+        }
+    }
+
+    /// First heap whose class equals `class`. A heap that is not available
+    /// on this VM (`None`) is skipped.
+    fn select(&self, class: G15PteClass) -> Option<G15Heap> {
+        for (heap, c, _) in G15_FIXED_HEAPS.iter() {
+            let present = match heap {
+                G15Heap::Range5Code => self.range5_code.is_some(),
+                G15Heap::Range5Ppl308 => self.range5_ppl308.is_some(),
+                G15Heap::Range5Uncached => self.range5_uncached.is_some(),
+                G15Heap::Range5Cached => self.range5_cached.is_some(),
+                G15Heap::Bank1Range7 | G15Heap::Bank1Range7Uncached | G15Heap::Bank1Range8 => {
+                    self.bank1.is_some()
+                }
+                G15Heap::Range5PrimeCode | G15Heap::Range5PrimePpl308 | G15Heap::Window(_) => {
+                    false
+                }
+            };
+            if present && *c == class {
+                return Some(*heap);
+            }
+        }
+        self.windows
+            .iter()
+            .position(|w| w.class == class)
+            .map(G15Heap::Window)
+    }
+
+    /// The next profile window after `heap` (a window) with class `class`,
+    /// in declaration order.
+    fn next_window(&self, heap: G15Heap, class: G15PteClass) -> Option<G15Heap> {
+        let G15Heap::Window(i) = heap else {
+            return None;
+        };
+        self.windows
+            .iter()
+            .enumerate()
+            .skip(i + 1)
+            .find(|(_, w)| w.class == class)
+            .map(|(j, _)| G15Heap::Window(j))
+    }
+
+    /// Map `size` bytes at exactly `va`, zeroed, with the PTE class `class`
+    /// (a G15 fixed native section or the native render target).
+    ///
+    /// The Linux heap whose VA range covers `[va, va + size)` reserves the
+    /// range and the pages get `class`, whatever class the heap itself maps
+    /// with (`HeapAllocator::reserve_fixed`). Range-5 arenas and the profile
+    /// VA windows can do this; bank-1 heaps and addresses no heap covers
+    /// cannot (EINVAL). EBUSY if a live heap object overlaps the range.
+    ///
+    /// A range over several adjacent owners (capture 5: the 4 MiB background
+    /// library at 0x100_001e_8000 crosses PPL308 into prime PPL308, the
+    /// 1 MiB EOT library at 0x100_000b_8000 crosses code into prime code) is
+    /// split at the owner boundaries ([`g15_fixed_pieces`]); each owner
+    /// reserves its piece and every piece gets the same `class`. Any failure
+    /// releases the pieces already reserved (restoring their heap class), so
+    /// nothing stays reserved. Such a resource has no contiguous CPU view
+    /// ([`G15Resource::write_with`]).
+    ///
+    /// The mapping gets exactly the profile's native (eGartRange, PTE
+    /// attribute) pair. The eGartRange must be the one Apple's classifier
+    /// gives `va`, and the attribute one of the existing protection
+    /// constants in [`G15_FIXED_PROTS`], none of which is writable and
+    /// executable. A render target's class must also be GPU-writable.
+    pub(crate) fn alloc_fixed(
+        &self,
+        class: G15Profiled<G15PteClass>,
+        va: u64,
+        size: usize,
+        use_: G15FixedUse,
+        what: &str,
+    ) -> Result<G15Resource> {
+        let class = class.need(what)?;
+        let end = va.checked_add(size as u64).ok_or(EINVAL)?;
+        if size == 0
+            || mmu::g15_apple_gart_range(va) != class.gart_range
+            || mmu::g15_apple_gart_range(end - 1) != class.gart_range
+        {
+            pr_err!(
+                "G15 render resources: fixed {} {:#x}..{:#x} is not in eGartRange {}\n",
+                what,
+                va,
+                end,
+                class.gart_range
+            );
+            return Err(EINVAL);
+        }
+        let prot = G15_FIXED_PROTS
+            .iter()
+            .copied()
+            .find(|p| (p.as_pte() & G15_PTE_ATTR_MASK) == class.pte_attr)
+            .ok_or_else(|| reject("fixed placement class"))?;
+        let class_ok = !g15_attr_write_exec(class.pte_attr)
+            && match use_ {
+                G15FixedUse::Native => true,
+                G15FixedUse::RenderTarget => g15_attr_gpu_writable(class.pte_attr),
+            };
+        if !class_ok {
+            pr_err!(
+                "G15 render resources: fixed {} class attr {:#x} not allowed for {:?}\n",
+                what,
+                class.pte_attr,
+                use_
+            );
+            return Err(EINVAL);
+        }
+
+        let range5: [(G15Heap, &Option<Arc<Mutex<alloc::DefaultAllocator>>>, Range<u64>); 6] = [
+            (G15Heap::Range5Code, self.range5_code, mmu::G15_GART_RANGE5_CODE),
+            (G15Heap::Range5PrimeCode, self.range5_prime_code, mmu::G15_GART_RANGE5_PRIME_CODE),
+            (G15Heap::Range5Ppl308, self.range5_ppl308, mmu::G15_GART_RANGE5_PPL308),
+            (
+                G15Heap::Range5PrimePpl308,
+                self.range5_prime_ppl308,
+                mmu::G15_GART_RANGE5_PRIME_PPL308,
+            ),
+            (G15Heap::Range5Uncached, self.range5_uncached, mmu::G15_GART_RANGE5_UNCACHED),
+            (G15Heap::Range5Cached, self.range5_cached, mmu::G15_GART_RANGE5_CACHED),
+        ];
+        // Owner table: the six arenas first, then the windows (which W8
+        // keeps out of the arenas).
+        let mut owners = KVec::with_capacity(range5.len() + self.windows.len(), GFP_KERNEL)?;
+        for (_, _, r) in range5.iter() {
+            owners.push(r.clone(), GFP_KERNEL)?;
+        }
+        for w in self.windows.iter() {
+            owners.push(w.range.clone(), GFP_KERNEL)?;
+        }
+        let pieces = g15_fixed_pieces(&owners, va, end).inspect_err(|_| {
+            pr_err!(
+                "G15 render resources: fixed {} {:#x}..{:#x} is not covered by Linux heaps or profile windows\n",
+                what,
+                va,
+                end
+            );
+        })?;
+        let owner = |i: usize| -> Option<(G15Heap, &Arc<Mutex<alloc::DefaultAllocator>>)> {
+            match range5.get(i) {
+                Some((heap, a, _)) => a.as_ref().map(|a| (*heap, a)),
+                None => self
+                    .windows
+                    .get(i - range5.len())
+                    .map(|w| (G15Heap::Window(i - range5.len()), &w.heap)),
+            }
+        };
+
+        // Dropping `parts` on any error below releases every piece reserved
+        // so far (HeapFixedRange restores the heap class first).
+        let mut parts = KVec::with_capacity(pieces.len(), GFP_KERNEL)?;
+        let mut first_heap = None;
+        for (i, piece) in pieces.iter() {
+            let Some((heap, allocator)) = owner(*i) else {
+                pr_err!(
+                    "G15 render resources: fixed {} {:#x}..{:#x}: piece {:#x}..{:#x} has no heap on this VM\n",
+                    what,
+                    va,
+                    end,
+                    piece.start,
+                    piece.end
+                );
+                return Err(EINVAL);
+            };
+            let len = (piece.end - piece.start) as usize;
+            let reserved = {
+                let mut a = allocator.lock();
+                a.reserve_fixed(piece.start, len, prot)
+            };
+            let part = reserved.inspect_err(|e| {
+                pr_err!(
+                    "G15 render resources: fixed {} {:#x}..{:#x}: piece {:#x}..{:#x} in {:?} failed: {:?}\n",
+                    what,
+                    va,
+                    end,
+                    piece.start,
+                    piece.end,
+                    heap,
+                    e
+                );
+            })?;
+            parts.push(part, GFP_KERNEL)?;
+            first_heap.get_or_insert(heap);
+            crate::debug::g15_stage(format_args!(
+                "alloc_fixed {}: piece {:#x}..{:#x} in {:?} reserved",
+                what, piece.start, piece.end, heap
+            ))?;
+        }
+        Ok(G15Resource {
+            backing: G15Backing::Fixed(parts),
+            heap: first_heap.ok_or(EINVAL)?,
+            class,
+        })
+    }
+
+    /// Map `size` bytes at exactly `va` inside the profile VA window that
+    /// covers them, with that window's class (TVB blocks, PM scene page).
+    fn alloc_in_window(&self, va: u64, size: usize, what: &str) -> Result<G15Resource> {
+        let end = va.checked_add(size as u64).ok_or(EINVAL)?;
+        let class = self
+            .windows
+            .iter()
+            .find(|w| va >= w.range.start && end <= w.range.end)
+            .map(|w| w.class)
+            .ok_or_else(|| {
+                pr_err!(
+                    "G15 render resources: {} {:#x}..{:#x} is in no profile VA window\n",
+                    what,
+                    va,
+                    end
+                );
+                EINVAL
+            })?;
+        // A fixed placement keeps whatever earlier objects left in the heap
+        // memory under it; zeroing it (TVB blocks, PM scene) was negative (G2).
+        self.alloc_fixed(G15Profiled::Resolved(class), va, size, G15FixedUse::Native, what)
+    }
+
+    /// Allocate one resource from its profile record. `min_size` is the
+    /// smallest size the tree's own users of this object need (TileInfo's
+    /// TPC, tilemap and heapmeta sizes): the profile size is a minimum, and
+    /// a larger target gets the larger allocation (the TPC formula matches
+    /// the native 128 and 513x257 commands).
+    pub(crate) fn alloc(
+        &self,
+        req: &G15ResourceReq<'_>,
+        what: &str,
+        tag: &[u8; 4],
+        min_size: usize,
+    ) -> Result<G15Resource> {
+        let size = req.size.need(what)?;
+        let align = req.alignment.need(what)?;
+        let class = req.class.need(what)?;
+        let init = req.init.need(what)?;
+
+        let size = size.max(min_size);
+        if size == 0 || !align.is_power_of_two() {
+            return Err(reject(what));
+        }
+        let mut heap = match self.select(class) {
+            Some(h) => h,
+            None => {
+                pr_err!(
+                    "G15 render resources: no heap realizes {} class range {} attr {:#x}\n",
+                    what,
+                    class.gart_range,
+                    class.pte_attr
+                );
+                return Err(EINVAL);
+            }
+        };
+
+        // A full window falls back to the next one of the same class (the
+        // profile declares a later range-1 window for the per-pass objects
+        // once the TVB fills the first). A failed heap allocation leaves the
+        // heap unchanged, so the retry starts clean. Other errors are final.
+        let mut backing = loop {
+            match self.alloc_on(heap, size, align, tag) {
+                Err(e) if e == ENOSPC => {
+                    let Some(next) = self.next_window(heap, class) else {
+                        return Err(e);
+                    };
+                    crate::debug::g15_trace(format_args!(
+                        "G15 render resources: {} ({:#x} bytes) does not fit in window {:#x?}; trying window {:#x?}",
+                        what,
+                        size,
+                        self.heap_range(heap)?,
+                        self.heap_range(next)?
+                    ));
+                    heap = next;
+                }
+                r => break r?,
+            }
+        };
+        let va = backing.gpu_va();
+        let range = self.heap_range(heap)?;
+        if va % align as u64 != 0 || va < range.start || va + size as u64 > range.end {
+            pr_err!(
+                "G15 render resources: {} landed at {:#x} outside {:?} or misaligned\n",
+                what,
+                va,
+                range
+            );
+            return Err(EIO);
+        }
+
+        // GpuArray::empty() zero-fills; only captured bytes need a copy.
+        if let G15ResourceInit::Bytes(bytes) = init {
+            let dst = backing.as_mut_slice()?;
+            if bytes.len() > dst.len() {
+                return Err(reject(what));
+            }
+            dst[..bytes.len()].copy_from_slice(bytes);
+        }
+
+        Ok(G15Resource { backing, heap, class })
+    }
+}
+
+/// Device-global PB descriptor-table slot allocator (256 records of 0x10,
+/// `InitData` RuntimePointers `+0x2b0`). W8 creates one in `GpuManager`.
+pub(crate) struct G15PbSlotAllocator(Arc<Mutex<[u64; 4]>>);
+
+/// Number of PB descriptor-table records (`fw/initdata.rs` table length).
+const G15_PB_DESC_SLOTS: usize = 0x100;
+const _: [(); 0x10] = [(); core::mem::size_of::<fw::initdata::raw::G15PBDescriptor>()];
+
+impl G15PbSlotAllocator {
+    pub(crate) fn new() -> Result<Self> {
+        Ok(Self(Arc::pin_init(
+            kernel::new_mutex!([0u64; 4], "g15_pb_desc_slots"),
+            GFP_KERNEL,
+        )?))
+    }
+
+    /// Debugfs: slots currently leased.
+    pub(crate) fn in_use(&self) -> u32 {
+        self.0.lock().iter().map(|w| w.count_ones()).sum()
+    }
+
+    /// Take the lowest free slot.
+    pub(crate) fn acquire(&self) -> Result<G15PbSlotLease> {
+        let mut map = self.0.lock();
+        for slot in 0..G15_PB_DESC_SLOTS {
+            let (w, b) = (slot / 64, slot % 64);
+            if map[w] & (1u64 << b) == 0 {
+                map[w] |= 1u64 << b;
+                return Ok(G15PbSlotLease {
+                    map: self.0.clone(),
+                    slot: slot as u8,
+                });
+            }
+        }
+        Err(EBUSY)
+    }
+}
+
+/// One PB descriptor-table slot. Released on drop.
+pub(crate) struct G15PbSlotLease {
+    map: Arc<Mutex<[u64; 4]>>,
+    slot: u8,
+}
+
+impl G15PbSlotLease {
+    pub(crate) fn slot(&self) -> u8 {
+        self.slot
+    }
+}
+
+impl Drop for G15PbSlotLease {
+    fn drop(&mut self) {
+        let slot = self.slot as usize;
+        self.map.lock()[slot / 64] &= !(1u64 << (slot % 64));
+    }
+}
+
+/// PB descriptor entry: slot lease plus the relocated record. The integrator
+/// writes `descriptor` to `g15_pb_desc_table[slot]` before the first TA
+/// publication that uses the buffer and zeroes it before dropping the entry.
+pub(crate) struct G15PbEntry {
+    lease: G15PbSlotLease,
+    descriptor: fw::initdata::raw::G15PBDescriptor,
+    word0_relocated: bool,
+}
+
+impl G15PbEntry {
+    pub(crate) fn slot(&self) -> u8 {
+        self.lease.slot()
+    }
+
+    pub(crate) fn descriptor(&self) -> fw::initdata::raw::G15PBDescriptor {
+        self.descriptor
+    }
+
+    /// Whether the record may be published:
+    /// [`G15PbDescriptorProfile::word0_relocated`]. A record that keeps the
+    /// native word 0 is for evidence-only dumps.
+    pub(crate) fn publishable(&self) -> bool {
+        self.word0_relocated
+    }
+}
+
+/// Apply one relocation to a native little-endian word.
+fn g15_apply_reloc(native: u64, target: u64, r: &G15PbReloc) -> Result<u64> {
+    let addr = target.checked_add_signed(r.addend).ok_or(EINVAL)?;
+    let width_mask = if r.width == 8 { u64::MAX } else { 0xffff_ffff };
+    match r.encoding {
+        G15RelocEncoding::FullAddress => {
+            if addr & !width_mask != 0 {
+                return Err(EINVAL);
+            }
+            Ok(addr)
+        }
+        G15RelocEncoding::Bitfield {
+            address_base,
+            address_shift,
+            field_shift,
+            mask,
+        } => {
+            let rel = addr.checked_sub(address_base).ok_or(EINVAL)?;
+            let shift = address_shift as u32;
+            if shift >= 64 || field_shift >= 64 || mask & !width_mask != 0 {
+                return Err(EINVAL);
+            }
+            // Lost low bits or high bits outside the mask reject the value.
+            if rel & ((1u64 << shift) - 1) != 0 {
+                return Err(EINVAL);
+            }
+            let field = (rel >> shift).checked_shl(field_shift as u32).ok_or(EINVAL)?;
+            if (field >> field_shift) != (rel >> shift) || field & !mask != 0 {
+                return Err(EINVAL);
+            }
+            Ok((native & !mask) | field)
+        }
+    }
+}
+
+/// Addresses a PB descriptor may reference.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct G15PbTargets {
+    /// FWVA of the queue's TVB buffer Info (`buffer::Buffer` info object).
+    pub(crate) buffer_info: u64,
+    pub(crate) pm_pool: u64,
+    pub(crate) fw_page_list: u64,
+    /// GPUVA of the queue's TVB page list, if the profile has one.
+    pub(crate) tvb_page_list: Option<u64>,
+}
+
+impl G15PbEntry {
+    /// Lease a slot and build the record from the profile.
+    pub(crate) fn new(
+        slots: &G15PbSlotAllocator,
+        profile: G15Profiled<G15PbDescriptorProfile>,
+        targets: &G15PbTargets,
+    ) -> Result<Self> {
+        let p = profile.need("pb_descriptor")?;
+        let mut bytes = [0u8; 16];
+        for (i, w) in p.words.iter().enumerate() {
+            bytes[i * 4..i * 4 + 4].copy_from_slice(&w.to_le_bytes());
+        }
+        let mut covered = 0u16;
+        for r in p.relocs.iter().flatten() {
+            if (r.width != 4 && r.width != 8) || r.offset + r.width > 16 {
+                return Err(reject("pb_descriptor.relocs"));
+            }
+            let span = ((1u32 << r.width) - 1) as u16;
+            if covered & (span << r.offset) != 0 {
+                return Err(reject("pb_descriptor.relocs (overlap)"));
+            }
+            covered |= span << r.offset;
+            let target = match r.target {
+                G15PbRelocTarget::BufferInfo => targets.buffer_info,
+                G15PbRelocTarget::PmPool => targets.pm_pool,
+                G15PbRelocTarget::FwPageList => targets.fw_page_list,
+                G15PbRelocTarget::TvbPageList => targets
+                    .tvb_page_list
+                    .ok_or_else(|| reject("pb_descriptor.relocs (no tvb_page_list)"))?,
+            };
+            let mut raw = [0u8; 8];
+            raw[..r.width].copy_from_slice(&bytes[r.offset..r.offset + r.width]);
+            let v = g15_apply_reloc(u64::from_le_bytes(raw), target, r)
+                .map_err(|_| reject("pb_descriptor.relocs (encoding)"))?;
+            bytes[r.offset..r.offset + r.width].copy_from_slice(&v.to_le_bytes()[..r.width]);
+        }
+        let mut words = [U32(0), U32(0), U32(0), U32(0)];
+        for (i, w) in words.iter_mut().enumerate() {
+            let mut b = [0u8; 4];
+            b.copy_from_slice(&bytes[i * 4..i * 4 + 4]);
+            *w = U32(u32::from_le_bytes(b));
+        }
+        Ok(Self {
+            lease: slots.acquire()?,
+            descriptor: fw::initdata::raw::G15PBDescriptor {
+                words: Array::new(words),
+            },
+            word0_relocated: p.word0_relocated(),
+        })
+    }
+}
