+const G15_RENDER_CONTEXT: Range<u64> = uapi::DRM_ASAHI_G15_RENDER_CONTEXT_START as u64
+    ..uapi::DRM_ASAHI_G15_RENDER_CONTEXT_END as u64;
+/// I09 R1: bytes from a HYBRID VDM base that must be bound READ.
+const G15_HYBRID_VDM_SPAN: u64 = uapi::DRM_ASAHI_G15_RENDER_HYBRID_VDM_SPAN as u64;
+// The aperture lies in the ordinary VM_BIND range, so binding there needs no
+// G15 exception, and its offsets fit the register's 32-bit field.
+const _: () = assert!(
