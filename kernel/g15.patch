+    // The three USC/VDM register shapes on G15 (synthetic addresses): an
+    // offset from a literal user-VA base, the same offset stored >> 6, and a
+    // full address. The legacy two-pointer USC packing has no encoding here.
+    #[test]
+    fn usc_vdm_register_shapes() {
+        const BASE: u64 = 0x40_0000_0000;
+        let mut t = G15TargetTable::new();
+        t.set(G15RelocTarget::VdmStream, BASE + 0x2_4000).unwrap();
+        t.set(G15RelocTarget::UscVertex, BASE + 0x7_1c40).unwrap();
+        t.set(G15RelocTarget::UscBackground, 0xffff_fc20_0abc_0000).unwrap();
+        let bf = |target, address_shift| G15Reloc {
+            target,
+            addend: 0,
+            encoding: G15Encoding::Bitfield {
+                base: G15AddrBase::Literal(BASE),
+                address_shift,
+                field_shift: 0,
+                mask: 0xffff_ffff,
+            },
+        };
+        assert_eq!(bf(G15RelocTarget::VdmStream, 0).encode(0, 8, &t), Ok(0x2_4000));
+        assert_eq!(bf(G15RelocTarget::UscVertex, 6).encode(0, 8, &t), Ok(0x7_1c40 >> 6));
+        // A loader that is not 64-byte aligned cannot be encoded >> 6.
+        t.set(G15RelocTarget::UscFragment, BASE + 0x7_1c48).unwrap();
+        assert_eq!(bf(G15RelocTarget::UscFragment, 6).encode(0, 8, &t), Err(EINVAL));
+        let fa = G15Reloc {
+            target: G15RelocTarget::UscBackground,
+            addend: 0,
+            encoding: G15Encoding::FullAddress,
+        };
+        assert_eq!(fa.encode(0, 8, &t), Ok(0xffff_fc20_0abc_0000));
+    }
