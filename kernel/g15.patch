+/// A heap range reserved at a fixed VA with its own PTE class
+/// ([`HeapAllocator::reserve_fixed`]). Dropping it restores the heap's class
+/// on the range and then releases the reservation. Drop it only after every
+/// GPU user of the range has retired.
+pub(crate) struct HeapFixedRange {
+    vm: mmu::Vm,
+    range: Range<u64>,
+    heap_prot: mmu::Prot,
+    ptr: NonNull<u8>,
+    // Keeps the heap (and with it the backing block) alive.
+    node: Option<mm::Node<HeapAllocatorInner, HeapAllocationInner>>,
+}
+
+// SAFETY: like `HeapAllocationInner`, this only points to raw memory.
+unsafe impl Send for HeapFixedRange {}
+// SAFETY: as above.
+unsafe impl Sync for HeapFixedRange {}
+
+impl HeapFixedRange {
+    /// First GPUVA (the requested fixed VA).
+    pub(crate) fn gpu_va(&self) -> u64 {
+        self.range.start
+    }
+
+    /// Size in bytes.
+    pub(crate) fn len(&self) -> usize {
+        (self.range.end - self.range.start) as usize
+    }
+
+    /// CPU view of the range.
+    pub(crate) fn as_slice(&self) -> &[u8] {
+        // SAFETY: `ptr` covers `len()` bytes of a live, CPU-mapped heap
+        // block that is reserved for this object.
+        unsafe { core::slice::from_raw_parts(self.ptr.as_ptr(), self.len()) }
+    }
+
+    /// Mutable CPU view of the range.
+    pub(crate) fn as_mut_slice(&mut self) -> &mut [u8] {
+        // SAFETY: as in `as_slice`, and `&mut self` is exclusive.
+        unsafe { core::slice::from_raw_parts_mut(self.ptr.as_ptr(), self.len()) }
+    }
+}
+
+impl Drop for HeapFixedRange {
+    fn drop(&mut self) {
+        crate::debug::g15_trace(format_args!(
+            "HeapFixedRange drop {:#x}..{:#x}: restoring heap class {:#x}",
+            self.range.start,
+            self.range.end,
+            self.heap_prot.as_pte()
+        ));
+        if let Err(e) = self.vm.g15_reprot_range(self.range.clone(), self.heap_prot) {
+            // Keep the range reserved: handing it out with the fixed class
