         mod_dev_dbg!(self.dev, "[Queue {}] Dropping queue\n", self.inner.id);
+
+        // Wait for any publication in flight, then refuse new ones: releasing
+        // the queue's firmware resources mid-pair would strand the pair.
+        #[ver(G == G15)]
+        {
+            *self.inner.g15_publish_gate.lock() = true;
+        }
+
+        #[ver(G == G15)]
+        {
+            // A client killed mid-render closes its queue while a render
+            // (its own or another client's) is on the GPU; a firmware
+            // teardown command under a running job hangs it until the
+            // watchdog. Hold the job slot across the release and the drop of
+            // the queue's firmware-visible objects (see `claim_for_teardown`).
+            let max_ms = G15_TEARDOWN_WAIT_MAX_MS;
+            let dev = self.dev.clone();
+            self.g15_teardown_slot =
+                G15JobGate::claim_for_teardown(&self.dev.g15_job_gate, max_ms, &|| dev.gpu.is_crashed());
+            // No slot (timeout, or a fail-stopped GPU that may still run an
+            // uncancelable job): send no firmware command and retain every
+            // firmware-visible resource.
+            if self.g15_teardown_slot.is_none() {
+                dev_warn!(
+                    self.dev.as_ref(),
+                    "G15 queue {} teardown: no job slot (timeout or fail-stop after up to {} ms); retaining resources\n",
+                    self.inner.id,
+                    max_ms
+                );
+            }
+            let mut retain_selected = self.g15_teardown_slot.is_none();
+            if !retain_selected { match self.inner._g15_scheduler_publication.state() {
+                G15SchedulerPublicationState::Unpublished
+                | G15SchedulerPublicationState::Released => {}
+                G15SchedulerPublicationState::Published => {
+                    let gpu = (*self.dev)
+                        .gpu
+                        .clone()
+                        .arc_as_any()
+                        .downcast::<gpu::GpuManager::ver>();
+                    let release = gpu
+                        .map_err(|_| EIO)
+                        .and_then(|gpu| self.g15_release_selected_scheduler_resource(&gpu));
+                    match release {
+                        Ok(()) => {
+                            if self.inner._g15_scheduler_publication.mark_released().is_err() {
+                                self.inner._g15_scheduler_publication.mark_uncertain();
+                                retain_selected = true;
+                            }
+                        }
+                        Err(err) => {
+                            self.inner._g15_scheduler_publication.mark_uncertain();
+                            retain_selected = true;
+                            dev_err!(
+                                self.dev.as_ref(),
+                                "G15 queue {} selected scheduler release failed: {:?}; retaining firmware-visible resources\n",
+                                self.inner.id,
+                                err
+                            );
+                        }
+                    }
+                }
+                G15SchedulerPublicationState::Publishing
+                | G15SchedulerPublicationState::Uncertain => {
+                    retain_selected = true;
+                }
+            } }
+
+            if self.inner.gpu_context.is_published_to_firmware() {
+                // Legacy E170/E171 registration-surrogate uncertainty remains
+                // independent from the real selected scheduler-resource state.
+                retain_selected = true;
+            }
+
+            if retain_selected {
+                dev_err!(
+                    self.dev.as_ref(),
+                    "G15 queue {} has uncertain firmware publication; retaining selected queue resources\n",
+                    self.inner.id
+                );
+                core::mem::forget(self.q_comp.take());
+                // W5: an assembled TA/3D channel may be firmware-visible too.
+                core::mem::forget(self.q_vtx.take());
+                core::mem::forget(self.q_frag.take());
+                // The PB descriptor and PM objects may still be referenced.
+                if let Some(render) = self.inner.g15_render_queue.take() {
+                    core::mem::forget(render);
+                }
+                if let Some(resources) = self.inner._g15_fw_queue_resources.take() {
+                    core::mem::forget(resources);
+                }
+            } else if let Some(render) = self.inner.g15_render_queue.take() {
+                // W6: zero g15_pb_desc_table[slot] before the per-queue
+                // resources can drop. A pass still in flight holds its own
+                // reference, so the slot lease outlives it either way.
+                let cleared = match render.published_pb_slot() {
+                    None => Ok(()),
+                    Some(slot) => (*self.dev)
+                        .gpu
+                        .clone()
+                        .arc_as_any()
+                        .downcast::<gpu::GpuManager::ver>()
+                        .map_err(|_| EIO)
+                        .and_then(|gpu| gpu.g15_set_pb_descriptor(slot, Default::default())),
+                };
+                if let Err(err) = cleared {
+                    dev_err!(
+                        self.dev.as_ref(),
+                        "G15 queue {} PB descriptor clear failed: {:?}; retaining render resources\n",
+                        self.inner.id,
+                        err
+                    );
+                    core::mem::forget(render);
+                }
+            }
+            // Still holding the slot: the channels and queue resources go
+            // before any other job may start.
+            drop(self.q_comp.take());
+            drop(self.q_vtx.take());
+            drop(self.q_frag.take());
+            drop(self.inner._g15_fw_queue_resources.take());
+        }
+
+        // The inner state (TA payload, PM arrays, notifier, ...) is
+        // firmware-visible too: if the slot could not be taken, leak it
+        // instead of dropping it with the other fields.
+        #[ver(G == G15)]
+        if self.g15_teardown_slot.is_none() {
+            self.inner.retain();
+        }
     }
 }
