+}
+
+/// Kernel-owned per-pass addresses (W6 `G15RenderResourceRefs` plus the PM
+/// record/Info selection and the segment resource list).
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct G15PassRefs {
+    /// 0x80-byte parameter-buffer Info (TA +0x24, 3D +0x28).
+    pub(crate) buffer_info: u64,
+    /// Selected PM record (`G15PmPool::record_va(index)`).
+    pub(crate) pm_record: u64,
+    /// PM state after the 80 records (`refs().pm_state`).
+    pub(crate) pm_state: u64,
+    pub(crate) pm_scene_slice: Option<u64>,
+    pub(crate) pm_page_metrics: Option<u64>,
+    pub(crate) ctxswitch: u64,
+    pub(crate) ctxswitch_secondary: u64,
+    pub(crate) tilemap: u64,
+    pub(crate) heapmeta: u64,
