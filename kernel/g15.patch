+#define DRM_ASAHI_G15_RENDER_ROLE_FS_USC 5     /* fragment USC words, USC */
+#define DRM_ASAHI_G15_RENDER_ROLE_FS_CODE 6    /* fragment shader code, USC */
+#define DRM_ASAHI_G15_RENDER_ROLE_BG_USC 7     /* background USC words, USC */
