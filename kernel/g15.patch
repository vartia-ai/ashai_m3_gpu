+#[allow(dead_code)]
+impl G15ClientUmaPoolContainerState {
+    pub(crate) fn new_client_address_space() -> Self {
+        Self {
+            command_buffer_state_sequence: 0,
+            slots: [
+                G15ClientUmaPoolSlotState::empty(),
+                G15ClientUmaPoolSlotState::empty(),
+                G15ClientUmaPoolSlotState::empty(),
+                G15ClientUmaPoolSlotState::empty(),
+            ],
+        }
