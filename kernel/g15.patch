+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! G15 (J613, V14_7) render profile types and pure serializers.
+//!
+//! The TA (vertex) and 3D (fragment) firmware commands are built from a
+//! *render profile* extracted offline from a native capture
+//! (`g15-render-bundle-v1`). This file holds only the kernel-side shape of
+//! that profile and the pure functions that turn it into bytes:
+//!
+//! - ordered register lists, one entry per native register, each with a
+//!   provenance class (N native, D derived, R relocated);
+//! - byte templates (SKU streams, command images) with per-field patches;
+//! - the relocation encodings from the bundle schema (`full_address`,
+//!   `bitfield`, which also covers offset-from-base);
+//! - the `ready`/`unresolved` gate.
+//!
+//! No native value lives in this file. Every value comes from the profile at
+//! runtime, from a Linux lifecycle scalar, or from a Linux resource address.
+//! Nothing here allocates: profiles borrow their storage and serializers
+//! write into caller-provided buffers. Every error is `EINVAL` (malformed
+//! profile or missing input) or `EOVERFLOW` (address arithmetic), and every
+//! serializer clears its output before returning an error, so a half-built
+//! image can never reach firmware.
+//!
+//! Consumers: `queue/g15_render.rs` (W4 builders) and the W7 dump. Until W4
+//! lands, nothing calls into this module.
+#![allow(dead_code)]
+
+use super::job::raw::RegisterArray;
+use kernel::prelude::*;
+
+/// Capacity of `fw::job::raw::RegisterArray` (`Array<128, Register>`).
+pub(crate) const G15_REG_LIST_MAX: usize = 128;
+
+/// Upper bound for one byte template (SKU stream or command image): one
+/// 16 KiB UAT page. This is a sanity limit, not a native size; the real size
+/// is the template length, which comes from the profile.
+pub(crate) const G15_TEMPLATE_MAX_BYTES: usize = 0x4000;
+
+macro_rules! g15_named_enum {
+    (
+        $(#[$m:meta])*
+        $name:ident { $($(#[$vm:meta])* $v:ident = $s:literal,)* }
+    ) => {
+        $(#[$m])*
+        #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+        #[repr(u8)]
+        pub(crate) enum $name { $($(#[$vm])* $v,)* }
+
+        impl $name {
+            pub(crate) const ALL: &'static [$name] = &[$($name::$v,)*];
+            pub(crate) const COUNT: usize = Self::ALL.len();
+
+            /// Name used by the bundle/profile producer.
+            pub(crate) const fn name(self) -> &'static str {
+                match self { $($name::$v => $s,)* }
+            }
+
+            /// Map a producer name to the kernel enum. Unknown names fail
+            /// closed: the kernel cannot supply a value it does not know.
+            pub(crate) fn from_name(s: &str) -> Result<Self> {
+                match s {
+                    $($s => Ok($name::$v),)*
+                    _ => Err(EINVAL),
+                }
+            }
+
+            const fn idx(self) -> usize {
+                self as usize
+            }
+        }
+    };
+}
+
+/// Firmware pipe that owns a register list or SKU stream.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum G15Engine {
+    /// Tiling accelerator, `RunVertexG15V14_7`.
+    Ta,
+    /// 3D, `RunFragmentG15V14_7`.
+    Frag,
+}
+
+g15_named_enum! {
+    /// Relocation target: a resource whose Linux address the builder supplies.
+    /// Names are bundle `resources[].id` / section roles (see
+    /// `research/reuse/i04-render-diff-format.md` section 1.2). Command and
+    /// SKU targets are absolute, so a SKU back-pointer into its own command
+    /// (for example `fragment_command + addend`) and a self-pointer into the
+    /// stream (`fragment_sku + addend`) need no special case.
+    G15RelocTarget {
+        TaCommand = "ta_command",
+        FragCommand = "fragment_command",
+        TaSku = "ta_sku",
+        FragSku = "fragment_sku",
+        BarrierCommand = "barrier_command",
+        InitBufferCommand = "initbuffer_command",
+        EventControl = "event_control",
+        StampTa = "stamp_ta",
+        StampFrag = "stamp_frag",
+        FwStampTa = "fw_stamp_ta",
+        FwStampFrag = "fw_stamp_frag",
+        ChannelStateTa = "channel_state_ta",
+        ChannelStateFrag = "channel_state_frag",
+        FirmwareStateTa = "firmware_state_ta",
+        FirmwareStateFrag = "firmware_state_frag",
+        ChannelCommandRegionTa = "channel_command_region_ta",
+        ChannelCommandRegionFrag = "channel_command_region_frag",
+        StatsTa = "stats_ta",
+        StatsFrag = "stats_frag",
+        BufferInfo = "buffer_info",
+        PmRecord = "pm_record",
+        PmState = "pm_state",
+        PmSceneSlice = "pm_scene_slice",
+        PmPageMetrics = "pm_page_metrics",
+        UmaPoolState = "uma_pool_state",
+        UmaMetrics = "uma_metrics",
+        UmaUncachedState = "uma_uncached_state",
+        HwMetrics = "hwmetrics",
+        SegmentResourceList = "segment_resource_list",
+        TvbTilemap = "tvb_tilemap",
+        TvbHeapmeta = "tvb_heapmeta",
+        TvbLayermeta = "tvb_layermeta",
+        Tpc = "tpc",
+        CtxSwitch = "ctxswitch",
+        TaPayload = "ta_payload",
+        RenderTarget = "render_target",
+        VdmStream = "vdm_stream",
+        UscVertex = "usc_vertex",
+        UscFragment = "usc_fragment",
+        UscBackground = "usc_background",
+        UscEndOfTile = "usc_eot",
+        EotStateLoader = "eot_state_loader",
+        PbeDescriptors = "pbe_descriptors",
+        Uniforms = "uniforms",
+    }
+}
+
+g15_named_enum! {
+    /// Linux-side scalar a derived (D) field reads. The first group are
+    /// lifecycle values (names match the W7 dump scalars); the second group
+    /// are register formulas that already exist in the tree and that the W4
+    /// builder evaluates with Linux inputs. The profile names which one a
+    /// field uses; this module never computes them.
+    G15ScalarId {
+        CounterFrag = "counter_frag",
+        CounterTa = "counter_ta",
+        UuidTa = "uuid_ta",
+        UuidFrag = "uuid_frag",
+        StampValueTa = "stamp_value_ta",
+        StampValueFrag = "stamp_value_frag",
+        StampSlotTa = "stamp_slot_ta",
+        StampSlotFrag = "stamp_slot_frag",
+        EventSeq = "event_seq",
+        ContextId = "context_id",
+        CtxGeneration = "ctx_generation",
+        EvctlIndex = "evctl_index",
+        StateSequence = "state_sequence",
+        QueueEventSequence = "queue_event_sequence",
+        /// Per-submission value at TA +0x840 == 3D +0xb88 (W7 section 3).
+        SubmissionTag = "submission_tag",
+        /// TA 0x1c830, `scene.slot()`.
+        PbSlot = "pb_slot",
+        /// 3D 0x10039, `g15_fragment_tile_config`.
+        FragTileConfig = "frag_tile_config",
+        /// 3D 0x16068, `g15_fragment_tilecfg`.
+        FragTilecfg = "frag_tilecfg",
+        /// TA 0x10169, `g15_ta_render_target_max`.
+        TaRenderTargetMax = "ta_render_target_max",
+        /// TA 0x101c9, `g15_ta_depth_level_reg`.
+        TaDepthLevel = "ta_depth_level",
+        /// TA 0xd471, `g15_ta_stencil_level_reg`.
+        TaStencilLevel = "ta_stencil_level",
+        /// TA 0x10799, `g15_ta_dynamic_reg_10799`.
+        TaEncoderTag = "ta_encoder_tag",
+        /// 0x1a099 / 0x1a0a9, `g15_render_clear_state`.
+        ClearState = "clear_state",
+        /// TA 0x1c910 PM page-metrics encoding (`buffer.rs`).
+        PmMetricsReg = "pm_metrics_reg",
+    }
+}
+
+/// Provenance class, as the W7 harness reports it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum G15Class {
+    N,
+    D,
+    R,
+    F,
+    L,
+    U,
+}
+
+/// `((src + add) & and) | or`, with a checked add. This one shape covers the
+/// relations the native captures show (`| bit63`, `+ 0x10_0000_0000`,
+/// `counter + 1`, `context_id - 1`); every constant comes from the profile.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15ValueOp {
+    pub(crate) add: i64,
+    pub(crate) and: u64,
+    pub(crate) or: u64,
+}
+
+impl G15ValueOp {
+    pub(crate) const IDENTITY: Self = Self {
+        add: 0,
+        and: !0,
+        or: 0,
+    };
+
+    pub(crate) fn apply(&self, v: u64) -> Result<u64> {
+        Ok((v.checked_add_signed(self.add).ok_or(EOVERFLOW)? & self.and) | self.or)
+    }
+}
+
+/// One register in one engine's list.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15RegRef {
+    pub(crate) engine: G15Engine,
+    pub(crate) reg: u32,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum G15DerivedSrc {
+    /// A Linux scalar supplied by the builder.
+    Scalar(G15ScalarId),
+    /// The resolved value of another register, in either list. The source
+    /// must itself be N, R or D-from-scalar; chains are rejected, so there
+    /// are no cycles.
+    Reg(G15RegRef),
+}
+
+/// D: a named source plus a data-driven transform.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15Derived {
+    pub(crate) src: G15DerivedSrc,
+    pub(crate) op: G15ValueOp,
+}
+
+/// Base for the bundle `bitfield` encoding.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum G15AddrBase {
+    /// Evidence-backed literal from the profile.
+    Literal(u64),
+    /// The Linux address of a live resource.
+    Target(G15RelocTarget),
+}
+
+/// Bundle relocation encodings. Anything else is rejected by the producer.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum G15Encoding {
+    /// Target + addend, little endian. Width 4 requires the result to fit.
+    FullAddress,
+    /// `((target + addend - base) >> address_shift) << field_shift`, placed
+    /// under `mask`; bits outside `mask` keep the native word. With
+    /// `address_shift == field_shift == 0` this is offset-from-base (TA VDM
+    /// register); with `address_shift == 6` it is the shifted USC program
+    /// field; with base 0 and a mask that excludes tag bits it keeps native
+    /// tag bits (for example bit 63). BG/EOT program registers use
+    /// `FullAddress`. The legacy two-pointer USC packing is not used on G15
+    /// and has no encoding.
+    Bitfield {
+        base: G15AddrBase,
+        address_shift: u8,
+        field_shift: u8,
+        mask: u64,
+    },
+}
+
+/// R: a relocated address.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15Reloc {
+    pub(crate) target: G15RelocTarget,
+    pub(crate) addend: i64,
+    pub(crate) encoding: G15Encoding,
+}
+
+/// Provenance and value rule of one field or register (bundle `fields[]`
+/// provenance plus `relocations[]`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum G15Prov {
+    /// N: the native value, copied.
+    Native,
+    /// D: derived from Linux inputs.
+    Derived(G15Derived),
+    /// R: relocated Linux address.
+    Reloc(G15Reloc),
+    /// F: firmware-owned, written as zero at publish.
+    FwOwned,
+    /// L: live control, evidence only. Never serializable.
+    LiveControl,
+    /// U: unresolved. Never serializable.
+    Unresolved,
+}
+
+impl G15Prov {
+    pub(crate) fn class(&self) -> G15Class {
+        match self {
+            G15Prov::Native => G15Class::N,
+            G15Prov::Derived(_) => G15Class::D,
+            G15Prov::Reloc(_) => G15Class::R,
+            G15Prov::FwOwned => G15Class::F,
+            G15Prov::LiveControl => G15Class::L,
+            G15Prov::Unresolved => G15Class::U,
+        }
+    }
+}
