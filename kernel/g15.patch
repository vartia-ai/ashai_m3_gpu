+        if let Some(id) = binding.hardware_buffer_id() {
+            let idx = id as usize;
+            if idx < G15_HARDWARE_BUFFER_ID_COUNT && self.owners[idx] == binding.owner_cookie {
+                self.refs[idx] = self.refs[idx].checked_add(1).ok_or(EOVERFLOW)?;
