+}
+
+/// One pipe's leases, shared by `QueueJob` (to mark them published) and the
+/// pipe's completion callback (which drops them). Boxed: the submit moves
+/// them several times before they get here.
+/// C9 (`g15_fw_sched_probe=2`): log the TVB page list's first 64 entries,
+/// read from memory (the CPU alias is write-back, the GPU writes uncached).
+fn g15_page_list_rows(when: &str, list: &[u8]) {
+    // Clean+invalidate: before the first publication the kernel's own
+    // writes may still be dirty and must not be discarded.
+    super::g15_resources::g15_clean_to_poc(list.as_ptr() as usize, list.len().min(256));
+    for (r, c) in list.chunks_exact(64).take(4).enumerate() {
+        let mut w = [0u32; 16];
+        for (k, x) in w.iter_mut().enumerate() {
+            // SAFETY: inside the CPU-mapped list.
+            *x = unsafe { core::ptr::read_volatile(c.as_ptr().add(4 * k) as *const u32) };
+        }
+        pr_info!("G15 pagelist {} [{}..]: {:x?}\n", when, r * 16, w);
+    }
+}
