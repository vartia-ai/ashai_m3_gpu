new file mode 100644
index 000000000..dbca4bd81
--- /dev/null
+++ b/drivers/gpu/drm/asahi/render_input.rs
@@ -0,0 +1,1290 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+
+//! User render inputs for the private J613 G15 experiment.
+//!
+//! A `DRM_ASAHI_CMD_RENDER` whose flags are exactly `DRM_ASAHI_RENDER_G15_USER`
+//! carries a userspace pointer to a `struct drm_asahi_g15_render` in
+//! `vdm_ctrl_stream_base`. That struct describes one captured render pass by
+//! its user payloads only (VDM/PPP, USC words and code, PBE, uniforms) plus
+//! the relocations that tie them to each other and to the driver-owned
+//! render target. [`G15UserRender::read`] copies and validates all of it
+//! and copies the kernel profile blob, which the submit path parses with
+//! `render_profile.rs` before anything is allocated;
+//! [`G15UserRender::apply_section`] writes one relocated section into its
+//! driver allocation. Firmware commands, SKU streams and kernel objects are
+//! built by the driver from the profile and never come from these bytes.
+#![allow(dead_code)]
+
+use kernel::{
+    prelude::*,
+    uaccess::{UserPtr, UserSlice},
+    uapi,
+};
+
+const HEADER_BYTES: usize = 96;
+const SECTION_BYTES: usize = 24;
+const RELOC_BYTES: usize = 40;
+const MAX_SECTIONS: usize = uapi::DRM_ASAHI_G15_RENDER_MAX_SECTIONS as usize;
+const MAX_RELOCS: usize = uapi::DRM_ASAHI_G15_RENDER_MAX_RELOCS as usize;
+const MAX_DATA: usize = uapi::DRM_ASAHI_G15_RENDER_MAX_DATA as usize;
+const MAX_SIZE: usize = uapi::DRM_ASAHI_G15_RENDER_MAX_SIZE as usize;
+const MAX_PROFILE: usize = uapi::DRM_ASAHI_G15_RENDER_MAX_PROFILE as usize;
+const MAX_DIM: u16 = uapi::DRM_ASAHI_G15_RENDER_MAX_DIM as u16;
+/// I09 R4: the largest bridge target side. The native 256x256 capture used
+/// the 128x128 one's TVB, TPC (2048 bytes) and PM/UMA sizes, and the tiling
+/// formulas give the same tilemap and TPC sizes up to 512.
+const BRIDGE_MAX_DIM: u16 = 256;
+
+/// The largest target side a plain render may use: [`BRIDGE_MAX_DIM`], or
+/// up to 4096 with the `g15_render_max_dim` module parameter (large targets:
+/// the 0x16068 tile fields and TileInfo-derived TPC/tilemap/heapmeta sizes).
+fn bridge_max_dim() -> u16 {
+    let p = *crate::module_parameters::g15_render_max_dim.value();
+    if p == 0 {
+        BRIDGE_MAX_DIM
+    } else {
+        p.clamp(u32::from(BRIDGE_MAX_DIM), 16384) as u16
+    }
+}
+
+/// I09 R4: row bytes of a bridge target `width` pixels wide: linear RGBA8
+/// rows aligned to 128 bytes, as Mesa's AGX linear layout makes them.
+fn bridge_stride(width: u16) -> usize {
+    (usize::from(width) * 4).next_multiple_of(128)
+}
+const MAX_TARGET: usize = uapi::DRM_ASAHI_G15_MAX_OUTPUT as usize;
+const MAX_ALIGN: u32 = 0x4000;
+const SECTION_DATA_ALIGN: u32 = 16;
+/// GPU addresses accepted for sections and the render target.
+const VA_LIMIT: u64 = 1 << 48;
+const TARGET_RT: u16 = uapi::DRM_ASAHI_G15_RENDER_TARGET_RENDER_TARGET as u16;
+const TARGET_USC: u16 = uapi::DRM_ASAHI_G15_RENDER_TARGET_USC_EXEC_BASE as u16;
+const TARGET_NONE: u16 = uapi::DRM_ASAHI_G15_RENDER_TARGET_NONE as u16;
+const SECTION_FIXED: u64 = uapi::DRM_ASAHI_G15_RENDER_SECTION_FIXED_VA as u64;
+const FIXED_ALIGN: u64 = uapi::DRM_ASAHI_G15_RENDER_FIXED_ALIGN as u64;
+const FIXED_RANGE1: core::ops::Range<u64> = uapi::DRM_ASAHI_G15_RENDER_FIXED_RANGE1_START as u64
+    ..uapi::DRM_ASAHI_G15_RENDER_FIXED_RANGE1_END as u64;
+const FIXED_RANGE5: core::ops::Range<u64> = uapi::DRM_ASAHI_G15_RENDER_FIXED_RANGE5_START as u64
+    ..uapi::DRM_ASAHI_G15_RENDER_FIXED_RANGE5_END as u64;
+
+// The parser below reads the UAPI by byte offset; keep it locked to the header.
+const _: () = {
+    use core::mem::{offset_of, size_of};
+    use uapi::{
+        drm_asahi_cmd_render as C, drm_asahi_g15_render as H, drm_asahi_g15_render_reloc as R,
+        drm_asahi_g15_render_section as S,
+    };
+    assert!(size_of::<H>() == HEADER_BYTES && size_of::<S>() == SECTION_BYTES);
+    assert!(size_of::<R>() == RELOC_BYTES && HEADER_BYTES <= MAX_SIZE);
+    assert!(offset_of!(H, size) == 4 && offset_of!(H, flags) == 8 && offset_of!(H, format) == 12);
+    assert!(
+        offset_of!(H, width) == 16 && offset_of!(H, height) == 18 && offset_of!(H, stride) == 20
+    );
+    assert!(offset_of!(H, canary) == 24 && offset_of!(H, section_count) == 28);
+    assert!(offset_of!(H, clear_color) == 32 && offset_of!(H, reloc_count) == 48);
+    assert!(offset_of!(H, data_size) == 52 && offset_of!(H, sections) == 56);
+    assert!(offset_of!(H, relocs) == 64 && offset_of!(H, data) == 72);
+    assert!(offset_of!(H, kernel_profile) == 80 && offset_of!(H, kernel_profile_size) == 88);
+    assert!(offset_of!(H, pad) == 92);
+    assert!(offset_of!(S, flags) == 2 && offset_of!(S, align) == 4 && offset_of!(S, offset) == 8);
+    assert!(offset_of!(S, length) == 12 && offset_of!(S, native_va) == 16);
+    assert!(offset_of!(R, encoding) == 1 && offset_of!(R, width) == 2);
+    assert!(offset_of!(R, address_shift) == 3 && offset_of!(R, field_shift) == 4);
+    assert!(offset_of!(R, pad) == 5 && offset_of!(R, target) == 6 && offset_of!(R, offset) == 8);
+    assert!(offset_of!(R, base_target) == 12 && offset_of!(R, pad2) == 14);
+    assert!(offset_of!(R, addend) == 16 && offset_of!(R, base) == 24 && offset_of!(R, mask) == 32);
+    assert!(offset_of!(C, flags) == 0 && offset_of!(C, vdm_ctrl_stream_base) == 8);
+};
+
+/// Return the `drm_asahi_g15_render` pointer of a G15 user render command.
+///
+/// `payload` is the command body after its `drm_asahi_cmd_header`, possibly
+/// truncated as the UAPI allows. Flags must be exactly
+/// `DRM_ASAHI_RENDER_G15_USER`, the pointer nonzero, and every other byte zero.
+pub(crate) fn command_pointer(payload: &[u8]) -> Result<u64> {
+    if payload.len() < 16 || payload.len() > core::mem::size_of::<uapi::drm_asahi_cmd_render>() {
+        return Err(EINVAL);
+    }
+    let pointer = le(&payload[8..16]);
+    if le(&payload[0..4]) != u64::from(uapi::DRM_ASAHI_RENDER_G15_USER)
+        || pointer == 0
+        || payload[4..8].iter().any(|&b| b != 0)
+        || payload[16..].iter().any(|&b| b != 0)
+    {
+        return Err(EINVAL);
+    }
+    Ok(pointer)
+}
+
+/// A G15 user render command: its `drm_asahi_g15_render` pointer and, for
+/// `DRM_ASAHI_RENDER_G15_HYBRID`, the VDM stream GPU VA.
+#[derive(Debug)]
+pub(crate) struct G15RenderCommand {
+    pub(crate) pointer: u64,
+    pub(crate) user_vdm: Option<u64>,
+    /// I09 R5 (`DRM_ASAHI_RENDER_G15_USER_RT`): the user render target.
+    pub(crate) user_rt: Option<G15UserTarget>,
+    /// I09 R3 (`DRM_ASAHI_RENDER_G15_USER_REGS`): register fields, boxed
+    /// for [`G15UserRender::read_with`] to keep.
+    pub(crate) user_regs: Option<KBox<G15UserRegFields>>,
+}
+
+/// I09 R3: the `drm_asahi_cmd_render` fields a HYBRID render with
+/// `DRM_ASAHI_RENDER_G15_USER_REGS` supplies register values from
+/// (`fw::g15_render::g15_user_reg_overrides` maps them to registers).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) struct G15UserRegFields {
+    pub(crate) zls_ctrl: u64,
+    pub(crate) ppp_multisamplectl: u64,
+    pub(crate) ppp_ctrl: u32,
+    pub(crate) width_px: u16,
+    pub(crate) height_px: u16,
+    pub(crate) layers: u16,
+    pub(crate) isp_merge_upper_x: u32,
+    pub(crate) isp_merge_upper_y: u32,
+    pub(crate) isp_bgobjdepth: u32,
+    pub(crate) isp_bgobjvals: u32,
+    /// I09 R7 (`g15_render_user_bgeot`, bridge only): the command's
+    /// background program `[bg.usc, bg.rsrc_spec]`, used instead of the
+    /// bundle's when present.
+    pub(crate) bg: Option<[u32; 2]>,
+    /// I09 R7: the same for the end-of-tile program `[eot.usc, eot.rsrc_spec]`.
+    pub(crate) eot: Option<[u32; 2]>,
+    /// Partial renders: the command's `partial_bg` and `partial_eot`
+    /// programs, the same way (`g15_render_user_bgeot`, bridge only).
+    pub(crate) partial_bg: Option<[u32; 2]>,
+    pub(crate) partial_eot: Option<[u32; 2]>,
+    /// Depth (bridge only): `isp_zls_pixels` and `depth.base`, 0 without a
+    /// depth buffer. The base is checked against the command's attachments.
+    pub(crate) isp_zls_pixels: u32,
+    pub(crate) depth_base: u64,
+    /// Stencil (bridge only, `g15_render_stencil`): `stencil.base` of an
+    /// uncompressed single-level S8 buffer, 0 without one. Checked against
+    /// the command's attachments like the depth base.
+    pub(crate) stencil_base: u64,
+    /// R9 (`g15_render_user_isp_arrays`): the command's ISP scissor and
+    /// depth-bias array bases, used instead of the bundle's when present.
+    pub(crate) isp_arrays: Option<[u64; 2]>,
+    /// No `PROCESS_EMPTY_TILES`: Mesa clears nothing, so this render only
+    /// loads and continues earlier contents (3D 0x10039 process-empty-tiles off).
+    pub(crate) load_pass: bool,
+}
+
+/// (offset, width) of every `drm_asahi_cmd_render` field in
+/// [`G15UserRegFields`], in its field order.
+const USER_REG_FIELDS: [(usize, usize); 10] = {
+    use core::mem::offset_of;
+    use uapi::drm_asahi_cmd_render as C;
+    [
+        (offset_of!(C, zls_ctrl), 8),
+        (offset_of!(C, ppp_multisamplectl), 8),
+        (offset_of!(C, ppp_ctrl), 4),
+        (offset_of!(C, width_px), 2),
+        (offset_of!(C, height_px), 2),
+        (offset_of!(C, layers), 2),
+        (offset_of!(C, isp_merge_upper_x), 4),
+        (offset_of!(C, isp_merge_upper_y), 4),
+        (offset_of!(C, isp_bgobjdepth), 4),
+        (offset_of!(C, isp_bgobjvals), 4),
+    ]
+};
+
+// The widths above are the header's field types.
+const _: () = {
+    use core::mem::offset_of;
+    use uapi::drm_asahi_cmd_render as C;
+    assert!(offset_of!(C, ppp_multisamplectl) == offset_of!(C, zls_ctrl) + 8);
+    assert!(offset_of!(C, sampler_heap) == offset_of!(C, ppp_multisamplectl) + 8);
+    assert!(offset_of!(C, width_px) == offset_of!(C, ppp_ctrl) + 4);
+    assert!(offset_of!(C, height_px) == offset_of!(C, width_px) + 2);
+    assert!(offset_of!(C, layers) == offset_of!(C, height_px) + 2);
+    assert!(offset_of!(C, sampler_count) == offset_of!(C, layers) + 2);
+    assert!(offset_of!(C, isp_merge_upper_y) == offset_of!(C, isp_merge_upper_x) + 4);
+    assert!(offset_of!(C, bg) == offset_of!(C, isp_merge_upper_y) + 4);
+    assert!(offset_of!(C, isp_bgobjvals) == offset_of!(C, isp_bgobjdepth) + 4);
+    assert!(offset_of!(C, ts_vtx) == offset_of!(C, isp_bgobjvals) + 4);
+};
+
+/// I09 R3: read [`G15UserRegFields`] from a full `drm_asahi_cmd_render`
+/// (`cmd`), whose bytes outside those fields the caller checks. Width and
+/// height must be 1..=`DRM_ASAHI_G15_RENDER_MAX_DIM` and layers 1.
+fn user_reg_fields(cmd: &[u8]) -> Result<G15UserRegFields> {
+    let f = |i: usize| {
+        let (off, width) = USER_REG_FIELDS[i];
+        le(&cmd[off..off + width])
+    };
+    let regs = G15UserRegFields {
+        zls_ctrl: f(0),
+        ppp_multisamplectl: f(1),
+        ppp_ctrl: f(2) as u32,
+        width_px: f(3) as u16,
+        height_px: f(4) as u16,
+        layers: f(5) as u16,
+        isp_merge_upper_x: f(6) as u32,
+        isp_merge_upper_y: f(7) as u32,
+        isp_bgobjdepth: f(8) as u32,
+        isp_bgobjvals: f(9) as u32,
+        bg: None,
+        eot: None,
+        partial_bg: None,
+        partial_eot: None,
+        isp_zls_pixels: 0,
+        depth_base: 0,
+        stencil_base: 0,
+        isp_arrays: None,
+        load_pass: false,
+    };
+    // Plain renders may be larger with `g15_render_max_dim`; `instantiate`
+    // applies that limit.
+    let max = MAX_DIM.max(bridge_max_dim());
+    if !(1..=max).contains(&regs.width_px)
+        || !(1..=max).contains(&regs.height_px)
+        || regs.layers != 1
+    {
+        return Err(EINVAL);
+    }
+    Ok(regs)
+}
+
+fn in_user_reg_field(i: usize) -> bool {
+    USER_REG_FIELDS
+        .iter()
+        .any(|&(off, width)| (off..off + width).contains(&i))
+}
+
+/// I09 R8b: a plain `drm_asahi_cmd_render` (Mesa's; flags without any
+/// `DRM_ASAHI_RENDER_G15_*` bit) for the bridge bundle. `payload` may stop
+/// before the trailing level offsets and `eot_state_loader`, as Mesa's
+/// struct does. Returns the VDM stream VA and the register fields (as
+/// G15_USER_REGS takes them). VERTEX_SCRATCH, helper programs, samplers and
+/// timestamps are ENODEV; unknown flags EINVAL. Depth: `isp_zls_pixels`
+/// and `depth.base` are taken (uncompressed depth only); stencil and depth
+/// compression are ENODEV. The scissor, depth bias and partial fields are
+/// not used: the bundle's are. Not inlined.
+#[inline(never)]
+pub(crate) fn plain_command(payload: &[u8]) -> Result<(u64, KBox<G15UserRegFields>)> {
+    type R = uapi::drm_asahi_cmd_render;
+    let mesa_len = core::mem::offset_of!(R, depth_level_offset);
+    if !(mesa_len..=CMD_BYTES).contains(&payload.len()) {
+        return Err(EINVAL);
+    }
+    let mut cmd = [0u8; CMD_BYTES];
+    cmd[..payload.len()].copy_from_slice(payload);
+    let flags = le(&cmd[0..4]) as u32;
+    let known = uapi::drm_asahi_render_flags_DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES
+        | uapi::drm_asahi_render_flags_DRM_ASAHI_RENDER_NO_VERTEX_CLUSTERING
+        | uapi::drm_asahi_render_flags_DRM_ASAHI_RENDER_DBIAS_IS_INT
+        | uapi::DRM_ASAHI_RENDER_G15_LONG_LISTS;
+    if flags & uapi::drm_asahi_render_flags_DRM_ASAHI_RENDER_VERTEX_SCRATCH != 0 {
+        return Err(ENODEV);
+    }
+    // Bit 3 is HAS_LOAD_CLEAR here and VDM_BARRIER_FRAGMENT in Gravity's
+    // Mesa, which sets it only when the kernel advertises
+    // FEATURE_FRAGMENT_BARRIER (G15 does not), so it is unknown too.
+    if flags & !known != 0 {
+        return Err(EINVAL);
+    }
+    let field = |off: usize, len: usize| cmd[off..off + len].iter().any(|&b| b != 0);
+    let unsupported = [
+        (core::mem::offset_of!(R, vertex_helper), core::mem::size_of::<uapi::drm_asahi_helper_program>()),
+        (core::mem::offset_of!(R, fragment_helper), core::mem::size_of::<uapi::drm_asahi_helper_program>()),
+        (core::mem::offset_of!(R, sampler_heap), 8),
+        (core::mem::offset_of!(R, sampler_count), 2),
+        (core::mem::offset_of!(R, ts_vtx), core::mem::size_of::<uapi::drm_asahi_timestamps>()),
+        (core::mem::offset_of!(R, ts_frag), core::mem::size_of::<uapi::drm_asahi_timestamps>()),
+        (core::mem::offset_of!(R, depth) + core::mem::offset_of!(uapi::drm_asahi_zls_buffer, comp_base), 8),
+        (core::mem::offset_of!(R, stencil) + core::mem::offset_of!(uapi::drm_asahi_zls_buffer, comp_base), 8),
+        (core::mem::offset_of!(R, stencil) + core::mem::offset_of!(uapi::drm_asahi_zls_buffer, comp_stride), 4),
+    ];
+    let stencil_off = core::mem::offset_of!(R, stencil);
+    let stencil_base = le(&cmd[stencil_off..][..8]);
+    // The layer stride is meaningless for one layer (Mesa may leave it set);
+    // layers > 1 are refused by the target check.
+    if stencil_base != 0 && *crate::module_parameters::g15_render_stencil.value() == 0 {
+        return Err(ENODEV);
+    }
+    // Stencil level offset: only level 0 for now.
+    let s_level = core::mem::offset_of!(R, stencil_level_offset);
+    if payload.len() >= s_level + 8 && field(s_level, 8) {
+        return Err(ENODEV);
+    }
+    if unsupported.iter().any(|&(off, len)| field(off, len)) {
+        return Err(ENODEV);
+    }
+    let vdm = le(&cmd[8..16]);
+    if vdm == 0 {
+        return Err(EINVAL);
+    }
+    let mut regs = user_reg_fields(&cmd)?;
+    regs.load_pass = flags & uapi::drm_asahi_render_flags_DRM_ASAHI_RENDER_PROCESS_EMPTY_TILES == 0;
+    regs.isp_zls_pixels = le(&cmd[core::mem::offset_of!(R, isp_zls_pixels)..][..4]) as u32;
+    regs.depth_base = le(&cmd[core::mem::offset_of!(R, depth)..][..8]);
+    regs.stencil_base = stencil_base;
+    let zs = regs.depth_base != 0 || regs.stencil_base != 0;
+    if regs.depth_base & 0x7f != 0 || regs.stencil_base & 0x7f != 0 || zs != (regs.isp_zls_pixels != 0) {
+        return Err(EINVAL);
+    }
+    // ZLS control: S load (bit 14) / store (bit 18) and S compression
+    // (bits 4, 8) need an uncompressed stencil buffer, or the ZLS unit would
+    // access address 0.
+    const S_LOAD_STORE: u64 = (1 << 14) | (1 << 18);
+    const S_COMPRESS: u64 = (1 << 4) | (1 << 8);
+    if regs.zls_ctrl & S_COMPRESS != 0 || (regs.stencil_base == 0 && regs.zls_ctrl & S_LOAD_STORE != 0) {
+        return Err(EINVAL);
+    }
+    // I09 R7: a bg.usc or eot.usc with an address brings that program; one
+    // without (0, or only Mesa's low flag bits) keeps the bundle's. A
+    // program's address is 64-byte aligned.
+    let word = |off: usize| le(&cmd[off..off + 4]) as u32;
+    if *crate::module_parameters::g15_render_user_bgeot.value() != 0 {
+        let program = |off: usize| -> Result<Option<[u32; 2]>> {
+            match word(off) {
+                usc if usc & !0x3f == 0 => Ok(None),
+                usc if usc & 0x3f != 0 => Err(EINVAL),
+                usc => Ok(Some([usc, word(off + 4)])),
+            }
+        };
+        regs.bg = program(core::mem::offset_of!(R, bg))?;
+        regs.eot = program(core::mem::offset_of!(R, eot))?;
+        regs.partial_bg = program(core::mem::offset_of!(R, partial_bg))?;
+        regs.partial_eot = program(core::mem::offset_of!(R, partial_eot))?;
+    }
+    if *crate::module_parameters::g15_render_user_isp_arrays.value() != 0 {
+        let scissor = le(&cmd[core::mem::offset_of!(R, isp_scissor_base)..][..8]);
+        let dbias = le(&cmd[core::mem::offset_of!(R, isp_dbias_base)..][..8]);
+        if scissor != 0 && dbias != 0 {
+            // The low two bits are flags in the legacy register layout.
+            regs.isp_arrays = Some([scissor & !0x3, dbias & !0x3]);
+        }
+    }
+    Ok((vdm, KBox::new(regs, GFP_KERNEL)?))
+}
+
+/// I09 R5: a render target in a user BO, as the command names it. Only the
+/// command shape is checked here; the range is checked against the VM later.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct G15UserTarget {
+    pub(crate) base: u64,
+    pub(crate) size: u64,
+}
+
+/// Bytes of a `drm_asahi_cmd_render`, and of the HYBRID commands after it.
+const CMD_BYTES: usize = core::mem::size_of::<uapi::drm_asahi_cmd_render>();
+const HYBRID_BYTES: usize = core::mem::size_of::<uapi::drm_asahi_g15_cmd_render_hybrid>();
+const HYBRID_RT_BYTES: usize = core::mem::size_of::<uapi::drm_asahi_g15_cmd_render_hybrid_rt>();
+const _: () = assert!(
+    HYBRID_BYTES == CMD_BYTES + 8
+        && core::mem::offset_of!(uapi::drm_asahi_g15_cmd_render_hybrid, g15_render) == CMD_BYTES
+        && HYBRID_RT_BYTES == HYBRID_BYTES + 16
+        && core::mem::offset_of!(uapi::drm_asahi_g15_cmd_render_hybrid_rt, rt_base) == HYBRID_BYTES
+        && core::mem::offset_of!(uapi::drm_asahi_g15_cmd_render_hybrid_rt, rt_size)
+            == HYBRID_BYTES + 8
+);
+
+/// Parse a G15 user render command (I09 R1). Flags exactly
+/// `DRM_ASAHI_RENDER_G15_USER | DRM_ASAHI_RENDER_G15_HYBRID` need the full
+/// `drm_asahi_g15_cmd_render_hybrid`: a nonzero `vdm_ctrl_stream_base` (the
+/// VDM stream VA, checked against the VM later), every other render byte
+/// zero and a nonzero `g15_render` pointer. I09 R5: with
+/// `DRM_ASAHI_RENDER_G15_USER_RT` as well, the full
+/// `drm_asahi_g15_cmd_render_hybrid_rt`, whose `rt_base` and `rt_size` must
+/// be nonzero. I09 R3: with `DRM_ASAHI_RENDER_G15_USER_REGS` on either
+/// HYBRID shape, the [`G15UserRegFields`] fields may be nonzero too (see
+/// `user_reg_fields`). Anything else is [`command_pointer`]'s shape, with no
+/// user VDM. Not inlined: keeps its locals out of the submit gate's frame.
+#[inline(never)]
+pub(crate) fn command_input(payload: &[u8]) -> Result<G15RenderCommand> {
+    let hybrid = u64::from(uapi::DRM_ASAHI_RENDER_G15_USER | uapi::DRM_ASAHI_RENDER_G15_HYBRID);
+    let hybrid_rt = hybrid | u64::from(uapi::DRM_ASAHI_RENDER_G15_USER_RT);
+    let regs_flag = u64::from(uapi::DRM_ASAHI_RENDER_G15_USER_REGS);
+    let flags = if payload.len() < 8 { 0 } else { le(&payload[0..4]) };
+    let with_regs = flags & regs_flag != 0;
+    let len = match flags & !regs_flag {
+        f if f == hybrid => HYBRID_BYTES,
+        f if f == hybrid_rt => HYBRID_RT_BYTES,
+        _ => {
+            return command_pointer(payload).map(|pointer| G15RenderCommand {
+                pointer,
+                user_vdm: None,
+                user_rt: None,
+                user_regs: None,
+            })
+        }
+    };
+    if payload.len() != len {
+        return Err(EINVAL);
+    }
+    let vdm = le(&payload[8..16]);
+    let pointer = le(&payload[CMD_BYTES..HYBRID_BYTES]);
+    if vdm == 0
+        || pointer == 0
+        || payload[4..8].iter().any(|&b| b != 0)
+        || payload[16..CMD_BYTES]
+            .iter()
+            .enumerate()
+            .any(|(i, &b)| b != 0 && !(with_regs && in_user_reg_field(16 + i)))
+    {
+        return Err(EINVAL);
+    }
+    let user_regs = if with_regs {
+        let fields = user_reg_fields(&payload[..CMD_BYTES])?;
+        Some(KBox::new(fields, GFP_KERNEL)?)
+    } else {
+        None
+    };
+    let user_rt = if len == HYBRID_RT_BYTES {
+        let rt = G15UserTarget {
+            base: le(&payload[HYBRID_BYTES..HYBRID_BYTES + 8]),
+            size: le(&payload[HYBRID_BYTES + 8..HYBRID_RT_BYTES]),
+        };
+        if rt.base == 0 || rt.size == 0 {
+            return Err(EINVAL);
+        }
+        Some(rt)
+    } else {
+        None
+    };
+    Ok(G15RenderCommand {
+        pointer,
+        user_vdm: Some(vdm),
+        user_rt,
+        user_regs,
+    })
+}
+
+/// Payload role of a section; decides placement and which builder uses it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Role {
+    Vdm,
+    Ppp,
+    VsUsc,
+    VsCode,
+    FsUsc,
+    FsCode,
+    BgUsc,
+    BgCode,
+    EotUsc,
+    EotCode,
+    Pbe,
+    Uniforms,
+    AuxData,
+    AuxCode,
+    AuxDataRw,
+}
+
+/// Where the driver must place a section.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Placement {
+    /// Addressable from the queue's USC execution base.
+    Usc,
+    /// Ordinary driver data memory.
+    Data,
+}
+
+impl Role {
+    fn from_raw(raw: u16) -> Option<Self> {
+        use Role::*;
+        Some(match u32::from(raw) {
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_VDM => Vdm,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_PPP => Ppp,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_VS_USC => VsUsc,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_VS_CODE => VsCode,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_FS_USC => FsUsc,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_FS_CODE => FsCode,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_BG_USC => BgUsc,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_BG_CODE => BgCode,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_EOT_USC => EotUsc,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_EOT_CODE => EotCode,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_PBE => Pbe,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_UNIFORMS => Uniforms,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_AUX_DATA => AuxData,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_AUX_CODE => AuxCode,
+            uapi::DRM_ASAHI_G15_RENDER_ROLE_AUX_DATA_RW => AuxDataRw,
+            _ => return None,
+        })
+    }
+
+    /// USC words and code are referenced as USC offsets, so both live in
+    /// the USC range. Confirm against the native addresses once I03 lands.
+    pub(crate) fn placement(self) -> Placement {
+        use Role::*;
+        match self {
+            Vdm | Ppp | Pbe | Uniforms | AuxData | AuxDataRw => Placement::Data,
+            _ => Placement::Usc,
+        }
+    }
+
+    /// Zero-based index of the role (`DRM_ASAHI_G15_RENDER_ROLE_*` - 1).
+    pub(crate) fn index(self) -> usize {
+        use Role::*;
+        match self {
+            Vdm => 0,
+            Ppp => 1,
+            VsUsc => 2,
+            VsCode => 3,
+            FsUsc => 4,
+            FsCode => 5,
+            BgUsc => 6,
+            BgCode => 7,
+            EotUsc => 8,
+            EotCode => 9,
+            Pbe => 10,
+            Uniforms => 11,
+            AuxData => 12,
+            AuxCode => 13,
+            AuxDataRw => 14,
+        }
+    }
+
+    /// Number of roles.
+    pub(crate) const COUNT: usize = 15;
+
+    fn repeatable(self) -> bool {
+        matches!(
+            self,
+            Role::Uniforms | Role::AuxData | Role::AuxCode | Role::AuxDataRw
+        )
+    }
+
+    fn min_align(self) -> u64 {
+        match self.placement() {
+            Placement::Usc => 0x80,
+            Placement::Data => 0x40,
+        }
+    }
+}
+
+/// One validated payload section.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Section {
+    pub(crate) role: Role,
+    /// Required GPU alignment of the driver copy.
+    pub(crate) align: u64,
+    /// Address in the native capture; the mapped address when `fixed`.
+    pub(crate) native_va: u64,
+    /// Map at exactly `native_va` (DRM_ASAHI_G15_RENDER_SECTION_FIXED_VA).
+    pub(crate) fixed: bool,
+    offset: usize,
+    len: usize,
+}
+
+impl Section {
+    pub(crate) fn len(&self) -> usize {
+        self.len
+    }
+
+    /// The fixed VA, if the section has one.
+    pub(crate) fn fixed_va(&self) -> Option<u64> {
+        self.fixed.then_some(self.native_va)
+    }
+
+    fn fixed_ok(&self) -> bool {
+        let end = match self.native_va.checked_add(self.len as u64) {
+            Some(end) => end,
+            None => return false,
+        };
+        let inside = |r: &core::ops::Range<u64>| self.native_va >= r.start && end <= r.end;
+        let window_ok = match (self.role, self.role.placement()) {
+            (Role::Vdm, _) => inside(&FIXED_RANGE1),
+            (_, Placement::Usc) => inside(&FIXED_RANGE5),
+            (_, Placement::Data) => inside(&FIXED_RANGE1) || inside(&FIXED_RANGE5),
+        };
+        window_ok && self.native_va % FIXED_ALIGN == 0 && self.len as u64 % FIXED_ALIGN == 0
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Target {
+    Section(usize),
+    RenderTarget,
+    UscExecBase,
+    Literal(u64),
+}
+
+#[derive(Clone, Copy, Debug)]
+enum Encoding {
+    FullAddress,
+    Bitfield {
+        base: Target,
+        address_shift: u32,
+        field_shift: u32,
+    },
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Reloc {
+    section: usize,
+    offset: usize,
+    width: usize,
+    /// Bits the relocation replaces within its `width`-byte word.
+    mask: u64,
+    target: Target,
+    addend: i64,
+    encoding: Encoding,
+}
+
+/// Driver addresses a render input is relocated against.
+#[derive(Clone, Copy)]
+pub(crate) struct RenderAddresses<'a> {
+    /// GPU address of each section's driver copy, by section index.
+    pub(crate) sections: &'a [u64],
+    pub(crate) render_target: u64,
+    pub(crate) usc_exec_base: u64,
+}
+
+/// A validated `drm_asahi_g15_render`, copied out of user memory.
+pub(crate) struct G15UserRender {
+    width: u16,
+    height: u16,
+    /// Row bytes of the render target.
+    stride: usize,
+    canary: u32,
+    clear_color: [u32; 4],
+    sections: KVec<Section>,
+    relocs: KVec<Reloc>,
+    data: KVVec<u8>,
+    profile: KVVec<u8>,
+    /// Built-in bridge: every section is zero and has no relocation, so
+    /// `data` is empty and each section is cleared in place.
+    zeroed: bool,
+    /// HYBRID (I09 R1): GPU VA of the user VDM stream; then no VDM section.
+    user_vdm: Option<u64>,
+    /// HYBRID with a user render target (I09 R5): no driver-owned target.
+    user_rt: Option<G15UserTarget>,
+    /// HYBRID with `DRM_ASAHI_RENDER_G15_USER_REGS` (I09 R3). Boxed: the
+    /// render input is moved through several submit frames.
+    user_regs: Option<KBox<G15UserRegFields>>,
+    /// G2: Mesa marked this render as able to give a tile list past byte
+    /// 0x40 (`DRM_ASAHI_RENDER_G15_LONG_LISTS`); only then is it relinked.
+    long_lists: bool,
+}
+
+fn le(bytes: &[u8]) -> u64 {
+    bytes
+        .iter()
+        .rev()
+        .fold(0, |acc, &b| (acc << 8) | u64::from(b))
+}
+
+fn read_user(pointer: u64, len: usize) -> Result<KVVec<u8>> {
+    let mut buf = KVVec::with_capacity(len, GFP_KERNEL)?;
+    buf.resize(len, 0, GFP_KERNEL)?;
+    if len != 0 {
+        if pointer == 0 {
+            return Err(EFAULT);
+        }
+        UserSlice::new(UserPtr::from_addr(pointer as _), len)
+            .reader()
+            .read_slice(&mut buf)?;
+    }
+    Ok(buf)
+}
+
+fn width_mask(width: usize) -> u64 {
+    if width == 8 {
+        u64::MAX
+    } else {
+        (1u64 << (8 * width)) - 1
+    }
+}
+
+impl G15UserRender {
+    /// See `long_lists`.
+    pub(crate) fn set_long_lists(&mut self, v: bool) {
+        self.long_lists = v;
+    }
+
+    pub(crate) fn long_lists(&self) -> bool {
+        self.long_lists
+    }
+
+    /// Copy and validate a render input from userspace.
+    pub(crate) fn read(pointer: u64) -> Result<Self> {
+        Self::read_with(pointer, None, None, None)
+    }
+
+    /// [`Self::read`], for a HYBRID command when `user_vdm` is set: the VDM
+    /// stream is that GPU VA, so a VDM section is EINVAL instead of required.
+    /// `user_rt` (I09 R5, HYBRID only) must hold at least
+    /// [`Self::target_size`] bytes. `user_regs` (I09 R3, HYBRID only) is
+    /// kept for the command builder.
+    pub(crate) fn read_with(
+        pointer: u64,
+        user_vdm: Option<u64>,
+        user_rt: Option<G15UserTarget>,
+        user_regs: Option<KBox<G15UserRegFields>>,
+    ) -> Result<Self> {
+        if (user_rt.is_some() || user_regs.is_some()) && user_vdm.is_none() {
+            return Err(EINVAL);
+        }
+        let head = read_user(pointer, 8)?;
+        let (version, size) = (le(&head[0..4]), le(&head[4..8]) as usize);
+        if version != u64::from(uapi::DRM_ASAHI_G15_RENDER_VERSION)
+            || !(HEADER_BYTES..=MAX_SIZE).contains(&size)
+        {
+            return Err(EINVAL);
+        }
+        let raw = read_user(pointer, size)?;
+        if raw[HEADER_BYTES..].iter().any(|&b| b != 0) {
+            return Err(EINVAL);
+        }
+        let h = |offset: usize, width: usize| le(&raw[offset..offset + width]);
+        let (flags, format) = (h(8, 4), h(12, 4));
+        let (width, height, stride) = (h(16, 2) as u16, h(18, 2) as u16, h(20, 4) as usize);
+        let (section_count, reloc_count) = (h(28, 4) as usize, h(48, 4) as usize);
+        let data_size = h(52, 4) as usize;
+        let (sections_ptr, relocs_ptr, data_ptr) = (h(56, 8), h(64, 8), h(72, 8));
+        let (profile_ptr, profile_size) = (h(80, 8), h(88, 4) as usize);
+        if flags != 0
+            || format != u64::from(uapi::DRM_ASAHI_G15_RENDER_FORMAT_RGBA8_UNORM)
+            || !(1..=MAX_DIM).contains(&width)
+            || !(1..=MAX_DIM).contains(&height)
+            || stride != usize::from(width) * 4
+            || stride * usize::from(height) > MAX_TARGET
+            || !(1..=MAX_SECTIONS).contains(&section_count)
+            || reloc_count > MAX_RELOCS
+            || (reloc_count == 0) != (relocs_ptr == 0)
+            || !(1..=MAX_DATA).contains(&data_size)
+            || !(1..=MAX_PROFILE).contains(&profile_size)
+            || h(92, 4) != 0
+        {
+            return Err(EINVAL);
+        }
+        let mut clear_color = [0u32; 4];
+        for (i, c) in clear_color.iter_mut().enumerate() {
+            *c = h(32 + 4 * i, 4) as u32;
+        }
+        let data = read_user(data_ptr, data_size)?;
+        let raw_sections = read_user(sections_ptr, section_count * SECTION_BYTES)?;
+        let raw_relocs = read_user(relocs_ptr, reloc_count * RELOC_BYTES)?;
+        let profile = read_user(profile_ptr, profile_size)?;
+
+        let mut render = Self {
+            width,
+            height,
+            stride,
+            canary: h(24, 4) as u32,
+            clear_color,
+            sections: KVec::with_capacity(section_count, GFP_KERNEL)?,
+            relocs: KVec::with_capacity(reloc_count, GFP_KERNEL)?,
+            data,
+            profile,
+            zeroed: false,
+            user_vdm,
+            user_rt,
+            user_regs,
+            long_lists: false,
+        };
+        for entry in raw_sections.chunks_exact(SECTION_BYTES) {
+            let section = render.parse_section(entry)?;
+            render.sections.push(section, GFP_KERNEL)?;
+        }
+        let end = render.sections.last().map_or(0, |s| s.offset + s.len);
+        if render.data[end..].iter().any(|&b| b != 0) {
+            return Err(EINVAL);
+        }
+        if render.find(Role::Vdm).is_some() == user_vdm.is_some() {
+            return Err(EINVAL);
+        }
+        if let Some(rt) = user_rt {
+            if rt.base % u64::from(uapi::DRM_ASAHI_G15_RENDER_USER_RT_ALIGN) != 0
+                || rt.size < render.target_size() as u64
+                || rt.size > u64::from(uapi::DRM_ASAHI_G15_RENDER_USER_RT_MAX_SIZE)
+            {
+                return Err(EINVAL);
+            }
+        }
+        for entry in raw_relocs.chunks_exact(RELOC_BYTES) {
+            let reloc = render.parse_reloc(entry)?;
+            render.relocs.push(reloc, GFP_KERNEL)?;
+        }
+        Ok(render)
+    }
+
+    /// Sections must be sorted, disjoint, and separated only by zero bytes.
+    fn parse_section(&self, e: &[u8]) -> Result<Section> {
+        let role = Role::from_raw(le(&e[0..2]) as u16).ok_or(EINVAL)?;
+        let (flags, align) = (le(&e[2..4]), le(&e[4..8]) as u32);
+        let (offset, len) = (le(&e[8..12]) as usize, le(&e[12..16]) as usize);
+        let prev_end = self.sections.last().map_or(0, |s| s.offset + s.len);
+        let end = offset.checked_add(len).ok_or(EINVAL)?;
+        if flags & !SECTION_FIXED != 0
+            || (align != 0 && (!align.is_power_of_two() || align > MAX_ALIGN))
+            || offset % SECTION_DATA_ALIGN as usize != 0
+            || len == 0
+            || offset < prev_end
+            || end > self.data.len()
+            || self.data[prev_end..offset].iter().any(|&b| b != 0)
+            || (!role.repeatable() && self.find(role).is_some())
+        {
+            return Err(EINVAL);
+        }
+        let section = Section {
+            role,
+            align: core::cmp::max(u64::from(align), role.min_align()),
+            native_va: le(&e[16..24]),
+            fixed: flags & SECTION_FIXED != 0,
+            offset,
+            len,
+        };
+        if section.fixed {
+            let end = section.native_va + len as u64;
+            if !section.fixed_ok()
+                || self.sections.iter().filter(|s| s.fixed).any(|s| {
+                    section.native_va < s.native_va + s.len as u64 && s.native_va < end
+                })
+            {
+                return Err(EINVAL);
+            }
+        }
+        Ok(section)
+    }
+
+    fn parse_target(&self, raw: u16, base: bool) -> Result<Target> {
+        Ok(match raw {
+            TARGET_RT => Target::RenderTarget,
+            TARGET_USC if base => Target::UscExecBase,
+            index if usize::from(index) < self.sections.len() => {
+                Target::Section(usize::from(index))
+            }
+            _ => return Err(EINVAL),
+        })
+    }
+
+    fn parse_reloc(&self, e: &[u8]) -> Result<Reloc> {
+        let section = usize::from(e[0]);
+        let (encoding, width) = (u32::from(e[1]), usize::from(e[2]));
+        let (address_shift, field_shift) = (u32::from(e[3]), u32::from(e[4]));
+        let (target, offset) = (le(&e[6..8]) as u16, le(&e[8..12]) as usize);
+        let base_target = le(&e[12..14]) as u16;
+        let (addend, base, mask) = (le(&e[16..24]) as i64, le(&e[24..32]), le(&e[32..40]));
+        if e[5] != 0 || e[14] != 0 || e[15] != 0 || !(width == 4 || width == 8) {
+            return Err(EINVAL);
+        }
+        let s = self.sections.get(section).ok_or(EINVAL)?;
+        if offset.checked_add(width).ok_or(EINVAL)? > s.len {
+            return Err(EINVAL);
+        }
+        let target = self.parse_target(target, false)?;
+        let (encoding, mask) = match encoding {
+            uapi::DRM_ASAHI_G15_RENDER_RELOC_FULL_ADDRESS => {
+                if address_shift != 0
+                    || field_shift != 0
+                    || base != 0
+                    || mask != 0
+                    || base_target != TARGET_NONE
+                {
+                    return Err(EINVAL);
+                }
+                (Encoding::FullAddress, width_mask(width))
+            }
+            uapi::DRM_ASAHI_G15_RENDER_RELOC_BITFIELD => {
+                let base = if base_target == TARGET_NONE {
+                    Target::Literal(base)
+                } else if base == 0 {
+                    self.parse_target(base_target, true)?
+                } else {
+                    return Err(EINVAL);
+                };
+                if address_shift >= 64
+                    || field_shift >= 8 * width as u32
+                    || mask == 0
+                    || mask & !width_mask(width) != 0
+                    || mask & ((1u64 << field_shift) - 1) != 0
+                {
+                    return Err(EINVAL);
+                }
+                let encoding = Encoding::Bitfield {
+                    base,
+                    address_shift,
+                    field_shift,
+                };
+                (encoding, mask)
+            }
+            _ => return Err(EINVAL),
+        };
+        // Patched bits must be zero placeholders in the submitted payload.
+        let start = s.offset + offset;
+        if le(&self.data[start..start + width]) & mask != 0 {
+            return Err(EINVAL);
+        }
+        // Two patches may share bytes only as disjoint fields of one word.
+        for old in self.relocs.iter().filter(|r| r.section == section) {
+            let disjoint_bytes = offset >= old.offset + old.width || old.offset >= offset + width;
+            let split_word = old.offset == offset && old.width == width && old.mask & mask == 0;
+            if !disjoint_bytes && !split_word {
+                return Err(EINVAL);
+            }
+        }
+        Ok(Reloc {
+            section,
+            offset,
+            width,
+            mask,
+            target,
+            addend,
+            encoding,
+        })
+    }
+
+    /// I09 R8b: the bridge bundle root installs (`DRM_IOCTL_ASAHI_G15_BRIDGE`),
+    /// validated as a HYBRID input with a user render target: no VDM
+    /// section, and the target only through RENDER_TARGET relocations. Its
+    /// VDM stream and target are placeholders that [`Self::instantiate`]
+    /// replaces.
+    pub(crate) fn read_bridge(pointer: u64) -> Result<Self> {
+        let target = G15UserTarget {
+            base: 0,
+            size: u64::from(uapi::DRM_ASAHI_G15_RENDER_USER_RT_MAX_SIZE),
+        };
+        Self::read_with(pointer, Some(0), Some(target), None)
+    }
+
+    /// R9 (`g15_render_builtin`): the kernel's own bridge, used when no
+    /// bundle is installed. `profile` is the built-in G15KPRF1 profile
+    /// (`g15_builtin_profile`). The sections keep the triangle capture's
+    /// fixed VAs, roles and sizes so every command word that addresses them
+    /// stays valid, but hold only zeros: with Mesa's own tile programs and
+    /// ISP arrays no captured payload content is read (R9 A/B, all 14
+    /// sections zeroed: exact R4 images and GLES tests). No relocations.
+    pub(crate) fn builtin(profile: KVVec<u8>) -> Result<Self> {
+        // (role, fixed native VA, bytes), in the bridge bundle's order.
+        const SECTIONS: [(Role, u64, usize); 14] = [
+            // Full native extents required: one-page mappings crashed the
+            // firmware at job 74 of a clear test (partials=0,
+            // f2ab-1195d9c1e). Which reader needs them (extent, PTE class or
+            // fixed pointers) is not known.
+            (Role::BgCode, 0x100_001e_8000, 0x40_0000),
+            (Role::EotCode, 0x100_000b_8000, 0x10_0000),
+            (Role::AuxData, 0x10_0000_0000, 0x4000),
+            (Role::AuxData, 0x10_0004_8000, 0x4000),
+            (Role::Ppp, 0x10_0005_8000, 0x4000),
+            (Role::AuxCode, 0x100_0000_0000, 0x4000),
+            (Role::Uniforms, 0x100_0004_0000, 0x4000),
+            (Role::Uniforms, 0x100_0004_4000, 0x4000),
+            (Role::Pbe, 0x100_0060_0000, 0x8000),
+            (Role::VsUsc, 0x100_0061_0000, 0x8000),
+            (Role::FsUsc, 0x100_0062_0000, 0x8000),
+            (Role::AuxDataRw, 0x100_0063_0000, 0x10_0000),
+            (Role::AuxDataRw, 0x100_0073_8000, 0x8000),
+            (Role::AuxCode, 0x100_0078_8000, 0xc_0000),
+        ];
+        let mut sections = KVec::with_capacity(SECTIONS.len(), GFP_KERNEL)?;
+        let mut offset = 0usize;
+        for &(role, native_va, len) in SECTIONS.iter() {
+            sections.push(
+                Section {
+                    role,
+                    align: 0x4000,
+                    native_va,
+                    fixed: true,
+                    offset,
+                    len,
+                },
+                GFP_KERNEL,
+            )?;
+            offset += len;
+        }
+        let data = KVVec::new();
+        Ok(Self {
+            width: 128,
+            height: 128,
+            stride: bridge_stride(128),
+            canary: 0,
+            clear_color: [0; 4],
+            sections,
+            relocs: KVec::new(),
+            data,
+            profile,
+            zeroed: true,
+            user_vdm: Some(0),
+            user_rt: Some(G15UserTarget {
+                base: 0,
+                size: u64::from(uapi::DRM_ASAHI_G15_RENDER_USER_RT_MAX_SIZE),
+            }),
+            user_regs: None,
+            long_lists: false,
+        })
+    }
+
+    /// I09 R8b: the render input for one plain command on this bridge
+    /// bundle: a copy with the command's VDM stream, render target and
+    /// register fields, checked as [`Self::read_with`] checks a HYBRID
+    /// command's. Copies the whole bundle (data and profile), so the
+    /// installed one is never written.
+    ///
+    /// I09 R4: the target is the command's `width_px` x `height_px`
+    /// (each 1..=[`BRIDGE_MAX_DIM`]), linear RGBA8 with the AGX linear row
+    /// stride ([`bridge_stride`]); the bundle's target descriptors are
+    /// rewritten for it ([`Self::resize_descriptors`]).
+    #[inline(never)]
+    pub(crate) fn instantiate(
+        &self,
+        vdm: u64,
+        rt: G15UserTarget,
+        regs: KBox<G15UserRegFields>,
+    ) -> Result<Self> {
+        let (width, height) = (regs.width_px, regs.height_px);
+        let stride = bridge_stride(width);
+        if vdm == 0
+            || !(1..=bridge_max_dim()).contains(&width)
+            || !(1..=bridge_max_dim()).contains(&height)
+            || rt.base % u64::from(uapi::DRM_ASAHI_G15_RENDER_USER_RT_ALIGN) != 0
+            || rt.size < (stride * usize::from(height)) as u64
+            || rt.size > u64::from(uapi::DRM_ASAHI_G15_RENDER_USER_RT_MAX_SIZE)
+        {
+            return Err(EINVAL);
+        }
+        let mut sections = KVec::with_capacity(self.sections.len(), GFP_KERNEL)?;
+        sections.extend_from_slice(&self.sections, GFP_KERNEL)?;
+        let mut relocs = KVec::with_capacity(self.relocs.len(), GFP_KERNEL)?;
+        relocs.extend_from_slice(&self.relocs, GFP_KERNEL)?;
+        let mut data = KVVec::with_capacity(self.data.len(), GFP_KERNEL)?;
+        data.extend_from_slice(&self.data, GFP_KERNEL)?;
+        let mut profile = KVVec::with_capacity(self.profile.len(), GFP_KERNEL)?;
+        profile.extend_from_slice(&self.profile, GFP_KERNEL)?;
+        self.resize_descriptors(&mut data, width, height, stride)?;
+        Ok(Self {
+            width,
+            height,
+            stride,
+            canary: self.canary,
+            clear_color: self.clear_color,
+            sections,
+            relocs,
+            data,
+            profile,
+            zeroed: self.zeroed,
+            user_vdm: Some(vdm),
+            user_rt: Some(rt),
+            user_regs: Some(regs),
+            long_lists: false,
+        })
+    }
+
+    /// I09 R4: rewrite, in `data` (a copy of this bundle's), the size of
+    /// every target descriptor: the 24-byte descriptor whose second qword
+    /// is a RENDER_TARGET relocation of the target address >> 4 (the BG,
+    /// partial BG and EOT descriptors of the native triangle). Each must
+    /// hold this bundle's own size in exactly one of the two layouts the
+    /// native 128, 160, 256 and 200x120 captures show:
+    ///
+    /// - texture (BG, partial BG): `width - 1` at bit 28 and `height - 1`
+    ///   at bit 42 of qword 0, `stride - 16` at bit 42 of qword 1;
+    /// - PBE (EOT): `width - 1` at bit 24 and `height - 1` at bit 38 of
+    ///   qword 0, `stride - 16` at bit 40 of qword 1.
+    ///
+    /// Anything else is EINVAL.
+    fn resize_descriptors(&self, data: &mut [u8], width: u16, height: u16, stride: usize) -> Result {
+        struct Layout {
+            width: u32,
+            height: u32,
+            stride: u32,
+            stride_mask: u64,
+        }
+        const LAYOUTS: [Layout; 2] = [
+            Layout {
+                width: 28,
+                height: 42,
+                stride: 42,
+                stride_mask: 0x3fff,
+            },
+            Layout {
+                width: 24,
+                height: 38,
+                stride: 40,
+                stride_mask: 0xffff,
+            },
+        ];
+        const DIM: u64 = 0x3fff;
+        let fields = |l: &Layout, q0: u64, q1: u64| {
+            (
+                (q0 >> l.width) & DIM,
+                (q0 >> l.height) & DIM,
+                (q1 >> l.stride) & l.stride_mask,
+            )
+        };
+        let own = (
+            u64::from(self.width) - 1,
+            u64::from(self.height) - 1,
+            (self.stride as u64).checked_sub(16).ok_or(EINVAL)?,
+        );
+        let value = (stride as u64).checked_sub(16).ok_or(EINVAL)?;
+        if stride % 16 != 0 {
+            return Err(EINVAL);
+        }
+        for r in self.relocs.iter() {
+            let pbe_address = matches!(
+                r.encoding,
+                Encoding::Bitfield {
+                    address_shift: 4,
+                    field_shift: 0,
+                    ..
+                }
+            );
+            if r.target != Target::RenderTarget || r.width != 8 || !pbe_address {
+                continue;
+            }
+            let s = &self.sections[r.section];
+            let start = r.offset.checked_sub(8).ok_or(EINVAL)?;
+            if start + 24 > s.len {
+                return Err(EINVAL);
+            }
+            let at = s.offset + start;
+            let (q0, q1) = (le(&data[at..at + 8]), le(&data[at + 8..at + 16]));
+            let mut found = LAYOUTS.iter().filter(|l| fields(l, q0, q1) == own);
+            let l = match (found.next(), found.next()) {
+                (Some(l), None) => l,
+                _ => return Err(EINVAL),
+            };
+            if value > l.stride_mask {
+                return Err(EINVAL);
+            }
+            let q0 = (q0 & !(DIM << l.width) & !(DIM << l.height))
+                | ((u64::from(width) - 1) << l.width)
+                | ((u64::from(height) - 1) << l.height);
+            let q1 = (q1 & !(l.stride_mask << l.stride)) | (value << l.stride);
+            data[at..at + 8].copy_from_slice(&q0.to_le_bytes());
+            data[at + 8..at + 16].copy_from_slice(&q1.to_le_bytes());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn width(&self) -> u16 {
+        self.width
+    }
+    pub(crate) fn height(&self) -> u16 {
+        self.height
+    }
+    pub(crate) fn stride(&self) -> usize {
+        self.stride
+    }
+    /// Bytes of the driver-owned render target (and of the readback limit).
+    pub(crate) fn target_size(&self) -> usize {
+        self.stride() * usize::from(self.height)
+    }
+    /// The kernel profile blob ("G15KPRF1"), as copied from userspace.
+    pub(crate) fn profile_blob(&self) -> &[u8] {
+        &self.profile
+    }
+    /// HYBRID: GPU VA of the user VDM stream (no VDM section then).
+    pub(crate) fn user_vdm(&self) -> Option<u64> {
+        self.user_vdm
+    }
+    /// I09 R5: the user render target; then the driver owns none.
+    pub(crate) fn user_rt(&self) -> Option<G15UserTarget> {
+        self.user_rt
+    }
+    /// I09 R3: the register fields of a USER_REGS command.
+    pub(crate) fn user_regs(&self) -> Option<&G15UserRegFields> {
+        self.user_regs.as_deref()
+    }
+    pub(crate) fn canary(&self) -> u32 {
+        self.canary
+    }
+    pub(crate) fn clear_color(&self) -> [u32; 4] {
+        self.clear_color
+    }
+    pub(crate) fn sections(&self) -> &[Section] {
+        &self.sections
+    }
+    /// Index of the first section with `role`.
+    pub(crate) fn find(&self, role: Role) -> Option<usize> {
+        self.sections.iter().position(|s| s.role == role)
+    }
+    /// Unrelocated bytes of a section.
+    pub(crate) fn bytes(&self, index: usize) -> Option<&[u8]> {
+        let s = self.sections.get(index)?;
+        Some(&self.data[s.offset..s.offset + s.len])
+    }
+
+    /// Check driver addresses: one per section, nonzero, below 2^48 and
+    /// aligned for its section, equal to `native_va` for a fixed section;
+    /// the render target 128-byte aligned.
+    pub(crate) fn check_addresses(&self, a: &RenderAddresses<'_>) -> Result {
+        let bad = |addr: u64, align: u64| addr == 0 || addr >= VA_LIMIT || addr & (align - 1) != 0;
+        if a.sections.len() != self.sections.len()
+            || bad(a.render_target, 0x80)
+            || self
+                .sections
+                .iter()
+                .zip(a.sections)
+                .any(|(s, &addr)| bad(addr, s.align) || s.fixed_va().is_some_and(|va| va != addr))
+        {
+            return Err(EINVAL);
+        }
+        Ok(())
+    }
+
+    fn resolve(target: Target, a: &RenderAddresses<'_>) -> u64 {
+        match target {
+            Target::Section(index) => a.sections[index],
+            Target::RenderTarget => a.render_target,
+            Target::UscExecBase => a.usc_exec_base,
+            Target::Literal(value) => value,
+        }
+    }
+
+    /// Copy section `index` into `dst` (its driver allocation, which may be
+    /// longer and is zero-filled past the section) and apply its relocations.
+    /// R9 built-in: every section is zero (no bytes, no relocations).
+    pub(crate) fn sections_zeroed(&self) -> bool {
+        self.zeroed
+    }
+
+    pub(crate) fn apply_section(
+        &self,
+        index: usize,
+        a: &RenderAddresses<'_>,
+        dst: &mut [u8],
+    ) -> Result {
+        self.check_addresses(a)?;
+        if self.zeroed {
+            // A fixed section is reserved over existing heap memory
+            // (`reserve_fixed`), which keeps whatever earlier objects and
+            // renders left there: clear it.
+            dst.fill(0);
+            return Ok(());
+        }
+        let src = self.bytes(index).ok_or(EINVAL)?;
+        if dst.len() < src.len() {
+            return Err(EINVAL);
+        }
+        dst[..src.len()].copy_from_slice(src);
+        dst[src.len()..].fill(0);
+        for r in self.relocs.iter().filter(|r| r.section == index) {
+            let address = (Self::resolve(r.target, a) as i64)
+                .checked_add(r.addend)
+                .filter(|&v| v >= 0)
+                .ok_or(EINVAL)? as u64;
+            let bits = match r.encoding {
+                Encoding::FullAddress => {
+                    if address & !r.mask != 0 {
+                        return Err(EINVAL);
+                    }
+                    address
+                }
+                Encoding::Bitfield {
+                    base,
+                    address_shift,
+                    field_shift,
+                } => {
+                    let delta = address.checked_sub(Self::resolve(base, a)).ok_or(EINVAL)?;
+                    if delta & ((1u64 << address_shift) - 1) != 0 {
+                        return Err(EINVAL);
+                    }
+                    let value = delta >> address_shift;
+                    let field = value << field_shift;
+                    if field >> field_shift != value || field & !r.mask != 0 {
+                        return Err(EINVAL);
+                    }
+                    field
+                }
+            };
+            let word = &mut dst[r.offset..r.offset + r.width];
+            let patched = (le(word) & !r.mask) | bits;
+            word.copy_from_slice(&patched.to_le_bytes()[..r.width]);
+        }
+        Ok(())
+    }
+}
