+/// UMA allocation unit (Page-Pool State counts 4-KiB pages).
+const G15_UMA_PAGE_BYTES: u64 = 0x1000;
+const _: [(); 1024] = [(); G15UmaPoolPopulation::PAGES_PER_BLOCK as usize];
