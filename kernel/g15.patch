+#[versions(AGX)]
+// G15-only; the other generations compile it without a caller.
+#[allow(dead_code)]
+impl G15RenderPairFinal::ver {
+    /// Returns the device slot; the caller frees it after the last pipe's
+    /// leases (K7).
+    fn finish(mut self) -> Option<G15JobSlot> {
+        let state = |c: &Arc<Mutex<Option<super::g15_channel::G15RenderChannel::ver>>>| {
+            let slot = c.lock();
+            (&*slot).as_ref().map(|c| c.transport_state())
+        };
+        let (ta_state, frag_state) = (state(&self.channels[0]), state(&self.channels[1]));
+        let retired = |s: &Option<Result<crate::buffer::G15ChannelTransportState>>| {
+            matches!(s, Some(Ok(s)) if s.doneptr == s.wptr)
+        };
+        let verified = self.error.is_none() && retired(&ta_state) && retired(&frag_state);
+        if self.error.is_some() || crate::debug::g15_verbose() {
+        dev_info!(
+            self.dev.as_ref(),
+            "J613 G15 render completion job={} error={:?} ta={:?} frag={:?} verified={} tvb_overflow={} partials={}\n",
+            self.job_id,
+            self.error,
+            ta_state,
+            frag_state,
+            verified,
+            self.frag_tvb_overflow,
+            self.frag_partials
+        );
+        }
+        // Diagnostic: the UMA page-pool rings after the pass (their
+        // cursors in dynamic_state show the pages the pass took and gave
+        // back; natively they advance every job).
+        if !crate::debug::g15_verbose() {
+        } else if let Some(gpu) = (*self.dev).gpu.as_any().downcast_ref::<gpu::GpuManager::ver>() {
+            for (id, d) in gpu.g15_uma_descriptors_in_use() {
+                dev_info!(
+                    self.dev.as_ref(),
+                    "J613 G15 render job={} uma descriptor {}: {:x?}\n",
+                    self.job_id,
+                    id,
+                    d
+                );
+            }
+        }
+        // The pass's GPU start/end are in its timing record (TA +0x8b0, 3D
+        // +0xbf8/+0xc00). Reported as read; 0 only means "not written".
+        let (gpu_start, gpu_end) = self.timing.read();
+        if let Some(probe) = self.tvb_pa_probe.as_ref() {
+            probe.log(&self.dev, self.job_id);
+        }
+        G15_T_LAST_FIN.store(g15_now_ns(), Ordering::Release);
+        // G2 diagnostic (`g15_fw_sched_probe`): how far the PM walked the TVB
+        // free-page list (entries no longer holding the kernel's initial
+        // page IDs), and the live BufferInfo words, for the first 400 renders.
+        if *module_parameters::g15_fw_sched_probe.value() != 0 && self.job_id < 400 {
+            let tvb = self._resources.queue().tvb();
+            if let Some(list) = tvb.page_list_bytes() {
+                let mut ids = KVec::new();
+                for id in tvb.ids() {
+                    let _ = ids.push(id, GFP_KERNEL);
+                }
+                // The CPU alias is write-back; the GPU writes uncached. The
+                // kernel last wrote the list at queue creation and cleaned it
+                // (pre snapshot), so clean+invalidate loses nothing.
+                super::g15_resources::g15_clean_to_poc(list.as_ptr() as usize, list.len());
+                let mut changed = 0usize;
+                let mut first = usize::MAX;
+                let mut last = 0usize;
+                for (i, w) in list.chunks_exact(4).take(ids.len() * crate::buffer::PAGES_PER_BLOCK).enumerate() {
+                    // SAFETY: inside the CPU-mapped list.
+                    let v = unsafe { core::ptr::read_volatile(w.as_ptr() as *const u32) };
+                    let block = i / crate::buffer::PAGES_PER_BLOCK;
+                    let want = ids.get(block).map(|&b| b + (i % crate::buffer::PAGES_PER_BLOCK) as u32);
+                    if Some(v) != want {
+                        changed += 1;
+                        first = first.min(i);
+                        last = i;
+                    }
+                }
+                let first = if first == usize::MAX { 0 } else { first };
+                // C9 (`g15_fw_sched_probe=2`): the list's first 64 entries
+                // after this render (= before the next one).
+                if *module_parameters::g15_fw_sched_probe.value() == 2 {
+                    g15_page_list_rows("post", list);
+                }
+                dev_info!(
+                    self.dev.as_ref(),
+                    "G15 tvb job={} verified={} pagelist changed={} first={} last={} info={:x?}\n",
+                    self.job_id, verified, changed, first, last,
+                    &self.snapshot_buffer.g15_info_words()[..24]
+                );
+            }
+            // `g15_fw_sched_probe=2`: the non-zero 16-byte lines of the
+            // first TVB blocks (tile lists and vertex data).
+            if *module_parameters::g15_fw_sched_probe.value() == 2 {
+                let tvb = self._resources.queue().tvb();
+                let mut lines = 0usize;
+                for i in 0..4 {
+                    let Some((id, b)) = tvb.block_bytes(i) else { break };
+                    for (j, l) in b.chunks_exact(16).enumerate() {
+                        let mut w = [0u32; 4];
+                        for (k, x) in w.iter_mut().enumerate() {
+                            // SAFETY: inside the CPU-mapped block.
+                            *x = unsafe { core::ptr::read_volatile((l.as_ptr() as *const u32).add(k)) };
+                        }
+                        if w != [0; 4] && lines < 3000 {
+                            lines += 1;
+                            dev_info!(self.dev.as_ref(), "G15 tvbdump job={} page={:#x} +{:#06x}: {:08x} {:08x} {:08x} {:08x}\n",
+                                self.job_id, id, j * 16, w[0], w[1], w[2], w[3]);
+                        }
+                    }
+                }
+            }
+            // PM record words +0x10 / +0x48 of every record (native: both 9
+            // after TA for the hotspot), and the first scene-stats words.
+            {
+                let pm = self._resources.queue().pm();
+                if let Ok(pool) = pm.pool_bytes() {
+                    let rd = |o: usize| -> u32 {
+                        if o + 4 > pool.len() {
+                            return 0;
+                        }
+                        // SAFETY: inside the CPU-mapped pool.
+                        unsafe { core::ptr::read_volatile(pool.as_ptr().add(o) as *const u32) }
+                    };
+                    for i in 0..36u32 {
+                        let o = crate::buffer::g15_j615_pm_record_offset(i) as usize;
+                        let (a, b) = (rd(o + 0x10), rd(o + 0x48));
+                        if a != 0 || b != 0 {
+                            dev_info!(self.dev.as_ref(), "G15 pm job={} record {} +10={:#x} +48={:#x}\n", self.job_id, i, a, b);
+                        }
+                    }
+                }
+                let st = pm.scene_stats_bytes();
+                let mut w = [0u32; 32];
+                for (k, x) in w.iter_mut().enumerate() {
+                    if (k + 1) * 4 <= st.len() {
+                        // SAFETY: inside the CPU-mapped scene stats.
+                        *x = unsafe { core::ptr::read_volatile((st.as_ptr() as *const u32).add(k)) };
+                    }
+                }
+                dev_info!(self.dev.as_ref(), "G15 pm job={} scene stats {:x?}\n", self.job_id, w);
+            }
+            for (name, b) in self._resources.tile_state() {
+                let Ok(b) = b else { continue };
+                let mut nz = KVec::new();
+                let mut count = 0usize;
+                for (i, w) in b.chunks_exact(4).enumerate() {
+                    // SAFETY: inside the CPU-mapped resource.
+                    let v = unsafe { core::ptr::read_volatile(w.as_ptr() as *const u32) };
+                    if v != 0 {
+                        count += 1;
+                        if nz.len() < 48 {
+                            let _ = nz.push((i * 4, v), GFP_KERNEL);
+                        }
+                    }
+                }
+                dev_info!(
+                    self.dev.as_ref(),
+                    "G15 tvb job={} {} len={:#x} nonzero={} first={:x?}\n",
+                    self.job_id, name, b.len(), count, &nz[..]
+                );
+            }
+        }
+        // G2: all 14 R9 fixed sections stay zero before and after both
+        // passing and failing renders (g2payload-113507).
+        if *module_parameters::g15_persist_audit.value() != 0 && self.job_id < 64 {
+            if let Some(p) = self._resources.persistent_fixed() {
+                for (i, first, last, count) in p.dirty().iter() {
+                    dev_info!(self.dev.as_ref(), "G15 persist audit job={} section {} dirty: +{:#x}..+{:#x}, {} bytes\n", self.job_id, i, first, last, count);
+                }
+            }
+        }
+        if *module_parameters::g15_job_timing.value() == 1 {
+            let t = self.t;
+            dev_info!(
+                self.dev.as_ref(),
+                "G15T job={} in={} slot={} pub={} ta={} frag={} fin={} gpu_start={} gpu_end={} ta_stamp={} frag_stamp={} cpub={} cta={} cfrag={}\n",
+                self.job_id, t[0], t[1], t[2], t[3], t[4], g15_now_ns(),
+                gpu_start, gpu_end, self.ta_complete, self.frag_complete,
+                self.c[0], self.c[1], self.c[2]
+            );
+        }
+        if let Some(ta_command) = self.dump_ta_command {
+            let mut last = (*self.dev).g15_render_last.lock();
+            let appended = super::g15_render::G15RenderDump::append_scalars(
+                &mut *last,
+                ta_command,
+                &[
+                    ("done.gpu_start", gpu_start),
+                    ("done.gpu_end", gpu_end),
+                    ("done.ta_complete", self.ta_complete),
+                    ("done.frag_complete", self.frag_complete),
+                ],
+            );
+            if let Err(err) = appended {
+                dev_err!(
+                    self.dev.as_ref(),
+                    "J613 G15 render job={}: completion dump append failed: {:?}\n",
+                    self.job_id,
+                    err
+                );
+            }
+        }
+        if let Some(busy) = self.user_busy.take() {
+            busy.complete(gpu_start, gpu_end, if verified { 0 } else { EIO.to_errno() });
+        }
+        if let Some(gpu) = (*self.dev).gpu.as_any().downcast_ref::<gpu::GpuManager::ver>() {
+            gpu.g15_release_submission(&self.reservation);
+            gpu.g15_note_completion(!verified);
+        }
+        let G15RenderPairFinal::ver {
+            job_slot,
+            fence,
+            error,
+            ..
+        } = self;
+        if let Some(err) = error {
+            fence.set_error(err.into());
+        } else if !verified {
+            fence.set_error(EIO);
+        }
+        job_slot
+    }
+}
