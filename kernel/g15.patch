+/// Linux backing of one resource.
+pub(crate) enum G15Backing {
+    /// DefaultAllocator heap (range-5 heaps and native VA windows).
+    Heap(GpuArray<u8>),
+    /// Accelerator-shared UAT bank 1 (eGartRange 7/8).
+    Bank1(alloc::G15SharedGpuArray<u8>),
+    /// Exact native VA reserved with its own PTE class
+    /// ([`G15RenderHeaps::alloc_fixed`]): one piece per owning heap, in VA
+    /// order, contiguous in GPU VA. Never empty. Only a single piece has a
+    /// contiguous CPU view; several pieces are written through
+    /// [`G15Resource::write_with`].
+    Fixed(KVec<alloc::HeapFixedRange>),
+}
+
+impl G15Backing {
+    /// GPUVA of the first byte.
+    pub(crate) fn gpu_va(&self) -> u64 {
+        match self {
+            G15Backing::Heap(a) => a.gpu_va().get(),
+            G15Backing::Bank1(a) => a.gpu_va().get(),
+            G15Backing::Fixed(p) => p.first().map_or(0, |a| a.gpu_va()),
+        }
+    }
+
+    /// Usable size in bytes.
+    pub(crate) fn len(&self) -> usize {
+        match self {
+            G15Backing::Heap(a) => a.len(),
+            G15Backing::Bank1(a) => a.len(),
+            G15Backing::Fixed(p) => p.iter().map(|a| a.len()).sum(),
+        }
+    }
+
+    /// Contiguous CPU view. EINVAL for a fixed placement of several pieces.
+    fn as_slice(&self) -> Result<&[u8]> {
+        match self {
+            G15Backing::Heap(a) => Ok(a.as_slice()),
+            G15Backing::Bank1(a) => Ok(a.as_slice()),
+            G15Backing::Fixed(p) => match &p[..] {
+                [a] => Ok(a.as_slice()),
+                _ => Err(EINVAL),
+            },
+        }
+    }
+
+    /// Contiguous mutable CPU view. EINVAL for a fixed placement of several
+    /// pieces.
+    fn as_mut_slice(&mut self) -> Result<&mut [u8]> {
+        match self {
+            G15Backing::Heap(a) => Ok(a.as_mut_slice()),
+            G15Backing::Bank1(a) => Ok(a.as_mut_slice()),
+            G15Backing::Fixed(p) => match &mut p[..] {
+                [a] => Ok(a.as_mut_slice()),
+                _ => Err(EINVAL),
+            },
+        }
+    }
+
+    /// Run `f` on a mutable view of the whole resource. A fixed placement of
+    /// several pieces (one section over adjacent arenas) has no contiguous
+    /// CPU mapping: `f` then sees a vmalloc'd copy, gathered from the pieces
+    /// before and scattered back after a successful `f`.
+    fn write_with(&mut self, f: impl FnOnce(&mut [u8]) -> Result) -> Result {
+        let len = self.len();
+        let G15Backing::Fixed(p) = self else {
+            return f(self.as_mut_slice()?);
+        };
+        if let [a] = &mut p[..] {
+            return f(a.as_mut_slice());
+        }
+        let mut staging = KVVec::from_elem(0u8, len, GFP_KERNEL)?;
+        let mut off = 0;
+        for a in p.iter() {
+            staging[off..off + a.len()].copy_from_slice(a.as_slice());
+            off += a.len();
+        }
+        f(&mut staging)?;
+        off = 0;
+        for a in p.iter_mut() {
+            let n = a.len();
+            a.as_mut_slice().copy_from_slice(&staging[off..off + n]);
+            off += n;
+        }
+        Ok(())
+    }
+
+    /// Zero the whole resource in place, piece by piece (no staging copy);
+    /// `stores`: ordinary stores whatever `g15_zero_mode` says.
+    fn zero(&mut self, stores: bool) -> Result {
+        if let G15Backing::Fixed(p) = self {
+            for a in p.iter_mut() {
+                g15_zero_bytes(a.as_mut_slice(), stores);
+            }
+            return Ok(());
+        }
+        g15_zero_bytes(self.as_mut_slice()?, stores);
+        Ok(())
+    }
+
+    /// F2 audit: (first nonzero offset, nonzero byte count), across pieces.
+    /// Lines are cleaned and invalidated first, so the scan sees memory, not
+    /// stale CPU cache lines (the GPU writes these pages uncached).
+    fn nonzero(&self) -> (Option<(usize, usize)>, usize) {
+        let mut first = None;
+        let mut last = 0;
+        let mut count = 0;
+        let mut base = 0;
+        let mut scan = |s: &[u8], base: usize| {
+            g15_clean_to_poc(s.as_ptr() as usize, s.len());
+            for i in 0..s.len() {
+                // SAFETY: `i` is inside the slice; volatile so memory (not a
+                // copy) is read after the invalidate.
+                let b = unsafe { core::ptr::read_volatile(s.as_ptr().add(i)) };
+                if b != 0 {
+                    first.get_or_insert(base + i);
+                    count += 1;
+                    last = base + i;
+                }
+            }
+        };
+        if let G15Backing::Fixed(p) = self {
+            for a in p.iter() {
+                scan(a.as_slice(), base);
+                base += a.len();
+            }
+        } else if let Ok(s) = self.as_slice() {
+            scan(s, 0);
+        }
+        (first.map(|f| (f, last)), count)
+    }
+
+    /// Copy the first `out.len()` bytes out, across pieces. EINVAL if `out`
+    /// is longer than the resource.
+    fn read_into(&self, out: &mut [u8]) -> Result {
+        if out.len() > self.len() {
+            return Err(EINVAL);
+        }
+        if let G15Backing::Fixed(p) = self {
+            let mut off = 0;
+            for a in p.iter() {
+                let n = a.len().min(out.len() - off);
+                out[off..off + n].copy_from_slice(&a.as_slice()[..n]);
+                off += n;
+            }
+            return Ok(());
+        }
+        out.copy_from_slice(&self.as_slice()?[..out.len()]);
+        Ok(())
+    }
+}
+
+/// A resource placed at a verified native class.
+pub(crate) struct G15Resource {
+    backing: G15Backing,
+    heap: G15Heap,
+    /// Class validated and applied by this resource's allocation path; not a live PTE read.
+    class: G15PteClass,
+}
+
+impl G15Resource {
+    /// GPUVA of the first byte.
+    pub(crate) fn gpu_va(&self) -> u64 {
+        self.backing.gpu_va()
+    }
+
+    /// Size in bytes (the profile size).
+    pub(crate) fn len(&self) -> usize {
+        self.backing.len()
+    }
+
+    /// Heap that realized the native class (for a fixed placement over
+    /// several arenas, the owner of its first piece).
+    pub(crate) fn heap(&self) -> G15Heap {
+        self.heap
+    }
+
+    /// Mapping policy this allocation actually applied (not sampled PTE bytes).
+    pub(crate) fn class(&self) -> G15PteClass {
+        self.class
+    }
+
+    /// Read-only contiguous installed payload. Split fixed placements reject;
+    /// the selected diagnostic deliberately does not invent a piece owner.
+    pub(crate) fn read_selected(&self, offset: usize, out: &mut [u8]) -> Result {
+        let end = offset.checked_add(out.len()).ok_or(EINVAL)?;
+        out.copy_from_slice(self.as_slice()?.get(offset..end).ok_or(EINVAL)?);
+        Ok(())
+    }
+
+    /// CPU view. Kernel objects only: after publication the firmware owns the
+    /// contents. EINVAL for a fixed placement of several pieces (use
+    /// [`Self::write_with`]).
+    pub(crate) fn as_mut_slice(&mut self) -> Result<&mut [u8]> {
+        self.backing.as_mut_slice()
+    }
+
+    /// CPU view for dumps and readback. EINVAL for a fixed placement of
+    /// several pieces.
+    pub(crate) fn as_slice(&self) -> Result<&[u8]> {
+        self.backing.as_slice()
+    }
+
+    /// Run `f` on a mutable view of the whole resource, whatever its pieces
+    /// (see [`G15Backing::write_with`]). Before publication only.
+    pub(crate) fn write_with(&mut self, f: impl FnOnce(&mut [u8]) -> Result) -> Result {
+        self.backing.write_with(f)
+    }
+
+    /// Zero the resource in place (a split fixed placement too).
+    pub(crate) fn zero(&mut self) -> Result {
+        self.backing.zero(false)
+    }
+
+    /// F2 audit: ((first, last) nonzero offsets, nonzero byte count).
+    pub(crate) fn nonzero(&self) -> (Option<(usize, usize)>, usize) {
+        self.backing.nonzero()
+    }
+
+    /// Zero with ordinary stores (never DC ZVA), for memory the GPU reads
+    /// through an uncached mapping (F2).
+    pub(crate) fn zero_with_stores(&mut self) -> Result {
+        self.backing.zero(true)
+    }
+}
