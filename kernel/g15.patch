+                            }
+                            dev_info!(pdev.as_ref(), "G15 PMP bootarg {}{}{}{} size={}\n",
+                                k[0] as char, k[1] as char, k[2] as char, k[3] as char, len);
+                            match &k {
+                                b"BDID" => bdid = true,
+                                b"DVID" => dvid = true,
+                                b"DCAP" => dcap = true,
+                                _ => {}
+                            }
+                            i += 8 + len;
+                        }
+                        dev_info!(pdev.as_ref(), "G15 PMP bootargs complete={} BDID={} DVID={} DCAP={}\n",
+                            (complete && i == size), bdid, dvid, dcap);
+                    } else {
+                        dev_info!(pdev.as_ref(), "G15 PMP bootargs span invalid; not parsed\n");
+                    }
+                    // SAFETY: `sram` came from ioremap above.
+                    unsafe { kernel::bindings::iounmap(sram as *mut _) };
+                }
+            } else {
+                dev_info!(pdev.as_ref(), "G15 PMP liveness: PMP or PMS_SRAM domain not on; CPU_CONTROL not read\n");
+            }
+        }
+        if ok && write {
+            // With `g15_pmp_report_diag_ms`, log and pause before each write
+            // so a streamed kernel log localizes a reset.
+            let pause = core::cmp::min(*crate::module_parameters::g15_pmp_report_diag_ms.value(), 1000);
+            for (off, _, val) in SEQ {
+                if pause != 0 {
+                    dev_info!(pdev.as_ref(), "G15 fabric tunables: write +{:#06x} = {:#010x}\n", off, val);
+                    // SAFETY: plain sleep.
+                    unsafe { kernel::bindings::msleep(pause) };
+                }
+                // SAFETY: see `reg`.
+                let _ = unsafe { kernel::bindings::readl(reg(off) as *const _) };
+                // SAFETY: see `reg`.
+                unsafe { kernel::bindings::writel(val, reg(off) as *mut _) };
+            }
+            dev_info!(pdev.as_ref(), "G15 fabric tunables: native 24-register sequence written\n");
+        }
+        // SAFETY: `virt` came from ioremap above.
+        unsafe { kernel::bindings::iounmap(virt as *mut _) };
+        if ok { Ok(()) } else { Err(EIO) }
+    }
+
+    /// G2 PMP qualification (`g15_pmp_sram_export`, read-only): a copy of
+    /// the PMP SRAM (PA 0x2_d050_0000, 0x80000 bytes) taken with aligned
+    /// 32-bit reads, only while the PMP and PMS_SRAM domains are on and the
+    /// PMP ASC is not running. Served by debugfs `asahi/g15_pmp_sram` (0400)
+    /// for offline firmware analysis on the host; never logged.
+    pub(crate) fn g15_pmp_sram_snapshot(pdev: &platform::Device<Core<'_>>) -> Result<KVec<u8>> {
+        let rd32 = |pa: u64| -> Result<u32> {
+            // SAFETY: maps one page of device MMIO for one read; unmapped below.
+            let v = unsafe { kernel::bindings::ioremap_np((pa & !0xfff) as _, 0x1000) } as *mut u8;
+            if v.is_null() {
+                return Err(ENOMEM);
+            }
+            // SAFETY: inside the mapped page.
+            let x = unsafe { kernel::bindings::readl(v.add((pa & 0xfff) as usize) as *const _) };
+            // SAFETY: `v` came from ioremap above.
+            unsafe { kernel::bindings::iounmap(v as *mut _) };
+            Ok(x)
+        };
+        let on = |ps: u32| (ps >> 4) & 0xf == 0xf;
+        if !on(rd32(0x2_d070_0450)?) || !on(rd32(0x2_d070_0458)?) {
+            dev_err!(pdev.as_ref(), "G15 PMP SRAM export: PMP or PMS_SRAM not on; not read\n");
+            return Err(EIO);
+        }
+        let ctl = rd32(0x2_d0c0_0044)?;
+        if ctl != 0 {
+            dev_err!(pdev.as_ref(), "G15 PMP SRAM export: PMP ASC CPU_CONTROL={:#x} (running); not read\n", ctl);
+            return Err(EBUSY);
+        }
+        const SIZE: usize = 0x80000;
+        let mut out = KVec::with_capacity(SIZE, GFP_KERNEL)?;
+        // SAFETY: maps the PMP SRAM for reads only; unmapped below.
+        let sram = unsafe { kernel::bindings::ioremap_np(0x2_d050_0000, SIZE) } as *mut u8;
+        if sram.is_null() {
+            return Err(ENOMEM);
+        }
+        for off in (0..SIZE).step_by(4) {
+            // SAFETY: inside the mapping, 4-aligned.
+            let w = unsafe { kernel::bindings::readl(sram.add(off) as *const _) };
+            out.extend_from_slice(&w.to_le_bytes(), GFP_KERNEL)?;
+        }
+        // SAFETY: `sram` came from ioremap above.
+        unsafe { kernel::bindings::iounmap(sram as *mut _) };
+        dev_info!(pdev.as_ref(), "G15 PMP SRAM export: {} bytes ready in debugfs asahi/g15_pmp_sram\n", out.len());
+        Ok(out)
+    }
+
+    /// G2 (`g15_pmp_sram_objects`, read-only): log the words of fixed PMP
+    /// SRAM objects (Codex's AGX notification audit: callback objects,
+    /// apertures, the row-8 instance and config) while the PMP runs, before
+    /// any AGX vote. Requires PMP and PMS_SRAM actual F, the ASC CPU running
+    /// and READY (dashboard +0x10 bit 0). Fixed offsets only; nothing read is
+    /// dereferenced. With `gpu`, then read (never write) the GPU words the
+    /// AGX callbacks write (0x2_90d14000 +0/+4, 0x2_90d14400 +0/+4/+0x20/
+    /// +0x40/+0x60/+0x80), each after a logged marker and the
+    /// `g15_pmp_report_diag_ms` pause, with the GFX power state actual F.
+    pub(crate) fn g15_pmp_sram_objects(pdev: &platform::Device<Core<'_>>, gpu: bool) -> Result {
+        const RANGES: [(usize, usize); 6] = [
+            (0x70500, 0x70530),
+            (0x6f9b0, 0x6f9f0),
+            (0x73470, 0x73478),
+            (0x73490, 0x734b0),
+            (0x78550, 0x78558),
+            (0x78620, 0x78628),
+        ];
+        let rd32 = |pa: u64| -> Result<u32> {
+            // SAFETY: maps one page of device MMIO for one read; unmapped below.
+            let v = unsafe { kernel::bindings::ioremap_np((pa & !0xfff) as _, 0x1000) } as *mut u8;
+            if v.is_null() {
+                return Err(ENOMEM);
+            }
+            // SAFETY: inside the mapped page.
+            let x = unsafe { kernel::bindings::readl(v.add((pa & 0xfff) as usize) as *const _) };
+            // SAFETY: `v` came from ioremap above.
+            unsafe { kernel::bindings::iounmap(v as *mut _) };
+            Ok(x)
+        };
+        let on = |ps: u32| (ps >> 4) & 0xf == 0xf;
+        let (pmp_ps, sram_ps) = (rd32(0x2_d070_0450)?, rd32(0x2_d070_0458)?);
+        let ctl = rd32(0x2_d0c0_0044)?;
+        // READY is a u64 at dashboard +0x10; read it 64-bit as g15_pmp does.
+        // SAFETY: maps one dashboard page for one read; unmapped below.
+        let dash = unsafe { kernel::bindings::ioremap_np(0x2_d03c_0000, 0x1000) } as *mut u8;
+        if dash.is_null() {
+            return Err(ENOMEM);
+        }
+        // SAFETY: +0x10 is inside the mapped page, 8-aligned.
+        let ready = unsafe { kernel::bindings::readq(dash.add(0x10) as *const _) };
+        // SAFETY: `dash` came from ioremap above.
+        unsafe { kernel::bindings::iounmap(dash as *mut _) };
+        dev_info!(pdev.as_ref(), "G15 PMP SRAM objects: pmp ps {:#x}, sram ps {:#x}, CPU_CONTROL {:#x}, READY {:#x}\n",
+            pmp_ps, sram_ps, ctl, ready);
+        if !on(pmp_ps) || !on(sram_ps) || ctl & (1 << 4) == 0 || ready & 1 == 0 {
+            dev_err!(pdev.as_ref(), "G15 PMP SRAM objects: PMP not powered, running and READY; not read\n");
+            return Err(EIO);
+        }
+        for (start, end) in RANGES {
+            let mut off = start;
+            while off < end {
+                let n = core::cmp::min(4, (end - off) / 4);
+                let mut w = [0u32; 4];
+                for (i, x) in w.iter_mut().take(n).enumerate() {
+                    *x = rd32(0x2_d050_0000 + (off + 4 * i) as u64)?;
+                }
+                match n {
+                    4 => dev_info!(pdev.as_ref(), "G15 PMP SRAM +{:#07x}: {:08x} {:08x} {:08x} {:08x}\n", off, w[0], w[1], w[2], w[3]),
+                    _ => dev_info!(pdev.as_ref(), "G15 PMP SRAM +{:#07x}: {:08x} {:08x}\n", off, w[0], w[1]),
+                }
+                off += 4 * n;
+            }
+        }
+        if gpu {
+            let pause = core::cmp::min(*crate::module_parameters::g15_pmp_report_diag_ms.value(), 1000);
+            let gfx = rd32(0x2_d070_01e0)?;
+            dev_info!(pdev.as_ref(), "G15 PMP AGX bank: gfx ps {:#x}\n", gfx);
+            if !on(gfx) {
+                dev_err!(pdev.as_ref(), "G15 PMP AGX bank: GFX not on; not read\n");
+                return Err(EIO);
+            }
+            for pa in [0x2_90d1_4000u64, 0x2_90d1_4004, 0x2_90d1_4400, 0x2_90d1_4404,
+                       0x2_90d1_4420, 0x2_90d1_4440, 0x2_90d1_4460, 0x2_90d1_4480] {
+                dev_info!(pdev.as_ref(), "G15 PMP AGX bank: read {:#x}\n", pa);
+                if pause != 0 {
+                    // SAFETY: plain sleep.
+                    unsafe { kernel::bindings::msleep(pause) };
+                }
+                let v = rd32(pa)?;
+                dev_info!(pdev.as_ref(), "G15 PMP AGX bank: {:#x} = {:#010x}\n", pa, v);
+            }
+            dev_info!(pdev.as_ref(), "G15 PMP AGX bank: read complete\n");
+        }
+        Ok(())
+    }
+
+    /// G2 experiment (`g15_agx_report_slot0`, research/g15-g2-agx-report-plan.md):
+    /// on an AGX vote the PMP's callback 88 programs eight slots of the GPU
+    /// report bank at 0x2_90d14400 (selectors +0x60/+0x40, mode +0x20, enable
+    /// +0x80) whose destination (+0/+4) the running PMP already set to its
+    /// dashboard mirror 0x2_d03d0000. Do slot 0 only, with the PMP's values
+    /// (+0x60 = 0xa, +0x40 = 0, +0x20 = 0), then enable it (+0x80 = 1), wait,
+    /// read back and disable (+0x80 = 0). Preconditions: PMP running and
+    /// READY, GFX actual F, bank destination as the PMP set it and slot 0 all
+    /// zero. Every step is logged and paused (`g15_pmp_report_diag_ms`).
+    pub(crate) fn g15_agx_report_slot0(pdev: &platform::Device<Core<'_>>) -> Result {
+        const BANK: u64 = 0x2_90d1_4400;
+        let dev = pdev.as_ref();
+        let pause = || {
+            let ms = core::cmp::min(*crate::module_parameters::g15_pmp_report_diag_ms.value(), 1000);
+            if ms != 0 {
+                // SAFETY: plain sleep.
+                unsafe { kernel::bindings::msleep(ms) };
+            }
+        };
+        let map = |pa: u64| -> Result<*mut u8> {
+            // SAFETY: maps one page of device MMIO; unmapped by the caller.
+            let v = unsafe { kernel::bindings::ioremap_np((pa & !0xfff) as _, 0x1000) } as *mut u8;
+            if v.is_null() { Err(ENOMEM) } else { Ok(v) }
+        };
+        let rd = |pa: u64| -> Result<u32> {
+            let v = map(pa)?;
+            // SAFETY: inside the mapped page.
+            let x = unsafe { kernel::bindings::readl(v.add((pa & 0xfff) as usize) as *const _) };
+            // SAFETY: `v` came from ioremap.
+            unsafe { kernel::bindings::iounmap(v as *mut _) };
+            Ok(x)
+        };
+        let on = |ps: u32| (ps >> 4) & 0xf == 0xf;
+        let (pmp_ps, ctl, gfx) = (rd(0x2_d070_0450)?, rd(0x2_d0c0_0044)?, rd(0x2_d070_01e0)?);
+        let dash = map(0x2_d03c_0000)?;
+        // SAFETY: +0x10 inside the mapped page, 8-aligned.
+        let ready = unsafe { kernel::bindings::readq(dash.add(0x10) as *const _) };
+        // SAFETY: `dash` came from ioremap.
+        unsafe { kernel::bindings::iounmap(dash as *mut _) };
+        let bank = map(BANK)?;
+        let r = |off: usize| -> u32 {
+            // SAFETY: `off` < 0x100, inside the mapped page.
+            unsafe { kernel::bindings::readl(bank.add((BANK & 0xfff) as usize + off) as *const _) }
+        };
+        let w = |off: usize, val: u32| {
+            dev_info!(dev, "G15 AGX report: write bank+{:#x} = {:#x}\n", off, val);
+            pause();
+            // SAFETY: `off` < 0x100, inside the mapped page.
+            unsafe { kernel::bindings::writel(val, bank.add((BANK & 0xfff) as usize + off) as *mut _) };
+            let back = r(off);
+            dev_info!(dev, "G15 AGX report: bank+{:#x} now {:#x}\n", off, back);
+            pause();
+        };
+        let before = [r(0x0), r(0x4), r(0x20), r(0x40), r(0x60), r(0x80)];
+        dev_info!(dev, "G15 AGX report: pmp ps {:#x} CPU_CONTROL {:#x} READY {:#x} gfx ps {:#x}; bank +0 {:#x} +4 {:#x} +20 {:#x} +40 {:#x} +60 {:#x} +80 {:#x}\n",
+            pmp_ps, ctl, ready, gfx, before[0], before[1], before[2], before[3], before[4], before[5]);
+        pause();
+        if !on(pmp_ps) || ctl & (1 << 4) == 0 || ready & 1 == 0 || !on(gfx)
+            || before[0] != 0xd03d_0000 || before[1] != 0x2 || before[2..].iter().any(|&x| x != 0)
+        {
+            dev_err!(dev, "G15 AGX report: preconditions not met; no writes\n");
+            // SAFETY: `bank` came from ioremap.
+            unsafe { kernel::bindings::iounmap(bank as *mut _) };
+            return Err(EIO);
+        }
+        w(0x60, 0xa);
+        w(0x40, 0x0);
+        w(0x20, 0x0);
+        w(0x80, 0x1);
+        dev_info!(dev, "G15 AGX report: slot 0 enabled; waiting 500 ms\n");
+        // SAFETY: plain sleep.
+        unsafe { kernel::bindings::msleep(500) };
+        dev_info!(dev, "G15 AGX report: after wait bank +0 {:#x} +4 {:#x} +60 {:#x} +80 {:#x}\n", r(0x0), r(0x4), r(0x60), r(0x80));
+        pause();
+        w(0x80, 0x0);
+        dev_info!(dev, "G15 AGX report: slot 0 disabled; done\n");
+        // SAFETY: `bank` came from ioremap.
+        unsafe { kernel::bindings::iounmap(bank as *mut _) };
+        Ok(())
+    }
+
+    /// G2 step 3 (`g15_pmp_report_gfx`, research/g15-g2-pmp-bringup-plan.md):
+    /// tell the running PMP the GPU is active, as macOS does right before the
+    /// GFX ASC RUN: SOC-DEV-PS-REQ bit 8 (AGX). Requires the firmware-published
+    /// READY (dashboard +0x10 bit 0). Read the request bitmap (+0x1000), write
+    /// it back with bit 8 set through the update mirror (PA 0x2_d03d_0800),
+    /// then wait (bounded) for the PMP's acknowledgement (+0x1080 bit 8).
+    pub(crate) fn g15_pmp_report_gfx(pdev: &platform::Device<Core<'_>>, write: bool) -> Result {
+        const AGX: u64 = 1 << 8;
+        // SAFETY: maps two pages of the dashboard read side; unmapped below.
+        let rd = unsafe { kernel::bindings::ioremap_np(0x2_d03c_0000, 0x2000) } as *mut u8;
+        if rd.is_null() {
+            return Err(ENOMEM);
+        }
+        // SAFETY: maps the update-mirror page; unmapped below.
+        let wr = unsafe { kernel::bindings::ioremap_np(0x2_d03d_0000, 0x1000) } as *mut u8;
+        if wr.is_null() {
+            // SAFETY: `rd` came from ioremap above.
+            unsafe { kernel::bindings::iounmap(rd as *mut _) };
+            return Err(ENOMEM);
+        }
+        // SAFETY (all reads/writes below): offsets inside the mappings, 8-aligned.
+        let readq = |o: usize| unsafe { kernel::bindings::readq(rd.add(o) as *const _) };
+        // Diagnostic only (`g15_pmp_report_diag_ms`): after each marker, give
+        // the line time to reach the host before the next step.
+        let diag_ms = *crate::module_parameters::g15_pmp_report_diag_ms.value();
+        let pause = || {
+            if diag_ms != 0 {
+                // SAFETY: plain sleep.
+                unsafe { kernel::bindings::msleep(diag_ms.min(1000)) };
+            }
+        };
+        dev_info!(pdev.as_ref(), "G15 PMP report: step ready-read\n");
+        pause();
+        let ready = readq(0x10);
+        let result = if ready & 1 == 0 {
+            dev_err!(pdev.as_ref(), "G15 PMP report: PMP not READY (+0x10 = {:#x}); not reported\n", ready);
+            Err(EIO)
+        } else {
+            let req = readq(0x1000);
+            let ack0 = readq(0x1080);
+            dev_info!(pdev.as_ref(), "G15 PMP report: step pre-write req {:#x} ack {:#x}\n", req, ack0);
+            pause();
+            // Guard, immediately before the vote: the GFX domain must be
+            // actually on (natively and in the clean control it is 0xF).
+            // SAFETY: maps one PMGR page for one read; unmapped below.
+            let gp = unsafe { kernel::bindings::ioremap_np(0x2_d070_0000, 0x1000) } as *mut u8;
+            let gfx_ps = if gp.is_null() {
+                None
+            } else {
+                // SAFETY: +0x1e0 inside the mapped page.
+                let v = unsafe { kernel::bindings::readl(gp.add(0x1e0) as *const _) };
+                // SAFETY: `gp` came from ioremap above.
+                unsafe { kernel::bindings::iounmap(gp as *mut _) };
+                Some(v)
+            };
+            if !gfx_ps.is_some_and(|ps| (ps >> 4) & 0xf == 0xf) {
+                dev_err!(pdev.as_ref(), "G15 PMP report: GFX power state {:x?} not on; not written\n", gfx_ps);
+                // SAFETY: both came from ioremap above.
+                unsafe {
+                    kernel::bindings::iounmap(wr as *mut _);
+                    kernel::bindings::iounmap(rd as *mut _);
+                }
+                return Err(EIO);
+            }
+            if !write {
+                // Read-only split (`g15_pmp_report_gfx=2`): every step but the vote.
+                dev_info!(pdev.as_ref(), "G15 PMP report: dry run, gfx ps {:#x}, no write\n", gfx_ps.unwrap_or(0));
+                pause();
+                // SAFETY: both came from ioremap above.
+                unsafe {
+                    kernel::bindings::iounmap(wr as *mut _);
+                    kernel::bindings::iounmap(rd as *mut _);
+                }
+                return Ok(());
+            }
+            dev_info!(pdev.as_ref(), "G15 PMP report: step write gfx ps {:#x} -> mirror {:#x}\n", gfx_ps.unwrap_or(0), req | AGX);
+            // SAFETY: see above.
+            unsafe { kernel::bindings::writeq(req | AGX, wr.add(0x800) as *mut _) };
+            dev_info!(pdev.as_ref(), "G15 PMP report: step written, polling ack\n");
+            pause();
+            let mut ack = 0;
+            for _ in 0..100 {
+                ack = readq(0x1080);
+                if ack & AGX != 0 {
+                    break;
+                }
+                // SAFETY: plain sleep.
+                unsafe { kernel::bindings::msleep(1) };
+            }
+            let state = if ack & AGX != 0 { "acknowledged" } else { "NOT acknowledged" };
+            let now = readq(0x1000);
+            dev_info!(pdev.as_ref(), "G15 PMP report: req {:#x} -> {:#x}, ack before {:#x} after {:#x} (AGX {})\n",
+                req, now, ack0, ack, state);
+            // Single writer here: the request must read back as req | AGX.
+            if now != req | AGX {
+                dev_err!(pdev.as_ref(), "G15 PMP report: request readback {:#x}, expected {:#x}\n", now, req | AGX);
+                Err(EIO)
+            } else if ack & AGX != 0 {
+                Ok(())
+            } else {
+                Err(ETIMEDOUT)
+            }
+        };
+        // SAFETY: both came from ioremap above.
+        unsafe {
+            kernel::bindings::iounmap(wr as *mut _);
+            kernel::bindings::iounmap(rd as *mut _);
+        }
+        result
+    }
+}
