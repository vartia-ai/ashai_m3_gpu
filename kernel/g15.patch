+    fn cached_channel_memory_fwva(&self) -> Result<u64> {
+        let mut state = self.manager.0.lock();
+        let (fwva, _slot) = state.selected_mapped_element(
+            self.index,
+            G15FirmwareResourceKind::CachedChannelMemory,
+        )?;
+        Ok(fwva)
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn reset_channel_state_j615_cl(
+        &self,
+        uncached_channel_fwva: u64,
+        cached_channel_fwva: u64,
+        timestamp_queue_state_fwva: u64,
+        channel_4c_value: u32,
+        scheduler_state_fwva: u64,
+        effective_priority: u32,
+        queue_qos: u32,
+        transport_priority: u32,
+    ) -> Result<u64> {
+        if uncached_channel_fwva == 0
+            || cached_channel_fwva == 0
+            || timestamp_queue_state_fwva == 0
+            || scheduler_state_fwva == 0
+        {
+            return Err(EINVAL);
+        }
+        let priority = fw::workqueue::g15_j615_cl_priority_image(effective_priority, queue_qos)
+            .ok_or(EINVAL)?;
+        let mut state = self.manager.0.lock();
+        let (fwva, slot) = state.selected_mapped_element(
+            self.index,
+            G15FirmwareResourceKind::ChannelState,
+        )?;
+        Self::write_channel_state_header(
+            fwva,
+            slot,
+            uncached_channel_fwva,
+            cached_channel_fwva,
+            timestamp_queue_state_fwva,
+            channel_4c_value,
+            scheduler_state_fwva,
+            fw::workqueue::G15_J615_CDM_BACKOFF_TIMEOUT,
+        )?;
+
+        // R26 has two traced queue roles. The CL0 prelude uses Apple's
+        // priority-0 image, while the write1337 CL2 queue retains R3's exact
+        // priority-2 image. Reject every other transport priority here.
+        let _ = priority;
+        let image = match transport_priority {
+            0 => (0, 0, 0xffff_ffff_ffff_0000, 1, 0, 1),
+            2 => (2, 2, 0xffff_0000_0000_0000, 0, 0, 2),
+            _ => return Err(EINVAL),
+        };
+        Self::write_channel_priority_words(
+            slot,
+            &G15ChannelPriorityWords {
+                word_30: image.0,
+                word_34: image.1,
+                mask_38: image.2,
+                word_40: image.3,
+                word_44: image.4,
+                word_48: image.5,
+            },
+        )?;
+        Ok(fwva)
+    }
+
+    /// Pipe-generic channel-state reset for TA/3D channels. Same header and
+    /// write order as `reset_channel_state_j615_cl`, with every CL-specific
+    /// constant taken from `image` instead.
+    fn reset_channel_state_j615_pipe(
+        &self,
+        uncached_channel_fwva: u64,
+        cached_channel_fwva: u64,
+        timestamp_queue_state_fwva: u64,
+        scheduler_state_fwva: u64,
+        image: &G15PipeChannelStateImage,
+    ) -> Result<u64> {
+        if uncached_channel_fwva == 0
+            || cached_channel_fwva == 0
+            || timestamp_queue_state_fwva == 0
+            || scheduler_state_fwva == 0
+        {
+            return Err(EINVAL);
+        }
+        let mut state = self.manager.0.lock();
+        let (fwva, slot) = state.selected_mapped_element(
+            self.index,
+            G15FirmwareResourceKind::ChannelState,
+        )?;
+        Self::write_channel_state_header(
+            fwva,
+            slot,
+            uncached_channel_fwva,
+            cached_channel_fwva,
+            timestamp_queue_state_fwva,
+            image.owner_pid_50,
+            scheduler_state_fwva,
+            image.byte_ac,
+        )?;
+        crate::debug::g15_stage(format_args!(
+            "init pipe: channel state {:#x} header written (pid {} +0xac {})",
+            fwva, image.owner_pid_50, image.byte_ac
+        ))?;
+        // Apple's priority-0 image for render pipes (and priority-0 queues)
+        // was negative in G2.
+        Self::write_channel_priority_words(slot, &image.priority)?;
+        crate::debug::g15_stage(format_args!(
+            "init pipe: channel state priority words written"
+        ))?;
+        Ok(fwva)
+    }
+
+    /// Zero one selected channel-state element and write its pointer header.
+    #[allow(clippy::too_many_arguments)]
+    fn write_channel_state_header(
+        fwva: u64,
+        slot: &mut [u8],
+        uncached_channel_fwva: u64,
+        cached_channel_fwva: u64,
+        timestamp_queue_state_fwva: u64,
+        channel_4c_value: u32,
+        scheduler_state_fwva: u64,
+        byte_ac: u8,
+    ) -> Result {
+        let gpu_buf_fwva = fwva
+            .checked_add(fw::workqueue::G15_CHANNEL_STATE_GPU_BUF_OFFSET as u64)
+            .ok_or(EOVERFLOW)?;
+        if gpu_buf_fwva == 0 {
+            return Err(EIO);
+        }
+
+        for byte in slot.iter_mut() {
+            *byte = 0;
+        }
+        Self::put_u64(slot, 0x00, uncached_channel_fwva)?;
+        Self::put_u64(slot, 0x08, cached_channel_fwva)?;
+        Self::put_u64(slot, 0x10, timestamp_queue_state_fwva)?;
+        Self::put_u64(slot, 0x18, gpu_buf_fwva)?;
+        Self::put_u32(slot, 0x2c, u32::MAX)?;
+        Self::put_u32(slot, 0x30, 4)?;
+        Self::put_u32(slot, 0x4c, u32::MAX)?;
+        Self::put_u32(slot, 0x50, channel_4c_value)?;
+        Self::put_u64(slot, 0xa4, scheduler_state_fwva)?;
+        slot[0xac] = byte_ac;
+        Ok(())
+    }
+
+    fn write_channel_priority_words(slot: &mut [u8], words: &G15ChannelPriorityWords) -> Result {
+        Self::put_u32(slot, 0x30, words.word_30)?;
+        Self::put_u32(slot, 0x34, words.word_34)?;
+        Self::put_u64(slot, 0x38, words.mask_38)?;
+        Self::put_u32(slot, 0x40, words.word_40)?;
+        Self::put_u32(slot, 0x44, words.word_44)?;
+        Self::put_u32(slot, 0x48, words.word_48)?;
+        Ok(())
+    }
+}
